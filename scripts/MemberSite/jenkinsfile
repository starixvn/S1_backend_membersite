pipeline {
    agent none
    environment {
        env = 'Development'
        registry = '13.213.82.69:8082'
        proj = 'membersite'
    }
    stages {
        stage('Build') {
            agent { node { label 'Build' } }
            steps {
                script {
                    env.version = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                }
                sh 'sudo docker build -f ./MemberSite/MemberSite/Dockerfile -t ${registry}/${proj}:${version} .'
                sh 'sudo docker login ${registry} -u admin -p 123456'
                sh 'sudo docker push ${registry}/${proj}:${version}'
            }
        }
        stage('Deploy') {
            agent { node { label 'master' } }
            steps {
                sh 'ansible-playbook -i DEV.AWS.yml deploy.docker.yml --extra-vars "host=linux-dev docker_name=dev_membersite ver=${proj}:${version} env=${env} docker_ports=5068:80 volume=/logs/membersite:/membersite"'
                sh 'ansible-playbook -i DEV.AWS.yml deploy.docker.yml --extra-vars "host=linux-dev docker_name=dev_membersite_app ver=${proj}:${version} env=Development.APP docker_ports=5069:80 volume=/logs/membersiteApp:/membersiteApp"'
            }
        }
    }
}
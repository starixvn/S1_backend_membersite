pipeline {
    agent none
    environment {
        env = 'Development'
        registry = '13.213.82.69/membersite/membersite'
        ansible_path = '/var/jenkins_home/ansible/backend'
    }
    stages {
        stage('Build') {
            agent { node { label 'Build' } }
            steps {
                script {
                    env.version = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                }
                sh 'sudo docker build -f ./MemberSite/MemberSite/Dockerfile -t ${registry}:${version} .'
                sh 'sudo docker push ${registry}:${version}'
                sh 'sudo docker rmi ${registry}:${version}'
            }
        }
        stage('Deploy') {
            agent { node { label 'master' } }
            steps {
                sh 'ansible-playbook -i ${ansible_path}/DEV.AWS.yml ${ansible_path}/deploy.yml --extra-vars "host=linux-dev docker_name=dev_membersite image=membersite/membersite:${version} env=${env} docker_ports=5068:80 volume=/logs/membersite:/membersite"'
                sh 'ansible-playbook -i ${ansible_path}/DEV.AWS.yml ${ansible_path}/deploy.yml --extra-vars "host=linux-dev docker_name=dev_membersite_app image=membersite/membersite:${version} env=Development.APP docker_ports=5069:80 volume=/logs/membersiteApp:/membersiteApp"'
            }
        }
    }
}
{
  "Urls": "http://*:5000",
  "Environment": "LOCAL",
  "ServiceType": "API",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ExcludesMessage": [
    "/health",
    "{HostingRequestStartingLog:l}",
    "Executing endpoint '{EndpointName}'",
    "Route matched with {RouteData}.",
    "Executing ObjectResult, writing value of type '{Type}'",
    "Executed action {ActionName}",
    "Executed endpoint '{EndpointName}'",
    "{HostingRequestFinishedLog:l}",
    "Executing ContentResult with HTTP Response ContentType of {ContentType}",
    "CORS policy execution successful.",
    "CORS policy execution failed.",
    "Request origin {origin} does not have permission to access the resource.",
    "Authorization was successful.",
    "Executed ViewResult - view {ViewName} executed in {ElapsedMilliseconds}ms.",
    "Sending file. Request path: '{VirtualPath}'. Physical path: '{PhysicalPath}'",
    "Executing ViewResult, running view {ViewName}.",
    "Executing RedirectResult, redirecting to {Destination}.",
    "AuthenticationScheme: {AuthenticationScheme} signed out.",
    "AuthenticationScheme: {AuthenticationScheme} signed in.",
    "AuthenticationScheme: {AuthenticationScheme} was challenged.",
    "{AuthenticationScheme} was not authenticated. Failure message: {FailureMessage}",
    "Successfully validated the token.",
    "Executing RedirectToRouteResult, redirecting to {Destination} from route {RouteName}.",
    "<!DOCTYPE html>",
    "<html>",
    "Executing {ObjectResultType}, writing value of type '{Type}'.",
    "Executing JsonResult, writing value of type '{Type}'.",
    "Received HTTP response headers after {ElapsedMilliseconds}ms - {StatusCode}",
    "Executing action method {ActionName} - Validation state: {ValidationState}",
    "Executed action method {ActionName}, returned result {ActionResult} in {ElapsedMilliseconds}ms.",
    "Executing StatusCodeResult, setting HTTP status code {StatusCode}"
  ],
  "ExcludesApiEndpoint": [
    "/health",
    "/metrics",
    "/api/Account/onlineCheck",
    "/api/Site/CheckSignIn/"
  ],
  "Sentry": {
    "Dsn": "https://4348f76a619e6558bd1e588c36ca47e2@sentry-s1.nexentgame.com/17",
    "SendDefaultPii": true,
    "MaxRequestBodySize": "Always",
    "MinimumBreadcrumbLevel": "Debug",
    "MinimumEventLevel": "Warning",
    "AttachStackTrace": true,
    "Debug": true,
    "DiagnosticLevel": "Error",
    "TracesSampleRate": 1.0
  },
  "AllowedHosts": "*",
  "ConfigService": [ "https://s1-config-service.nexdev.net/" ]
}
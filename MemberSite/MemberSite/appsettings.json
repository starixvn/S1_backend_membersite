{
  "ServiceType": "API",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Name": "ServiceFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/membersite/membersite-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      },
      {
        "Name": "Console"
      }
    ]
  },
  "ExcludesMessage": [
    "/health",
    "{HostingRequestStartingLog:l}",
    "Executing endpoint '{EndpointName}'",
    "Route matched with {RouteData}.",
    "Executing ObjectResult, writing value of type '{Type}'",
    "Executed action {ActionName}",
    "Executed endpoint '{EndpointName}'",
    "{HostingRequestFinishedLog:l}",
    "Executing ContentResult with HTTP Response ContentType of {ContentType}",
    "CORS policy execution successful.",
    "CORS policy execution failed.",
    "Request origin {origin} does not have permission to access the resource.",
    "Authorization was successful.",
    "Executed ViewResult - view {ViewName} executed in {ElapsedMilliseconds}ms.",
    "Sending file. Request path: '{VirtualPath}'. Physical path: '{PhysicalPath}'",
    "Executing ViewResult, running view {ViewName}.",
    "Executing RedirectResult, redirecting to {Destination}.",
    "AuthenticationScheme: {AuthenticationScheme} signed out.",
    "AuthenticationScheme: {AuthenticationScheme} signed in.",
    "Successfully validated the token.",
    "Executing RedirectToRouteResult, redirecting to {Destination} from route {RouteName}.",
    "<!DOCTYPE html>",
    "<html>"
  ],
  "ExcludesApiEndpoint": [
    "/health",
    "/api/Account/onlineCheck",
    "/api/Message/GetAnnouncement"
  ],
  "AllowedHosts": "*",
  "SiteConfig": {
    "Nova88": {
      "ImageURL": "https://img.0814media.net",
      "MaintainURL": "https://error.0814media.net/tp"
    },
    "Bwing": {
      "ImageURL": "https://img.bw88.io",
      "MaintainURL": "https://error.bw88.io/tp"
    },
    "Goal123": {
      "ImageURL": "https://img.goal123.org",
      "MaintainURL": "https://error.goal123.org/tp"
    }
  },
  "LoginDeviceConfig": {
    "Desktop": "www." ,
    "H5": "m." ,
    "APP": "app."
  },
  "JwtSettings": {
    "IsJwt": false,
    "Issuer": "MobileApiServer",
    "SignKey": "Chv8yvlWpe9qAf3ooBXJL7wZA1mJjKINGo7B3ya1lQyqSsmMYzsb3aZjcXLqmjMS"
  }
}

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using MemberSite.Service.Library
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject IWebHostEnvironment environment
@inject WalletBLL walletBLL
@inject CustInfoBLL custInfoBLL
@inject Tools tools
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var SkinRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/common");
}
<!DOCTYPE html>
<html lang="@selLangBLL.GetLangId()" data-layout="@(tools.IsMobile() ? "mobile" : "desktop")">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta name="format-detection" content="telephone=no">
    <link rel="shortcut icon" href="@SkinRootPath/images/favicon.ico" type="image/x-icon">
    <title>@selLangBLL.GetResourceValue("lbl_Title")</title>

    <meta name="twitter:card" content="website" />
    <meta name="twitter:site" content="@selLangBLL.GetResourceValue("lbl_TwitterSite")" />
    <meta name="twitter:creator" content="@selLangBLL.GetResourceValue("lbl_TwitterCreator")" />

    <meta property="og:title" content="@selLangBLL.GetResourceValue("lbl_Title")" />
    <meta property="og:description" content="@selLangBLL.GetResourceValue("lbl_Description")" />
    <meta property="og:image" content="@selLangBLL.GetResourceValue("lbl_image)")" />
    <meta property="og:url" content="@selLangBLL.GetResourceValue("lbl_URL")" />
    <meta property=”og:type” content=”website” />
    <meta property="og:site_name" content="@selLangBLL.GetResourceValue("lbl_Title")" />

    <meta name="description" content="@selLangBLL.GetResourceValue("lbl_Description")" />
    <meta name="author" content="@selLangBLL.GetResourceValue("lbl_Author")" />
    <meta name="copyright" content="@string.Format(selLangBLL.GetResourceValue("lbl_Copyright"), DateTime.Now.Year)" />
    <meta name="application-name" content="@selLangBLL.GetResourceValue("lbl_Applicationname")" />
    <meta name="keywords" content="@selLangBLL.GetResourceValue("lbl_Keywords")">
    <link href="@SkinRootPath/css/main.css" rel="stylesheet" asp-append-version="true" />

    <script>
        var SiteLanguage = "@selLangBLL.GetLangId()";
        var SkinRootPath = "@Url.Content($"~/SiteSkin/{serverInfo.SiteName}")";
    </script>
    @RenderSection("Style", required: false)
</head>
<body>
    <div class="app">
        <partial name="~/Views/Shared/_Header.cshtml" />
        @*Url.RouteUrl(new { action = "Index", controller = "Home", area = "Mobile", LangId = selLangBLL.GetLangId() });*@
        @RenderBody()
        @if (!string.Equals(ViewContext.RouteData.Values["controller"] as string, "sports", StringComparison.OrdinalIgnoreCase))
        {
            <partial name="~/Views/Shared/_Footer.cshtml" />
            <partial name="~/Views/Shared/_LeftMenu.cshtml" />
        }

    </div>
    <script src="~/lib/moment.min.js"></script>
    <script src="~/lib/axios.min.js"></script>
    @if (environment.EnvironmentName == "Development")
    {
        if (!tools.IsMobile())
        {
            <script src="~/lib/es6-promise.min.js"></script>
            <script src="~/lib/es6-promise.auto.min.js"></script>
        }

        <script src="~/lib/jquery-3.4.1.slim.min.js"></script>
        <script src="~/lib/react.development.js"></script>
        <script src="~/lib/react-dom.development.js"></script>
        <script src="~/lib/babel.min.js"></script>
        @*<script src="https://cdnjs.cloudflare.com/ajax/libs/require.js/2.3.6/require.min.js" integrity="sha256-1fEPhSsRKlFKGfK3eO710tEweHh1fwokU5wFGDHO+vg=" crossorigin="anonymous"></script>*@
    }
    else
    {
        <script src="~/lib/jquery-3.4.1.slim.min.js"></script>
        <script src="~/lib/react.production.min.js"></script>
        <script src="~/lib/react-dom.production.min.js"></script>
        if (!tools.IsMobile())
        {
            <script src="~/lib/es6-promise.min.js"></script>
            <script src="~/lib/es6-promise.auto.min.js"></script>
        }
    }

<script>
        @if (User.Identity.IsAuthenticated)
        {
            var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
            var CurrencyId = custInfoBLL.GetCustInfoWithCache(custId).CurrencyId;
            Dictionary<string, string> i18n = new Dictionary<string, string>();
            i18n.Add("lbl_LastTransaction", selLangBLL.GetResourceValue("lbl_LastTransaction"));
            i18n.Add("lbl_LastLogin", selLangBLL.GetResourceValue("lbl_LastLogin"));
            i18n.Add("lbl_ShowBalance", selLangBLL.GetResourceValue("lbl_ShowBalance"));
            i18n.Add("lbl_Currency", selLangBLL.GetResourceValue($"Currency_{CurrencyId}"));

            string[] lbl_Txts = new string[] { "lbl_Deposit", "lbl_TransferFunds" };
            foreach (var lbl_Txt in lbl_Txts)
            {
                if (!i18n.ContainsKey(lbl_Txt))
                    i18n.Add(lbl_Txt, selLangBLL.GetResourceValue(lbl_Txt));
            }
            @:var i18n = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n));
            @:var IsConvertRequired = @Newtonsoft.Json.JsonConvert.SerializeObject(custInfoBLL.IsConvertRequired(CurrencyId));
        }
        else
        {
            Dictionary<string, string> i18n = new Dictionary<string, string>();
            i18n.Add("lbl_JoinNow", selLangBLL.GetResourceValue("lbl_JoinNow"));
            i18n.Add("lbl_DontHaveAccount", selLangBLL.GetResourceValue("lbl_DontHaveAccount"));
            i18n.Add("lbl_ForgetPassword", selLangBLL.GetResourceValue("lbl_ForgetPassword"));
            i18n.Add("lbl_Login", selLangBLL.GetResourceValue("lbl_Login"));
            i18n.Add("lbl_Username", selLangBLL.GetResourceValue("lbl_Username"));
            i18n.Add("lbl_UsernameTooltip", selLangBLL.GetResourceValue("lbl_UsernameTooltip"));
            i18n.Add("lbl_Password", selLangBLL.GetResourceValue("lbl_Password"));
            i18n.Add("lbl_PasswordTooltip", selLangBLL.GetResourceValue("lbl_PasswordTooltip"));
            i18n.Add("msg_PasswordVaildate", selLangBLL.GetMsg("msg_PasswordVaildate"));
            i18n.Add("msg_PasswordLength", selLangBLL.GetMsg("msg_PasswordLength"));
            i18n.Add("msg_PasswordReq", selLangBLL.GetMsg("msg_PasswordReq"));
            i18n.Add("msg_UsernameVaildate", selLangBLL.GetMsg("msg_UsernameVaildate"));
            i18n.Add("msg_UsernameLength", selLangBLL.GetMsg("msg_UsernameLength"));
            i18n.Add("msg_UsernameReq", selLangBLL.GetMsg("msg_UsernameReq"));
            @:var i18n = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n));
            @:var joinNowUrl = '@Url.RouteUrl("desktop", new { action = "Register", controller = "Home", LangId = selLangBLL.GetLangId() })';
            @:var forgetPassowrdUrl = '@Url.RouteUrl("desktop", new { action = "ForgetPassowrd", controller = "Home", LangId = selLangBLL.GetLangId() })';
            var CurrencyId = selLangBLL.GetPreferCurrencyId();
            @:var IsConvertRequired = @Newtonsoft.Json.JsonConvert.SerializeObject(custInfoBLL.IsConvertRequired(CurrencyId));
        }

        $(function () {
                var breakpoint;
                var getBreakpoint = function () {
                    return window.getComputedStyle(document.body, '::before').content.replace(/\"/g, '');
                };

            var displayBreakpoint = function () {
                document.querySelector('html').dataset.layout = breakpoint;
            };

            breakpoint = getBreakpoint();

            displayBreakpoint();

            window.addEventListener('resize', function () {

                breakpoint = getBreakpoint();

                displayBreakpoint();

            }, false);

            $(".btn-toggle-nav").on("touchstart, click", function () {
                $(".side-bar").attr("data-open", "true");
            });

            $(".side-bar .overlay").on("touchstart, click", function () {
                $(".side-bar").removeAttr("data-open");
            });

            //$(".side-nav__item > .dropdown > .btn").on("touchstart, click", function () {
            //    var $dropdown = $(this).parent();
            //    $dropdown.attr("data-open") == "true" ? $dropdown.removeAttr("data-open") : $dropdown.attr("data-open", "true");
            //});

            $(document.body).on("touchstart, mousedown", function (e) {
                var container = $(".dropdown");
                if (!container.is(e.target) && container.has(e.target).length === 0) {
                   container.removeAttr("data-open");
                }
            });

            $(".dropdown > .btn").on("touchstart, click", function (e) {
                var $target = $(this).parent();

                var container = $(".dropdown");
                if (!container.is($target) && container.has($target).length === 0) {
                    container.removeAttr("data-open");
                }

                $target.attr("data-open", $target.attr("data-open") === "true" ? "false" : "true");
            });
        });
</script>

    @if (User.Identity.IsAuthenticated)
    {
        <script src="~/js/commJS/common.js"></script>
        <script src="~/js/commJS/Account.js" asp-append-version="true"></script>
        <script src="~/js/component/app/BalancePanel.min.js" asp-append-version="true"></script>
        <script src="~/js/component/app/WalletInfo.min.js" asp-append-version="true"></script>
    }
    else
    {
        <script src="~/lib/runtime.min.js"></script>
        <script src="~/js/component/app/loginForm.min.js" asp-append-version="true"></script>
    }
    @* Start of LiveChat (www.livechatinc.com) code *@
    <script type="text/javascript">
        !function (t, c) { t.__lc = t.__lc || {}, t.__lc.license = 11638088; var e = c.createElement("script"); e.type = "text/javascript", e.async = !0, e.src = ("https:" == c.location.protocol ? "https://" : "http://") + "cdn.livechatinc.com/tracking.js"; var n = c.getElementsByTagName("script")[0]; n.parentNode.insertBefore(e, n) }(window, document);
    </script>
    <noscript>
        <a href="https://www.livechatinc.com/chat-with/11638088/" rel="nofollow">Chat with us</a>,
        powered by <a href="https://www.livechatinc.com/?welcome" rel="noopener nofollow" target="_blank">LiveChat</a>
    </noscript>
    @*  End of LiveChat code*@
    @RenderSection("Scripts", required: false)
    @RenderSection("PromptMsg", required: false)
</body>
</html>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@inject SelLangBLL selLangBLL
@inject IWebHostEnvironment environment
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@selLangBLL.GetResourceValue("lbl_Title")|@selLangBLL.GetResourceValue("lbl_TitleDesc")|@selLangBLL.GetResourceValue("lbl_TitleKeywords")</title>
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@selLangBLL.GetResourceValue("lbl_TwitterSite")" />
    <meta name="twitter:creator" content="@selLangBLL.GetResourceValue("lbl_TwitterCreator")" />
    <meta property="og:url" content="@selLangBLL.GetResourceValue("lbl_URL")" />
    <meta property="og:title" content="@selLangBLL.GetResourceValue("lbl_Title")" />
    <meta property="og:description" content="@selLangBLL.GetResourceValue("lbl_Description")" />
    <meta property="og:image" content="" />

    @*<meta property="fb:admins" content="100002847892748" />
        <meta property="fb:app_id" content="350231215126101" />
        <meta property="fb:pages" content="241284961029,219315794887869,163253543730991,362512194085320,413437005485686,578214755657993" />
        <meta property="article:author" content="https://www.facebook.com/myudn/" />
        <meta property="article:publisher" content="https://www.facebook.com/myudn/" />*@

    <meta name="description" content="@selLangBLL.GetResourceValue("lbl_Description")" />
    <meta name="author" content="@selLangBLL.GetResourceValue("lbl_Author")" />
    <meta name="copyright" content="@string.Format(selLangBLL.GetResourceValue("lbl_Copyright"),DateTime.Now.Year)" />
    <meta name="application-name" content="@selLangBLL.GetResourceValue("lbl_Applicationname")" />
    <meta name="keywords" content="@selLangBLL.GetResourceValue("lbl_Keywords")">
    <script>
        var SiteLanguage = "@selLangBLL.GetLangId()";
    </script>
    @RenderSection("Style", required: false)
</head>
<body>
    <div>
        @foreach (var siteLanguage in selLangBLL.GetLangIdList())
        {
            <div>@siteLanguage.LangId</div>
            <div>@siteLanguage.Language</div>
        }
        @if (User.Identity.IsAuthenticated)
        {
            <div>@User.Identity.Name</div>
            <input id="logoutBtn" type="button" value="Logout" />
        }
        else
        {
            <form id="loginForm">
                <input id="UserName" type="text" />
                <input id="Userpwd" type="text" />
                <input id="Submit1" type="submit" value="submit" />
            </form>
        }
        @RenderBody()
    </div>
    <script src="~/lib/moment.min.js"></script>
    <script src="~/lib/axios.min.js" asp-append-version="true"></script>
    @if (environment.EnvironmentName == "Development")
    {
        <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha256-pasqAKBDmFT4eHoN2ndd6lN370kFiGUFyTiUHWhU7k8=" crossorigin="anonymous"></script>
        <script crossorigin src="https://unpkg.com/react@16/umd/react.development.js"></script>
        <script crossorigin src="https://unpkg.com/react-dom@16/umd/react-dom.development.js"></script>
        <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/6.26.0/babel.js"></script>
        @if (User.Identity.IsAuthenticated)
        {
            <script type="text/javascript">
                $("#logoutBtn").click(function () {
                    axios.post('/api/Account/Logout')
                        .then(function (response) {
                            let result = response.data;
                            if (result.errorCode == 0) {
                                alert(result.message);
                                location.reload();
                            } else {
                                alert(result.message);
                            }
                        }).catch(function (error) {
                            alert(error);
                        });
                });
            </script>
        }
        else
        {
            <script type="text/javascript">
                const form = document.getElementById('loginForm');
                form.onsubmit = (e) => {
                    let data = { "UserName": $("#UserName").val(), "Userpwd": $("#Userpwd").val() };
                    axios.post('/api/Site/Validation', data)
                        .then(function (response) {
                            let result = response.data;
                            if (result.errorCode == 0) {
                                alert(result.message);
                                location.reload();
                            } else {
                                alert(result.message);
                            }
                        }).catch(function (error) {
                            alert(error);
                            console.log(error);
                        });
                    e.preventDefault();
                };
            </script>
        }
    }
    else
    {

    }
    @RenderSection("Scripts", required: false)
</body>
</html>

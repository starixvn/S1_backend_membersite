@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@inject SelLangBLL selLangBLL
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@selLangBLL.GetResourceValue("lbl_Title")|@selLangBLL.GetResourceValue("lbl_TitleDesc")|@selLangBLL.GetResourceValue("lbl_TitleKeywords")</title>
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@selLangBLL.GetResourceValue("lbl_TwitterSite")" />
    <meta name="twitter:creator" content="@selLangBLL.GetResourceValue("lbl_TwitterCreator")" />
    <meta property="og:url" content="@selLangBLL.GetResourceValue("lbl_URL")" />
    <meta property="og:title" content="@selLangBLL.GetResourceValue("lbl_Title")" />
    <meta property="og:description" content="@selLangBLL.GetResourceValue("lbl_Description")" />
    <meta property="og:image" content="" />

    @*<meta property="fb:admins" content="100002847892748" />
        <meta property="fb:app_id" content="350231215126101" />
        <meta property="fb:pages" content="241284961029,219315794887869,163253543730991,362512194085320,413437005485686,578214755657993" />
        <meta property="article:author" content="https://www.facebook.com/myudn/" />
        <meta property="article:publisher" content="https://www.facebook.com/myudn/" />*@

    <meta name="description" content="@selLangBLL.GetResourceValue("lbl_Description")" />
    <meta name="author" content="@selLangBLL.GetResourceValue("lbl_Author")" />
    <meta name="copyright" content="@selLangBLL.GetResourceValue("lbl_Copyright")" />
    <meta name="application-name" content="@selLangBLL.GetResourceValue("lbl_Applicationname")" />
    <meta name="keywords" content="@selLangBLL.GetResourceValue("lbl_Keywords")">
    <script>
        var SiteLanguage = "@selLangBLL.GetLangId()";
    </script>

    @RenderSection("Style", required: false)
</head>
<body>
    <div>
        @RenderBody()
    </div>
    <script src="~/lib/moment.min.js"></script>
    <script src="~/lib/axios.min.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

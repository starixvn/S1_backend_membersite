@using MemberSite.Service.BLL
@using MemberSite.Service.Library
@using System.Security.Claims
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject PromotionBLL promotionBLL
@inject CustInfoBLL custInfoBLL
@inject Tools tools
@functions{
    string GetEntPageUrl(int tpId, string gameId)
    {
        var entPageUrl = "";
        if (tpId == 1)
        {
            if (!User.Identity.IsAuthenticated && (gameId == "202" || gameId == "208" || gameId == "211"))
            {
                var message = selLangBLL.GetMsg("msg_LoginToAccess");
                entPageUrl = "javascript:alert('" + message + "');";
            }
            else
            {
                var homeUrl = Url.RouteUrl("desktop", new { action = ViewContext.RouteData.Values["action"], controller = ViewContext.RouteData.Values["controller"], LangId = selLangBLL.GetLangId() }, protocol: Context.Request.Scheme, host: Context.Request.Host.Host);
                var signupUrl = Url.RouteUrl("desktop", new { action = "Register", controller = "Home", LangId = selLangBLL.GetLangId() }, protocol: Context.Request.Scheme, host: Context.Request.Host.Host);
                var LoginUrl = Url.RouteUrl("desktop", new { action = ViewContext.RouteData.Values["action"], controller = ViewContext.RouteData.Values["controller"], LangId = selLangBLL.GetLangId(), loginCont = 1 }, protocol: Context.Request.Scheme, host: Context.Request.Host.Host);

                if (gameId == "202" || gameId == "208" || gameId == "211")
                {
                    entPageUrl = Url.RouteUrl("desktop", new { action = "Index", controller = "entPage", LangId = selLangBLL.GetLangId(), homeUrl = homeUrl, signupUrl = signupUrl, LoginUrl = LoginUrl, tpId = tpId, gameId = gameId });
                    entPageUrl = $"javascript:window.open('{entPageUrl}', 'Tp_{tpId}_{gameId}', 'toolbar=no, menubar=no,scrollbars=no,resizable=no,location=no,directories=no,status=no').focus();";
                }
                else if (tools.IsMobile())
                {
                    entPageUrl = Url.RouteUrl("desktop", new { action = "Index", controller = "entPage", LangId = selLangBLL.GetLangId(), homeUrl = homeUrl, signupUrl = signupUrl, LoginUrl = LoginUrl, tpId = tpId, gameId = gameId });
                }
                else
                {
                    @*IFrame*@
                    entPageUrl = Url.RouteUrl("desktop", new { action = "Index", controller = "sports", LangId = selLangBLL.GetLangId(), tpId = tpId, gameId = gameId });
                }
            }
        }
        else if (gameId == "livecasino")
        {
            entPageUrl = Url.RouteUrl("desktop", new { action = "Index", controller = "LiveCasino", LangId = selLangBLL.GetLangId() });
        }
        return entPageUrl;
    }
}
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    int CurrencyId = 0;

    int promotionCnt = 0;

    if (User.Identity.IsAuthenticated)
    {
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(custId).CurrencyId;
        promotionCnt = promotionBLL.GetPromotionListByCustId(custId).Count();
    }
    else
    {
        CurrencyId = selLangBLL.GetPreferCurrencyId();
        promotionCnt = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).Count();
    }
}
<div class="side-bar" role="mobile-only">
    <div class="overlay"></div>
    <div class="side-nav">
        <div class="side-nav__header">
            <div class="side-nav__account">
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="account-info">
                        <div class="account-info__row" role="mobile-only">
                            <span class="account-info__name">@selLangBLL.GetResourceValue("lbl_Welcome") @User.Identity.Name</span>
                        </div>
                        <div id="BalancePanel1"></div>
                    </div>
                }
                else
                {
                    <a class="btn btn-secondary" href="@Url.RouteUrl("desktop", new { action = "Register", controller = "Home", LangId = selLangBLL.GetLangId() })">
                        <span class="text">@selLangBLL.GetResourceValue("lbl_JoinNow")</span>
                    </a>
                    <button class="btn btn-highlight loginBtn">
                        <div class="btn__inner">
                            <span class="text">@selLangBLL.GetResourceValue("lbl_Login")</span>
                        </div>
                    </button>
                }
                <div class="dropdown dropdown--right">
                    <a class="btn">
                        <i class="flag-square-@selLangBLL.GetLangId()"></i>
                    </a>
                    <div class="dropdown__container">
                        <div class="dropdown__list">
                            @foreach (var siteLanguage in selLangBLL.GetLangIdList())
                            {
                                if (siteLanguage.LangId != selLangBLL.GetLangId())
                                {
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <div class="dropdown__item" data-lang-id="@siteLanguage.LangId">
                                            <i class="flag-square-@(siteLanguage.LangId)"></i>
                                            <span class="text">@siteLanguage.Language</span>
                                        </div>
                                    }
                                    else
                                    {
                                        var LangUrl = $"{Url.RouteUrl("desktop", new { action = ViewContext.RouteData.Values["action"], controller = ViewContext.RouteData.Values["controller"], LangId = siteLanguage.LangId })}{Context.Request.QueryString}";
                                        <a href="@LangUrl">
                                            <div class="dropdown__item">
                                                <i class="flag-square-@(siteLanguage.LangId)"></i>
                                                <span class="text">@siteLanguage.Language</span>
                                            </div>
                                        </a>
                                    }
                                }
                            }
                        </div>
                    </div>
                </div>
                @if (User.Identity.IsAuthenticated)
                {
                    <button class="side-nav__btn logoutBtn">
                        <i class="icon icon-logout"></i>
                        <span class="text">@selLangBLL.GetResourceValue("lbl_Logout")</span>
                    </button>
                }
            </div>
        </div>
        @if (User.Identity.IsAuthenticated)
        {
            var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
            var promotions = promotionBLL.GetPromotionListByCustIdWithCache(custId).Where(x => x.BonusInfoStatus == 1);
            var rolloverPanelDisplay = "none";
            decimal totalRollover = 1m;
            decimal totalturnover = 0m;

            if (promotions != null && promotions.Count() > 0)
            {

                rolloverPanelDisplay = "block";
                totalRollover = 0m;
                foreach (var promotion in promotions)
                {
                    promotion.Title = selLangBLL.GetResourceValue($"{promotion.BonusCode}Title");
                    promotion.custRollOver = custInfoBLL.GetCustRollOver(custId, promotion.BonusCode);
                    totalRollover += promotion.custRollOver.RollOver;
                    totalturnover += promotion.custRollOver.TurnOver;
                }
            }
            <div class="dropdown dropdown-secondary dropdown--right dropdown--balance dropdown-rollover" data-open="true" style="display:@rolloverPanelDisplay">
                <a class="btn">
                    <i class="icon icon-schedule"></i>
                    <span class="text">
                        @selLangBLL.GetResourceValue("lbl_RolloverProgress")
                    </span>
                    <span class="text">@((Math.Floor(totalturnover / totalRollover * 10000) / 100).ToString("0.##")) %</span>
                    <i class="icon icon-caret"></i>
                </a>
                <div class="dropdown__container">
                    <div class="balance-info">
                        <div class="rollover-info">
                            @if (promotions != null && promotions.Count() > 0)
                            {
                                foreach (var promotion in promotions)
                                {
                                    <div class="rollover-info__item">
                                        <span class="text">@promotion.Title</span>
                                        <div class="schedule">
                                            <div class="schedule-bg" style="width: @(tools.Floor((promotion.custRollOver.TurnOver / promotion.custRollOver.RollOver*100),2).ToString("0.##"))%"></div>
                                        </div>
                                        <div class="schedule-info">
                                            <span class="text">@selLangBLL.GetResourceValue($"Currency_{CurrencyId}") $@promotion.custRollOver.TurnOver.ToString("#,#0.##")</span>
                                            <span class="text">(@selLangBLL.GetResourceValue("lbl_Req") @selLangBLL.GetResourceValue($"Currency_{CurrencyId}")) $@promotion.custRollOver.RollOver.ToString("#,#0.##")) @((Math.Floor(totalturnover / totalRollover * 10000) / 100).ToString("0.##")) %</span>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        <div class="side-nav__main">
            @if (User.Identity.IsAuthenticated)
            {
                <div class="side-nav__hot">
                    <a class="side-nav__btn" href="@Url.RouteUrl("desktop", new { action = "Deposit", controller = "Cashier", LangId = selLangBLL.GetLangId() })">
                        <i class="icon icon-deposit-bank"></i>
                        <span class="text">@selLangBLL.GetResourceValue("lbl_Deposit")</span>
                    </a>
                    <a class="side-nav__btn" href="@Url.RouteUrl("desktop", new { action = "Withdrawal", controller = "Cashier", LangId = selLangBLL.GetLangId() })">
                        <i class="icon icon-withdrawal"></i>
                        <span class="text">@selLangBLL.GetResourceValue("lbl_Withdrawal")</span>
                    </a>
                    @*<a class="side-nav__btn">
                            <i class="icon icon-statement"></i>
                            <span class="text">Statement</span>
                        </a>*@
                    <a class="side-nav__btn" href="@Url.RouteUrl("desktop", new { action = "Profile", controller = "Account", LangId = selLangBLL.GetLangId() })">
                        <i class="icon icon-account"></i>
                        <span class="text">@selLangBLL.GetResourceValue("lbl_Profile")</span>
                    </a>
                </div>
            }
            <div class="side-nav__list-sports">
                <a class="side-nav__btn" href="@Url.RouteUrl("desktop", new { action = "Index", controller = "Home", LangId = selLangBLL.GetLangId() })">
                    <i class="icon icon-home"></i>
                    <span class="text">@selLangBLL.GetResourceValue("lbl_Home")</span>
                </a>
                <a class="side-nav__btn" href="@GetEntPageUrl(1,"1")">
                    <i class="icon icon-all-sports"></i>
                    <span class="text">@selLangBLL.GetResourceValue("lbl_Sports")</span>
                </a>
                <a class="side-nav__btn" href="@GetEntPageUrl(1,"43")">
                    <i class="icon icon-sport43"></i>
                    <span class="text">@selLangBLL.GetResourceValue("lbl_eSports")</span>
                </a>
                <a class="side-nav__btn" href="@GetEntPageUrl(1,"161")">
                    <i class="icon icon-sport161"></i>
                    <span class="text">@selLangBLL.GetResourceValue("lbl_NumberGame")</span>
                </a>
                <a class="side-nav__btn" href="@GetEntPageUrl(1,"180")">
                    <i class="icon icon-sport18x"></i>
                    <span class="text">@selLangBLL.GetResourceValue("lbl_VirtualSports")</span>
                </a>
                <a class="side-nav__btn" href="@GetEntPageUrl(1,"208")">
                    <i class="icon icon-sport251"></i>
                    <span class="text">@selLangBLL.GetResourceValue("lbl_Casino")</span>
                </a>
                <a class="side-nav__btn" href="@GetEntPageUrl(0,"livecasino")">
                    <i class="icon icon-sport162"></i>
                    <span class="text">@selLangBLL.GetResourceValue("lbl_LiveCasino")</span>
                </a>
                <a class="side-nav__btn" href="@GetEntPageUrl(1,"202")">
                    <i class="icon icon-sport202"></i>
                    <span class="text">@selLangBLL.GetResourceValue("lbl_Keno")</span>
                </a>
            </div>
            <div class="side-nav__list-member">
                @if (User.Identity.IsAuthenticated)
                {
                    <a class="side-nav__btn" href="@Url.RouteUrl("desktop", new { action = "Messages", controller = "Account", LangId = selLangBLL.GetLangId() })">
                        <span class="side-nav__icon">
                            <i class="icon icon-email"></i>
                            <span class="new-dot MsgCount"></span>
                        </span>
                        <span class="text">@selLangBLL.GetResourceValue("lbl_Message")</span>
                    </a>

                    <a class="side-nav__btn" href="@Url.RouteUrl("desktop", new { action = "Profile", controller = "Account", LangId = selLangBLL.GetLangId() })">
                        <span class="side-nav__icon">
                            <i class="icon icon-account"></i>
                        </span>
                        <span class="text">@selLangBLL.GetResourceValue("lbl_Profile")</span>
                    </a>
                }
                @if (promotionCnt > 0)
                {
                    <a class="side-nav__btn" href="@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })">
                        <span class="side-nav__icon">
                            <i class="icon icon-promotion"></i>
                            <span class="new-dot">@promotionCnt</span>
                        </span>
                        <span class="text">@selLangBLL.GetResourceValue("lbl_Promotion")</span>
                    </a>
                }
                @if (User.Identity.IsAuthenticated)
                {
                    <a class="side-nav__btn" href="@Url.RouteUrl("desktop", new { action = "ChangePwd", controller = "Account", LangId = selLangBLL.GetLangId() })">
                        <span class="side-nav__icon">
                            <i class="icon icon-key"></i>
                        </span>
                        <span class="text">@selLangBLL.GetResourceValue("lbl_ChangePassword")</span>
                    </a>
                    @*<a class="side-nav__btn">
                            <span class="side-nav__icon">
                                <i class="icon icon-transaction"></i>
                            </span>
                            <span class="text">@selLangBLL.GetResourceValue("lbl_Cashier")</span>
                        </a>*@
                    <a class="side-nav__btn" href="@Url.RouteUrl("desktop", new { action = "Transfer", controller = "Cashier", LangId = selLangBLL.GetLangId() })">
                        <span class="side-nav__icon">
                            <i class="icon icon-transfer"></i>
                        </span>
                        <span class="text">@selLangBLL.GetResourceValue("lbl_TransferFunds")</span>
                    </a>
                    <a class="side-nav__btn" href="@Url.RouteUrl("desktop", new { action="Deposit" , controller="History" , LangId=selLangBLL.GetLangId() })">
                        <span class="side-nav__icon">
                            <i class="icon icon-statement"></i>
                        </span>
                        <span class="text">@selLangBLL.GetResourceValue("lbl_TransactionHistory")</span>
                    </a>
                }
                @*<a class="side-nav__btn">
                        <span class="side-nav__icon">
                            <i class="icon icon-info-outline"></i>
                        </span>
                        <span class="text">@selLangBLL.GetResourceValue("lbl_Help")</span>
                    </a>*@
            </div>
        </div>
    </div>
</div>
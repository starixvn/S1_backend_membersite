@using MemberSite.Service.BLL
@using MemberSite.Service.Library
@using MemberSite.Service.Model.enums
@using System.Security.Claims
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject CustInfoBll custInfoBLL
@inject PromotionBLL promotionBLL
@inject Tools tools
@inject GamingBLL gamingBLL
@inject AuthorizeBLL authorizeBLL
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var SkinRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/common");

    var entFishingPageUrl = "";
    var CurrencyId = 0;
    if (User.Identity.IsAuthenticated)
    {
        entFishingPageUrl = gamingBLL.GetEntPageUrl(7, "10", Url, GameType.Fishing);
        entFishingPageUrl = $"javascript:window.open('{entFishingPageUrl}', 'Tp_7_10', 'toolbar=no, menubar=no,scrollbars=no,resizable=no,location=no,directories=no,status=no, top=0, left=0').focus()";
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;
    }
    else
    {
        entFishingPageUrl = "javascript:void(0);";
        CurrencyId = selLangBLL.GetPreferCurrencyId();
    }
}
<div class="header">
    <div class="header__main">
        <a class="btn btn-icon btn-toggle-nav" role="mobile-only">
            <i class="icon icon-menu"></i>
        </a>
        <div class="header__logo">
            <a class="logo" href="@Url.RouteUrl("desktop", new { action = "Index", controller = "Home", LangId = selLangBLL.GetLangId() })"></a>
        </div>
        <div class="header__option" role="mobile-only">
            @if (User.Identity.IsAuthenticated)
            {
            <div class="account-info" role="mobile-only">
                <div class="account-info__row">
                    <span class="account-info__name">@selLangBLL.GetResourceValue("lbl_Welcome") @User.Identity.Name</span>
                </div>
                <div id="BalancePanel"></div>
            </div>
            }
            else
            {
            <a class="btn btn-secondary" href="@Url.RouteUrl("desktop", new { action = "Register", controller = "Home", LangId = selLangBLL.GetLangId() })">
                <span class="text">@selLangBLL.GetResourceValue("lbl_JoinNow")</span>
            </a>
            <button class="btn btn-highlight loginBtn">
                <div class="btn__inner">
                    <span class="text">@selLangBLL.GetResourceValue("lbl_Login")</span>
                </div>
            </button>
            }
        </div>
        <div class="header__option" role="desktop-only">
            @*<a class="btn btn-base btn-icon shape-circle">
                    <i class="icon icon-device-mobile"></i>
                </a>*@
            @*<a class="btn btn-base btn-icon shape-circle">
                    <i class="icon icon-headphone"></i>
                </a>*@
            <div class="dropdown dropdown--right">
                <a class="btn btn-icon btn-base shape-circle">
                    <i class="flag-square-@selLangBLL.GetLangId()"></i>
                </a>
                <div class="dropdown__container">
                    <div class="dropdown__list">
                        @foreach (var siteLanguage in selLangBLL.GetLangIdList())
                        {
                            if (siteLanguage.LangId != selLangBLL.GetLangId())
                            {
                        @if (User.Identity.IsAuthenticated)
                                {
                        <div class="dropdown__item" data-lang-id="@siteLanguage.LangId">
                            <i class="flag-square-@(siteLanguage.LangId)"></i>
                            <span class="text">@siteLanguage.Language</span>
                        </div>
                                }
                                else
                                {
                                    var LangUrl = $"{Url.RouteUrl("desktop", new { action = ViewContext.RouteData.Values["action"], controller = ViewContext.RouteData.Values["controller"], siteLanguage.LangId })}{Context.Request.QueryString}";

                        <a href="@LangUrl">
                            <div class="dropdown__item">
                                <i class="flag-square-@(siteLanguage.LangId)"></i>
                                <span class="text">@siteLanguage.Language</span>
                            </div>
                        </a>
                                }
                            }
                        }
                    </div>
                </div>
            </div>
            @if (User.Identity.IsAuthenticated)
            {
            <div class="dropdown dropdown-highlight dropdown--right">
                <a class="btn">
                    <i class="icon icon-transaction"></i>
                    <span class="text">@selLangBLL.GetResourceValue("lbl_Cashier")</span>
                    <i class="icon icon-caret"></i>
                </a>
                <div class="dropdown__container">
                    <div class="dropdown__list">
                        <div class="dropdown__group">
                            <a class="dropdown__item" href="@Url.RouteUrl("desktop", new { action = "Deposit", controller = "Cashier", LangId = selLangBLL.GetLangId() })">
                                <i class="icon icon-deposit-bank"></i>
                                <span class="text">@selLangBLL.GetResourceValue("lbl_Deposit")</span>
                            </a>
                            <a class="dropdown__item" href="@Url.RouteUrl("desktop", new { action = "Transfer", controller = "Cashier", LangId = selLangBLL.GetLangId() })">
                                <i class="icon icon-transfer"></i>
                                <span class="text">@selLangBLL.GetResourceValue("lbl_TransferFunds")</span>
                            </a>
                            <a class="dropdown__item" href="@Url.RouteUrl("desktop", new { action = "Withdrawal", controller = "Cashier", LangId = selLangBLL.GetLangId() })">
                                <i class="icon icon-withdrawal"></i>
                                <span class="text">@selLangBLL.GetResourceValue("lbl_Withdrawal")</span>
                            </a>
                            <a class="dropdown__item" href="@Url.RouteUrl("desktop", new { action = "Deposit", controller = "History", LangId = selLangBLL.GetLangId() })">
                                <i class="icon icon-statement"></i>
                                <span class="text">@selLangBLL.GetResourceValue("lbl_TransactionHistory")</span>
                            </a>
                            <a class="dropdown__item" href="@Url.RouteUrl("desktop", new { action = "Statement", controller = "History", LangId = selLangBLL.GetLangId() })">
                                <i class="icon icon-statement_history"></i>
                                <span class="text">@selLangBLL.GetResourceValue("lbl_Statement")</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="dropdown dropdown-secondary dropdown--right dropdown--balance">
                <a class="btn">
                    <i class="icon icon-balance"></i>
                    <span class="text WalletInfo"></span>
                    <i class="icon icon-caret"></i>
                </a>
                <div class="dropdown__container" id="Top_WalletInfo"></div>
            </div>
            <div class="dropdown dropdown-secondary dropdown--right">
                <a class="btn">
                    <i class="icon icon-account"></i>
                    <span class="text">@User.Identity.Name</span>
                    <i class="icon icon-caret"></i>
                </a>
                <div class="dropdown__container">
                    <div class="dropdown__list">
                        <div class="dropdown__group">
                            <a class="dropdown__item" href="@Url.RouteUrl("desktop", new { action = "ChangePwd", controller = "Account", LangId = selLangBLL.GetLangId() })">
                                <i class="icon icon-key"></i>
                                <span class="text">@selLangBLL.GetResourceValue("lbl_ChangePassword")</span>
                            </a>
                            <a class="dropdown__item" href="@Url.RouteUrl("desktop", new { action = "Profile", controller = "Account", LangId = selLangBLL.GetLangId() })">
                                <i class="icon icon-account"></i>
                                <span class="text">@selLangBLL.GetResourceValue("lbl_Profile")</span>
                            </a>
                            <a class="dropdown__item" href="@Url.RouteUrl("desktop", new { action = "CustBankInfo", controller = "Account", LangId = selLangBLL.GetLangId() })">
                                <i class="icon icon-deposit-bank"></i>
                                <span class="text">@selLangBLL.GetResourceValue("lbl_CustBank")</span>
                            </a>
                            <a class="dropdown__item" href="@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })">
                                <i class="icon icon-promotion"></i>
                                <span class="text">@selLangBLL.GetResourceValue("lbl_Promotion")</span>
                            </a>
                        </div>
                        <div class="dropdown__group">
                            <a class="dropdown__item logoutBtn">
                                <i class="icon icon-logout"></i>
                                <span class="text">@selLangBLL.GetResourceValue("lbl_Logout")</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <a class="btn btn-icon btn-secondary" href="@Url.RouteUrl("desktop", new { action = "PersonalMsg", controller = "Message", LangId = selLangBLL.GetLangId() })">
                <i class="icon icon-email"></i>
                <span class="new-dot MsgCount"></span>
            </a>
                var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
                var promotions = promotionBLL.GetPromotionListByCustIdWithCache(custId).Where(x => x.BonusInfoStatus == 1);
                var rolloverPanelDisplay = "none";
                var totalRollover = 1m;
                var totalturnover = 0m;

                if (promotions != null && promotions.Any())
                {
                    totalRollover = 0m;
                    rolloverPanelDisplay = "block";
                    foreach (var promotion in promotions)
                    {
                        promotion.Title = selLangBLL.GetResourceValue($"{promotion.BonusCode}Title");
                        promotion.custRollOver = custInfoBLL.GetCustRollOver(custId, promotion.BonusCode);
                        totalRollover += promotion.custRollOver.RollOver;
                        totalturnover += promotion.custRollOver.TurnOver;
                    }
                }
            <div class="dropdown dropdown-secondary dropdown--right dropdown--balance dropdown-rollover" style="display:@rolloverPanelDisplay">
                <a class="btn">
                    <i class="icon icon-schedule"></i>
                    <span class="text">
                        @selLangBLL.GetResourceValue("lbl_RolloverProgress")
                    </span>
                    <span class="text">@((Math.Floor(totalturnover / totalRollover * 10000) / 100).ToString("0.##")) %</span>
                    <i class="icon icon-caret"></i>
                </a>
                <div class="dropdown__container">
                    <div class="balance-info">
                        <div class="rollover-info">
                            @if (promotions != null && promotions.Any())
                                {
                                    foreach (var promotion in promotions)
                                    {
                            <div class="rollover-info__item">
                                <span class="text">@promotion.Title</span>
                                <div class="schedule">
                                    <div class="schedule-bg" style="width: @(tools.Floor((promotion.custRollOver.TurnOver / promotion.custRollOver.RollOver*100),2).ToString("0.##"))%"></div>
                                </div>
                                <div class="schedule-info">
                                    <span class="text">@selLangBLL.GetResourceValue($"Currency_{CurrencyId}") $@promotion.custRollOver.TurnOver.ToString("#,#0.##")</span>
                                    <span class="text">(@selLangBLL.GetResourceValue("lbl_Req") @selLangBLL.GetResourceValue($"Currency_{CurrencyId}")) $@promotion.custRollOver.RollOver.ToString("#,#0.##")) @((Math.Floor(totalturnover / totalRollover * 10000) / 100).ToString("0.##"))%</span>
                                </div>
                            </div>
                                    }
                                }
                        </div>
                    </div>
                </div>
            </div>
            }
            else
            {
            <a class="btn btn-secondary" href="@Url.RouteUrl("desktop", new { action = "Register", controller = "Home", LangId = selLangBLL.GetLangId() })">
                <span class="text">@selLangBLL.GetResourceValue("lbl_JoinNow")</span>
            </a>
            <button class="btn btn-highlight loginBtn">
                <div class="btn__inner">
                    <span class="text">@selLangBLL.GetResourceValue("lbl_Login")</span>
                </div>
            </button>
            <div class="text-group">
                <a class="text-link" href="@Url.RouteUrl("desktop", new { action = "ForgetPassowrd", controller = "Home", LangId = selLangBLL.GetLangId() })">
                    <span class="text">@selLangBLL.GetResourceValue("lbl_ForgetPassword")</span>
                </a>
            </div>
            }
        </div>
    </div>
    <div class="header__nav" role="desktop-only">
        <a class="header__col-home" data-selected="false" href="@Url.RouteUrl("desktop", new { action = "Index", controller = "Home", LangId = selLangBLL.GetLangId() })">
            <i class="icon icon-home"></i>
        </a>
        <a class="header__col" data-selected="false" href="@gamingBLL.GetEntPageUrl(1,"1",Url)">
            <span class="text">@selLangBLL.GetResourceValue("lbl_Sports")</span>
        </a>
        <a class="header__col @(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" data-selected="false" href="@gamingBLL.GetEntPageUrl(1,"43",Url)">
            <span class="text">@selLangBLL.GetResourceValue("lbl_eSports")</span>
        </a>
        <a class="header__col" data-selected="false" href="@gamingBLL.GetEntPageUrl(1,"161",Url)">
            <span class="text">@selLangBLL.GetResourceValue("lbl_NumberGame")</span>
        </a>
        <a class="header__col" data-selected="false" href="@gamingBLL.GetEntPageUrl(1,"180",Url)">
            <span class="text">@selLangBLL.GetResourceValue("lbl_VirtualSports")</span>
        </a>
        <a class="header__col" data-selected="false" href="@Url.RouteUrl("desktop", new { action = "Index", controller = "Casino", LangId = selLangBLL.GetLangId() })">
            <span class="text">@selLangBLL.GetResourceValue("lbl_Casino")</span>
        </a>
        <a class="header__col" data-selected="false" href="@Url.RouteUrl("desktop", new { action = "Index", controller = "LiveCasino", LangId = selLangBLL.GetLangId() })">
            <span class="text">@selLangBLL.GetResourceValue("lbl_LiveCasino")</span>
        </a>
        @*<a class="header__col" data-selected="false" href="@gamingBLL.GetEntPageUrl(1,"211",Url)">
                <span class="text">@selLangBLL.GetResourceValue("lbl_Games")</span>
            </a>
            <a class="header__col" data-selected="false" href="@gamingBLL.GetEntPageUrl(1,"202",Url)">
                <span class="text">@selLangBLL.GetResourceValue("lbl_KenoAndLottery")</span>
            </a>*@

        <div class="dropdown">
            <a class="btn">
                <span class="text">@selLangBLL.GetResourceValue("lbl_Lottery")</span>
                <i class="icon icon-caret"></i>
                @if (CurrencyId == 4 || CurrencyId == 15)
                {
                    <img src="~/SiteSkin/Nova88/common/images/new.gif" class="newicon" />
                }
            </a>
            <div class="dropdown__container">
                <div class="dropdown__list">
                    <div class="dropdown__group">
                        <a class="dropdown__item @(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@gamingBLL.GetEntPageUrl(1,"202",Url)">
                            <i class="icon icon-sport202"></i>
                            <span class="text">@selLangBLL.GetResourceValue("lbl_Keno")</span>
                        </a>
                        <a class="dropdown__item @(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@gamingBLL.GetEntPageUrl(1,"220",Url)">
                            <i class="icon icon-sport220"></i>
                            <span class="text">@selLangBLL.GetResourceValue("lbl_Lottery")</span>
                        </a>
                        @if (CurrencyId == 4 || CurrencyId == 15)
                        {
                            <a class="dropdown__item @(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@gamingBLL.GetEntPageUrl(1, "223", Url)">
                                <i class="icon icon-sport223">
                                    <img src="~/common/images/svg/4D.svg" />
                                </i>
                                <span class="text">@selLangBLL.GetResourceValue("lbl_Indo4d")</span>
                                <img src="~/SiteSkin/Nova88/common/images/new.gif" class="newicon" />
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
        <a class="header__col @(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" data-selected="false" href="@entFishingPageUrl">
            <span class="text">@selLangBLL.GetResourceValue("lbl_Fishing")</span>
        </a>
    </div>
</div>

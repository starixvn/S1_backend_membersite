@model Dictionary<string, string>
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>ServerInfo</title>
</head>
<body>
    <div class="main">
        <ul>
            @*Key/Value*@
            @foreach (var Info in Model)
            {
                <li><label>@Info.Key</label>&nbsp;:&nbsp;<span>@Info.Value</span></li>
            }
        </ul>
    </div>
</body>
</html>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL
@{
    ViewData["Title"] = "Statement";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var i18n = new Dictionary<string, string>
    {
        { "lbl_TransactionHistory", selLangBLL.GetResourceValue("lbl_TransactionHistory") },
        { "lbl_From", selLangBLL.GetResourceValue("lbl_From") },
        { "lbl_To", selLangBLL.GetResourceValue("lbl_To") },
        { "lbl_Status", selLangBLL.GetResourceValue("lbl_Status") },
        { "lbl_Submit", selLangBLL.GetResourceValue("lbl_Submit") },
        { "lbl_Page", selLangBLL.GetResourceValue("lbl_Page") },
        { "lbl_Of", selLangBLL.GetResourceValue("lbl_Of") },
        { "lbl_DateMissing", selLangBLL.GetResourceValue("lbl_DateMissing") },
        { "msg_NoData", selLangBLL.GetMsg("msg_NoData") },
        { "lbl_Statement", selLangBLL.GetResourceValue("lbl_Statement") },
        { "lbl_Date", selLangBLL.GetResourceValue("lbl_Date") },
        { "lbl_Time", selLangBLL.GetResourceValue("lbl_Time") },
        { "lbl_TypeName", selLangBLL.GetResourceValue("lbl_TypeName") },
        { "lbl_ChangeAmount", selLangBLL.GetResourceValue("lbl_ChangeAmount") },
        { "lbl_BeforeAmount", selLangBLL.GetResourceValue("lbl_BeforeAmount") },
        { "lbl_AfterAmount", selLangBLL.GetResourceValue("lbl_AfterAmount") },
        { "lbl_RefTransId", selLangBLL.GetResourceValue("lbl_RefTransId") },
        { "lbl_QuickPick", selLangBLL.GetResourceValue("lbl_QuickPick") },
        { "lbl_Today", selLangBLL.GetResourceValue("lbl_Today") },
        { "lbl_YesterDay", selLangBLL.GetResourceValue("lbl_YesterDay") },
        { "lbl_ThisWeek", selLangBLL.GetResourceValue("lbl_ThisWeek") },
        { "lbl_LastWeek", selLangBLL.GetResourceValue("lbl_LastWeek") },
        { "lbl_ThisMonth", selLangBLL.GetResourceValue("lbl_ThisMonth") },
        { "lbl_LastMonth", selLangBLL.GetResourceValue("lbl_LastMonth") }
    };


}
    <div class="main">
        <partial name="~/Views/Shared/_DesktopLeftMenu.cshtml" />
        <div class="page-title" role="mobile-only">
            <span class="text">@selLangBLL.GetResourceValue("lbl_Statement")</span>
        </div>
        <div class="page-tabs" role="mobile-only">
            <a class="page-tabs__btn" href="@Url.RouteUrl("desktop", new { action = "Deposit", controller = "History", LangId = selLangBLL.GetLangId() })">
                <span class="text">@selLangBLL.GetResourceValue("lbl_Deposit")</span>
            </a>
            <a class="page-tabs__btn" href="@Url.RouteUrl("desktop", new { action = "Transfer", controller = "History", LangId = selLangBLL.GetLangId() })">
                <span class="text">@selLangBLL.GetResourceValue("lbl_TransferFunds")</span>
            </a>
            <a class="page-tabs__btn" href="@Url.RouteUrl("desktop", new { action = "Withdrawal", controller = "History", LangId = selLangBLL.GetLangId() })">
                <span class="text">@selLangBLL.GetResourceValue("lbl_Withdrawal")</span>
            </a>
            <a class="page-tabs__btn" data-selected="true">
                <span class="text">@selLangBLL.GetResourceValue("lbl_Statement")</span>
            </a>
        </div>
        <div id="StatementPanel" class="page"></div>
    </div>
@section Scripts{
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
    </script>
    <script src="~/lib/runtime.min.js"></script>
    <script src="~/js/component/history/Statement/Statement.min.js" asp-append-version="true"></script>
}


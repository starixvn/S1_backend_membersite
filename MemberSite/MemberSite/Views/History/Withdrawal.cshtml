@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL

@{
    ViewData["Title"] = "Withdrawal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var i18n = new Dictionary<string, string>();
    i18n.Add("lbl_TransactionHistory", selLangBLL.GetResourceValue("lbl_TransactionHistory"));
    i18n.Add("lbl_Withdrawal", selLangBLL.GetResourceValue("lbl_Withdrawal"));
    i18n.Add("lbl_Date", selLangBLL.GetResourceValue("lbl_Date"));
    i18n.Add("lbl_Time", selLangBLL.GetResourceValue("lbl_Time"));
    i18n.Add("lbl_From", selLangBLL.GetResourceValue("lbl_From"));
    i18n.Add("lbl_To", selLangBLL.GetResourceValue("lbl_To"));
    i18n.Add("lbl_ID", selLangBLL.GetResourceValue("lbl_ID"));
    i18n.Add("lbl_Method", selLangBLL.GetResourceValue("lbl_Method"));
    i18n.Add("lbl_Amount", selLangBLL.GetResourceValue("lbl_Amount"));
    i18n.Add("lbl_ChargeFee", selLangBLL.GetResourceValue("lbl_ChargeFee"));
    i18n.Add("lbl_Status", selLangBLL.GetResourceValue("lbl_Status"));
    i18n.Add("lbl_Submit", selLangBLL.GetResourceValue("lbl_Submit"));
    i18n.Add("lbl_Page", selLangBLL.GetResourceValue("lbl_Page"));
    i18n.Add("lbl_Of", selLangBLL.GetResourceValue("lbl_Of"));
    i18n.Add("lbl_DateMissing", selLangBLL.GetResourceValue("lbl_DateMissing"));
    i18n.Add("msg_NoData", selLangBLL.GetMsg("msg_NoData"));

    i18n.Add("lbl_QuickPick", selLangBLL.GetResourceValue("lbl_QuickPick"));
    i18n.Add("lbl_Today", selLangBLL.GetResourceValue("lbl_Today"));
    i18n.Add("lbl_YesterDay", selLangBLL.GetResourceValue("lbl_YesterDay"));
    i18n.Add("lbl_ThisWeek", selLangBLL.GetResourceValue("lbl_ThisWeek"));
    i18n.Add("lbl_LastWeek", selLangBLL.GetResourceValue("lbl_LastWeek"));
    i18n.Add("lbl_ThisMonth", selLangBLL.GetResourceValue("lbl_ThisMonth"));
    i18n.Add("lbl_LastMonth", selLangBLL.GetResourceValue("lbl_LastMonth"));
    for (int i = 0; i <= 7; i++)
    {
        if (!i18n.ContainsKey($"lbl_WithdrawalStatus{i}"))
            i18n.Add($"lbl_WithdrawalStatus{i}", selLangBLL.GetResourceValue($"lbl_WithdrawalStatus{i}"));
    }
    i18n.Add($"lbl_WithdrawalStatus{99}", selLangBLL.GetResourceValue($"lbl_WithdrawalStatus{99}"));
}
<div class="main">
    <partial name="~/Views/Shared/_DesktopLeftMenu.cshtml" />
    <div class="page-title" role="mobile-only">
        <span class="text">@selLangBLL.GetResourceValue("lbl_History")</span>
    </div>
    <div class="page-tabs" role="mobile-only">
        <a class="page-tabs__btn" href="@Url.RouteUrl("desktop", new { action = "Deposit", controller = "History", LangId = selLangBLL.GetLangId() })">
            <span class="text">@selLangBLL.GetResourceValue("lbl_Deposit")</span>
        </a>
        <a class="page-tabs__btn" href="@Url.RouteUrl("desktop", new { action = "Transfer", controller = "History", LangId = selLangBLL.GetLangId() })">
            <span class="text">@selLangBLL.GetResourceValue("lbl_TransferFunds")</span>
        </a>
        <a class="page-tabs__btn" data-selected="true">
            <span class="text">@selLangBLL.GetResourceValue("lbl_Withdrawal")</span>
        </a>
    </div>
    <div id="History" class="page"></div>
</div>
@section Scripts{
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
    </script>
    <script src="~/lib/runtime.min.js"></script>
    <script src="~/js/component/history/Withdrawal.min.js" asp-append-version="true"></script>
}



@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL

@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Deposit");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
    <div class="main">
        <div class="page-title" role="mobile-only">
            <span class="text">@selLangBLL.GetResourceValue("lbl_History")</span>
        </div>
        <div class="page-tabs" role="mobile-only">
            <a class="page-tabs__btn" data-selected="true">
                <span class="text">@selLangBLL.GetResourceValue("lbl_Deposit")</span>
            </a>
            <a class="page-tabs__btn" href="@Url.RouteUrl("desktop", new { action = "Withdrawal", controller = "History", LangId = selLangBLL.GetLangId() })">
                <span class="text">@selLangBLL.GetResourceValue("lbl_Withdrawal")</span>
            </a>
        </div>
        <div id="History" class="page"></div>
    </div>
@section Scripts{
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(null)));
    </script>
    <script src="~/lib/runtime.min.js"></script>
    <script src="~/js/component/history/Deposit.min.js" asp-append-version="true"></script>
}

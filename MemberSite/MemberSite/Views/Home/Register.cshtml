@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@using MemberSite.Service.Model
@using System.Security.Claims
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL
@inject CustInfoBll custInfoBLL
@inject GamingBLL gamingBLL
@inject BannerBLL bannerBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Register");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Style{
    <style>
        .modal__body {
            flex: 0 0 auto;
            overflow: visible;
            color: #26416e;
        }

            .modal__body a {
                color: #f77a00;
                font-weight: bold;
                text-decoration: underline;
            }
    </style>
}
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var CmsPromotionPath = Url.Content($"~/CMS/{serverInfo.SiteName}/Promotion/{selLangBLL.GetLangId()}");
    var SkinrootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Promotion");
    var domain = serverInfoBLL.GetDomain();

    var currencyList = new List<dynamic>();
    foreach (var currencyId in serverInfo.ICurrencyList)
    {
        currencyList.Add(new { text = selLangBLL.GetResourceValue($"Currency_{currencyId}"), value = currencyId });
    }

    Customer customer = null;
    var CurrencyId = 0;
    if (User.Identity.IsAuthenticated)
    {
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        customer = custInfoBLL.GetCustInfoWithCache(custId);
        CurrencyId = customer.CurrencyId;
    }
    else
    {
        CurrencyId = selLangBLL.GetPreferCurrencyId();
    }

    var BannerList = bannerBLL.GetBanner(CurrencyId, "Promotion");
    BannerList = BannerList.Where(x => x.refId != null && x.refId.Any(r => string.Equals(r, "nova88c", StringComparison.OrdinalIgnoreCase)));
    var langId = selLangBLL.GetLangId();

    var i18n = new Dictionary<string, string>
    {
        { "lbl_CompleteRegistration", selLangBLL.GetResourceValue("lbl_CompleteRegistration") },
        { "lbl_Username", selLangBLL.GetResourceValue("lbl_Username") },
        { "lbl_UsernameTooltip", selLangBLL.GetResourceValue("lbl_UsernameTooltip") },
        { "lbl_Password", selLangBLL.GetResourceValue("lbl_Password") },
        { "lbl_PasswordTooltip", selLangBLL.GetResourceValue("lbl_PasswordTooltip") },
        { "lbl_Email", selLangBLL.GetResourceValue("lbl_Email") },
        { "lbl_EmailToolTip", selLangBLL.GetResourceValue("lbl_EmailToolTip") },
        { "lbl_PrefferedCurrency", selLangBLL.GetResourceValue("lbl_PrefferedCurrency") },
        { "lbl_PreferredCurrencyToolTip", selLangBLL.GetResourceValue("lbl_PreferredCurrencyToolTip") },
        { "lbl_CheckTCTooltip", selLangBLL.GetResourceValue("lbl_CheckTCTooltip") },
        { "lbl_Check18TC1", selLangBLL.GetResourceValue("lbl_Check18TC1") },
        { "lbl_Check18TC2", selLangBLL.GetResourceValue("lbl_Check18TC2") },
        { "lbl_Check18TC3", selLangBLL.GetResourceValue("lbl_Check18TC3") },
        { "lbl_Check18TC4", selLangBLL.GetResourceValue("lbl_Check18TC4") },
        { "lbl_TermsConditions", selLangBLL.GetResourceValue("lbl_TermsConditions") },
        { "lbl_RuleRegulations", selLangBLL.GetResourceValue("lbl_RuleRegulations") },
        { "lbl_Check18TCTooltip", selLangBLL.GetResourceValue("lbl_Check18TCTooltip") },
        { "msg_UsernameReq", selLangBLL.GetMsg("msg_UsernameReq") },
        { "msg_UsernameLength", selLangBLL.GetMsg("msg_UsernameLength") },
        { "msg_UsernameValidate", selLangBLL.GetMsg("msg_UsernameValidate") },
        { "msg_UsernameNotAvailable", selLangBLL.GetMsg("msg_UsernameNotAvailable") },
        { "msg_PasswordReq", selLangBLL.GetMsg("msg_PasswordReq") },
        { "msg_PasswordLength", selLangBLL.GetMsg("msg_PasswordLength") },
        { "msg_PasswordValidate", selLangBLL.GetMsg("msg_PasswordValidate") },
        { "msg_MailReq", selLangBLL.GetMsg("msg_MailReq") },
        { "msg_MailWrongFormat", selLangBLL.GetMsg("msg_MailWrongFormat") },
        { "msg_MailExisted", selLangBLL.GetMsg("msg_MailExisted") }
    };
}

<div class="main">
    <div class="page">
        <div class="heading">
            <span class="text">@selLangBLL.GetResourceValue("lbl_JoinNow")</span>
        </div>
        <p>
            @selLangBLL.GetResourceValue("lbl_LoginMsg")
            <button class="text-link loginBtn">
                <span class="text">@selLangBLL.GetResourceValue("lbl_LoginHere")</span>
            </button>
        </p>
        <div id="RegisterForm"></div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        var currencyList = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(currencyList));
        var defCurrencyId = @selLangBLL.GetPreferCurrencyId();
        var siteName = "@serverInfo.SiteName";
        var Check18URL = "@Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Static/{selLangBLL.GetLangId()}")";
        $.extend( i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
    </script>

    <script src="~/lib/runtime.min.js"></script>
    <script src="~/js/component/home/registerForm.min.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(function () {
            $(".Js-CreditSignUp").on("touchstart, click", function () {
                $("#CreditSignUpBtnModel").attr("data-open", false);
            });
        });
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/4.5.1/js/swiper.min.js"></script>
    <script>
        // 主 Banner 輪播
        $(function () {
            var bannerSwiper = new Swiper('.lobby-banner-swiper', {
                loop: true,
                autoplay: {
                    delay: 3000,
                },
                pagination: {
                    el: '.swiper-pagination',
                },
                observer: true,
                observeParents: true,
                updateTranslate: true,
            });
            bannerSwiper.updateSize();
            bannerSwiper.updateSlides();
        });

        // 產品輪播
        $(function () {
            var productSwiper = new Swiper('.lobby-product-swiper', {
                loop: true,
                autoplay: {
                    delay: 6000,
                },
                slidesPerView: 4, // 預設顯示 3個
                breakpoints: {
                    //當寬度小於等於 768 則顯示 1個
                    768: {
                        slidesPerView: 1,
                    }
                },
                observer: true,
                observeParents: true,
                updateTranslate: true,
            });
            productSwiper.updateSize();
            productSwiper.updateSlides();
        });
    </script>
}
@section PromptMsg{
    @if ((Context.Request.Query.ContainsKey("refId") && Context.Request.Query["refId"].ToString().StartsWith("Nova88", StringComparison.OrdinalIgnoreCase)) || (!Context.Request.Query.ContainsKey("refId") && Context.Request.Cookies["refId"] != null && Context.Request.Cookies["refId"].StartsWith("Nova88", StringComparison.OrdinalIgnoreCase)))
    {
        <div class="modal" data-open="true" id="CreditSignUpBtnModel">
            <div class="overlay Js-CreditSignUp"></div>
            <div class="modal__dialog">
                <div class="modal__header">
                    <span class="text">@selLangBLL.GetResourceValue("lbl_Welcome")</span>
                </div>
                <div class="modal__body">
                    <div class="lobby-page">
                        <div class="lobby-banner-swiper">
                            <div class="swiper-wrapper">
                                @foreach (var b in BannerList)
                                {
                                    var _actionLink = b.actionLink;
                                    var _outerLink = b.outerLink;

                                    var _actionByLang = b.actionLinkByLang?.FirstOrDefault(x => x.lang == langId);
                                    if (_actionByLang != null)
                                    {
                                        _actionLink = _actionByLang.link;
                                        _outerLink = _actionByLang.outerLink ?? _outerLink;
                                    }

                                    if (!string.IsNullOrEmpty(_actionLink))
                                    {
                                        if (b.urlWithLang)
                                        {
                                            <div class="swiper-slide">
                                                <a href='@Url.Content($"~/{langId}/{_actionLink}")'>
                                                    <img src="@CmsPromotionPath/@(b.img)" asp-append-version="true" />
                                                </a>
                                            </div>
                                        }
                                        else
                                        {
                                            if (_outerLink)
                                            {
                                                <div class="swiper-slide">
                                                    <a href='@Url.Content($"{_actionLink}")' target="_event">
                                                        <img src="@CmsPromotionPath/@(b.img)" asp-append-version="true" />
                                                    </a>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="swiper-slide">
                                                    <a href='@Url.Content($"~/{_actionLink}")' target="_event">
                                                        <img src="@CmsPromotionPath/@(b.img)" asp-append-version="true" />
                                                    </a>
                                                </div>
                                            }
                                        }
                                    }
                                    else if (b.tpId != null)
                                    {
                                        <div class="swiper-slide">
                                            <a class="swiper-slide  @(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@gamingBLL.GetEntPageUrl((int)b.tpId, b.gameId?.ToString(), Url)">
                                                <img src="@CmsPromotionPath/@(b.img)" asp-append-version="true" />
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="swiper-slide">
                                            <img src="@CmsPromotionPath/@(b.img)" asp-append-version="true" />
                                        </div>
                                    }
                                }
                            </div>
                            <div class="swiper-pagination"></div>
                        </div>
                        <br />
                        @Html.Raw(string.Format(selLangBLL.GetMsg("msg_CreditSignUp"),domain))
                    </div>
                    <div class="modal__footer">
                        <div class="btn-group">
                            <button class="btn btn-secondary Js-CreditSignUp" type="button">
                                <span class="text">@selLangBLL.GetResourceValue("lbl_Close")</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

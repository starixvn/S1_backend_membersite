@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = "Registered";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Style{

}
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    List<dynamic> currencyList = new List<dynamic>();
    foreach (var currencyId in serverInfo.ICurrencyList)
    {
        currencyList.Add(new { text = selLangBLL.GetResourceValue($"Currency_{currencyId}"), value = currencyId });
    }

    Dictionary<string, string> i18n = new Dictionary<string, string>();
    i18n.Add("lbl_CompleteRegistration", selLangBLL.GetResourceValue("lbl_CompleteRegistration"));
    i18n.Add("lbl_Username", selLangBLL.GetResourceValue("lbl_Username"));
    i18n.Add("lbl_UsernameTooltip", selLangBLL.GetResourceValue("lbl_UsernameTooltip"));
    i18n.Add("lbl_Password", selLangBLL.GetResourceValue("lbl_Password"));
    i18n.Add("lbl_PasswordTooltip", selLangBLL.GetResourceValue("lbl_PasswordTooltip"));
    i18n.Add("lbl_PrefferedCurrency", selLangBLL.GetResourceValue("lbl_PrefferedCurrency"));
    i18n.Add("lbl_PreferredCurrencyToolTip", selLangBLL.GetResourceValue("lbl_PreferredCurrencyToolTip"));
    i18n.Add("msg_UsernameReq", selLangBLL.GetMsg("msg_UsernameReq"));
    i18n.Add("msg_UsernameLength", selLangBLL.GetMsg("msg_UsernameLength"));
    i18n.Add("msg_UsernameVaildate", selLangBLL.GetMsg("msg_UsernameVaildate"));
    i18n.Add("msg_UsernameNotAvailable", selLangBLL.GetMsg("msg_UsernameNotAvailable"));
    i18n.Add("msg_PasswordReq", selLangBLL.GetMsg("msg_PasswordReq"));
    i18n.Add("msg_PasswordLength", selLangBLL.GetMsg("msg_PasswordLength"));
    i18n.Add("msg_PasswordVaildate", selLangBLL.GetMsg("msg_PasswordVaildate"));

}
<div class="main">
    <div class="page page--join">
        <div class="heading">
            <span class="text">@selLangBLL.GetResourceValue("lbl_JoinNow")</span>
            <a class="btn btn-icon">
                <i class="icon icon-clear"></i>
            </a>
        </div>
        <p>
            @selLangBLL.GetResourceValue("lbl_LoginMsg")
            <a class="text-link" demo-open-login>
                <span class="text">@selLangBLL.GetResourceValue("lbl_LoginHere")</span>
            </a>.
        </p>
        <div id="RegisterForm">

        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        var currencyList =@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(currencyList));
        var defCurrencyId =@selLangBLL.GetDefCurrencyId();
        $.extend( i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));

    </script>

    <script src="~/lib/runtime.min.js"></script>
    <script src="~/js/component/home/registerForm.min.js" asp-append-version="true"></script>
}

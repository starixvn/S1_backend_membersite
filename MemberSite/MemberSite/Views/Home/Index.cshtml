    var StaticRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Static/{selLangBLL.GetLangId()}");

    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int CurrencyId = 0;
    int promotionCnt = 0;
    int mainWalletType = configuration.GetValue<int>("MainWalletType");
    Customer customer = null;

    if (User.Identity.IsAuthenticated)
    {
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        customer = custInfoBLL.GetCustInfoWithCache(custId);
        CurrencyId = customer.CurrencyId;
        promotionCnt = promotionBLL.GetPromotionListByCustId(custId).Count();
    }
    else
    {
        CurrencyId = selLangBLL.GetPreferCurrencyId();
        promotionCnt = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).Count();
    }

    var entFishingPageUrl = "";
    if (User.Identity.IsAuthenticated)
    {
        entFishingPageUrl = gamingBLL.GetEntPageUrl(7, "10", Url, GameType.Fishing);
        entFishingPageUrl = $"javascript:window.open('{entFishingPageUrl}', 'Tp_7_10', 'toolbar=no, menubar=no,scrollbars=no,resizable=no,location=no,directories=no,status=no, top=0, left=0').focus()";
    }
    else
    {
        entFishingPageUrl = "javascript:void(0);";
    }
}


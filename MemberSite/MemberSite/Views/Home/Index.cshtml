            </div>
            <div class="modal__body">
                <p>@Html.Raw(string.Format(selLangBLL.GetMsg("msg_DepositAlert"), selLangBLL.GetResourceValue($"Currency_{CurrencyId}"), balance.ToString("#,##0.##")))</p>
                <br>
            </div>
            <div class="modal__footer">
                <div class="btn-group">
                    <button class="btn btn-primary Js-DepositAlet" type="button">
                        <span class="text">@selLangBLL.GetResourceValue("lbl_Later")</span>
                    </button>

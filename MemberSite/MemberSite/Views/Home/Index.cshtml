@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using MemberSite.Service.Library
@using Microsoft.AspNetCore.Hosting
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject IWebHostEnvironment environment
@inject WalletBLL walletBLL
@inject CustInfoBLL custInfoBLL
@inject Tools tools
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var SkinRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/common");
    var SkinImgPath = $"{SkinRootPath}/images";
    var CmsPromotionPath = Url.Content($"~/CMS/{serverInfo.SiteName}/Promotion/{selLangBLL.GetLangId()}");
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@functions{
    string GetEntPageUrl(int tpId, string gameId)
    {

        var homeUrl = Url.RouteUrl("desktop", new { action = ViewContext.RouteData.Values["action"], controller = ViewContext.RouteData.Values["controller"], LangId = selLangBLL.GetLangId() }, protocol: Context.Request.Scheme, host: Context.Request.Host.Host);
        var signupUrl = Url.RouteUrl("desktop", new { action = "Register", controller = "Home", LangId = selLangBLL.GetLangId() }, protocol: Context.Request.Scheme, host: Context.Request.Host.Host);
        var LoginUrl = Url.RouteUrl("desktop", new { action = ViewContext.RouteData.Values["action"], controller = ViewContext.RouteData.Values["controller"], LangId = selLangBLL.GetLangId(), loginCont = 1 }, protocol: Context.Request.Scheme, host: Context.Request.Host.Host);

        var entPageUrl = Url.RouteUrl("desktop", new { action = "Index", controller = "entPage", LangId = selLangBLL.GetLangId(), homeUrl = homeUrl, signupUrl = signupUrl, LoginUrl = LoginUrl, tpId = tpId, gameId = gameId });
        if (!tools.IsMobile() && tpId == 1)
        {
            entPageUrl = $"javascript:window.open('{entPageUrl}', 'Tp_{tpId}');";
        }

        return entPageUrl;
    }
}
<div class="main main--home">
    <div class="lobby-page">
        <div class="lobby-banner-swiper">
            <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <img src="@CmsPromotionPath/Banner-Welcome.jpg">
                </div>
                <div class="swiper-slide">
                    <img src="@CmsPromotionPath/Banner-Welcome.jpg">
                </div>
                <div class="swiper-slide">
                    <img src="@CmsPromotionPath/Banner-Welcome.jpg">
                </div>
            </div>
            <div class="swiper-pagination"></div>
        </div>
        <div class="lobby-quicklink-list">
            <div class="lobby-quicklink-download">
                <div class="lobby-quicklink__info">
                    <i class="icon icon-download"></i>
                    <span class="text-title">@selLangBLL.GetResourceValue("lbl_DownloadApp")</span><span class="text">@selLangBLL.GetResourceValue("lbl_RebatebonusonMobile")</span>
                </div><img src="@SkinImgPath/UI/Download-App.png"><i class="icon icon-arrow-right"></i>
            </div>
            @if (User.Identity.IsAuthenticated)
            {
                <a class="lobby-quicklink" href="@Url.RouteUrl("desktop", new { action = "Deposit", controller = "Cashier", LangId = selLangBLL.GetLangId() })">
                    <div class="lobby-quicklink__info">
                        <i class="icon icon-deposit-bank"></i>
                        <span class="text-title">@selLangBLL.GetResourceValue("lbl_DepositNow")</span><span class="text">@selLangBLL.GetResourceValue("lbl_VariousBankingOptions")</span>
                    </div><i class="icon icon-arrow-right"></i>
                </a>
            }
            else
            {
                <a class="lobby-quicklink" href="@Url.RouteUrl("desktop", new { action = "Register", controller = "Home", LangId = selLangBLL.GetLangId() })">
                    <div class="lobby-quicklink__info">
                        <i class="icon icon-join-now"></i>
                        <span class="text-title">@selLangBLL.GetResourceValue("lbl_JoinNow")</span><span class="text">@selLangBLL.GetResourceValue("lbl_Clickhereforbonus")</span>
                    </div><i class="icon icon-arrow-right"></i>
                </a>
            }


        </div>
        <div class="lobby-sport-list">
            <a class="lobby-sport" href="@GetEntPageUrl(1,"1")">
                <img src="@SkinImgPath/Lobby/Home/Sport-Soccer.png">
                <img src="@SkinImgPath/Lobby/Home/d_Sport-Soccer.png">
                <div class="lobby-sport__info">
                    <span class="text">@selLangBLL.GetResourceValue("lbl_Soccer")</span>
                </div>
            </a>
            <a class="lobby-sport" href="@GetEntPageUrl(1,"2")">
                <img src="@SkinImgPath/Lobby/Home/Sport-Basketball.png">
                <img src="@SkinImgPath/Lobby/Home/d_Sport-Basketball.png">
                <div class="lobby-sport__info">
                    <span class="text">@selLangBLL.GetResourceValue("lbl_Basketball")</span>
                </div>
            </a>
            <a class="lobby-sport" href="@GetEntPageUrl(1,"8")">
                <img src="@SkinImgPath/Lobby/Home/Sport-Baseball.png">
                <img src="@SkinImgPath/Lobby/Home/d_Sport-Baseball.png">
                <div class="lobby-sport__info">
                    <span class="text">@selLangBLL.GetResourceValue("lbl_Baseball")</span>
                </div>
            </a>
            <a class="lobby-sport" href="@GetEntPageUrl(1,"43")">
                <img src="@SkinImgPath/Lobby/Home/Sport-E-Sports.png">
                <img src="@SkinImgPath/Lobby/Home/d_Sport-E-Sports.png">
                <div class="lobby-sport__info">
                    <span class="text">@selLangBLL.GetResourceValue("lbl_eSports")</span>
                </div>
            </a>
            <a class="lobby-sport" href="@GetEntPageUrl(1,"5")">
                <img src="@SkinImgPath/Lobby/Home/Sport-Tennis.png">
                <img src="@SkinImgPath/Lobby/Home/d_Sport-Tennis.png">
                <div class="lobby-sport__info">
                    <span class="text">@selLangBLL.GetResourceValue("lbl_Tennis")</span>
                </div>
            </a>
        </div>
        <div class="lobby-product-swiper">
            <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <div class="lobby-product">
                        <div class="lobby-product__info">
                            <span class="text-title">@selLangBLL.GetResourceValue("lbl_Casino")</span>
                            <span class="text">@selLangBLL.GetResourceValue("lbl_CasinoSlogon")</span>
                            <a class="btn btn-secondary"><span class="text">@selLangBLL.GetResourceValue("lbl_TryNow")</span></a>
                        </div>
                        <img src="@SkinImgPath/Lobby/Home/Product-Casino.png">
                    </div>
                </div>
                <div class="swiper-slide">
                    <div class="lobby-product">
                        <div class="lobby-product__info">
                            <span class="text-title">@selLangBLL.GetResourceValue("lbl_Keno")</span>
                            <span class="text">@selLangBLL.GetResourceValue("lbl_KenoSlogon")</span>
                            <a class="btn btn-secondary"><span class="text">@selLangBLL.GetResourceValue("lbl_TryNow")</span></a>
                        </div>
                        <img src="@SkinImgPath/Lobby/Home/Product-Keno.png">
                    </div>
                </div>
                <div class="swiper-slide">
                    <div class="lobby-product">
                        <div class="lobby-product__info">
                            <span class="text-title">@selLangBLL.GetResourceValue("lbl_LiveCasino")</span>
                            <span class="text">@selLangBLL.GetResourceValue("lbl_LiveCasinoSlogon")</span>
                            <a class="btn btn-secondary"><span class="text">@selLangBLL.GetResourceValue("lbl_TryNow")</span></a>
                        </div>
                        <img src="@SkinImgPath/Lobby/Home/Product-LiveCasino.png">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@functions{
    private class TpInfo
    {
        public int TpId { set; get; }
        public int CustId { set; get; }
        public Dictionary<string, string> inputs { set; get; }
    }

    private class UserBalance
    {
        public decimal balance { get; set; }
        public decimal outstanding { get; set; }
        public byte Currency { get; set; }
    }

    async Task<decimal> Get3rdBalanceAsync(int tpId, int custId)
    {
        var apiUrl = configuration.GetValue<string>("TpService");
        var myUrl = $"{apiUrl}GetBalance";
        var oTpInfo = new TpInfo
        {
            TpId = tpId,
            CustId = custId,
            inputs = new Dictionary<string, string>()
        };

        var data = await courierAdapter.MyPostAsync<UserBalance, TpInfo>(myUrl, oTpInfo);

        return data.ErrorCode == 0 ? data.Data.balance : 0;
    }
}
@section PromptMsg{
    @if (User.Identity.IsAuthenticated)
    {
        if (!Context.Request.Cookies.ContainsKey($"Initialization{User.Identity.Name}"))
        {
            var custId = customer.CustId;
            var balance = 0m;
            if (customer.ActStatus == 2)
            {
                balance = walletBLL.GetBalance(custId) + await Get3rdBalanceAsync(1, custId);
                if (custInfoBLL.IsConvertRequired(CurrencyId))
                {
                    balance /= 1000;
                }
            }

            if (balance < 1m)
            {
    <div class="modal" id="DepositAlet" data-open="false">

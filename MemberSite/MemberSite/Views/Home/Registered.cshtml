@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = "Registered";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Style{

}
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    List<dynamic> currencyList = new List<dynamic>();
    foreach (var currencyId in serverInfo.ICurrencyList)
    {
        currencyList.Add(new { text = selLangBLL.GetResourceValue($"Currency_{currencyId}"), value = currencyId });
    }
}
<div class="main">
    <div class="page page--join">
        <div class="heading">
            <span class="text">Join Now</span>
            <a class="btn btn-icon">
                <i class="icon icon-clear"></i>
            </a>
        </div>
        <p>
            Please note that we do not permit members to own more than (1) account. Already have a account?
            <a class="text-link" demo-open-login>
                <span class="text">Log in here</span>
            </a>.
        </p>
        <div id="Registered">

        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        var currencyList =@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(currencyList));
        var defCurrencyId=@selLangBLL.GetDefCurrencyId();
    </script>

    @if (environment.EnvironmentName == "Development")
    {
        <script type="text/babel" src="~/js/component/home/Registered.jsx"></script>
    }
    else
    {

    }
}

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_ForgetPassword");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main ">
    <div class="page">
        <div class="heading">
            <span class="text">@selLangBLL.GetResourceValue("lbl_ForgetPassword")</span>
        </div>
        <p>@selLangBLL.GetResourceValue("lbl_ForgetPwdHint")</p>
        <form class="form">
            <div class="form-group">
                <label class="form-title">@selLangBLL.GetResourceValue("lbl_YourEmail")</label>
                <div class="form-content">
                    <div class="textfield">
                        <input type="text" class="textfield__input">
                        <span class="textfield__bg"></span>
                    </div>
                </div>
            </div>
            <div class="btn-group">
                <button class="btn btn-secondary">
                    <div class="btn__inner">
                        <span class="text">@selLangBLL.GetResourceValue("lbl_Submit")</span>
                    </div>
                </button>
            </div>
        </form>
    </div>
</div>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_ForgetPassword");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="main ">
    <div class="page">
        <div class="heading">
            <span class="text">@selLangBLL.GetResourceValue("lbl_ForgetPassword")</span>
        </div>
        <p>@selLangBLL.GetResourceValue("lbl_ForgetPwdHint")</p>
        <form class="form" method="post" id="ForgetPassowrd">
            <div class="form-group">
                <label class="form-title">@selLangBLL.GetResourceValue("lbl_YourEmail")</label>
                <div class="form-content">
                    <div class="textfield">
                        <input type="email" id="email" class="textfield__input" required />
                        <span class="textfield__bg"></span>
                    </div>
                </div>
            </div>
            <div class="btn-group">
                <button class="btn btn-secondary" type="submit">
                    <div class="btn__inner">
                        <span class="text">@selLangBLL.GetResourceValue("lbl_Submit")</span>
                    </div>
                </button>
            </div>
        </form>
    </div>
</div>
@section Scripts{
    <script>
        var langId = '@selLangBLL.GetLangId()';
    </script>
    <script src="~/lib/runtime.min.js"></script>
    <script src="~/js/component/home/ForgetPassowrd.min.js" asp-append-version="true"></script>
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Title") + '|' + @selLangBLL.GetResourceValue("lbl_TitleDesc") + "|" + @selLangBLL.GetResourceValue("lbl_Sports");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var SkinRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/common");
}
@section Style{
    <style>
        html,
        body {
            height: 100%;
        }

        .sports-ifrname {
            border: none;
            width: 1366px;
            background: #000;
            margin: 0 auto;
            height: 100%;
        }

        [data-layout=desktop] .main {
            background-image: url("@SkinRootPath/images/Lobby/Home/Sports-Iframe-BG.jpg");
            background-size: cover;
            padding: 0rem 0rem;
            max-width: none;
        }
    </style>
}
@functions{
    string GetEntPageUrl()
    {
        var homeUrl = Url.RouteUrl("desktop", new { action = ViewContext.RouteData.Values["action"], controller = ViewContext.RouteData.Values["controller"], LangId = selLangBLL.GetLangId() }, protocol: Context.Request.Scheme, host: Context.Request.Host.Host);
        var signupUrl = Url.RouteUrl("desktop", new { action = "Register", controller = "Home", LangId = selLangBLL.GetLangId() }, protocol: Context.Request.Scheme, host: Context.Request.Host.Host);
        var LoginUrl = Url.RouteUrl("desktop", new { action = ViewContext.RouteData.Values["action"], controller = ViewContext.RouteData.Values["controller"], LangId = selLangBLL.GetLangId(), loginCont = 1 }, protocol: Context.Request.Scheme, host: Context.Request.Host.Host);

        var entPageUrl = Url.RouteUrl("desktop", new { action = "Index", controller = "entPage", LangId = selLangBLL.GetLangId(), homeUrl, signupUrl, LoginUrl, tpId = Context.Request.Query["tpId"], gameId = Context.Request.Query["gameId"], matchid = Context.Request.Query["matchId"], device = Context.Request.Query["device"] });
        return entPageUrl;
    }
}
<div class="main ">
    <iframe class="sports-ifrname" src="@GetEntPageUrl()"></iframe>
</div>

@section Scripts{

}
@using MemberSite.Service.BLL
@inject ServerInfoBll serverInfoBLL

@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var SkinRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/common");
}


<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>HightLight</title>
    <link href="https://unpkg.com/video.js/dist/video-js.min.css" rel="stylesheet">
    <script src="https://unpkg.com/video.js/dist/video.min.js"></script>
</head>
<body style="margin: 30px 0px 0px 30px;">
    <video id="my-video"
           class="video-js"
           controls
           preload="auto"
           width="720"
           height="403"
           poster="@ViewData["poster"]"
           data-setup='{"muted": false, "autoplay": false, "preload": "auto"}'>
        <source src="@ViewData["url"]" type="application/x-mpegURL" />
        <p class="vjs-no-js">
            To view this video please enable JavaScript, and consider upgrading to a
            web browser that
            <a href="https://videojs.com/html5-video-support/" target="_blank">supports HTML5 video</a>
        </p>
    </video>
</body>
</html>
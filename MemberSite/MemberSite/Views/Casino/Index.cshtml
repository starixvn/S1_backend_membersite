@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL
@inject GamingBLL gamingBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Title") + '|' + @selLangBLL.GetResourceValue("lbl_TitleDesc") + "|" + @selLangBLL.GetResourceValue("lbl_Casino");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var SkinRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/common");
}
@section Style{
    <link rel="stylesheet" href="@SkinRootPath/css/CasinoLobby.css" asp-append-version="true">
}

<div class="main ">
    <div class="page CasinoLobby">
        <span class="title">@selLangBLL.GetResourceValue("lbl_CasinoLobby")</span>
        <div class="line"></div>
        <div class="CasModule">
            <a class="BIG" onclick="location.href='@Url.RouteUrl("desktop", new { action = "Lobby", controller = "Casino", LangId = selLangBLL.GetLangId() })'">
                <img src="@SkinRootPath/images/Lobby/casino/lobbyEntrance1.png" />
                <div>
                    <span>@selLangBLL.GetResourceValue("lbl_SelfCasino")</span>
                </div>
            </a>
            <a class="BIG @(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" onclick="@(!User.Identity.IsAuthenticated ? "javascript:void(0);" : @gamingBLL.GetEntPageUrl(1,"208",Url))">
                <img src="@SkinRootPath/images/Lobby/casino/lobbyEntrance2.png" />
                <div>
                    <span>@selLangBLL.GetResourceValue("lbl_OWCasino")</span>
                </div>
            </a>
        </div>
    </div>
</div>
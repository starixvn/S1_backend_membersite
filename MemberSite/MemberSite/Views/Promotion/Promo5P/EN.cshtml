@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

@section Style{
    <style>
        /* Style the tab */
        .tab {
            overflow: hidden;
            border: 1px solid #ccc;
            background-color: #f1f1f1;
        }

            /* Style the buttons that are used to open the tab content */
            .tab button {
                background-color: inherit;
                float: left;
                border: none;
                outline: none;
                cursor: pointer;
                padding: 14px 16px;
                transition: 0.3s;
            }

                /* Change background color of buttons on hover */
                .tab button:hover {
                    background-color: #ddd;
                }

                /* Create an active/current tablink class */
                .tab button.active {
                    background-color: #ccc;
                }

        /* Style the tab content */
        .tabcontent {
            display: none;
            padding: 6px 12px;
            border-top: none;
        }
    </style>
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-promo5.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <h2>WED, FRI & SUN 5% Redeposit bonus up to MYR300</h2>
            
        </div>
        <div class="promotions-module">
             <span class="promotions-title">Promotion Details</span>
                <ol type="a">
                    <li>Promotion applied when members made a minimum deposit amount.<br><br></li>
                    <li>Bonus will be credited to account wallet within 24 hours upon successful deposit.<br><br></li>
                </ol>

            <span class="promotions-title">Bonus Play Conditions</span>
            <p>Members are required to one time (1x) turnover (Deposit + Bonus 1x) before make a withdrawal.</p>
            
            <p>Promotion particulars are as illustrated below:</p>
            <div class="table table-rwd table-primary">
                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">Bonus %</span>
                        </div>
                        <div class="td-date">
                            <span class="text">Max Payout (capped)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">Turnover</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">5%</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 300</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>
            </div>
            <br><br>

            <span class="promotions-title">Promotion Terms & Conditions</span>
                <ol type="1">
                    <li>This promotion available on every Wednesday, Friday & Sunday only.<br><br></li>
                    <li>This Promotion effective from 3rd JUNE 2020 (Wednesday)<br><br></li>
                    <li>Promotion is accumulate total of unlimited redeposit on the day of promotion (Wednesday, Friday & Sunday)<br><br></li>
                    <li>Promotion applies to all Nova88 members.<br><br></li>
                    <li>Bonus acquired from this promotion is valid for thirty (30) days upon issuance, unless stated otherwise. Shall the participating member fail to fulfill required 
                        prerequisites within given time frame, all money won using bonus funds will be revoked.<br><br></li>
                    <li>Only wagers placed on Nova88 products that generate a win/loss outcome will contribute to the one time (1x) turnover requirement in all Nova88 product 
                        except cash out. Cancelled or voided wagers will not count toward this requirement.<br><br></li>
                    <li>Participating members must accept and comply with all the terms mentioned above as well as all relevant rules and regulations implemented by Nova88.<br><br></li>
                    <li>Nova88 reserves the right to amend or withdraw the Promotion at any time.<br><br></li>
                    <li>Nova88 is the sole arbiter of the Promotion and its decision is final.<br><br></li>
                    <li>Nova88 Terms & Conditions apply.<br><br></li>
                </ol>

        </div>
    </div>
</div>



@section Scripts{
    <script>
        openPromo(event, "Promo1");
        //document.getElementById('Promo1').focus();
        function openPromo(evt, PromoName) {
            // Declare all variables
            var i, tabcontent, tablinks;

            // Get all elements with class="tabcontent" and hide them
            tabcontent = document.getElementsByClassName("tabcontent");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }

            // Get all elements with class="tablinks" and remove the class "active"
            tablinks = document.getElementsByClassName("tablinks");
            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].className = tablinks[i].className.replace(" active", "");
            }

            // Show the current tab, and add an "active" class to the button that opened the tab
            document.getElementById(PromoName).style.display = "block";
            evt.currentTarget.className += " active";
        }

    </script>
}
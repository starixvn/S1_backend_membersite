@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

@section Style{
    <style>
        /* Style the tab */
        .tab {
            overflow: hidden;
            border: 1px solid #ccc;
            background-color: #f1f1f1;
        }

            /* Style the buttons that are used to open the tab content */
            .tab button {
                background-color: inherit;
                float: left;
                border: none;
                outline: none;
                cursor: pointer;
                padding: 14px 16px;
                transition: 0.3s;
            }

                /* Change background color of buttons on hover */
                .tab button:hover {
                    background-color: #ddd;
                }

                /* Create an active/current tablink class */
                .tab button.active {
                    background-color: #ccc;
                }

        /* Style the tab content */
        .tabcontent {
            display: none;
            padding: 6px 12px;
            border-top: none;
        }
    </style>
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-promo5.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <h2>RABU, JUMAT & MINGGU 5% Redeposit bonus Hingga IDR 1,000,000</h2>
            
        </div>
        <div class="promotions-module">
             <span class="promotions-title">Keterangan Promosi</span>
                <ol type="a">
                    <li>Promosi berlaku ketika Member melakukan jumlah setoran minimum.<br><br></li>
                    <li>Bonus akan dikreditkan ke dompet akun Nova88 dalam waktu 24 jam setelah setoran anda berhasil.<br><br></li>
                </ol>

            <span class="promotions-title">Ketentuan Bermain Bonus</span>
            <p>Setelah anggota menerima Bonus, anggota memerlukan rollover 1X sebelum melakukan penarikan.</p>
            
            <p>Informasi promosi seperti diilustrasikan di bawah ini:</p>
            <div class="table table-rwd table-primary">
                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">Bonus %</span>
                        </div>
                        <div class="td-date">
                            <span class="text">Maksimum Pembayaran (dibatasi)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">Turnover</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">5%</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR1,000,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>
            </div>
            <br><br>

            <span class="promotions-title">Syarat & Ketentuan Promosi</span>
                <ol type="1">
                    <li>Promosi ini hanya berlaku pada setiap hari Rabu, Jumat & Minggu saja<br><br></li>
                    <li>Promosi ini dimulai pada hari Rabu  Tanggal 3 Juni 2020<br><br></li>
                    <li>Promosi adalah akumulasi total Re-deposit tidak terbatas pada hari promosi (Rabu, Jumat & Minggu)<br><br></li>
                    <li>Promosi berlaku untuk semua anggota Nova88.<br><br></li>
                    <li>Bonus yang diperoleh dari promosi ini berlaku selama tiga puluh (30) hari setelah penerbitan, kecuali dinyatakan lain. Jika member yang berpartisipasi gagal memenuhi syarat
                        yang diperlukan dalam jangka waktu tertentu, semua uang yang dimenangkan dengan menggunakan dana bonus akan dicabut.<br><br></li>
                    <li>Hanya taruhan yang ditempatkan pada produk Nova88 yang menghasilkan hasil win-loss yang berkontribusi pada persyaratan turnover satu kali (1x) di semua produk Nova88
                        kecuali Cash out. Taruhan yang dibatalkan atau dibatalkan tidak akan diperhitungkan dalam persyaratan ini.<br><br></li>
                    <li>Member yang ikut berpartisipasi harus menerima dan mematuhi semua persyaratan yang disebutkan di atas serta semua peraturan dan ketentuan terkait yang diterapkan oleh Nova88.<br><br></li>
                    <li>Nova88 berhak untuk mengubah atau menarik Promosi kapan saja.<br><br></li>
                    <li>Nova88 adalah penyelenggara tunggal Promosi dan keputusannya adalah final.<br><br></li>
                    <li>Berlaku syarat dan ketentuan Umum Nova88.<br><br></li>
                </ol>

        </div>
    </div>
</div>



@section Scripts{
    <script>
        openPromo(event, "Promo1");
        //document.getElementById('Promo1').focus();
        function openPromo(evt, PromoName) {
            // Declare all variables
            var i, tabcontent, tablinks;

            // Get all elements with class="tabcontent" and hide them
            tabcontent = document.getElementsByClassName("tabcontent");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }

            // Get all elements with class="tablinks" and remove the class "active"
            tablinks = document.getElementsByClassName("tablinks");
            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].className = tablinks[i].className.replace(" active", "");
            }

            // Show the current tab, and add an "active" class to the button that opened the tab
            document.getElementById(PromoName).style.display = "block";
            evt.currentTarget.className += " active";
        }

    </script>
}
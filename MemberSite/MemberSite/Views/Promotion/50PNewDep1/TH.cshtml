@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var lang = selLangBLL.GetLangId();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-50PNewDep1.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <h2>สมาชิกใหม่ ฝากเงินครั้งแรก รับ 50%</h2>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">รายละเอียดโปรโมชั่น</span>
            <ol type="a">
                <li>โปรโมชั่นนี้สำหรับสมาชิกใหม่ที่ฝากเงินครั้งแรก<br><br></li>
                <li>จำนวนเงินฝากครั้งแรก x 50% = จำนวนเงินโบนัสที่จะได้รับ<br><br></li>
            </ol>

            <span class="promotions-title">เงื่อนไขการรับโบนัส</span>
            <ol type="a">
                <li>สมาชิกจะได้รับโบนัสก็ต่อเมื่อมีการโรลโอเวอร์ 1 ครั้ง (1x) ถึงจะมีสิทธิ์ถอนได้<br><br></li>
            </ol>

            <span class="promotions-title">รายการละเอียดโบนัสมีดังต่อไปนี้:</span>
            <div class="table table-rwd table-primary">
                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">โบนัส 50% ( ตามสกุลเงิน )</span>
                        </div>
                        <div class="td-date">
                            <span class="text">การจ่ายเงินสูงสุด (ต่อยอด)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">เทิร์นโอเวอร์</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">MYR</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 200</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">THB</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 1,400</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">IDR</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR 660,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

            </div>
            <br><br>

            <span class="promotions-title">ข้อกำหนดและเงื่อนไข</span>
            <ol type="1">
                <li>โปรโมชั่นนี้ใช้ได้กับสมาชิกทุกคนของ Nova88<br><br></li>
                <li>โปรโมชั่นนี้เริ่มตั้งแต่วันท่ี 1 กรกฎาคม 2020 จนกว่าจะมีกำหนดเปลี่ยนแปลง<br><br></li>
                <li>โบนัส 50% จะถูกโอนเข้าบัญชีเครดิตของสมาชิกภายใน 24 ชั่วโมง<br><br></li>
                <li>โบนัสที่ได้รับจากโปรโมชั่นนี้สามารถใช้ได้เป็นเวลาสามสิบ (30) วันเมื่อมีการออกโบนัส เว้นแต่จะระบุไว้เป็นอย่างอื่น สมาชิกที่เข้าร่วมจะต้องปฏิบัติตามข้อกำหนดเบื้องต้นภายในระยะเวลาที่กำหนด มิเช่นนั้นเงินทั้งหมดที่ได้รับจากการใช้เงินโบนัสจะถูกเพิกถอน<br><br></li>
                <li>การวางเดิมพันเฉพาะผลิตภัณฑ์ Nova88 ที่มีผลการชนะ / แพ้จะมีผลต่อข้อกำหนดการหมุนเวียนหนึ่งครั้ง (เทิร์นโอเวอร์) (1x) ในผลิตภัณฑ์ Nova88 ทั้งหมด ยกเว้น Cash Out การเดิมพันที่ยกเลิกหรือเป็นโมฆะจะไม่ถูกนับรวมในข้อกำหนดนี้<br><br></li>
                <li>สมาชิกที่เข้าร่วมต้องยอมรับและปฏิบัติตามข้อกำหนดทั้งหมดที่กล่าวถึงข้างต้นรวมถึงกฎและระเบียบที่เกี่ยวข้องทั้งหมดที่ใช้โดย Nova88<br><br></li>
                <li>Nova88 ขอสงวนสิทธิ์ในการแก้ไขหรือถอนโปรโมชั่นได้ตลอดเวลา<br><br></li>
                <li>Nova88 เป็นผู้ชี้ขาด แต่เพียงผู้เดียวของโปรโมชั่นและการตัดสินของ Nova88 ถือเป็นที่สิ้นสุด<br><br></li>
                 <li><a class="text-link" href="https://www.nova88asia.com/SiteSkin/Nova88/Static/@lang/Promotion.html" target="_blank">ข้อกำหนดและเงื่อนไขโปรโมชั่</a>นแบบทั่วไปของ Nova88.<br><br></li>
            </ol>

        </div>
    </div>
</div>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var lang = selLangBLL.GetLangId();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-50PNewDep1.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <h2>新会员50%首存优惠</h2>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">优惠详情</span>
            <ol type="a">
                <li>此优惠仅适用于新会员第一次成功存款.<br><br></li>
                <li>首存金额 x50％=奖金金额.<br><br></li>
            </ol>

            <span class="promotions-title">优惠奖励条件</span>
            <ol type="a">
                <li>优惠金额汇入账号后必须进行一次(1x)的流水投注才能提款.<br><br></li>
            </ol>

            <span class="promotions-title">促销详情如下所示：</span>
            <div class="table table-rwd table-primary">
                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">优惠50% (货币)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">最高奖金 (上限)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">投注倍数</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">MYR</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 200</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">THB</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 1,400</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">IDR</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR 660,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

            </div>
            <br><br>

            <span class="promotions-title">优惠标准规则</span>
            <ol type="1">
                <li>促销适用于所有Nova88会员.<br><br></li>
                <li>此促销活动于2020年7月1日 (星期三) 开始.<br><br></li>
                <li>50%奖金金额将在24小时内汇入玩家的帐户.<br><br></li>
                <li>除非另有说明，否则从此次促销中获得的奖金在汇入的三十（30）天内有效。参加会员在指定的时间内未能达到要求的条件，所有优惠奖金将被撤销.<br><br></li>
                <li>有效投注额仅计算在 Nova88 投注产生输赢结果的注单。即时兑现，注单取消或本金退还，及在同一局游戏中同时投注对等盘口的注单将不计算为有效投注额内.<br><br></li>
                <li>参与优惠会员必须接受并遵守上述所有条款以及Nova88实施的所有相关规则和规定.<br><br></li>
                <li>Nova88有权随时中止或取消本优惠.<br><br></li>
                <li>Nova88保留对本优惠的最终解释权.<br><br></li>
                <li>Nova88<a class="text-link" href="https://www.nova88asia.com/SiteSkin/Nova88/Static/@lang/Promotion.html" target="_blank">标准规则和条款</a>适用。</li>
            </ol>

        </div>
    </div>
</div>
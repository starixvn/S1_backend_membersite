@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-50PNewDep1.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <h2>新會員50%首存優惠</h2>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">優惠詳情</span>
            <ol type="a">
                <li>此優惠僅適用於新會員第一次成功存款.<br><br></li>
                <li>首存金額 x50％=獎金金額.<br><br></li>
            </ol>

            <span class="promotions-title">優惠獎勵條件</span>
            <ol type="a">
                <li>優惠金額匯入賬號後必須進行一次(1x)的流水投注才能提款.<br><br></li>
            </ol>

            <span class="promotions-title">促銷詳情如下所示：</span>
            <div class="table table-rwd table-primary">
                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">優惠 50% (貨幣)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">最高獎金 (上限)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">投注倍數</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">MYR</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 200</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">THB</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 1,400</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">IDR</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR 660,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

            </div>
            <br><br>

            <span class="promotions-title">優惠標準規則</span>
            <ol type="1">
                <li>促銷適用於所有Nova88會員.<br><br></li>
                <li>此促銷活動於2020年7月1日(星期三) 開始.<br><br></li>
                <li>50%獎金金額將在24小時內匯入玩家的帳戶.<br><br></li>
                <li>除非另有說明，否則從此次促銷中獲得的獎金在匯入的三十（30）天內有效。參加會員在指定的時間內未能達到要求的條件，所有優惠獎金將被撤銷.<br><br></li>
                <li>有效投注額僅計算在 Nova88 投注產生輸贏結果的注單。即時兌現，注單取消或本金退還，及在同一局遊戲中同時投注對等盤口的注單將不計算為有效投注額內.<br><br></li>
                <li>參與優惠會員必須接受並遵守上述所有條款以及Nova88實施的所有相關規則和規定.<br><br></li>
                <li>Nova88有權隨時中止或取消本優惠.<br><br></li>
                <li>Nova88保留對本優惠的最終解釋權.<br><br></li>
                <li>Nova88標準規則和條款適用.<br><br></li>
            </ol>

        </div>
    </div>
</div>
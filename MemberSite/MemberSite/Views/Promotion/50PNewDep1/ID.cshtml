@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-50PNewDep1.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <h2>Member baru Bonus Deposit pertama 50%</h2>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">Keterangan Promosi</span>
            <ol type="a">
                <li>Promosi ini berlaku untuk Member baru yang berhasiil melakukan setoran pertama.<br><br></li>
                <li>Jumlah deposit pertama x 50% = Jumlah Bonus<br><br></li>
            </ol>

            <span class="promotions-title">Ketentuan Bermain Bonus</span>
            <ol type="a">
                <li>Jumlah bonus yang diperlukan adalah 1 x Rollover untuk melakukan pernarikan<br><br></li>
            </ol>

            <span class="promotions-title">Informasi promosi seperti diilustrasikan di bawah ini:</span>
            <div class="table table-rwd table-primary">
                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">Bonus 50% (mata uang)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">Maksimum Pembayaran (dibatasi)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">Rollover</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">MYR</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 200</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">THB</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 1,400</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">IDR</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR 660,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

            </div>
            <br><br>

            <span class="promotions-title">Syarat & Ketentuan Promosi</span>
            <ol type="1">
                <li>Promosi berlaku untuk semua Member Nova88.<br><br></li>
                <li>Promosi ini berlaku mulai Tanggal 1 Juli 2020 hingga pemberitahuan lebih lanjut.<br><br></li>
                <li>Bonus 50% akan dikreditkan kepada member secara otomatis dalam waktu 24 jam.<br><br></li>
                <li>Bonus yang diperoleh dari promosi ini berlaku selama tiga puluh (30) hari setelah penerbitan, kecuali dinyatakan lain. Jika Member yang berpartisipasi gagal memenuhi syarat yang diperlukan dalam jangka waktu tertentu, maka semua uang yang
                    dimenangkan dengan menggunakan dana bonus akan dicabut.<br><br></li>
                <li>Hanya taruhan yang ditempatkan pada produk Nova88 yang menghasilkan hasil win-loss yang berkontribusi pada persyaratan turnover satu kali (1x) di semua produk Nova88 kecuali Cash out. Taruhan yang dibatalkan atau dibatalkan tidak akan
                    diperhitungkan dalam persyaratan ini.<br><br></li>
                <li>Member yang berpartisipasi harus menerima dan mematuhi semua persyaratan yang disebutkan di atas serta semua peraturan dan ketentuan terkait yang diterapkan oleh Nova88.<br><br></li>
                <li>Nova88 berhak untuk mengubah atau menarik Promosi setiap saat.<br><br></li>
                <li>Nova88 adalah penyelenggara tunggal Promosi dan keputusannya adalah final.<br><br></li>
                <li>Berlaku syarat dan ketentuan Umum Nova88.<br><br></li>
            </ol>

        </div>
    </div>
</div>
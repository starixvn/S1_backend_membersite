@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Promotion Info</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-promo10friday.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <article>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">快樂星期五 10%</li>
                        <li class="txt-gray">
                            此促銷活動開始於2020年4月10日上午12:00至2020年5月01日下午11:59
                        </li>
                        
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
             <span class="promotions-title">優惠標準規則</span>
                <ol type="1">
                    <li>此優惠活動使用於貨幣為馬幣的客戶</li>
                    <li>此促銷僅在每個星期五有效。</li>
                    <li>符合此促銷獎金條件將根據您每個星期五的首次存款金額計算。</li>
                    <li>每個星期五玩家只能申請一次獎金。</li>
                    <li>每個星期五的首次存款與紅利只需要進行1倍流水投注便可提款
                        <br><br>
                        計算示例:<br>
                        存款    MYR 50 +  獎金 (10%) MYR5 1X 流水投注  =  流水投注 MYR 55<br><br>
                        <div class="table table-rwd table-primary">
                            <div class="thead">
                                <div class="tr">
                                    <div class="td-date">
                                        <span class="text">產品</span>
                                    </div>
                                    <div class="td-date">
                                        <span class="text">最高獎金</span>
                                    </div>
                                </div>
                            </div>
                            <div class="tbody">
                                <div class="tr row-even">
                                    <div class="td-date">
                                        <span class="text">所有 Nova88 除了即時兌現</span>
                                    </div>
                                    <div class="td-date">
                                        <span class="text">MYR500</span>
                                    </div>
                                </div>
                            </div>
            </div>
            <br>
                    </li>
                    <li>最高獎金上限為MYR 500</li>
                    <li>此促銷將無法與150%歡迎紅利同時進行。</li>
                    <li>玩家沒進行過提款將不符合此促銷條件。</li>
                    <li>獎金將在48小時內存入合格的Nova88帳戶。</li>
                </ol>
                <br>
                <p>Nova88 有權隨時中止或取消本優惠。</p>
                <p>Nova88 保留對本優惠的最終解釋權。</p>
                <p>Nova88 標準規則和條款適用。</p>
                <br>
            <div class="panel panel-primary panel--payment" data-open="true">
                <div class="panel__header">
                    <span class="txt-blue">3簡單的步驟</span>
                    <i class="icon icon-caret"></i>
                </div>
                <div class="panel__body">
                    <p>步驟1：在Nova88進行存款</p>
                    <p>步驟2：聯繫Nova88在線客服</p>
                    <p>步驟3：出示存款收據索取紅利</p>
                </div>
            </div>
        </div>
    </div>
</div>

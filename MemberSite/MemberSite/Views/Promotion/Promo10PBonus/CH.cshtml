@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-promo10p.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>


            <div class="promotions-module">
                <article>
                    <div class="promotions-txt">
                        <ul>
                            <li class="txt-blue">無限充值 X 10%，優惠高達 MYR500！</li>
                            
                            
                        </ul>
                    </div>
                </article>
            </div>
                <div class="promotions-module">
                    <span class="promotions-title">優惠詳情</span>
                    <ol type="1">
                        <li>會員進行最低存款額就可享受此優惠促銷.<br><br></li>
                        <li>在歐亞主頁[收銀], 後按 [充值].<br><br></li>
                        <li>選擇符合您的[充值]方式，成功存款款額將存入您的[體育錢包]<br><br></li>
                        <li>完成存款後，優惠獎金將在24小時內直接匯入您的賬號錢包.<br><br></li>
                    </ol>

                    <span class="promotions-title">優惠獎勵條件</span>
                    <p>會員(存款數額 + 優惠獎金1x) 需要進行1倍流水投注便可提款.</p>
                    <p>
                        促銷詳情如下所示：
                    </p>
                    <div class="table table-rwd table-primary">
                        <div class="thead">
                            <div class="tr">
                                <div class="td-time">
                                    <span class="text">遊戲平台</span>
                                </div>
                                <div class="td-time">
                                    <span class="text">優惠%</span>
                                </div>
                                <div class="td-time">
                                    <span class="text">最高獎金 (上限)</span>
                                </div>
                                <div class="td-time">
                                    <span class="text">流水投注</span>
                                </div>
                            </div>
                        </div>
                        <div class="tbody">
                            <div class="tr row-even">
                                <div class="td-time">
                                    <span class="text">Nova88.net</span>
                                </div>
                                <div class="td-time">
                                    <span class="text">10%</span>
                                </div>
                                <div class="td-time">
                                    <span class="text">MYR 500</span>
                                </div>
                                <div class="td-time">
                                    <span class="text">1x</span>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                    <br>
                    <span class="promotions-title">優惠標準規則</span>
                    
                        <ol type="1">
                            <li>此促銷僅在每個星期三有效.<br><br></li>
                            <li>此促銷將會員在星期三優惠期間的總存款額進行計算.<br><br></li>
                            <li>此促銷活動結束於2020年5月31日 11:59:59PM (GMT+8)<br><br></li>
                            <li>促銷僅適用於所有Nova88會員.<br><br></li>
                            <li>除非另有說明，否則從此次促銷中獲得的獎金在匯入的三十（30）天內有效。參加會員在指定的時間內未能達到要求的條件，所有優惠獎金將被撤銷.<br><br></li>
                            <li>有效投注額僅計算在 Nova88 投注產生輸贏結果的注單，以進行1倍流水投資計算。注單取消或本金退還的注單將不計算為有效投注額內.<br><br></li>
                            <li>參與優惠會員必須接受並遵守上述所有條款以及Nova88實施的所有相關規則和規定。<br><br></li>
                            <li>Nova88有權隨時中止或取消本優惠.<br><br></li>
                            <li>Nova88保留對本優惠的最終解釋權.<br><br></li>
                            <li>Nova88標準規則和條款適用.<br><br></li>
                        </ol>  
            </div>

    </div>
</div>

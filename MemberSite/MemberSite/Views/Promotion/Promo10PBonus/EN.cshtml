@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-promo10p.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>


            <div class="promotions-module">
                <article>
                    <div class="promotions-txt">
                        <ul>
                            <li class="txt-blue">Unlimited X 10% Reload up to MYR500</li>
                            
                            
                        </ul>
                    </div>
                </article>
            </div>
                <div class="promotions-module">
                    <span class="promotions-title">Promotion Details</span>
                    <ol type="1">
                        <li>Promotion applied when members made a minimum deposit amount.<br><br></li>
                        <li>In [Cashier] page, click [Deposit].<br><br></li>
                        <li>Select [Deposit type] to make a deposit, after successful deposit into the [Sportsbook wallet]<br><br></li>
                        <li>Bonus will be credited to account wallet within 24 hours upon successful deposit.<br><br></li>
                    </ol>

                    <span class="promotions-title">Bonus Play Conditions</span>
                    <p>Members are required to one time (1x) turnover (Deposit + Bonus 1x) before make a withdrawal.</p>
                    <p>
                        Promotion particulars are as illustrated below:
                    </p>
                    <div class="table table-rwd table-primary">
                        <div class="thead">
                            <div class="tr">
                                <div class="td-time">
                                    <span class="text">Provider</span>
                                </div>
                                <div class="td-time">
                                    <span class="text">Bonus %</span>
                                </div>
                                <div class="td-time">
                                    <span class="text">Max Payout (capped)</span>
                                </div>
                                <div class="td-time">
                                    <span class="text">Turnover</span>
                                </div>
                            </div>
                        </div>
                        <div class="tbody">
                            <div class="tr row-even">
                                <div class="td-time">
                                    <span class="text">Nova88.net</span>
                                </div>
                                <div class="td-time">
                                    <span class="text">10%</span>
                                </div>
                                <div class="td-time">
                                    <span class="text">MYR 500</span>
                                </div>
                                <div class="td-time">
                                    <span class="text">1x</span>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                    <br>
                    <span class="promotions-title">Promotion Terms & Conditions</span>
                    
                        <ol type="1">
                            <li>This promotion available on Wednesday only.<br><br></li>
                            <li>Promotion is accumulate total of Wednesday redeposit within the promotion period.<br><br></li>
                            <li>This Promotion end 31st May 2020 11:59:59PM (GMT+8)<br><br></li>
                            <li>Promotion only applies to all Nova88 members.<br><br></li>
                            <li>Bonus acquired from this promotion is valid for thirty (30) days upon issuance, unless stated otherwise. Shall the participating member fail to fulfill required prerequisites 
                            within given time frame, all money won using bonus funds will be revoked.<br><br></li>
                            <li>Only wagers placed on Nova88 products that generate a win/loss outcome will contribute to the one time (1x) turnover requirement. Cancelled or voided wagers 
                            will not count toward this requirement.<br><br></li>
                            <li>Participating members must accept and comply with all the terms mentioned above as well as all relevant rules and regulations implemented by Nova88.<br><br></li>
                            <li>Nova88 reserves the right to amend or withdraw the Promotion at any time.<br><br></li>
                            <li>Nova88 is the sole arbiter of the Promotion and its decision is final.<br><br></li>
                            <li>Nova88 Terms & Conditions apply.<br><br></li>
                        </ol>
        </div>

    </div>
</div>

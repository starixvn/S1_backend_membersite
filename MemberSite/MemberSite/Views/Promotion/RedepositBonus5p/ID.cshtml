@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var lang = selLangBLL.GetLangId();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Promosi</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-RedepositBonus5p.jpg" alt="" style="display: block;width: 100%;" />
        </div>
        <div class="promotions-module">
            <h2>Redeposit Harian 5% hingga Rp 1,800,000</h2>

        </div>
        <div class="promotions-module">
            <span class="promotions-title">Keterangan Promosi</span>
            <ol type="a">
                <li>Promosi berlaku ketika Member melakukan jumlah setoran minimum.<br><br></li>
                <li>Bonus akan dikreditkan ke dompet akun Nova88 dalam waktu 24 jam setelah setoran anda berhasil.<br><br></li>
            </ol>
            <span class="promotions-title">Ketentuan Bonus :</span>
            <ol type="a" start="3">
                <li>Anggota diharuskan memainkan sekali rollover (1x) untuk bonus setelah dikreditkan kedalam akun anggota, sebelum melakukan penarikan.<br><br></li>
            </ol>

            <span class="promotions-title">Informasi promosi seperti diilustrasikan di bawah ini:</span>
            <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                <tr>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        Bonus 10% (mata uang)
                    </th>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        Maksimum Pembayaran (dibatasi)
                    </th>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        Rollover
                    </th>
                </tr>
                
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">MYR</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">MYR 500</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">1x</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">THB</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">THB 3,800</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">1x</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">IDR</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">IDR 1,800,000</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">1x</td>
                </tr>
                
            </table>
           <br>
<br>
            <span class="promotions-title">Syarat & Ketentuan Promosi</span>
            <ol type="1">
                <li>Promosi ini tersedia setiap hari.<br><br></li>
                <li>Promosi berlaku untuk semua anggota Nova88. <br><br></li>
                <li>Promosi ini berlaku mulai 19 Agustus 2020 (Rabu)<br><br></li>
                <li>Promosi adalah akumulasi total redeposit tidak terbatas pada hari itu.<br><br></li>
                <li>Bonus yang diperoleh dari promosi ini berlaku selama tiga puluh (30) hari setelah penerbitan, kecuali dinyatakan lain. Jika member yang berpartisipasi gagal memenuhi syarat yang diperlukan dalam jangka waktu tertentu, semua uang yang dimenangkan dengan menggunakan dana bonus akan dicabut.<br><br></li>
                <li>Member yang ikut berpartisipasi harus menerima dan mematuhi semua persyaratan yang disebutkan di atas serta semua peraturan dan ketentuan terkait yang diterapkan oleh Nova88.<br><br></li>
                <li>Nova88 berhak untuk mengubah atau menarik Promosi kapan saja.<br><br></li>
                <li>Nova88 adalah penyelenggara tunggal Promosi dan keputusannya adalah final.<br><br></li>
                <li><a class="text-link" href="https://www.nova88asia.com/SiteSkin/Nova88/Static/@lang/Promotion.html" target="_blank">Berlaku syarat dan ketentuan Umum</a> Nova88.<br><br></li>
            </ol>

        </div>
    </div>
</div>
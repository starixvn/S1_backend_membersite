@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var lang = selLangBLL.GetLangId();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">โปรโมชั่น</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-RedepositBonus5p.jpg" alt="" style="display: block;width: 100%;" />
        </div>
        <div class="promotions-module">
            <h2>ฝากเงินเพิ่มประจำวัน รับโบนัส 5% สูงสุดถึง 3,800 บาท</h2>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">รายละเอียดโปรโมชั่น</span>
            <ol type="a">
                <li>โปรโมชั่นจะใช้ได้เมื่อสมาชิกทำการฝากขั้นต่ำตามที่กำหนดไว้<br><br></li>
                <li>โบนัสจะถูกโอนเข้าบัญชีกระเป๋าเงินภายใน 24 ชั่วโมงเมื่อทำการฝากเงินสำเร็จ.<br><br></li>
            </ol>
            <span class="promotions-title">เงื่อนไขการเล่นโบนัส</span>
            <ol type="a" start="3">
                <li>สมาชิกต้องเล่นอย่างน้อย 1 ครั้ง (โรลโอเวอร์ 1 ครั้ง (1x)) เพื่อที่จะได้ส่วนลด หลังจากการเพิ่มเครดิตให้สมาชิก ก่อนที่จะทำการถอน<br><br></li>
            </ol>

            <span class="promotions-title">รายการละเอียดโบนัสมีดังต่อไปนี้:</span>
            <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                <tr>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        โบนัส 5% ( ตามสกุลเงิน )
                    </th>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        การจ่ายเงินสูงสุด (ต่อยอด)
                    </th>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        โรลโอเวอร์
                    </th>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">MYR</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">MYR 500</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">1x</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">ไทยบาท</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">3,800 บาท</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">1x</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">IDR</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">IDR 1,800,000</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">1x</td>
                </tr>
            </table>
            <br>
            <br>
            <span class="promotions-title">ข้อกำหนดและเงื่อนไข</span>
            <ol type="1">
                <li>โปรโมชั่นนี้ให้บริการทุกวัน<br><br></li>
                <li>โปรโมชั่นนี้สำหรับสมาชิก Nova88 ทุกคน<br><br></li>
                <li>โปรโมชั่นนี้จะเริ่มวันที่ 19 สิงหาคม 2020 (วันพุธ) เป็นต้นไป<br><br></li>
                <li>โปรโมชั่นนี้สามารถสะสมได้ตลอดไม่จำกัดการฝากในหนึ่งวัน<br><br></li>
                <li>โบนัสที่ได้รับจากโปรโมชั่นนี้สามารถใช้ได้เป็นเวลาสามสิบ (30) วันเมื่อมีการออกโบนัส เว้นแต่จะระบุไว้เป็นอย่างอื่น สมาชิกที่เข้าร่วมจะต้องปฏิบัติตามข้อกำหนดเบื้องต้นภายในระยะเวลาที่กำหนด มิเช่นนั้นเงินทั้งหมดที่ได้รับจากการใช้เงินโบนัสจะถูกเพิกถอน<br><br></li>
                <li>สมาชิกที่เข้าร่วมต้องยอมรับและปฏิบัติตามข้อกำหนดทั้งหมดที่กล่าวถึงข้างต้นรวมถึงกฎและระเบียบที่เกี่ยวข้องทั้งหมดที่ใช้โดย Nova88<br><br></li>
                <li>Nova88 ขอสงวนสิทธิ์ในการแก้ไขหรือถอนโปรโมชั่นได้ตลอดเวลา<br><br></li>
                <li>Nova88 เป็นผู้ชี้ขาด แต่เพียงผู้เดียวของโปรโมชั่นและการตัดสินของ Nova88 ถือเป็นที่สิ้นสุด<br><br></li>
                <li><a class="text-link" href="https://www.nova88asia.com/SiteSkin/Nova88/Static/@lang/Promotion.html" target="_blank">ข้อกำหนดและเงื่อนไข</a>ของ Nova88<br><br></li>
            </ol>
        </div>
    </div>
</div>
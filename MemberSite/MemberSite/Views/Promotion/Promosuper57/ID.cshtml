@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-super57.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <article>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">SUPER JUMAT & MINGGU Redeposit Bonus Hingga pada IDR 1,000,000 (5%)</li>
                        
                        
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
             <span class="promotions-title">Keterangan promosi</span>
                <ol type="a">
                    <li>Promosi berlaku ketika Member melakukan jumlah setoran minimum.<br><br></li>
                    <li>Bonus akan dikreditkan ke dompet akun Nova88 dalam waktu 24 jam setelah setoran anda berhasil.<br><br></li>
                </ol>

            <span class="promotions-title">Ketentuan Bermain Bonus</span>
               <p>
                Member diharuskan untuk melakukan sekali turnover (1x) (Setoran + Bonus 1x) sebelum melakukan penarikan.
               </p>
               <p>
                Informasi promosi seperti diilustrasikan di bawah ini:<br>
                <div class="table table-rwd table-primary">
                    <div class="thead">
                        <div class="tr">
                            <div class="td-date">
                                <span class="text">Bonus %</span>
                            </div>
                            <div class="td-date">
                                <span class="text">Maksimum Pembayaran</span>
                            </div>
                            <div class="td-date">
                                <span class="text">Turnover</span>
                            </div>
                        </div>
                    </div>
                    <div class="tbody">
                        <div class="tr row-even">
                            <div class="td-date">
                                <span class="text">5%</span>
                            </div>
                            <div class="td-date">
                                <span class="text">IDR 1,000,000</span>
                            </div>
                            <div class="td-date">
                                <span class="text">1x</span>
                            </div>
                        </div>
                    </div>
                </div>
               </p>

            <span class="promotions-title">Syarat & Ketentuan Promosi</span>
            <ol type="1">
                <li>Promosi ini hanya berlaku pada setiap hari Jumat & Minggu.<br><br></li>
                <li>Promosi ini dimulai pada Tanggal 8 Mei 2020 Hari Jumat  & 10 Mei 2020 Hari Minggu<br><br></li>
                <li>Promosi adalah akumulasi total Re- deposit tidak terbatas pada hari promosi (Jumat & Minggu)<br><br></li>
                <li>Promosi berlaku untuk semua anggota Nova88.<br><br></li>
                <li>Bonus yang diperoleh dari promosi ini berlaku selama tiga puluh (30) hari setelah penerbitan, kecuali dinyatakan lain. Jika member yang berpartisipasi
                gagal memenuhi syarat yang diperlukan dalam jangka waktu tertentu, semua uang yang dimenangkan dengan menggunakan dana bonus akan dicabut.<br><br></li>
                <li>Hanya taruhan yang ditempatkan pada produk Nova88 yang menghasilkan hasil win-loss yang berkontribusi pada persyaratan turnover satu kali (1x) di semua 
                produk Nova88 kecuali uang tunai. Taruhan yang dibatalkan atau dibatalkan tidak akan diperhitungkan dalam persyaratan ini.<br><br></li>
                <li>Member yang ikut berpartisipasi harus menerima dan mematuhi semua persyaratan yang disebutkan di atas serta semua peraturan dan ketentuan terkait yang diterapkan oleh Nova88.<br><br></li>
                <li>Nova88 berhak untuk mengubah atau menarik Promosi kapan saja.<br><br></li>
                <li>Nova88 adalah penyelenggara tunggal Promosi dan keputusannya adalah final.<br><br></li>
                <li>Berlaku syarat dan ketentuan Umum  Nova88.<br><br></li>
            </ol>
                
            
        </div>
    </div>
</div>
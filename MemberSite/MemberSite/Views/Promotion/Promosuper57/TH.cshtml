@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-super57.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <article>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">Super Friday & Sunday redeposit รับโบนัสมากถึง 2,500 บาท (5%)</li>
                        
                        
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
             <span class="promotions-title">รายละเอียดโปรโมชั่น</span>
                <ol type="a">
                    <li>สมาชิกต้องฝากเงินขั้นต่ำตามที่กำหนดไว้<br><br></li>
                    <li>โบนัสจะถูกโอนเข้าบัญชีวอลเล็ทภายใน 24 ชั่วโมงหลังจากฝากเงินเสร็จเรียบร้อยแล้ว<br><br></li>
                </ol>

            <span class="promotions-title">เงื่อนไขการเล่น</span>
               <p>
                สมาชิกจะต้องมีการเทิร์นโอเวอร์หนึ่งครั้ง (1x) (ฝาก + โบนัส 1x) ก่อนทำการถอน
               </p>
               <p>
                รายละเอียดมีดังต่อไปนี้:<br>
                <div class="table table-rwd table-primary">
                    <div class="thead">
                        <div class="tr">
                            <div class="td-date">
                                <span class="text">โบนัส %</span>
                            </div>
                            <div class="td-date">
                                <span class="text">การจ่ายเงินสูงสุด (ต่อยอด)</span>
                            </div>
                            <div class="td-date">
                                <span class="text">เทิร์นโอเวอร์</span>
                            </div>
                        </div>
                    </div>
                    <div class="tbody">
                        <div class="tr row-even">
                            <div class="td-date">
                                <span class="text">5%</span>
                            </div>
                            <div class="td-date">
                                <span class="text">THB 2,500</span>
                            </div>
                            <div class="td-date">
                                <span class="text">1x</span>
                            </div>
                        </div>
                    </div>
                </div>
               </p>

            <span class="promotions-title">ข้อกำหนดและเงื่อนไข</span>
            <ol type="1">
                <li>โปรโมชั่นนี้ใช้ได้กับสกุลเงิน มาเลเซียริงกิต, ไทยบาท, และ รูเปียห์อินโดนีเซียเท่านั้น.<br><br></li>
                <li>โปรโมชั่นนี้มีทุกวันศุกร์และวันอาทิตย์เท่านั้น<br><br></li>
                <li>โปรโมชั่นนี้เริ่มตั้งแต่ 8 พฤษภาคม 2563 (วันศุกร์) และ 10 พฤษภาคม 2563 (วันอาทิตย์)<br><br></li>
                <li>โปรโมชั่นสะสมยอดรวม "โบนัสฝากเงินซ้ำ" อย่างไม่จำกัดในวันที่มีโปรโมชั่น (วันศุกร์และวันอาทิตย์)<br><br></li>
                <li>โปรโมชั่นนี้สำหรับสมาชิก Nova88 ทุกคน<br><br></li>
                <li>โบนัสที่สมาชิกได้รับจากโปรโมชั่นนี้สามารถใช้ได้เป็นเวลาสามสิบ (30) วันหลังจากออกให้ เว้นแต่จะระบุไว้เป็นอย่างอื่น สมาชิกจะต้องปฏิบัติตามข้อกำหนดเบื้องต้นภายในระยะเวลาที่กำหนด มิฉะนั้นเงินทั้งหมดที่ได้รับจากการใช้เงินโบนัสจะถูกตัดสิทธิ์<br><br></li>
                <li>การวางเดิมพันเฉพาะผลิตภัณฑ์ Nova88 ที่สร้างผลการชนะ / แพ้จะมีผลต่อข้อกำหนดการเทิร์นโอเวอร์ (1x) ในผลิตภัณฑ์ Nova88 ทั้งหมดยกเว้น Cash out การเดิมพันที่ยกเลิกหรือเป็นโมฆะจะไม่ถูกนับรวมในข้อกำหนดนี้<br><br></li>
                <li>สมาชิกที่เข้าร่วมต้องยอมรับและปฏิบัติตามข้อกำหนดทั้งหมดที่กล่าวถึงข้างต้นรวมถึงกฎและระเบียบที่เกี่ยวข้องทั้งหมดที่ใช้โดย  Nova88<br><br></li>
                <li>Nova88 ขอสงวนสิทธิ์ในการแก้ไขหรือถอนโปรโมชั่นได้ตลอดเวลา<br><br></li>
                <li>Nova88 เป็นผู้ชี้ขาด แต่เพียงผู้เดียวของโปรโมชั่นและการตัดสินของถือเป็นที่สิ้นสุด<br><br></li>
                <li>ข้อกำหนดและเงื่อนไขของ Nova88<br><br></li>
            </ol>
                
            
        </div>
    </div>
</div>
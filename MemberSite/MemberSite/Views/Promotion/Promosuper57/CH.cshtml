@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-super57.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <article>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">超級星期五 & 星期天 再存紅利高達 MYR300 (5%)</li>
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
             <span class="promotions-title">優惠詳情</span>
                <ol type="a">
                    <li>會員進行最低存款額就可享受此優惠促銷.<br><br></li>
                    <li>完成存款後，優惠獎金將在24小時內直接匯入您的賬號錢包.<br><br></li>

                </ol>

            <span class="promotions-title">優惠獎勵條件</span>
               <p>
                會員(存款數額 + 優惠獎金1x) 需要進行1倍流水投注便可提款.
               </p>
               <p>
                促銷詳情如下所示：<br>
                <div class="table table-rwd table-primary">
                    <div class="thead">
                        <div class="tr">
                            <div class="td-date">
                                <span class="text">優惠%</span>
                            </div>
                            <div class="td-date">
                                <span class="text">最高獎金 (上限)</span>
                            </div>
                            <div class="td-date">
                                <span class="text">流水投注</span>
                            </div>
                        </div>
                    </div>
                    <div class="tbody">
                        <div class="tr row-even">
                            <div class="td-date">
                                <span class="text">5%</span>
                            </div>
                            <div class="td-date">
                                <span class="text">MYR 300</span>
                            </div>
                            <div class="td-date">
                                <span class="text">1x</span>
                            </div>
                        </div>
                    </div>
                </div>
               </p>

            <span class="promotions-title">優惠標準規則</span>
            <ol type="1">
                <li>此促銷優惠僅適用於MYR，THB到IDR貨幣<br><Br></li>
                <li>此促銷僅在每個星期五與星期天有效.<br><br></li>
                <li>此促銷活動於2020年5月8日 (星期五) 及 2020年5月10日 (星期天) 開始.<br><br></li>
                <li>此促銷將會員在優惠期間的無限再存款額進行計算. (星期五與星期天)<br><br></li>
                <li>促銷僅適用於所有Nova88會員.<br><br></li>                
                <li>除非另有說明，否則從此次促銷中獲得的獎金在匯入的三十（30）天內有效。參加會員在指定的時間內未能達到要求的條件，所有優惠獎金將被撤銷.<br><br></li>
                <li>有效投注額僅計算在 Nova88 投注產生輸贏結果的注單，以進行1倍流水投資計算。注單取消或本金退還的注單將不計算為有效投注額內.<br><br></li>
                <li>參與優惠會員必須接受並遵守上述所有條款以及Nova88實施的所有相關規則和規定.<br><br></li>
                <li>Nova88有權隨時中止或取消本優惠.<br><br></li>
                <li>Nova88保留對本優惠的最終解釋權.<br><br></li>
                <li>Nova88標準規則和條款適用.<br><br></li>                
            </ol>
                
            
        </div>
    </div>
</div>
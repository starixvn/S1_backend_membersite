@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject PromotionBLL promotionBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var StaticRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Static/{selLangBLL.GetLangId()}");
    int CurrencyId = 0;
    long ExpiryTime = 0;
    Promotion promotion = null;

    if (User.Identity.IsAuthenticated)
    {
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;

        promotion = promotionBLL.GetPromotionListByCustId(custId).FirstOrDefault();
    }
    else
    {
        CurrencyId = selLangBLL.GetPreferCurrencyId();
        promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
    }

    if (promotion.BonusInfoStatus == 0)
    {
        ExpiryTime = promotion.PeriodTo;
    }
    else
    {
        ExpiryTime = new DateTimeOffset(promotion.ExpiryTime.ToUniversalTime(), TimeSpan.Zero).ToUnixTimeSeconds();
    }
    var Currency = selLangBLL.GetResourceValue($"lbl_Currency_{CurrencyId}");
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Thông Tin Khuyến Mãi</span>
        </div>
        <div class="promotions-module">
            <article>
                <div class="promotions-banner" style="background-image: url('@Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Promotion/{promotion.BonusCode}/{selLangBLL.GetLangId()}.png?v=20200306")'); background-position: center top; background-size: cover;"></div>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">@promotion.Title</li>
                        <li class="txt-gray">
                            @serverInfo.SiteName tặng thưởng cho khách hàng trong lần nạp đầu tiên lên tới @promotion.MaxBonus.ToString("#,##0") @Currency! Hãy tham gia NGAY!
                        </li>
                        <li>
                            <div class="promotions-type">
                                <ul class="txt-gray">
                                    <li>
                                        <i class="icon icon-transaction"></i>BONUS
                                        <span class="txt-org">@Currency @promotion.Bonus.ToString("#,##0")%</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-gototop"></i>MAX BONUS AMOUNT
                                        <span class="txt-org">@Currency @promotion.MaxBonus.ToString("#,##0")</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-sport252"></i>ROLLOVER
                                        <span class="txt-org">@(promotion.RollOver)x</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-race"></i>REMAINING TIME
                                        <span class="txt-org" id="REMAINING"></span>
                                    </li>
                                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                                    {
                                        <li>
                                            <div class="btn-group">
                                                <button class="btn btn-secondary" id="JOIN">
                                                    <div class="btn__inner">
                                                        <span class="text">@selLangBLL.GetResourceValue("lbl_JoinNow")</span>
                                                    </div>
                                                </button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">Significant Conditions</span>
            <article>
                <ol type="i">
                    <li>Chương trình khuyến mãi chỉ áp dụng cho khách hàng Việt Nam</li>
                    <li>Thời gian khuyến mãi bắt đầu từ ngày <span id="ExpiryTime"></span></li>
                    <li>Để thỏa điều kiện nhận thưởng, người chơi phải thực hiện việc nạp tiền lần đầu trong thời gian diễn ra khuyến mãi và trước đó chưa thực hiện việc rút tiền.</li>
                    <li>Tặng thưởng lên tới @promotion.MaxBonus.ToString("#,##0") @Currency dựa trên số tiền nạp cho những khách hàng thỏa điều kiện, tiền thưởng sẽ được chuyển vào tài khoản trong vòng 48 tiếng;</li>
                    <li>Người chơi có thể rút tiền nạp vào và tiền thưởng sau khi đã hoàn tất yêu cầu doanh thu cược @promotion.RollOver lần trong vòng 30 ngày đối với bất kỳ sản phẩm cá cược của @serverInfo.SiteName ngoại trừ Casino and sản phẩm Cash Out .</li>
                </ol>
            </article>
            <div class="panel panel-primary panel--payment" data-open="true">
                <div class="panel__header">
                    <span class="txt-blue">Chi tiết điều khoản và điều kiện để nhận thưởng</span>
                    <i class="icon icon-caret"></i>
                </div>
                <div class="panel__body">
                    <article>
                        <ol type="i">
                            <li>
                                Để đủ điều kiện nhận thưởng, người chơi phải đáp ứng tất cả các tiêu chí dưới đây:
                            </li>
                            <ol>
                                <li>Sử dụng tiền @Currency như là tiền tệ giao dịch chính thức</li>
                                <li>
                                    Người chơi thực hiện thành công việc nạp tiền vào tài khoản tại trang @serverInfo.SiteName, trong thời gian diễn ra khuyến mãi.
                                </li>
                            </ol>
                            <li>
                                Người chơi thỏa điều kiện sẽ được nhận thưởng  @promotion.Bonus.ToString("#,##0")%, lên tới  @Currency @promotion.MaxBonus.ToString("#,##0") dựa trên số tiền của lần nạp đầu tiên, được thực hiện trong thời gian diễn ra khuyến mãi, như ví dụ sau đây:
                                <div class="table table-rwd table-primary">
                                    <div class="thead">
                                        <div class="tr">
                                            <div class="td-date">
                                                <span class="text">Tiền Thưởng</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">Sản Phẩm</span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">Tiền Thưởng Tối Đa (@Currency)</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">Yêu Cầu Doanh Thu Cược</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tbody">
                                        <div class="tr row-even">
                                            <div class="td-date">
                                                <span class="text">@promotion.Bonus.ToString("#,##0")%</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">Tất các các sản phẩm cá cược của @serverInfo.SiteName ngoại trừ Casino và Cash Out.</span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">@promotion.MaxBonus.ToString("#,##0")</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">@(promotion.RollOver)x</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li>
                                Người chơi thỏa điều kiện sẽ được yêu cầu bấm vào nút "Tham gia ngay" trong mục "Điều khoản và Điều kiện nhận thưởng" để nhận thưởng, ngay sau khi họ đăng nhập vào tài khoản cá cược tại trang at www.@(serverInfo.SiteName).com.
                            </li>
                            <li>
                                Người chơi thỏa điều kiện không được phép bỏ giải thưởng một khi tiền thưởng đã được chuyển vào tài khoản cá cược của họ tại trang @serverInfo.SiteName.
                            </li>
                            <li>
                                Người chơi thỏa điều kiện có thể rút tiền nạp vào và tiền thưởng sau khi đã hoàn tất yêu cầu doanh thu cược @promotion.RollOver lần đối với bất kỳ sản phẩm cá cược nào của @serverInfo.SiteName ngoại trừ Casino and Cash Out. Quy định về rút tiền sẽ được áp dụng cho tất cả các khoản tiền nạp khác không dùng cho khuyến mãi.
                            </li>
                            <li>
                                Người chơi đủ điều kiện chỉ được phép tham gia một (1) chương trình khuyến mãi 'Thưởng Lần Đầu Nạp' do @serverInfo.SiteName cung cấp. Nếu Người chơi đủ điều kiện tham gia nhiều hơn một (1), thì người chơi chỉ nhận được tiền thưởng mà @serverInfo.SiteName duyệt đầu tiên và việc tham gia vào các chương trình khuyến mãi liên quan đến 'Thưởng Lần Đầu Nạp' khác sẽ không có hiệu lực.
                            </li>
                            <li>
                                Người chơi đủ điều kiện vẫn sẽ bị loại khỏi Chương trình khuyến mãi, nếu có bất kỳ khoản rút tiền nào được thực hiện trước khi Tiền thưởng được chuyển vào tài khoản của họ tại trang @serverInfo.SiteName.
                            </li>
                            <li>
                                Chỉ những cược có thắng/thua trong @serverInfo.SiteName mới được cộng dồn vào Yêu cầu doanh thu cược. Rút tiền, hủy hoặc bỏ cược, cược với tỷ lệ cược nhỏ hơn 1,5 (Odds thập phân); 0,5 (Odds Trung Quốc); 0,5 (Odds dương Malay); -2.0 (Odds Indo); -200 (Odds Mỹ) hoặc cược cả hai cửa trong một trò chơi và cược trên Casino sẽ không được tính vào tổng cược này.
                            </li>
                            <li>
                                Yêu cầu doanh thu cược sẽ được xem là đủ điều kiện, nếu số dư tài khoản Người chơi đủ điều kiện thấp hơn số tiền cược tối thiểu được phép (ví dụ: 25,000 Việt Nam Đồng)
                            </li>
                            <li>@serverInfo.SiteName có quyền sửa đổi hoặc kết thúc Khuyến mãi bất cứ lúc nào. </li>
                            <li>Chương trình khuyến mãi đang được cung cấp và tiến hành bởi @serverInfo.SiteName có hiệu lực chỉ ở những nơi mà pháp luật địa phương hoặc quốc gia cho phép, và nơi mà mọi người có thể đủ điều kiện hợp pháp để tham gia theo quy định của pháp luật hiện hành. Người chơi thừa nhận rằng @serverInfo.SiteName hoạt động từ một vùng tài phán mà công ty được cấp phép, được điều chỉnh và được pháp luật cho phép tiến hành các chương trình khuyến mãi như vậy và @serverInfo.SiteName thực hiện các nỗ lực hợp lý để không cung cấp chương trình khuyến mãi như vậy ở những vùng tài phán bị cấm hoặc cung cấp cho Người chơi ở tại, hoặc từ các vùng tài phán bị cấm. Người chơi hoàn toàn chịu trách nhiệm đảm bảo tuân thủ pháp luật địa phương hoặc quốc gia trước khi tham gia vào các chương trình khuyến mãi của @serverInfo.SiteName. Ngoài ra, bằng việc tham gia vào các chương trình khuyến mãi như vậy, Người chơi cũng đảm bảo rằng mình đã tìm kiếm tư vấn pháp lý và/hoặc đủ quen thuộc với luật pháp hiện hành để xác minh rằng việc tham gia không trái với luật pháp đó.</li>
                            <li>@serverInfo.SiteName <a class="text-link" href="@StaticRootPath/Promotion.html" target="_blank">Điều Khoản Và Điều Kiện Tiêu Chuẩn</a> apply.</li>
                        </ol>
                    </article>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(function() {
            const diff = moment.duration(moment.unix(@promotion.PeriodTo).diff(new Date()))
            $("#REMAINING").html(diff.days() + " days" + diff.hours() + " hours" );
            $("#ExpiryTime").html(moment.unix(@ExpiryTime).format('lll'));

            $("#JOIN").on("touchstart, click", function () {
                  if (confirm("@Html.Raw(selLangBLL.GetResourceValue("lbl_BonusConfirm"))")) {
                    axios.post('/api/Promotion/SetClaimPromotion/@selLangBLL.GetLangId()', { BonusCode:"@promotion.BonusCode"})
                        .then(function (response) {
                            var result = response.data;
                            if (result.errorCode == 0) {
                                alert("@Html.Raw(selLangBLL.GetMsg("msg_Updatesuccessful"))");
                                window.location.replace("@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })");
                            } else {
                                alert(result.message);
                            }
                        }.bind(this)).catch(function (error) {
                            alert(error);
                        }.bind(this));
                }
            });
        });
    </script>
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject PromotionBLL promotionBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var StaticRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Static/{selLangBLL.GetLangId()}");
    int CurrencyId = 0;
    long ExpiryTime = 0;
    Promotion promotion = null;

    if (User.Identity.IsAuthenticated)
    {
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;

        promotion = promotionBLL.GetPromotionListByCustId(custId).FirstOrDefault();
    }
    else
    {
        CurrencyId = selLangBLL.GetPreferCurrencyId();
        promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
    }

    if (promotion.BonusInfoStatus == 0)
    {
        ExpiryTime = promotion.PeriodTo;
    }
    else
    {
        ExpiryTime = new DateTimeOffset(promotion.ExpiryTime.ToUniversalTime(), TimeSpan.Zero).ToUnixTimeSeconds();
    }
    var Currency = selLangBLL.GetResourceValue($"lbl_Currency_{CurrencyId}");
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Thông Tin Khuyến Mãi</span>
        </div>
        <div class="promotions-module">
            <article>
                <div class="promotions-banner" style="background-image: url('@Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Promotion/{promotion.BonusCode}/{selLangBLL.GetLangId()}.png")'); background-position: center top; background-size: cover;"></div>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">Tặng thưởng 125% lên tới 2.000.000 VND cho khách hàng mới</li>
                        <li class="txt-gray">
                            Bwing tặng thưởng cho khách hàng trong lần nạp đầu tiên lên tới 2.000.000 VND! Hãy tham gia NGAY!
                        </li>
                        <li>
                            <div class="promotions-type">
                                <ul class="txt-gray">
                                    <li>
                                        <i class="icon icon-transaction"></i>BONUS
                                        <span class="txt-org">@Currency @promotion.Bonus.ToString("#,##0")%</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-gototop"></i>MAX BONUS AMOUNT
                                        <span class="txt-org">@Currency @promotion.MaxBonus.ToString("#,##0")</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-sport252"></i>ROLLOVER
                                        <span class="txt-org">@(promotion.RollOver)x</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-race"></i>REMAINING TIME
                                        <span class="txt-org" id="REMAINING"></span>
                                    </li>
                                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                                    {
                                        <li>
                                            <div class="btn-group">
                                                <button class="btn btn-secondary" id="JOIN">
                                                    <div class="btn__inner">
                                                        <span class="text">@selLangBLL.GetResourceValue("lbl_JoinNow")</span>
                                                    </div>
                                                </button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">Significant Conditions</span>
           
            <div class="panel panel-primary panel--payment" data-open="true">
                <div class="panel__body">
                        <p><strong>Tặng thưởng 125% lên tới 2.000.000 VND cho khách hàng mới</strong></p>
                        <p>Bwing tặng thưởng cho khách hàng trong lần nạp đầu tiên lên tới 2.000.000 VND! Hãy tham gia NGAY!</p>
                        <p>Điều kiện chính</p>
                        <p>1 Chương trình khuyến mãi chỉ áp dụng cho khách hàng Việt Nam</p>
                        <p>2. Thời gian khuyến mãi bắt đầu từ ngày 5/3/2020 08:00:00 (GMT+7) cho đến 11:00:00 (GMT+7)</p>
                        <p>3. Để thỏa điều kiện nhận thưởng, người chơi phải thực hiện việc nạp tiền lần đầu trong thời gian diễn ra khuyến mãi và trước đó chưa thực hiện việc rút tiền.</p>
                        <p>4. Tặng thưởng lên tới 2.000.000 VND dựa trên số tiền nạp cho những khách hàng thỏa điều kiện, tiền thưởng sẽ được chuyển vào tài khoản trong vòng 48 tiếng;</p>
                        <p>5. Người chơi có thể rút tiền nạp vào và tiền thưởng sau khi đã hoàn tất yêu cầu doanh thu cược [rollover] lần trong vòng 30 ngày đối với bất kỳ sản phẩm cá cược của Bwing ngoại trừ Casino and sản phẩm Cash Out .</p>
                        <p>
                            Ví dụ
                            <br>&nbsp;
                        </p>
                        <ul class="decimal_type">
                            <li>Nạp tiền:&nbsp;10.500.000 VND&nbsp;</li>
                            <li>Tiền thưởng&nbsp;=&nbsp;10.500.000 x 125% = 2.000.000 (max capped)</li>
                            <li>Số tiền nạp được dùng để tính thưởng&nbsp;=&nbsp;2.000.000 / 125% = 1.600.000 VND</li>
                            <li>Số tiền nạp không dùng để tính thưởng&nbsp;=&nbsp;10.500.000 VND – 1.600.000 VND= 8.900.000 VND</li>
                            <li>- Yêu cầu doanh thu cược&nbsp;=&nbsp;( 2.000.000VND +1.600.000) x 20 + 8.900.000 = 80.900.000 VND</li>
                        </ul>
                        <p>&nbsp;</p>
                        <p><strong>Chi tiết điều khoản và điều kiện để nhận thưởng</strong></p>
                        <p>
                            <br>1. Để đủ điều kiện nhận thưởng, người chơi phải đáp ứng tất cả các tiêu chí dưới đây:
                            <br>&nbsp;Sử dụng tiền Việt Nam Đồng như là tiền tệ giao dịch chính thức.
                        </p>
                        <p>Người chơi thực hiện thành công việc nạp tiền vào tài khoản tại trang Bwing, trong thời gian diễn ra khuyến mãi.</p>
                        <p>2. Người chơi thỏa điều kiện sẽ được nhận thưởng 125%, lên tới 2.000.000 VND dựa trên số tiền của lần nạp đầu tiên, được thực hiện trong thời gian diễn ra khuyến mãi, như ví dụ sau đây:</p>
                        <p>
                            Tiền thưởng &nbsp; &nbsp; &nbsp;Sản phẩm&nbsp; Tiền thưởng tối đa (VND) Yêu cầu doanh thu cược
                            <br>125% &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;Tất cả sản phẩm cá cược &nbsp;&nbsp;2.000.000&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; 20 lần
                            <br>của Bwing ngoại trừ
                            <br>Casino and Cash Out.
                            <br>&nbsp;3. Người chơi thỏa điều kiện sẽ được yêu cầu bấm vào nút "Tham gia ngay" trong mục "Điều khoản và Điều kiện nhận thưởng" để nhận thưởng, ngay sau khi họ đăng nhập vào tài khoản cá cược tại trang&nbsp;
                            <a href="https://www.bwing.com">www.Bwing.com</a>.
                        </p>
                        <p>4. Người chơi thỏa điều kiện không được phép bỏ giải thưởng một khi tiền thưởng đã được chuyển vào tài khoản cá cược của họ tại trang Bwing.</p>
                        <p>
                            <br>&nbsp;5. Người chơi thỏa điều kiện có thể rút tiền nạp vào và tiền thưởng sau khi đã hoàn tất yêu cầu doanh thu cược = ( số tiền thưởng + số tiền nạp dùng để tính thưởng) x 20 đối với bất kỳ sản phẩm cá cược nào của Bwing ngoại trừ Casino and Cash Out. Quy định về rút tiền sẽ được áp dụng cho tất cả các khoản tiền nạp khác không dùng cho khuyến mãi.
                        </p>
                        <p>
                            Ví dụ:
                            <br>&nbsp;Người chơi A thỏa điều kiện, có thực hiện việc nạp tiền lần đầu với số tiền 10,500,000 VND. Khi đó, người chơi A sẽ đủ điều kiện để nhận thưởng:
                        </p>
                        <ul class="decimal_type">
                            <li>Nạp tiền:&nbsp;10.500.000 VND&nbsp;</li>
                            <li>Tiền thưởng&nbsp;=&nbsp;10.500.000 x 125% = 2.000.000 (max capped)</li>
                            <li>Số tiền nạp được dùng để tính thưởng&nbsp;=&nbsp;2.000.000 / 125% = 1.600.000 VND</li>
                            <li>Số tiền nạp không dùng để tính thưởng&nbsp;=&nbsp;10.500.000 VND – 1.600.000 VND= 8.900.000 VND</li>
                        </ul>
                        <p>Để có thể rút tiền, Người chơi A phải đạt mức Yêu cầu doanh thu cược = 2.000.000VND +1.600.000) x 20 + 8.900.000 = 80.900.000</p>
                        <p>6. Người chơi đủ điều kiện chỉ được phép tham gia một (1) chương trình khuyến mãi 'Thưởng Lần Đầu Nạp' do Bwing cung cấp. Nếu Người chơi đủ điều kiện tham gia nhiều hơn một (1), thì người chơi chỉ nhận được tiền thưởng mà Bwing duyệt đầu tiên và việc tham gia vào các chương trình khuyến mãi liên quan đến 'Thưởng Lần Đầu Nạp' khác sẽ không có hiệu lực.</p>
                        <p>
                            <br>&nbsp;7. Người chơi đủ điều kiện vẫn sẽ bị loại khỏi Chương trình khuyến mãi, nếu có bất kỳ khoản rút tiền nào được thực hiện trước khi Tiền thưởng được chuyển vào tài khoản của họ tại trang Bwing.
                        </p>
                        <p>
                            <br>&nbsp;8. Chỉ những cược có thắng/thua trong Bwing mới được cộng dồn vào Yêu cầu doanh thu cược. Rút tiền, hủy hoặc bỏ cược, cược với tỷ lệ cược nhỏ hơn 1,5 (Odds thập phân); 0,5 (Odds Trung Quốc); 0,5 (Odds dương Malay); -2.0 (Odds Indo); -200 (Odds Mỹ) hoặc cược cả hai cửa trong một trò chơi và cược trên Casino sẽ không được tính vào tổng cược này.
                        </p>
                        <p>9. Yêu cầu doanh thu cược sẽ được xem là đủ điều kiện, nếu số dư tài khoản Người chơi đủ điều kiện thấp hơn số tiền cược tối thiểu được phép (ví dụ: 28.000 Việt Nam Đồng)</p>
                        <p>Bwing có quyền sửa đổi hoặc kết thúc Khuyến mãi bất cứ lúc nào.</p>
                        <p>Bwing có toàn quyền trong Chương trình khuyến mãi và quyết định của Bwing là quyết định cuối cùng.</p>
                        <p>Bwing Điều khoản và điều kiện tiêu chuẩn được áp dụng.</p>
                        <p><strong><u>&nbsp;</u></strong></p>
                        <p><strong>Điều khoản và Điều kiện Tiêu chuẩn cho chương trình Khuyến mãi (“Điều khoản và Điều kiện”)</strong></p>
                        <ol>
                            <li>Các Điều khoản và Điều kiện sau đây áp dụng cho và điều chỉnh tất cả các chương trình khuyến mãi được cung cấp và tiến hành bởi trang web www.Bwing.com&nbsp;(“Bwing”) trừ phi có quy định khác.</li>
                            <li>Chương trình khuyến mãi giới hạn một lần đổi thưởng cho mỗi người/gia đình/tài khoản /địa chỉ thư tín/địa chỉ e-mail/tài khoản thanh toán/số điện thoại/thiết bị/địa chỉ IP/môi trường máy tính chia sẻ, bao gồm nhưng không giới hạn quán café hay nơi làm việc trong suốt thời gian khuyến mãi. &nbsp; &nbsp;</li>
                            <li>Bwing sẽ áp dụng các quy tắc nghiêm ngặt về việc lạm dụng nhiều tài khoản trong tất cả các hoạt động khuyến mãi của công ty. Bwing, theo quyền tự quyết tuyệt đối và độc quyền của công ty, sẽ quyết định hoạt động nào cấu thành việc lạm dụng nhiều tài khoản.</li>
                            <li>Người chơi có thể được yêu cầu xác nhận rằng tất cả thông tin đã đăng ký theo tài khoản của Người chơi là đúng và chính xác. &nbsp; Việc không xác nhận ngay lập tức thông tin nhận dạng của bạn khi có thông báo có thể dẫn tới việc bị truất quyền tham gia hoặc rút khỏi chương trình khuyến mãi.</li>
                            <li>Người chơi chỉ được phép tham gia một (1) chương trình khuyến mãi tại một thời điểm. Trước khi Người chơi được phép tham gia bất kỳ chương trình khuyến mãi nào, trước tiên người chơi phải hoàn thành chương trình khuyến mãi nào mà người chơi đang tham gia.</li>
                            <li>Trong suốt giai đoạn khuyến mãi, các quy tắc nghiêm ngặt được áp dụng cho yêu cầu đặt cược (“Yêu cầu đặt cược” (Rollover Requirement). Người chơi không được phép rút tiền cho đến khi đáp ứng Yêu cầu đặt cược được áp dụng.</li>
                            <li>Yêu cầu đặt cược sẽ chỉ bắt đầu sau khi tiền thưởng khuyến mãi được ghi có vào tài khoản Bwing của Người chơi.</li>
                            <li>Nếu không đáp ứng Yêu cầu đặt cược trong vòng (30) ngày sau khi tiền thưởng được ghi có vào tài khoản của Người chơi hoặc trong thời gian được quy định trong các điều khoản và điều kiện cụ thể được áp dụng cho chương trình khuyến mãi, tiền thưởng đã được ghi có và bất kỳ tiền thắng cược nào từ đó sẽ bị mất.</li>
                            <li>Nếu Người chơi đã áp dụng tiền thưởng khuyến mãi, nhưng trước khi ghi có tiền thưởng, số dư tài khoản của người chơi không đủ để hoàn thành điều kiện đặt cược tiền thưởng (bonus turnover condition), Bwing sẽ yêu cầu Người chơi nạp thêm số dư hoặc nạp thêm tiền để có đủ số tiền đáp ứng điều kiện đặt cược tiền thưởng.</li>
                            <li>Nếu Người chơi yêu cầu rút tiền mà không đáp ứng Yêu cầu đặt cược hoặc hoàn thành điều kiện đặt cược tiền thưởng, Bwing sẽ bác bỏ yêu cầu đó. &nbsp;Người chơi có thể đưa ra một yêu cầu rút tiền khác khi đã đáp ứng yêu cầu đặt cược hoặc điều kiện đặt cược.</li>
                            <li>Nếu sau đó Người chơi đặt cược hoặc tăng tiền đặt cược đã được đặt sau khi tiền thưởng khuyến mãi được ghi có vào tài khoản của mình, Người chơi sẽ không được phép hủy cược hoặc rút tiền thưởng và Bwing sẽ bác bỏ yêu cầu rút tiền thưởng, trừ phi Người chơi đáp ứng Yêu cầu đặt cược hoặc điều kiện đặt cược tiền thưởng trước</li>
                            <li>Yêu cầu đặt cược sẽ được xem là đã hoàn thành nếu số dư tài khoản đủ điều kiện của Người chơi ít hơn tiền đặt cược tối thiểu được phép (tức là:VND5(‘000))</li>
                            <li>Chỉ có tiền cược tạo ra tiền lời thắng/thua sẽ được tính vào Yêu cầu đặt cược. &nbsp;Tiền cược bị hủy hoặc mất hiệu lực, tiền cược đặt vào tỷ lệ cược nhỏ hơn 1,5 (Tỷ lệ cược thập phân); 0,5 (Tỷ lệ cược Trung Quốc); 0,5 (Tỷ lệ cược Malay dương); -2,0 (Tỷ lệ cược Indo); -200 (Tỷ lệ cược Mỹ), hoặc tiền cược đặt vào cả hai khả năng chẵn trong một trò chơi sẽ không được tính vào yêu cầu này.</li>
                            <li>Tất cả các chương trình khuyến mãi do Bwing cung cấp và tiến hành chỉ nhằm mục đích giải trí và Bwing theo quyền tự quyết độc quyền của công ty có thể giới hạn khả năng hội đủ điều kiện của Người chơi tham gia vào bất kỳ chương trình khuyến mãi nào.</li>
                            <li>Bằng việc tham gia vào chương trình khuyến mãi, Người chơi đồng ý giải phóng, miễn trừ, giữ vô hại, đền bù và bảo vệ Bwing, đại diện pháp lý của công ty, các công ty liên kết, công ty con, công ty quảng cáo và cổ đông tương ứng của họ, cán bộ, giám đốc, nhân viên, tư vấn viên, cố vấn và đại lý khỏi bất kỳ và tất cả mọi khiếu nại, trách nhiệm pháp lý, thiệt hại, chi phí, phí tổn và tổn thất phải chịu hoặc chấp nhận liên quan đến việc tham gia vào chương trình khuyến mãi hoặc liên quan đến việc chấp nhận bất kỳ giải thưởng, chiến thắng hoặc tiền thưởng nào.</li>
                            <li>Bất kỳ phí chuyển tiền, xử lý hoặc dịch vụ nào được ngân hàng thụ hưởng của Người chơi tính cho Người chơi hoặc cho Bwing sẽ được chuyển cho hoặc tính cho Người chơi. &nbsp;</li>
                            <li>Nếu Bwing có lý do để tin rằng có khả năng xảy ra vi phạm bất kỳ Điều khoản hoặc Điều kiện nào liên quan đến chương trình khuyến mãi, hoặc có lý do để nghi ngờ rằng có các cá cược bất thường, thì Bwing, theo quyền tự quyết tuyệt đối và độc quyền của công ty, sẽ có quyền đòi lại tiền thưởng hoặc bất kỳ tiền thắng cược nào từ đó, và/hoặc vô hiệu hóa các khoản đặt cược miễn phí hoặc bất kỳ khoản đặt cược nào được trả bằng tiền thưởng. Bwing sẽ có quyền tự quyết tuyệt đối để quyết định hoạt động nào cấu thành cá cược bất thường.</li>
                            <li>Bwing bảo lưu quyền thỉnh thoảng tiến hành kiểm tra ngẫu nhiên và xem lại hồ sơ và nhật ký giao dịch vì bất kỳ lý do nào. Nếu khi xem lại, Bwing cho rằng Người chơi đã hưởng lợi từ chương trình khuyến mãi bằng cách sử dụng bất kỳ chiến lược hoặc mô hình cược nào mà Bwing cho là lạm dụng, gây hại, gian dối hoặc không công bằng, Bwing, theo quyền tự quyết tuyệt đối và độc quyền của công ty và không cần giải thích, bảo lưu quyền rút lại số tiền thưởng và bất kỳ tiền thắng cược liên kết nào.</li>
                            <li>Bwing bảo lưu quyền yêu cầu tài liệu nhận dạng của Người chơi (ví dụ hộ chiếu hoặc thẻ CMND) cho mục đích xác minh trước khi rút tiền và/hoặc ghi có bất kỳ khoản tiền thưởng hoặc tiền thắng cược nào từ đó.</li>
                            <li>Bwing, theo quyền tự quyết tuyệt đối và độc quyền của công ty và không cần giải thích, bảo lưu quyền loại trừ bất kỳ Người chơi hoặc hủy bỏ tư cách tham gia của bất kỳ Người chơi nào khỏi bất kỳ và tất cả mọi chương trình khuyến mãi bất kỳ lúc nào và vì bất kỳ lý do gì.</li>
                            <li>Bwing bảo lưu quyền sửa đổi, điều chỉnh, thay đổi và/hoặc thu hồi hoặc vô hiệu hóa bất kỳ khoản tiền thưởng nào hoặc chấm dứt hoặc hủy bỏ bất kỳ chương trình khuyến mãi bất kỳ lúc nào hoặc vì bất kỳ lý do nào và không cần cung cấp bất kỳ lời giải thích nào hoặc đưa ra thông báo trước.</li>
                            <li>Nhân viên của Bwing và người thân của họ, bao gồm mọi nhân viên của các thực thể liên kết hoặc liên quan đến Bwing không được phép tham gia bất kỳ chương trình khuyến mãi nào.</li>
                            <li>Bwing, theo quyền tự quyết tuyệt đối và độc quyền của công ty, bảo lưu quyền thỉnh thoảng sửa đổi các Điều khoản và Điều kiện và vì bất kỳ lý do gì mà công ty cho là phù hợp, mà không cần thông báo trước. Bwing sẽ thực hiện những nỗ lực hợp lý để đăng thông báo nổi bật trên màn hình hiển thị Trang web bất kỳ thay đổi nào về các Điều khoản và Điều kiện.</li>
                            <li>Các Điều khoản và Điều kiện này có bản gốc được viết bằng tiếng Anh. &nbsp;Nếu các Điều khoản và Điều kiện này được dịch thành bất kỳ ngôn ngữ nào khác, bản Tiếng Anh sẽ giữ quyền chi phối. &nbsp;Nếu có bất kỳ nội dung nào không nhất quán giữa các Điều khoản và Điều kiện và Điều khoản và Điều kiện Khuyến mãi cụ thể hoặc cá biệt nào, thì Điều khoản và Điều kiện Khuyến mãi cụ thể hoặc cá biệt sẽ giữ quyền chi phối trừ phi có quy định khác trong tài liệu này.&nbsp;</li>
                            <li>Mọi quyền tự định đoạt hoặc quyết định của Bwing về các vấn đề liên quan đến chương trình khuyến mãi hoặc tiền thưởng sẽ là quyết định cuối cùng và không phụ thuộc vào bất kỳ kháng nghị hoặc xem xét nào.&nbsp;</li>
                        </ol>
                        <p>&nbsp;</p>
                        <ol>
                            <li>Nếu có bất kỳ tranh chấp nào phát sinh từ các vấn đề liên quan đến chương trình khuyến mãi, và/hoặc các Điều khoản và Điều kiện này, quyết định cuối cùng luôn thuộc quyền quyết định của Bwing. Bất kỳ quyết định nào được đưa ra sẽ có ý nghĩa ràng buộc ngay lập tức và không phụ thuộc vào việc xem xét hoặc kháng nghị bởi Người chơi hoặc bên thứ ba.</li>
                        </ol>
                        <p>&nbsp;</p>
                        <ol>
                            <li>Chương trình khuyến mãi đang được cung cấp và tiến hành bởi Bwing có hiệu lực chỉ ở những nơi mà pháp luật địa phương hoặc quốc gia cho phép, và nơi mà mọi người có thể đủ điều kiện hợp pháp để tham gia theo quy định của pháp luật hiện hành. Người chơi thừa nhận rằng Bwing hoạt động từ một vùng tài phán mà công ty được cấp phép, được điều chỉnh và được pháp luật cho phép tiến hành các chương trình khuyến mãi như vậy và Bwing thực hiện các nỗ lực hợp lý để không cung cấp chương trình khuyến mãi như vậy ở những vùng tài phán bị cấm hoặc cung cấp cho Người chơi ở tại, hoặc từ các vùng tài phán bị cấm. Người chơi hoàn toàn chịu trách nhiệm đảm bảo tuân thủ pháp luật địa phương hoặc quốc gia trước khi tham gia vào các chương trình khuyến mãi của Bwing. Ngoài ra, bằng việc tham gia vào các chương trình khuyến mãi như vậy, Người chơi cũng đảm bảo rằng mình đã tìm kiếm tư vấn pháp lý và/hoặc đủ quen thuộc với luật pháp hiện hành để xác minh rằng việc tham gia không trái với luật pháp đó.</li>
                        </ol>


                    </article>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(function() {
            const diff = moment.duration(moment.unix(@promotion.PeriodTo).diff(new Date()))
            $("#REMAINING").html(diff.days() + " days" + diff.hours() + " hours" );
            $("#ExpiryTime").html(moment.unix(@ExpiryTime).format('lll'));

            $("#JOIN").on("touchstart, click", function () {
                  if (confirm("@Html.Raw(selLangBLL.GetResourceValue("lbl_BonusConfirm"))")) {
                    axios.post('/api/Promotion/SetClaimPromotion/@selLangBLL.GetLangId()', { BonusCode:"@promotion.BonusCode"})
                        .then(function (response) {
                            var result = response.data;
                            if (result.errorCode == 0) {
                                alert("@Html.Raw(selLangBLL.GetMsg("msg_Updatesuccessful"))");
                                window.location.replace("@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })");
                            } else {
                                alert(result.message);
                            }
                        }.bind(this)).catch(function (error) {
                            alert(error);
                        }.bind(this));
                }
            });
        });
    </script>
}

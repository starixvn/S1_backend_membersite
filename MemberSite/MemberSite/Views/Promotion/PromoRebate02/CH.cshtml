@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}
@section Style{
    <style>
        /* Style the tab */
        .tab {
            overflow: hidden;
            border: 1px solid #ccc;
            background-color: #f1f1f1;
        }

            /* Style the buttons that are used to open the tab content */
            .tab button {
                background-color: inherit;
                float: left;
                border: none;
                outline: none;
                cursor: pointer;
                padding: 14px 16px;
                transition: 0.3s;
            }

                /* Change background color of buttons on hover */
                .tab button:hover {
                    background-color: #ddd;
                }

                /* Create an active/current tablink class */
                .tab button.active {
                    background-color: #ccc;
                }

        /* Style the tab content */
        .tabcontent {
            display: none;
            padding: 6px 12px;
            border-top: none;
        }
    </style>
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-promoRebate02.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>

        <div class="tab">
            <button class="tablinks" onclick="openPromo(event, 'Promo1')">真人娛樂場返水 0.5%</button>
            <button class="tablinks" onclick="openPromo(event, 'Promo2')">捕魚返水0.5％</button>
        </div>
        <br><br>

        <div id="Promo1" class="tabcontent">
            <div class="promotions-module">
                <h2>真人娛樂場返水 0.5%</h2>
                <font color="gray">此優惠於2020年5月12日上午00:00開始</font><br><br>
            </div>
            <div class="promotions-module">

                <span class="promotions-title">優惠標準規則</span>

                <ol type="1">
                    <li>此優惠活動使用於貨幣為馬幣的客戶<br><br></li>
                    <li>此促銷的截止時間將在每星期一馬來西亞時間上午11點59分59秒（GMT+8）<br><br></li>
                    <li>真人娛樂場返水0.5％是根據會員每週總投注額從星期一12:00:00 下午（GMT + 8）到星期一11:59:59 上午（GMT + 8）計算。<br><br></li>
                    <li>舉例：每週總投注額： 10,000x 0.5% = MYR 50<br><br></li>
                    <li>最低返水金額為MYR 50，最高支付金額為MYR 2000。<br><br></li>
                    <li>返水金額將在每個星期一計算後 48小時內匯入Nova88合格玩家帳戶。<br><br></li>
                    <li>返水金額必須進行1X的流水投注才能提款<br><br></li>
                    <li>此促銷優惠僅適用於MYR，THB到IDR貨幣<br><br></li>
                </ol>

                <div class="table table-rwd table-primary">
                    <div class="thead">
                        <div class="tr">
                            <div class="td-date">
                                <span class="text">產品</span>
                            </div>
                            <div class="td-date">
                                <span class="text">最低支出</span>
                            </div>
                            <div class="td-time">
                                <span class="text">最高支出</span>
                            </div>
                        </div>
                    </div>
                    <div class="tbody">
                        <div class="tr row-even">
                            <div class="td-date">
                                <span class="text">真人娛樂場除了西式廳</span>
                            </div>
                            <div class="td-date">
                                <span class="text">MYR 50</span>
                            </div>
                            <div class="td-time">
                                <span class="text">MYR 2000</span>
                            </div>
                        </div>
                    </div>
                </div>
                <br>
                <p>Nova88 有權隨時中止或取消本優惠。</p>
                <p>Nova88 保留對本優惠的最終解釋權。</p>
                <p>Nova88 適用。 </p>

            </div>

        </div>

        <div id="Promo2" class="tabcontent">
            <div class="promotions-module">
                <h2>捕魚返水0.5％</h2>
                <font color="gray">此優惠於2020年5月12日上午00:00開始</font><br><br>
            </div>
            <div class="promotions-module">

                <span class="promotions-title">優惠標準規則</span>

                <ol type="1">
                    <li>此優惠活動使用於貨幣為馬幣的客戶<br><br></li>
                    <li>此促銷的截止時間將在每星期二馬來西亞時間上午11點59分59秒（GMT+8）<br><br></li>
                    <li>捕魚返水0.5％是根據會員每週總投注額從星期二12:00:00 下午（GMT + 8）到星期二11:59:59 上午（GMT + 8）計算。<br><br></li>
                    <li>舉例：每週總投注額： 10,000x 0.5% = MYR 50<br><br></li>
                    <li>最低返水金額為MYR 50，最高支付金額為MYR 2000。<br><br></li>
                    <li>返水金額將在每個星期二計算後 48小時內匯入Nova88合格玩家帳戶。<br><br></li>
                    <li>返水金額必須進行1X的流水投注才能提款<br><br></li>
                    <li>此促銷優惠僅適用於MYR，THB到IDR貨幣<br><br></li>

                </ol>

                <div class="table table-rwd table-primary">
                    <div class="thead">
                        <div class="tr">
                            <div class="td-date">
                                <span class="text">產品</span>
                            </div>
                            <div class="td-date">
                                <span class="text">最低支出</span>
                            </div>
                            <div class="td-time">
                                <span class="text">最高支出</span>
                            </div>
                        </div>
                    </div>
                    <div class="tbody">
                        <div class="tr row-even">
                            <div class="td-date">
                                <span class="text">捕魚</span>
                            </div>
                            <div class="td-date">
                                <span class="text">MYR 50</span>
                            </div>
                            <div class="td-time">
                                <span class="text">MYR 2000</span>
                            </div>
                        </div>
                    </div>
                </div>
                <br>
                <p>Nova88 有權隨時中止或取消本優惠。</p>
                <p>Nova88 保留對本優惠的最終解釋權。</p>
                <p>Nova88 適用。 </p>

            </div>
        </div>



    </div>
</div>
@section Scripts{
    <script>
        openPromo(event, "Promo1");
        //document.getElementById('Promo1').focus();
        function openPromo(evt, PromoName) {
            // Declare all variables
            var i, tabcontent, tablinks;

            // Get all elements with class="tabcontent" and hide them
            tabcontent = document.getElementsByClassName("tabcontent");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }

            // Get all elements with class="tablinks" and remove the class "active"
            tablinks = document.getElementsByClassName("tablinks");
            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].className = tablinks[i].className.replace(" active", "");
            }

            // Show the current tab, and add an "active" class to the button that opened the tab
            document.getElementById(PromoName).style.display = "block";
            evt.currentTarget.className += " active";
        }

    </script>
}
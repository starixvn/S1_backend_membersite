@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}
@section Style{
    <style>
        .evn-time-line {
            border-left: 5px solid #9e5108;
            width: 1030px;
            text-align: left;
            margin: auto;
        }

            .evn-time-line > h4:last-child {
                position: absolute;
            }

            .evn-time-line h1 {
                text-align: left;
                font-style: italic;
            }

            .evn-time-line h4 {
                text-align: left;
                margin: 0;
                font-weight: bold;
                letter-spacing: 1px;
                margin-left: 40px;
                margin-top: 5px;
                margin-bottom: 50px;
                color: #fff;
                font-style: italic;
            }

            .evn-time-line > .point {
                display: flex;
                align-items: center;
                cursor: pointer;
            }

            .evn-time-line div .Round {
                width: 70px;
                height: 70px;
                border-radius: 100%;
                margin-left: -38px;
                position: absolute;
                display: flex;
                align-items: center;
            }

                .evn-time-line div .Round:before {
                    content: "";
                    display: block;
                    width: 50px;
                    height: 50px;
                    border-radius: 100%;
                    background: #f77a00;
                    margin: auto;
                }

                .evn-time-line div .Round:after {
                    content: "";
                    display: block;
                    width: 25px;
                    height: 25px;
                    border-radius: 100%;
                    background: #26416e;
                    left: 50%;
                    margin-left: -12.5px;
                    position: absolute;
                }

            .evn-time-line div .text {
                padding: 0 20px 0 40px;
                line-height: 55px;
                border-radius: 50px;
            }

        .evn-list:before {
            content: "";
            display: block;
            width: 0;
            height: 0;
            border-style: solid;
            border-width: 20px 20px 0 20px;
            border-color: #191414 transparent transparent transparent;
            margin-left: 35px;
            margin-top: -30px;
        }

        .evn-time-line > div.open .text {
            background: #26416e;
        }

        .evn-time-line > div.open .Round:before {
            background: #26416e;
        }

        .evn-time-line > div.open .Round:after {
            background: #f77a00;
        }

        .evn-time-line > div.point.open + h4 {
            margin-bottom: 10px;
        }

        .evn-time-line > div.point + h4 + .evn-list .rank .side-nav__item {
            display: none;
        }

        .evn-time-line > div.point.open + h4 + .evn-list .rank .side-nav__item {
            display: block;
        }

        .evn-list {
            width: calc(100% - 80px);
            background: #26416e;
            font-weight: bold;
            text-align: center;
            opacity: 0;
            visibility: hidden;
            height: 0;
            padding: 20px;
        }

        .evn-time-line > div.point.open + h4 + .evn-list {
            animation-name: g1;
            animation-duration: 2s;
            transition: 0.7s;
            opacity: 1;
            visibility: visible;
            height: auto;
            margin: 0 20px 50px;
            padding: 30px;
        }
    </style>
}

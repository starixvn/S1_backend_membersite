@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Promotion Info</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-8PBonus.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <article>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue"> Cashback Sportsbook 8%</li>
                        <li class="txt-gray">
                            Promosi ini dimulai pada Tanggal 09 Mar 2020 12:00 AM sampai pemberitahuan lebih lanjut.
                        </li>
                        <li>
                            <div class="promotions-type">
                                <ul class="txt-gray">
                                    <li>
                                        <i class="icon icon-transaction"></i>BONUS
                                        <span class="txt-org"> 8%</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-gototop"></i>JUMLAH MAKSIMAL BONUS
                                        <span class="txt-org"> Rp.10,000,000,-</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-sport252"></i>PERPUTARAN
                                        <span class="txt-org"> 1x</span>
                                    </li>

                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">Ketentuan yang berlaku </span>
            <article>
                <ol type="i">
                    <li>Promosi ini hanya berlaku untuk akun Member Mata uang IDR (Rupiah Indonesia);</li>
                    <li>Batas waktu untuk promosi ini adalah pada setiap hari Senin di 11:59:59AM (GMT + 8)</li>
                    <li>Cashback Sportsbook 8% dihitung dari total kekalahan Member setiap minggu di mulai dari Hari Senin 11:59:59AM (GMT+8) sampai dengan Hari Senin 11:59:59 AM(GMT+8).</li>
                    <li>Semua Member Nova88 berhak mendapatkan Cashback 8% berdasarkan "Kekalahan" Mingguan untuk produk Sportsbook Nova88 </li>
                    <li>Minimum pembayaran Promo Cashback adalah Rp. 34,000,- dan Jumlah maksimum pembayaran adalah Rp.10,000,000,-</li>
                    <li>Bagi member yang memenuhi syarat setiap hari Senin dalam waktu 48 jam maka Cashback akan dikreditkan ke Akun Member Nova88 anda</li>
                    <li>Kredit Cashback anda cukup melakukan 1X rollover saja sebelum melakukan penarikan.</li>



                </ol>
            </article>
            <div class="table table-rwd table-primary">
                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">Produk</span>
                        </div>
                        <div class="td-date">
                            <span class="text">Minimum pembayaran</span>
                        </div>
                        <div class="td-time">
                            <span class="text">Maksimum pembayaran</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">Semua Produk Olahraga, Kecuali Esports dan Olahraga Maya </span>
                        </div>
                        <div class="td-date">
                            <span class="text">Rp. 30,000,- </span>
                        </div>
                        <div class="td-time">
                            <span class="text">Rp. 10,000,000,- </span>
                        </div>
                    </div>
                </div>
            </div>
            <br>
            <p>Nova88 berhak untuk mengubah atau menarik promosi setiap saat.</p>
            <p>Nova88 adalah penyelenggara tunggal Promosi dan keputusannya adalah final.</p>
            <p>Nova88 syarat dan ketentuan standar berlaku.</p>





        </div>
    </div>
</div>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Promotion Info</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-8PBonus.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <article>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">สปอร์ตบุ๊ค รับเงินคืน 8%</li>
                        <li class="txt-gray">
                            โปรโมชั่นนี้มีเริ่มตั้งแต่วันที่ 9 มีนาคม เที่ยงคืนเป็นต้นไป
                        </li>
                        <li>
                            <div class="promotions-type">
                                <ul class="txt-gray">
                                    <li>
                                        <i class="icon icon-transaction"></i>โบนัส
                                        <span class="txt-org"> 8%</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-gototop"></i>จำนวนโบนัสสูงสุด
                                        <span class="txt-org"> 22,000 บาท</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-sport252"></i>ยอดหมุนเวียน
                                        <span class="txt-org"> 1x</span>
                                    </li>

                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">เงื่อนไขที่สำคัญ</span>
            <article>
                <ol type="i">
                    <li>โปรโมชั่นนี้ใช้ได้สำหรับลูกค้าไทยที่เปิดบัญชีไทยบาทเท่านั้น</li>
                    <li>เวลาตัดโปรโมชั่นคือทุกวันจันทร์เวลา 11:59:59 (GMT+8)</li>
                    <li>เครดิตเงินคือ 8% นี้คำนวณจากยอด Loss ของสมาชิกเป็นรายสัปดาห์ตั้งแต่วันจันทร์ 11:59:59 (GMT + 8) ถึงวันอาทิตย์ 11:59:59 (GMT + 8)</li>
                    <li>สมาชิก Nova88 ทุกคนมีสิทธิ์ได้รับเงินคืน 8% จากสถานะ“ LOSS” ใน Nova88 Sportsbook ทุกสัปดาห์เท่านั้น</li>
                    <li>การคืนเงินขั้นต่ำคือ 75 บาทและการจ่ายเงินสูงสุดสูงสุดที่ 22,000 บาท</li>
                    <li>เงินคืนจะโอนเข้าบัญชีโนวา 88 ของผู้เล่นที่ผ่านการรับรอง ทุกวันจันทร์ภายใน 48 ชั่วโมง</li>
                    <li>เครดิตเงินคืนภายใต้ยอดหมุนเวียน 1 เท่าเท่านั้นก่อนทำการถอนเงิน</li>


                </ol>
            </article>
            <div class="table table-rwd table-primary">
                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">ผลิตภัณฑ์</span>
                        </div>
                        <div class="td-date">
                            <span class="text">จ่ายขั้นต่ำ</span>
                        </div>
                        <div class="td-time">
                            <span class="text">จ่ายสูงสุด</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">ทุกเกมยกเว้น E-Sports และ กีฬาจำลอง</span>
                        </div>
                        <div class="td-date">
                            <span class="text">100 บาท </span>
                        </div>
                        <div class="td-time">
                            <span class="text">20,000 บาท</span>
                        </div>
                    </div>
                </div>
            </div>
            <br>

            <p>- Nova88 ขอสงวนสิทธิ์ในการแก้ไขหรือถอนโปรโมชั่นได้ตลอดเวลา</p>
            <p>- Nova88 เป็นผู้ชี้ขาด แต่เพียงผู้เดียวของโปรโมชั่นและการตัดสินใจถือเป็นที่สิ้นสุด</p>
            <p>- โปรโมชั่นนี้ใช้ข้อกำหนดและเงื่อนไขมาตรฐานของ Nova88</p>




        </div>
    </div>
</div>

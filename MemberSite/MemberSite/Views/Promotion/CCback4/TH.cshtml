@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-CCback4.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <h2>คาสิโนเงินคืน 3%</h2>

        </div>
        <div class="promotions-module">
            <span class="promotions-title">เงื่อนไขที่สำคัญ</span>
            <ol type="a">
                <li>โปรโมชั่นนี้เริ่มตั้งแต่วันที่ 9 พฤษภาคม 2020 12:00 น. จนกว่าจะมีประกาศเปลี่ยนแปลง<br><br></li>
                <li>ช่วงเวลา cut-off สำหรับโปรโมชั่นนี้คือ ทุกวันอังคารเวลา 11:59:59 AM (GMT+8)<br><br></li>
                <li>เงินคืนคาสิโน 3% จะคำนวนจากยอดเสียของสมาชิกในรายสัปดาห์ จากวันอังคารถึงวันจันทร์<br><br></li>
                <li>สมาชิก Nova88 ทุกคนมีสิทธิ์ได้รับเงินคืน 3% จากสถานะ “LOSS” ในผลิตภัณฑ์ คาสิโน ทุกสัปดาห์เท่านั้น<br><br></li>
                <li>สมาชิกที่มีสิทธิ์ได้รับการคืนเงินต้องมีการโรลโอเวอร์หนึ่งครั้ง (1x) ก่อนทำการถอน <br><br></li>
                <li>เงินคืนจะนำเข้าบัญชีโนวา 88 ของผู้เล่นที่มีคุณสมบัติเหมาะสมทุกวันอังคารภายใน 48 ชั่วโมง<br><br></li>
            </ol>

            <span class="promotions-title">เงื่อนไขโบนัส:</span>

            <div class="table table-rwd table-primary">
                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">โบนัส 3% (สกุลเงิน)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">ยอดจ่ายต่ำสุด (ต่อยอด)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">ยอดจ่ายสูงสุด (ต่อยอด)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">เทิร์นโอเวอร์</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">มาเลเซียริงกิต</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 10</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 3000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">รูเปียห์อินโดนีเซีย</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR 30,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR10,000,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">บาท</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 100</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 20,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>


            </div>
            <br><br>

            <span class="promotions-title">ข้อกำหนดและเงื่อนไข:</span>
            <ol type="1">
                <li>โปรโมชั่นนี้ใช้ได้กับสมาชิกทุกคนของ Nova88<br><br></li>
                <li>สมาชิกที่เข้าร่วมจะต้องยอมรับและปฏิบัติตามข้อกำหนดทั้งหมดที่กล่าวถึงข้างต้นรวมถึงกฎและระเบียบที่เกี่ยวข้องทั้งหมดที่ระบุไว้ในเว็บไซต์ Nova88<br><br></li>
                <li>Nova88 ขอสงวนสิทธิ์ในการแก้ไขหรือถอนโปรโมชั่นได้ตลอดเวลา<br><br></li>
                <li>Nova88 เป็นผู้ตัดสินแต่เพียงผู้เดียวของโปรโมชั่นและการตัดสินใจของเราถือเป็นที่สิ้นสุด<br><br></li>
                <li>Nova88 ใช้ข้อกำหนดและเงื่อนไขมาตรฐานของ Nova88<br><br></li>
            </ol>
        </div>
    </div>
</div>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Promotion Info</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-sabaworldcup1.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>


        <div class="promotions-module">
            <article>
                    <span class="promotions-title txt-blue">沙巴世界杯2020 - 免费旋转优惠</span>
            </article>
        </div>
            <div class="promotions-module">
                
                <span class="promotions-title">优惠标准规则</span>
                    <ol type="1">
                        <li>所有Nova88玩家在促销活动期间会自动获得参与沙巴世界杯2020免费旋转优惠.<br><br></li>
                        <li>每场沙巴世界杯2020球赛都将在指定的老虎机赠送10次免费旋转.<br><br></li>
                        <li>从2020年4月17日至2020年4月28日，每场沙巴世界杯2020球赛都有一名优胜者.<br><br></li>
                        <li>沙巴世界杯2020期间每个货币 (MYR, IDR 和 THB) 我们将送出640次免费旋转, (640 x 3) 总共1920次免费旋转等着您！<br><br></li>
                    </ol>

                <span class="promotions-title">优惠奖励条件</span>
                    <ol type="a">
                        <li>每场沙巴世界杯2020球赛最高投注额的玩家将会赢取该场的赠送优惠.<br><br></li>
                        <li>获奖者的优惠将在当天计算后 48小时内汇入Nova88合格玩家帐户.<br><br></li>
                        <li>我们的客服将会通知获奖者去指定Nova88老虎机内领取免费旋转.<br><br></li>
                        <li>当您进入客服指定的Nova88老虎机游戏后将显示你获得的“10次免费旋转”.<br><br></li>
                    </ol>
                
                <span class="promotions-title">优惠标准规则</span>
                    <ol type="1">
                        <li>任何取消或作废的投注，将不被视为有效投注额.<br><br></li>
                        <li>得奖者必须在一周（7天）内领取您的奖励.<br><br></li>
                        <li>赠送的奖励一周（7天）内没领取将自动取消.<br><br></li>
                        <li>此促销活动适用于所有Nova88会员.<br><br></li>
                        <li>参加会员必须接受并遵守上述所有条款以及Nova88网站上规定的所有相关规则和规定.<br><br></li>
                        <li>Nova88有权随时中止或取消本优惠.<br><br></li>
                        <li>Nova88保留对本优惠的最终解释权.<br><br></li>
                        <li>Nova88标准规则和条款适用.<br><br></li>
                    </ol>
            </div>       
        
    </div>
</div>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Promotion Info</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-ref.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <article>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">推荐朋友奖金高达MYR 280</li>
                        <li class="txt-gray">
                        </li>
                        <li>
                            <div class="promotions-type">
                                <ul class="txt-gray">
                                    <li>
                                        <i class="icon icon-gototop"></i>最高奖金
                                        <span class="txt-org"> MYR 280</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-sport252"></i>最低投注倍数
                                        <span class="txt-org"> 1x</span>
                                    </li>

                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">
                优惠标准规则
            </span>
            <article>
                <ol type="i">
                    <li>a. 参与此优惠推荐人请在 "Live Chat" 联系我们的客服团队。</li>
                    <li>b. 向客服提供您推荐的新会员用户名，真实姓名，以及新会员第一次存款记录（MYR180起）以便进行验证</li>
                    <li>c.MYR28 将在24小时内汇入推荐人的账号</li>
                    <li>d.Nova88合营代理无法参与此次促销</li>
                    <li>e.新会员必须进行最低存款MYR 180的第一笔存款才能享受此优惠</li>
                </ol>
            </article>
            <div class="panel panel-primary panel--payment" data-open="true">
                <div class="panel__header">
                    <span class="txt-blue">优惠标准规则</span>
                    <i class="icon icon-caret"></i>
                </div>
                <div class="panel__body">
                    <article>
                        <ol type="i">
                            <li>此优惠奖金MYR28有效投注额在Nova88产品（除了娱乐城，真人娱乐场，虚拟娱乐城，扑克，捕鱼，棋牌和即时兑现。）进行1倍投注后，才可申请提款。</li>
                            <li>优惠期间每个推荐人的新会员名额上限为10人。</li>
                            <li>优惠奖金必须在30天内完成投注，否则Nova88有权没收所有奖金和赢利。</li>
                            <li>优惠结束于2020年4月1日上午11:59（GMT + 8）</li>
                            <li>此优惠促销只适用于拥有一个独立账户的玩家，如有发现违反 Nova88 有权取消玩家此优惠活动权力
                            Nova88 标准规则和条款适用。</li>
                        </ol>
                    </article>
                </div>
            </div>
        </div>
    </div>
</div>
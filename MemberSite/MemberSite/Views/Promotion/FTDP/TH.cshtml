@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject PromotionBLL promotionBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var CurrencyId = selLangBLL.GetPreferCurrencyId();
    if (User.Identity.IsAuthenticated)
    {
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;
    }

    var Currency = selLangBLL.GetResourceValue($"Currency_{CurrencyId}");

    var promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">PromotionsInfo</span>
        </div>
        <div class="promotions-module">
            <article>
                <div class="promotions-banner"></div>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">@Currency 988 First Deposit Bonus Promotion</li>
                        <li class="txt-gray">
                            Enjoy up to @Currency 988 Bonus with your first deposit made in @serverInfo.SiteName! If you
                            are not an @serverInfo.SiteName member yet, join now! Enjoy up to @Currency 988 Bonus with your first deposit
                            made in @serverInfo.SiteName! If you are not an @serverInfo.SiteName member yet, join now! Enjoy
                            up to @Currency 988 Bonus with your first deposit made in @serverInfo.SiteName! If you are not an @serverInfo.SiteName member
                            yet, join now! Enjoy up to @Currency 988 Bonus with your first deposit made in @serverInfo.SiteName! If you are
                            not an @serverInfo.SiteName member yet, join now!
                        </li>
                        <li>
                            <div class="promotions-type">
                                <ul class="txt-gray">
                                    <li>
                                        <i class="icon icon-transaction"></i>BONUS
                                        <span class="txt-org">@Currency @promotion.Bonus.ToString("#,##0") %</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-gototop"></i>MAX
                                        <span class="txt-org">@Currency @promotion.MaxBonus.ToString("#,##0")</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-sport252"></i>ROLL OVER
                                        <span class="txt-org">@promotion.RollOver X</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-race"></i>REMAINING TIME
                                        <span class="txt-org" id="REMAINING"></span>
                                    </li>
                                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                                    {
                                        <li>
                                            <div class="btn-group">
                                                <button class="btn btn-secondary" id="JOIN">
                                                    <div class="btn__inner">
                                                        <span class="text">เข้าร่วมตอนนี้</span>
                                                    </div>
                                                </button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">ข้อกำหนดและเงื่อนไข</span>
            <article>
                <ol type="i">
                    <li>โปรโมชั่นนี้ใช้ได้กับบัญชีผู้เล่นที่เป็นสกุลเงิน THB ไทยเท่านั้น</li>
                    <li>โบนัส 50% โปรโมชั่น เริ่มตั้งแต่ 00:00:00 (GMT+8) จนถึง xxxx 2020 23:59:59 (GMT+8) (ระยะเวลาโปรโมชั่น)</li>
                    <li>โสมาชิกที่มีสิทธิ์ได้รับโปรโมชั่นนี้ต้องฝากเงินครั้งแรกและไม่มีรายการถอนเงินมาก่อน</li>
                    <li>โบนัสสูงสุด 5000 THB สำหรับการฝากเงินครั้งแรกจะถูกโอนไปยังบัญชีที่ผ่านการพิจารณาภายใน 48 ชั่วโมงหลังฝาก</li>
                    <li>
                        โบนัสและเงินฝากที่มีคุณสมบัติตามที่กำหนดนั้น ขึ้นอยู่กับการทำยอดเดิมพันหมุนเวียนให้ครบ 15ครั้ง ภายในระยะเวลา 30 วันในผลิตภัณฑ์ใดๆของ Nova88 ทั้งหมดยกเว้นผลิตภัณฑ์คาสิโนและการแลกเงินสด (Cash Out)
                    </li>
                    <li>
                        <br>ยกตัวอย่างเช่น:
                        <br>
                        <em>
                            - สมาชิกฝากเงินครั้งแรก 15,000 THB
                            <br> - ยอดเงินโบนัสที่จะได้รับคือ 15,000 x 50% = 5000 THB (จำนวนโบนัสสูงสุดไม่เกิน)
                            <br> - ยอดเงินฝากสูงสุดที่นำมาคิดโบนัสคือ 5000 THB/50% = 10,000 THB
                            <br> - ยอดเงินฝากที่ไม่ได้นำมาคิดโบนัสคือ  15,000 - 10,000 = 5000 THB
                            <br> - คำนวนยอดเงินเดิมพันสะสม/หมุนเวียนคือ (10,000 + 5,000) x 15 + 5,000 = 230,000 THB
                        </em>
                        <br>
                    </li>
                </ol>
            </article>
            <div class="panel panel-primary panel--payment" data-open="true">
                <div class="panel__header">
                    <span class="txt-blue">ข้อกำหนดและเงื่อนไขแบบเฉพาะเจาะจง</span>
                    <i class="icon icon-caret"></i>
                </div>
                <div class="panel__body">
                    <article>
                        <ol type="i">
                            <li>
                                เพื่อให้มีสิทธิ์สำหรับโปรโมชั่นผู้เล่นจะต้องผ่านเกณฑ์ทั้งหมดด้านล่าง (“ ผู้เล่นที่ผ่านการรับรอง”):
                            </li>
                            <ol>
                                <li>- ต้องเลือกเล่นในสกุลเงิน ไทย THB</li>
                                <li>
                                    - ทำการฝากเงินครั้งแรกสำเร็จในช่วงที่มีโปรโมชั่น
                                </li>
                            </ol>
                            <li>
                                ผู้เล่นที่ผ่านการรับรองจะได้รับโบนัส 50% แต่ไม่เกิน 5,000 THB จากการฝากเงินครั้งแรกในช่วงโปรโมชั่น ตามตัวอย่างที่แสดงด้านล่าง
                                <br>
                                <div class="table table-rwd table-primary">
                                    <div class="thead">
                                        <div class="tr">
                                            <div class="td-date">
                                                <span class="text">โบนัส</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">สินค้าและผลิตภัณฑ์</span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">ยอดเงินโบนัสสูงสุด (THB)</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">ยอดเดิมพันสะสม / หมุนเวียน</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tbody">
                                        <div class="tr row-even">
                                            <div class="td-date">
                                                <span class="text">50%</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">สินค้าใดๆของ Nova88 ยกเว้นคาสิโนและการแลกเงินสด (Cash Out)</span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">5,000</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">15ครั้ง</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li>
                                ผู้เล่นสามารถกดรับโบนัสได้ด้วยตัวเอง ด้วยการกดปุ่ม “เข้าร่วมตอนนี้” (Join Now) ในหน้า ข้อกำหนดและเงื่อนไขของโบนัส หลังจากล็อคอินเข้าสู่ระบบสมาชิกของ www.Nova88.net
                            </li>
                            <li>
                                ผู้เล่นที่ผ่านการรับรองไม่ได้สามารถยกเลิกโบนัสเมื่อเครดิตเข้าบัญชี Nova88 แล้ว
                            </li>
                            <li>
                                โบนัสที่ได้รับและจำนวนเงินฝากที่ใช้ในการคิดโบนัส (“ เงินฝากที่ผ่านการรับรอง”) โดยผู้เล่นที่ผ่านการรับรองจากโปรโมชั่นจะต้องมีการทำยอดเงินเดิมพันหมุนเวียน 15ครั้ง ในผลิตภัณฑ์ Nova88 ทั้งหมดยกเว้นผลิตภัณฑ์คาสิโนและการแลกเงินสด (Cash Out)   กฎการถอนเงินทั่วไปใช้กับจำนวนเงินฝากอื่น ๆ ที่ไม่ได้ใช้สำหรับโปรโมชั่น
                                <p>
                                    ยกตัวอย่างเช่น:
                                    <br>
                                    <br> - ยอดเงินโบนัสที่จะได้รับคือ 15,000 x 50% = 5000 THB (สูงสุดไม่เกิน)
                                    <br> - ยอดเงินฝากสูงสุดที่นำมาคิดโบนัสคือ 5000 THB/50% = 10,000 THB
                                    <br> - ยอดเงินฝากที่ไม่ได้นำมาคิดโบนัสคือ 15,000 - 10,000 = 5000 THB
                                    <br>
                                    <br> ก่อนที่จะทำการถอนใด ๆ ผู้เล่นที่ผ่านการรับรอง A จะต้องมีการทำยอดเงินเดิมพันหมุนเวียน = (10,000 THB + 5,000 THB) x 15 + 5,000 THB = 230,000 THB
                                </p>
                            </li>
                            <li>
                                ผู้เล่นมีสิทธิ์เข้าร่วมโปรโมชั่น (1) โบนัสเงินฝากครั้งแรกที่ได้รับอนุมัติโดย Nova88 เพียงครั้งเดียวเท่านั้น หากผู้เล่นที่ผ่านการรับรองเข้าร่วมมากกว่าหนึ่ง (1) โปรโมชั่นที่เกี่ยวข้องกับ 'โบนัสฝากเงินครั้งแรก' จะถือว่าโปรโมชั่นอื่น ๆ เป็นโมฆะ
                            </li>
                            <li>
                                ผู้เล่นที่ผ่านการรับรองจะถูกตัดสิทธิ์จากโปรโมชั่นหากมีการถอนใด ๆ เกิดขึ้นก่อนที่โบนัสจะเข้าบัญชีของผู้เล่น Nova88
                            </li>
                            <li>
                                บิลเดิมพันที่จะนับยอดต้องมีผล ชนะ/แพ้ ภายในข้อกำหนดยอดหมุนเวียน 15 ครั้ง การแลกเงินสด, ยกเลิก /โมฆะ หรือเดิมพันที่น้อยกว่า 1.5 แบบยูโร หรือ 0.5 แบบ จีน; 0.5 แบบมาเลย์; -2.0 แบบอินโด; -200 แบบ US เดิมพันสองฝั่งในเกมเดียว และ เดิมพันในเกมคาสิโนจะไม่นับรวมในข้อกำหนดนี้
                            </li>
                            <li>
                                โบนัสจะสิ้นสุดหากยอดเงินคงเหลือในบัญชีน้อยกว่าจำนวนเงินที่กำหนด เช่น  50 THB
                            </li>
                            <li>Nova88 ขอสงวนสิทธิ์ในการแก้ไขหรือยกเลิกโปรโมชั่นได้ตลอดเวลา</li>
                            <li>Nova88 ขอสงวนสิทธิ์ในการเป็นผู้พิจารณาการเข้าร่วมโปรโมชั่นให้กับสมาชิกแต่เพียงผู้เดียว และการตัดสินใจของ NOVA88 ถือเป็นอันสิ้นสุด</li>
                            <li><a class="text-link" href="/SiteSkin/Nova88/Static/th/Promotion.html" target="_blank">ข้อกำหนดและเงื่อนไขโปรโมชั่</a>นแบบทั่วไปของ Nova88</li>
                        </ol>
                    </article>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(function() {
            $("#REMAINING").html(moment.unix(@promotion.PeriodTo).format('lll'));

            $("#JOIN").on("touchstart, click", function () {
                if (confirm("Are you sure?")) {
                    axios.post('/api/Promotion/SetClaimPromotion/@selLangBLL.GetLangId()', { BonusCode:"@promotion.BonusCode"})
                        .then(function (response) {
                            var result = response.data;
                            if (result.errorCode == 0) {
                                alert("success!");
                                window.location.replace("@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })");
                            } else {
                                alert(result.message);
                            }
                        }.bind(this)).catch(function (error) {
                            alert(error);
                        }.bind(this));
                }
            });
        });
    </script>
}
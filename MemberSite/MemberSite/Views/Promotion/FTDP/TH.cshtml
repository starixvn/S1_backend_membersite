@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject PromotionBLL promotionBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var StaticRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Static/{selLangBLL.GetLangId()}");
    int CurrencyId = 0;
    long ExpiryTime = 0;
    Promotion promotion = null;

    if (User.Identity.IsAuthenticated)
    {
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;

        promotion = promotionBLL.GetPromotionListByCustId(custId).FirstOrDefault();
    }
    else
    {
        CurrencyId = selLangBLL.GetPreferCurrencyId();
        promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
    }

    if (promotion.BonusInfoStatus != 1)
    {
        ExpiryTime = promotion.PeriodTo;
    }
    else
    {
        ExpiryTime = new DateTimeOffset(promotion.ExpiryTime.ToUniversalTime(), TimeSpan.Zero).ToUnixTimeSeconds();
    }
    var Currency = selLangBLL.GetResourceValue($"lbl_Currency_{CurrencyId}");
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">@selLangBLL.GetResourceValue("lbl_PromotionInfo")</span>
        </div>
        <div class="promotions-module">
            <article>
                @if (CurrencyId == 13)
                {
                <div><img src="~/SiteSkin/@serverInfo.SiteName/Promotion/@promotion.BonusCode/@selLangBLL.GetLangId()13.png?v=20200306"></div>
                }
                else
                {
                    <div class="promotions-banner" style="background-image: url('@Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Promotion/{promotion.BonusCode}/{selLangBLL.GetLangId()}.png?v=20200306")'); background-position: center top; background-size: cover;"></div>
                }
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">@promotion.Title</li>
                        <li class="txt-gray">
                            รับโบนัสสูงสุดถึง @Currency @promotion.MaxBonus.ToString("#,##0") เมื่อคุณทำการฝากเงินครั้งแรกกับ @serverInfo.SiteName! สมัครเลย
                        </li>
                        <li>
                            <div class="promotions-type">
                                <ul class="txt-gray">
                                    <li>
                                        <i class="icon icon-transaction"></i>โบนัส
                                        <span class="txt-org"> @promotion.Bonus.ToString("#,##0")%</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-gototop"></i>จำนวนโบนัสสูงสุด
                                        <span class="txt-org"> @Currency @promotion.MaxBonus.ToString("#,##0")</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-sport252"></i>ยอดหมุนเวียน
                                        <span class="txt-org"> @(promotion.RollOver)x</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-race"></i>เวลาคงเหลือ
                                        <span class="txt-org" id="REMAINING"></span>
                                    </li>
                                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                                    {
                                        <li>
                                            <div class="btn-group">
                                                <button class="btn btn-secondary" id="JOIN">
                                                    <div class="btn__inner">
                                                        <span class="text">@selLangBLL.GetResourceValue("lbl_JoinNow")</span>
                                                    </div>
                                                </button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">ข้อกำหนดและเงื่อนไข</span>
            
                <ol type="1">
                    <li>โปรโมชั่นนี้ใช้ได้กับบัญชีผู้เล่นที่เป็นสกุลเงิน @Currency ไทยเท่านั้น</li>
                    <li>โบนัส @promotion.Bonus.ToString("#,##0")% โปรโมชั่น เริ่มตั้งแต่  จนถึง <span id="ExpiryTime"></span> (ระยะเวลาโปรโมชั่น)</li>
                    <li>โสมาชิกที่มีสิทธิ์ได้รับโปรโมชั่นนี้ต้องฝากเงินครั้งแรกและไม่มีรายการถอนเงินมาก่อน</li>
                    <li>โบนัสสูงสุด @Currency @promotion.MaxBonus.ToString("#,##0") สำหรับการฝากเงินครั้งแรกจะถูกโอนไปยังบัญชีที่ผ่านการพิจารณาภายใน 48 ชั่วโมงหลังฝาก</li>
                    <li>
                        โบนัสและเงินฝากที่มีคุณสมบัติตามที่กำหนดนั้น ขึ้นอยู่กับการทำยอดเดิมพันหมุนเวียนให้ครบ @promotion.RollOver เท่า ภายในระยะเวลา 30 วันในผลิตภัณฑ์ใดๆของ @serverInfo.SiteName ทั้งหมดยกเว้นผลิตภัณฑ์คาสิโนและการแลกเงินสด (Cash Out)
                        @*<br>ยกตัวอย่างเช่น:
                        <br>
                        <em>
                            - สมาชิกฝากเงินครั้งแรก @promotion.MaxBonus.ToString("#,##0") @Currency
                            <br> - ยอดเงินโบนัสที่จะได้รับคือ 15,000 x @promotion.Bonus.ToString("#,##0")% = 5000 @Currency (จำนวนโบนัสสูงสุดไม่เกิน)
                            <br> - ยอดเงินฝากสูงสุดที่นำมาคิดโบนัสคือ 5000 @Currency / @promotion.Bonus.ToString("#,##0")% = 10,000 @Currency
                            <br> - ยอดเงินฝากที่ไม่ได้นำมาคิดโบนัสคือ 15,000 - 10,000 = 5000 @Currency
                            <br> - คำนวนยอดเงินเดิมพันสะสม/หมุนเวียนคือ (10,000 + 5,000) x @promotion.RollOver + 5,000 = 230,000 @Currency
                        </em>*@
                    </li>
                </ol>
                
            <div class="panel panel-primary panel--payment" data-open="true">
                <div class="panel__header">
                    <span class="txt-blue">ข้อกำหนดและเงื่อนไขแบบเฉพาะเจาะจง</span>
                    <i class="icon icon-caret"></i>
                </div>
                <div class="panel__body">
                        <ol type="1">
                            <li>
                                เพื่อให้มีสิทธิ์สำหรับโปรโมชั่นผู้เล่นจะต้องผ่านเกณฑ์ทั้งหมดด้านล่าง (“ ผู้เล่นที่ผ่านการรับรอง”):
                            </li>
                            <ol>
                                <li>- ต้องเลือกเล่นในสกุลเงิน ไทย @Currency</li>
                                <li>
                                    - ทำการฝากเงินครั้งแรกสำเร็จในช่วงที่มีโปรโมชั่น
                                </li>
                            </ol>
                            <li>
                                ผู้เล่นที่ผ่านการรับรองจะได้รับโบนัส @promotion.Bonus.ToString("#,##0")% แต่ไม่เกิน @promotion.MaxBonus.ToString("#,##0") @Currency จากการฝากเงินครั้งแรกในช่วงโปรโมชั่น ตามตัวอย่างที่แสดงด้านล่าง
                                <br>
                                <div class="table table-rwd table-primary">
                                    <div class="thead">
                                        <div class="tr">
                                            <div class="td-date">
                                                <span class="text">โบนัส</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">สินค้าและผลิตภัณฑ์</span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">ยอดเงินโบนัสสูงสุด (@Currency)</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">ยอดเดิมพันสะสม / หมุนเวียน</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tbody">
                                        <div class="tr row-even">
                                            <div class="td-date">
                                                <span class="text">@promotion.Bonus.ToString("#,##0")%</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">สินค้าใดๆของ @serverInfo.SiteName ยกเว้นคาสิโน, ไลฟ์คาสิโน, เวอร์ชวลเกม, โปกเกอร์, เกมตกปลา, เกมหมากรุก และการแลกเงินสด (Cash Out)</span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">@promotion.MaxBonus.ToString("#,##0")</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">@(promotion.RollOver) เท่า</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li>
                                ผู้เล่นสามารถกดรับโบนัสได้ด้วยตัวเอง ด้วยการกดปุ่ม “เข้าร่วมตอนนี้” (Join Now) ในหน้า ข้อกำหนดและเงื่อนไขของโบนัส หลังจากล็อคอินเข้าสู่ระบบสมาชิกของ www.@(serverInfo.SiteName).net
                            </li>
                            <li>
                                ผู้เล่นที่ผ่านการรับรองไม่ได้สามารถยกเลิกโบนัสเมื่อเครดิตเข้าบัญชี @serverInfo.SiteName แล้ว
                            </li>
                            <li>
                                โบนัสที่ได้รับและจำนวนเงินฝากที่ใช้ในการคิดโบนัส (“ เงินฝากที่ผ่านการรับรอง”) โดยผู้เล่นที่ผ่านการรับรองจากโปรโมชั่นจะต้องมีการทำยอดเงินเดิมพันหมุนเวียน @promotion.RollOver เท่า ในผลิตภัณฑ์ @serverInfo.SiteName ทั้งหมดยกเว้นผลิตภัณฑ์คาสิโนและการแลกเงินสด (Cash Out) กฎการถอนเงินทั่วไปใช้กับจำนวนเงินฝากอื่น ๆ ที่ไม่ได้ใช้สำหรับโปรโมชั่น
                                @*<p>
                                    ยกตัวอย่างเช่น:
                                    <br>
                                    <br> - ยอดเงินโบนัสที่จะได้รับคือ 15,000 x @promotion.Bonus.ToString("#,##0")% = 5000 @Currency (สูงสุดไม่เกิน)
                                    <br> - ยอดเงินฝากสูงสุดที่นำมาคิดโบนัสคือ 5000 @Currency / @promotion.Bonus.ToString("#,##0")% = 10,000 @Currency
                                    <br> - ยอดเงินฝากที่ไม่ได้นำมาคิดโบนัสคือ 15,000 - 10,000 = 5000 @Currency
                                    <br>
                                    <br> ก่อนที่จะทำการถอนใด ๆ ผู้เล่นที่ผ่านการรับรอง A จะต้องมีการทำยอดเงินเดิมพันหมุนเวียน = (10,000 @Currency + 5,000 @Currency) x @promotion.RollOver + 5,000 @Currency = 230,000 @Currency
                                </p>*@
                            </li>
                            <li>
                                ผู้เล่นมีสิทธิ์เข้าร่วมโปรโมชั่น (1) โบนัสเงินฝากครั้งแรกที่ได้รับอนุมัติโดย @serverInfo.SiteName เพียงครั้งเดียวเท่านั้น หากผู้เล่นที่ผ่านการรับรองเข้าร่วมมากกว่าหนึ่ง (1) โปรโมชั่นที่เกี่ยวข้องกับ 'โบนัสฝากเงินครั้งแรก' จะถือว่าโปรโมชั่นอื่น ๆ เป็นโมฆะ
                            </li>
                            <li>
                                ผู้เล่นที่ผ่านการรับรองจะถูกตัดสิทธิ์จากโปรโมชั่นหากมีการถอนใด ๆ เกิดขึ้นก่อนที่โบนัสจะเข้าบัญชีของผู้เล่น @serverInfo.SiteName
                            </li>
                            <li>
                                บิลเดิมพันที่จะนับยอดต้องมีผล ชนะ/แพ้ ภายในข้อกำหนดยอดหมุนเวียน @promotion.RollOver เท่า การแลกเงินสด, ยกเลิก /โมฆะ หรือเดิมพันที่น้อยกว่า 1.5 แบบยูโร หรือ 0.5 แบบ จีน; 0.5 แบบมาเลย์; -2.0 แบบอินโด; -200 แบบ US เดิมพันสองฝั่งในเกมเดียว, เดิมพันในเกมคาสิโน, ไลฟ์คาสิโน, เวอร์ชวลเกม, โปกเกอร์, เกมตกปลา, เกมหมากรุก และการแลกเงินสด (Cash Out) จะไม่นับรวมในข้อกำหนดนี้
                            </li>
                            <li>
                                โบนัสจะสิ้นสุดหากยอดเงินคงเหลือในบัญชีน้อยกว่าจำนวนเงินที่กำหนด เช่น 50 @Currency
                            </li>
                            <li>@serverInfo.SiteName ขอสงวนสิทธิ์ในการแก้ไขหรือยกเลิกโปรโมชั่นได้ตลอดเวลา</li>
                            <li>@serverInfo.SiteName ขอสงวนสิทธิ์ในการเป็นผู้พิจารณาการเข้าร่วมโปรโมชั่นให้กับสมาชิกแต่เพียงผู้เดียว และการตัดสินใจของ @serverInfo.SiteName ถือเป็นอันสิ้นสุด</li>
                            <li><a class="text-link" href="@StaticRootPath/Promotion.html" target="_blank">ข้อกำหนดและเงื่อนไขโปรโมชั่</a>นแบบทั่วไปของ @serverInfo.SiteName</li>
                        </ol>
                        
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(function() {
            const diff = moment.duration(moment.unix(@promotion.PeriodTo).diff(new Date()))
            $("#REMAINING").html(diff.days() + " วัน" + diff.hours() + " ชั่วโมง" );
           var sExpiryTime = moment.unix(@ExpiryTime).date() +' วัน '+ (parseInt(moment.unix(@ExpiryTime).get('month'),10) + 1 ) +' เดือน '+ moment.unix(@ExpiryTime).year() +' ปี';
            sExpiryTime += moment.unix(@ExpiryTime).format(' HH:mm');
            $("#ExpiryTime").html(sExpiryTime);

            $("#JOIN").on("touchstart, click", function () {
                  if (confirm("@Html.Raw(selLangBLL.GetResourceValue("lbl_BonusConfirm"))")) {
                    axios.post('/api/Promotion/SetClaimPromotion/@selLangBLL.GetLangId()', { BonusCode:"@promotion.BonusCode"})
                        .then(function (response) {
                            var result = response.data;
                            if (result.errorCode == 0) {
                                alert("@Html.Raw(selLangBLL.GetMsg("msg_Updatesuccessful"))");
                                window.location.replace("@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })");
                            } else {
                                alert(result.message);
                            }
                        }.bind(this)).catch(function (error) {
                            alert(error);
                        }.bind(this));
                }
            });
        });
    </script>GetResourceValue
}
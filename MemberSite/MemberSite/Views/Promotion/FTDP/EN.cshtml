@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject PromotionBLL promotionBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var CurrencyId = selLangBLL.GetPreferCurrencyId();
    if (User.Identity.IsAuthenticated)
    {
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;
    }

    var Currency = selLangBLL.GetResourceValue($"Currency_{CurrencyId}");

    var promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">PromotionsInfo</span>
        </div>
        <div class="promotions-module">
            <article>
                <div class="promotions-banner"></div>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">MYR 988 First Deposit Bonus Promotion</li>
                        <li class="txt-gray">
                            Enjoy up to MYR 988 Bonus with your first deposit made in Nova88e! If you
                            are not an Nova88e member yet, join now! Enjoy up to MYR 988 Bonus with your first deposit
                            made in Nova88e! If you are not an Nova88e member yet, join now! Enjoy
                            up to MYR 988 Bonus with your first deposit made in Nova88e! If you are not an Nova88e member
                            yet, join now! Enjoy up to MYR 988 Bonus with your first deposit made in Nova88e! If you are
                            not an Nova88e member yet, join now!
                        </li>
                        <li>
                            <div class="promotions-type">
                                <ul class="txt-gray">
                                    <li>
                                        <i class="icon icon-transaction"></i>BONUS
                                        <span class="txt-org">MYR @promotion.Bonus.ToString("#,##0") %</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-gototop"></i>MAX
                                        <span class="txt-org">MYR @promotion.MaxBonus.ToString("#,##0")</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-sport252"></i>ROLL OVER
                                        <span class="txt-org">@promotion.RollOver X</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-race"></i>REMAINING TIME
                                        <span class="txt-org" id="REMAINING"></span>
                                    </li>
                                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                                    {
                                        <li>
                                            <div class="btn-group">
                                                <button class="btn btn-secondary" id="JOIN">
                                                    <div class="btn__inner">
                                                        <span class="text">JOIN NOW</span>
                                                    </div>
                                                </button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </article>
        </div>

        <div class="promotions-module">
            <span class="promotions-title">Significant Conditions</span>
            <article>
                <ol type="i">
                    <li>This promotion applies only to MYR account players;</li>
                    <li>This promotion starts at 00:00:00 (GMT+8) until xxxx 2020 23:59:59 (GMT+8) (“Promotion Period”).</li>
                    <li>To qualify, the player must have made their First Deposit and have not made any withdrawal requests before.</li>
                    <li>A Bonus of up to MYR 500 based on the First Deposit amount will be credited to qualified players within 48 hours;</li>
                    <li>
                        The Bonus and Qualifying Deposit amount used are subject to a 15 times rollover requirement within 30 days on any Nova88 products, except Casino and Cash Out products.
                        <br>
                        <br> Example:
                        <br>
                        <em>
                            - Deposit amount: MRY 1,500
                            <br> - Bonus amount = MRY 1,500 x 50% = MRY 500 Capped MAX
                            <br> - Deposit amount used to generate the bonus = MRY 500/ 50% = MRY 1,000
                            <br> - Deposit amounts not used for the promotion = MRY 1,500 – MRY 1,000 = MRY 500
                            <br> - Rollover requirement = (MYR 1,000 + MYR 500) x 15 + MYR 500 = MYR 23,000
                        </em>
                        <br>
                    </li>
                </ol>
            </article>
            <div class="panel panel-primary panel--payment" data-open="true">
                <div class="panel__header">
                    <span class="txt-blue">FULL PROMOTION SPECIFIC TERMS AND CONDITIONS</span>
                    <i class="icon icon-caret"></i>
                </div>
                <div class="panel__body">
                    <article>
                        <ol type="i">
                            <li>
                                To be eligible for the Promotion, players must meet all the criteria below (“Qualified Player”):
                            </li>
                            <ol>
                                <li>- Have chosen MRY as their preferred currency,</li>
                                <li>
                                    - Have made their first approved deposit to their Nova88 account during the promotion period.
                                </li>
                            </ol>
                            <li>
                                Qualified Players will be awarded with a 50% bonus based on their first approved deposit amount made during the Promotion Period, up to a maximum of  MRY 500, as illustrated below:
                                <br>
                                <div class="table table-rwd table-primary">
                                    <div class="thead">
                                        <div class="tr">
                                            <div class="td-date">
                                                <span class="text">BONUS</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">PRODUCTS</span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">MAX BONUS AMOUNT  (MRY)</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">ROLLOVER</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tbody">
                                        <div class="tr row-even">
                                            <div class="td-date">
                                                <span class="text">50%</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">All Nova88 Products, except Casino and Cash Out.</span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">500</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">15x</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li>
                                The Qualified Player is required to click on the “JOIN NOW” button within the Promotion-Specific Terms and Conditions page upon login to their Nova88 account at www.Nova88.net to claim the Bonus.
                            </li>
                            <li>
                                The Qualified Member is not allowed to cancel the Bonus once it is credited to their  Nova88 account.
                            </li>
                            <li>
                                The bonus received and deposit amount used to generate the bonus (“Qualifying Deposit”) by the Qualified Player from the Promotion are subject to a 15 times rollover requirement in all Nova88 products, except Casino and Cash Out products, before any withdrawals can be made. General withdrawal rule applies for all other deposit amounts not used for the Promotion.
                                <p>
                                    Example: <br>
                                    Qualified Player A has made the first approved deposit with an amount of MRY 1,500. Player A is now eligible to claim the deposit bonus.
                                    <br>
                                    <br> - Bonus amount = MRY 1,500 x 50% = capped to MRY 500
                                    <br> - Deposit amount used to generate the bonus = MRY 500/50% = MRY 1,000
                                    <br> - Deposit amounts not used for the promotion = MRY 1,500 – MRY 1,000 = MRY 500
                                    <br>
                                    <br> Before any withdrawals can be made, Qualified Member A is subjected to rollover = (MRY 1,000 + MRY 500) x 15 + MRY 500 = MRY 23,000
                                </p>
                            </li>
                            <li>
                                The Qualified Player is allowed to participate in only one (1) ‘First Time Deposit Bonus’ related promotion offered by Nova88. Should the Qualified Player participate in more than one (1), only the first approved ‘First Time Deposit Bonus’ related promotion received by Nova88 from such Qualified Player will be considered valid and participation in all other ‘First Time Deposit Bonus’ related promotions will be void.
                            </li>
                            <li>
                                The Qualified Player will be disqualified from the Promotion if any withdrawals are made before the Bonus is credited to their Nova88 account.
                            </li>
                            <li>
                                Only wagers in Nova88 that generate a win/loss return will be contributed to the rollover requirement. Cash Out, cancelled or void wagers, wagers on odds less than 1.5 (Decimal odd); 0.5 (China odd); 0.5 (Malay Positive odd); -2.0(Indo odd); -200 (US odd), or wagers on both even-chances during a single game and wagers on Casino Games will not be counted towards this requirement.
                            </li>
                            <li>
                                The rollover requirement will be considered fulfilled if the Qualified Player’s account balance is less than the minimum stake amount allowed (i.e. MRY 5)
                            </li>
                            <li>Nova88 reserves the right to amend or withdraw the Promotion at any time.</li>
                            <li>Nova88 is the sole arbiter of the Promotion and its decision is final.</li>
                            <li>Nova88 <a class="text-link" href="/SiteSkin/Nova88/Static/en/Promotion.html" target="_blank">Standard Terms and Conditions</a> apply.</li>
                        </ol>
                    </article>
                </div>
            </div>
        </div>
    </div>
    @section Scripts{
        <script type="text/javascript">
        $(function() {
            $("#REMAINING").html(moment.unix(@promotion.PeriodTo).format('lll'));

            $("#JOIN").on("touchstart, click", function () {
                if (confirm("Are you sure?")) {
                    axios.post('/api/Promotion/SetClaimPromotion/@selLangBLL.GetLangId()', { BonusCode:"@promotion.BonusCode"})
                        .then(function (response) {
                            var result = response.data;
                            if (result.errorCode == 0) {
                                alert("success!");
                                window.location.replace("@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })");
                            } else {
                                alert(result.message);
                            }
                        }.bind(this)).catch(function (error) {
                            alert(error);
                        }.bind(this));
                }
            });
        });
        </script>
    }

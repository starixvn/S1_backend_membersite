@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject PromotionBLL promotionBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var StaticRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Static/{selLangBLL.GetLangId()}");
    int CurrencyId = 0;
    long ExpiryTime = 0;
    Promotion promotion = null;

    if (User.Identity.IsAuthenticated)
    {
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;

        promotion = promotionBLL.GetPromotionListByCustId(custId).FirstOrDefault();
    }
    else
    {
        CurrencyId = selLangBLL.GetPreferCurrencyId();
        promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
    }

    if (promotion.BonusInfoStatus == 0)
    {
        ExpiryTime = promotion.PeriodTo;
    }
    else
    {
        ExpiryTime = new DateTimeOffset(promotion.ExpiryTime.ToUniversalTime(), TimeSpan.Zero).ToUnixTimeSeconds();
    }
    var Currency = selLangBLL.GetResourceValue($"lbl_Currency_{CurrencyId}");
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">PromotionsInfo</span>
        </div>
        <div class="promotions-module">
            <article>
                <div class="promotions-banner" style="background-image: url('@Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Promotion/{promotion.BonusCode}/{selLangBLL.GetLangId()}.png?v=20200306")'); background-position: center top; background-size: cover;"></div>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">@promotion.Title</li>
                        <li class="txt-gray">
                            Enjoy up to @Currency @promotion.MaxBonus.ToString("#,##0") with your first deposit with @serverInfo.SiteName! Join NOW!
                        </li>
                        <li>
                            <div class="promotions-type">
                                <ul class="txt-gray">
                                    <li>
                                        <i class="icon icon-transaction"></i>BONUS
                                        <span class="txt-org">@Currency @promotion.Bonus.ToString("#,##0")%</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-gototop"></i>MAX BONUS AMOUNT
                                        <span class="txt-org">@Currency @promotion.MaxBonus.ToString("#,##0")</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-sport252"></i>ROLLOVER
                                        <span class="txt-org">@(promotion.RollOver)x</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-race"></i>REMAINING TIME
                                        <span class="txt-org" id="REMAINING"></span>
                                    </li>
                                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                                    {
                                        <li>
                                            <div class="btn-group">
                                                <button class="btn btn-secondary" id="JOIN">
                                                    <div class="btn__inner">
                                                        <span class="text">@selLangBLL.GetResourceValue("lbl_JoinNow")</span>
                                                    </div>
                                                </button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">Significant Conditions</span>
            <article>
                <ol type="i">
                    <li>1.	This promotion applies only to @Currency account players;</li>
                    <li>2.	This promotion starts at until <span id="ExpiryTime"></span> (“Promotion Period”).</li>
                    <li>3.	To qualify, the player must have made their First Deposit and have not made any withdrawal requests before.</li>
                    <li>4.	A Bonus of up to @Currency @promotion.MaxBonus.ToString("#,##0") based on the First Deposit amount will be credited to qualified players within 48 hours;</li>
                    <li>
                        5.	The Bonus and Qualifying Deposit amount used are subject to a 15 times rollover requirement within 30 days on any @serverInfo.SiteName products, except Casino and Cash Out products.
                        <br>
                        @*<br> Example:
                        <br>
                        <em>
                            - Deposit amount: @Currency 1,500
                            <br> - Bonus amount = @Currency 1,500 x @promotion.Bonus.ToString("#,##0")% = @Currency 500 Capped MAX
                            <br> - Deposit amount used to generate the bonus = @Currency 500 / @promotion.Bonus.ToString("#,##0")% = @Currency 1,000
                            <br> - Deposit amount not used for the promotion = @Currency 1,500 – @Currency 1,000 = @Currency 500
                            <br> - Rollover requirement = (@Currency 1,000 + @Currency 500) x 15 + @Currency 500 = @Currency 23,000
                        </em>*@
                    </li>
                </ol>
            </article>
            <div class="panel panel-primary panel--payment" data-open="true">
                <div class="panel__header">
                    <span class="txt-blue">FULL PROMOTION SPECIFIC TERMS AND CONDITIONS</span>
                    <i class="icon icon-caret"></i>
                </div>
                <div class="panel__body">
                    <article>
                        <ol type="i">
                            <li>
                                To be eligible for the Promotion, players must meet all the criteria below (“Qualified Player”):
                            </li>
                            <ol>
                                <li>- Have chosen @Currency as their preferred currency,</li>
                                <li>
                                    - Have made their first approved deposit to their @serverInfo.SiteName account during the promotion period.
                                </li>
                            </ol>
                            <li>
                                Qualified Players will be awarded with a @promotion.Bonus.ToString("#,##0")% bonus based on their first approved deposit amount made during the Promotion Period, up to a maximum of @Currency @promotion.MaxBonus.ToString("#,##0"), as illustrated below:
                                <br>
                                <div class="table table-rwd table-primary">
                                    <div class="thead">
                                        <div class="tr">
                                            <div class="td-date">
                                                <span class="text">BONUS</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">PRODUCTS</span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">MAX BONUS AMOUNT (@Currency)</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">ROLLOVER</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tbody">
                                        <div class="tr row-even">
                                            <div class="td-date">
                                                <span class="text">@promotion.Bonus.ToString("#,##0")%</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">All @serverInfo.SiteName Products, except Casino and Cash Out.</span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">@promotion.MaxBonus.ToString("#,##0")</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">@(promotion.RollOver)x</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li>
                                The Qualified Player is required to click on the “JOIN NOW” button within the Promotion-Specific Terms and Conditions page upon login to their @serverInfo.SiteName account at www.@(serverInfo.SiteName).net to claim the Bonus.
                            </li>
                            <li>
                                The Qualified Member is not allowed to cancel the Bonus once it is credited to their @serverInfo.SiteName account.
                            </li>
                            <li>
                                The bonus received and deposit amount used to generate the bonus (“Qualifying Deposit”) by the Qualified Player from the Promotion are subject to a @promotion.RollOver times rollover requirement in all @serverInfo.SiteName products, except Casino and Cash Out products, before any withdrawals can be made. General withdrawal rule applies for all other deposit amounts not used for the Promotion.
                                @*<p>
                                    Example: <br>
                                    Qualified Player A has made the first approved deposit with an amount of @Currency 1,500. Player A is now eligible to claim the deposit bonus.
                                    <br>
                                    <br> - Bonus amount = @Currency 1,500 x @promotion.Bonus.ToString("#,##0")% = capped to @Currency 500
                                    <br> - Deposit amount used to generate the bonus = @Currency 500 / @promotion.Bonus.ToString("#,##0")% = @Currency 1,000
                                    <br> - Deposit amounts not used for the promotion = @Currency 1,500 – @Currency 1,000 = @Currency 500
                                    <br>
                                    <br> Before any withdrawals can be made, Qualified Member A is subjected to rollover = (@Currency 1,000 + @Currency 500) x @promotion.RollOver + @Currency 500 = @Currency 23,000
                                </p>*@
                            </li>
                            <li>
                                The Qualified Player is allowed to participate in only one (1) ‘First Time Deposit Bonus’ related promotion offered by @serverInfo.SiteName. Should the Qualified Player participate in more than one (1), only the first approved ‘First Time Deposit Bonus’ related promotion received by @serverInfo.SiteName from such Qualified Player will be considered valid and participation in all other ‘First Time Deposit Bonus’ related promotions will be void.
                            </li>
                            <li>
                                The Qualified Player will be disqualified from the Promotion if any withdrawals are made before the Bonus is credited to their @serverInfo.SiteName account.
                            </li>
                            <li>
                                Only wagers in @serverInfo.SiteName that generate a win/loss return will be contributed to the rollover requirement. Cash Out, cancelled or void wagers, wagers on odds less than 1.5 (Decimal odd); 0.5 (China odd); 0.5 (Malay Positive odd); -2.0(Indo odd); -200 (US odd), or wagers on both even-chances during a single game and wagers on Casino Games will not be counted towards this requirement.
                            </li>
                            <li>
                                The rollover requirement will be considered fulfilled if the Qualified Player’s account balance is less than the minimum stake amount allowed (i.e. @Currency 5)
                            </li>
                            <li>@serverInfo.SiteName reserves the right to amend or withdraw the Promotion at any time.</li>
                            <li>@serverInfo.SiteName is the sole arbiter of the Promotion and its decision is final.</li>
                            <li>@serverInfo.SiteName <a class="text-link" href="@StaticRootPath/Promotion.html" target="_blank">Standard Terms and Conditions</a> apply.</li>
                        </ol>
                    </article>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(function() {
            const diff = moment.duration(moment.unix(@promotion.PeriodTo).diff(new Date()))
            $("#REMAINING").html(diff.days() + " days" + diff.hours() + " hours" );
            $("#ExpiryTime").html(moment.unix(@ExpiryTime).format('lll'));

            $("#JOIN").on("touchstart, click", function () {
                  if (confirm("@Html.Raw(selLangBLL.GetResourceValue("lbl_BonusConfirm"))")) {
                    axios.post('/api/Promotion/SetClaimPromotion/@selLangBLL.GetLangId()', { BonusCode:"@promotion.BonusCode"})
                        .then(function (response) {
                            var result = response.data;
                            if (result.errorCode == 0) {
                                alert("@Html.Raw(selLangBLL.GetMsg("msg_Updatesuccessful"))");
                                window.location.replace("@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })");
                            } else {
                                alert(result.message);
                            }
                        }.bind(this)).catch(function (error) {
                            alert(error);
                        }.bind(this));
                }
            });
        });
    </script>
}
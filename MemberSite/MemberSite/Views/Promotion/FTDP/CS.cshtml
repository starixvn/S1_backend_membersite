@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject PromotionBLL promotionBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var StaticRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Static/{selLangBLL.GetLangId()}");
    int CurrencyId = 0;
    long ExpiryTime = 0;
    Promotion promotion = null;

    if (User.Identity.IsAuthenticated)
    {
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;

        promotion = promotionBLL.GetPromotionListByCustId(custId).FirstOrDefault();
    }
    else
    {
        CurrencyId = selLangBLL.GetPreferCurrencyId();
        promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
    }

    if (promotion.BonusInfoStatus == 0)
    {
        ExpiryTime = promotion.PeriodTo;
    }
    else
    {
        ExpiryTime = new DateTimeOffset(promotion.ExpiryTime.ToUniversalTime(), TimeSpan.Zero).ToUnixTimeSeconds();
    }
    var Currency = selLangBLL.GetResourceValue($"lbl_Currency_{CurrencyId}");
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">PromotionsInfo</span>
        </div>
        <div class="promotions-module">
            <article>
                <div class="promotions-banner" style="background-image: url('@Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Promotion/{promotion.BonusCode}/{selLangBLL.GetLangId()}.png")'); background-position: center top; background-size: cover;"></div>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">50% 欢迎红利，最高 @Currency 500</li>
                        <li class="txt-gray">
                            在欧亚88完成第一笔存款以享受高达 马币500 的优惠回馈！立即加入！
                        </li>
                        <li>
                            <div class="promotions-type">
                                <ul class="txt-gray">
                                    <li>
                                        <i class="icon icon-transaction"></i>优惠
                                        <span class="txt-org"> @promotion.Bonus.ToString("#,##0")%</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-gototop"></i>最高奖金
                                        <span class="txt-org"> @Currency @promotion.MaxBonus.ToString("#,##0")</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-sport252"></i>最低投注倍数
                                        <span class="txt-org"> @(promotion.RollOver)x</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-race"></i>剩余时间
                                        <span class="txt-org" id="REMAINING"></span>
                                    </li>
                                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                                    {
                                        <li>
                                            <div class="btn-group">
                                                <button class="btn btn-secondary" id="JOIN">
                                                    <div class="btn__inner">
                                                        <span class="text">@selLangBLL.GetResourceValue("lbl_JoinNow")</span>
                                                    </div>
                                                </button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">
                优惠标准规则
            </span>
            <article>
                <ol type="i">
                    <li>此优惠活动使用于货币为 @Currency 的新客户。</li>
                    <li>优惠期限为马来西亚时间 至 <span id="ExpiryTime"></span> (优惠期间)</li>
                    <li>获得红利资格，玩家必须先进行首存，并且没有申请过提款请求。</li>
                    <li>根据首存存款额，最高 @Currency 500的红利将在48小时内存入玩家账户。</li>
                    <li>
                        在提款前，存款金额和红利至少需要完成 @promotion.RollOver 倍投注额；在红利注入的30天，若未完成最低投注，带来的赢利将被扣除。红利适用于 @serverInfo.SiteName 所有产品，除了娱乐城和实时兑现。
                        <br>
                        <br>举例：
                        <br>
                        <em>
                            - 存款金额 = 1,500 @Currency
                            <br> - 优惠红利 = 1,500 @Currency X 50% = 封顶红利500 @Currency
                            <br> - 用于申请奖金的部分 = 封顶奖金500 @Currency / 50% = 1,000 @Currency
                            <br> - 没有申请奖金的部分 = 1,500 @Currency – 1,000马币 = 500 @Currency
                            <br> - 最低投注额 = (1,000 @Currency + 500 @Currency) x @promotion.RollOver + 500 @Currency = 23,000 @Currency
                            <br>
                        </em>
                    </li>
                </ol>
            </article>
            <div class="panel panel-primary panel--payment" data-open="true">
                <div class="panel__header">
                    <span class="txt-blue">完整优惠标准规则</span>
                    <i class="icon icon-caret"></i>
                </div>
                <div class="panel__body">
                    <article>
                        <ol type="i">
                            <li>
                                本优惠适用于以下会员（“符合资格的会员”）：
                            </li>
                            <ol>
                                <li>首选货币是 @Currency</li>
                                <li>
                                    优惠期间，在 @serverInfo.SiteName 有首次成功的存款(“有效存款”)。
                                </li>
                            </ol>
                            <li>
                                优惠期间，符合以上优惠资格的会员，可享有一次50%首存存款奖金，最高为500 @Currency（“奖金”），详情如下：
                                <br>
                                <div class="table table-rwd table-primary">
                                    <div class="thead">
                                        <div class="tr">
                                            <div class="td-date">
                                                <span class="text">优惠</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">产品</span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">最高奖金（@Currency）</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">最低投注倍数</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tbody">
                                        <div class="tr row-even">
                                            <div class="td-date">
                                                <span class="text">@promotion.Bonus.ToString("#,##0")%</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">所有 @serverInfo.SiteName 产品，除了娱乐城与实时兑现.</span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">@promotion.MaxBonus.ToString("#,##0")</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">@(promotion.RollOver)x</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li>
                                符合资格的会员请登录 @serverInfo.SiteName 网站，进入优惠页面，点击特定的优惠规则与条款，在上方点击"立即加入"即可。
                            </li>
                            <li>
                                优惠奖金注入后，会员将不能申请取消。
                            </li>
                            <li>
                                会员申请优惠的存款金额和奖金需要在 @serverInfo.SiteName 达到指定奖金的投注要求后，才可申请提款。此优惠奖金最低投注金额倍数为 @promotion.RollOver 倍。此投注要求会且仅计算 @serverInfo.SiteName 产品，除了娱乐城与实时兑现。
                                <p>
                                    举例: 会员A在优惠期间成功存款了1,500 @Currency, 以下是本优惠最低投注需求算法;
                                    <br>
                                    <br> - 优惠奖金 = 1,500 @Currency x 50% = 封顶奖金500 @Currency
                                    <br> - 用于申请奖金的部分 = 封顶奖金500 @Currency / 50% = 1,000 @Currency
                                    <br> - 没有申请奖金的部分 = 1,500 @Currency – 1,000 @Currency = 500 @Currency
                                    <br>
                                    <br>会员A在申请提款前必须完成的最低投注额 = (1,000 @Currency + 500 @Currency) x @promotion.RollOver + 500 @Currency = 23,000 @Currency.
                                </p>
                            </li>
                            <li>
                                符合资格的会员在优惠期间只能领取一次“首存优惠奖金”，如果会员在优惠期间申请了多次“首存优惠奖金”，只有第一笔的“首存优惠奖金”被视为有效，而其他申请将被视为无效。
                            </li>
                            <li>
                                在奖金未注入您的账号之前请勿提款，否则将失去领取奖金的资格。
                            </li>
                            <li>
                                有效投注额仅计算在 @serverInfo.SiteName 投注产生输赢结果的注单。实时兑现，注单取消或本金退还，任何赔率低于标准盘1.5、中国盘0.5、马来盘正数赔率0.5、印度尼西亚盘-2.0、美国盘-200的投注，及在同一局游戏中同时投注对等盘口，或在娱乐城的注单将不计算为有效投注额内。
                            </li>
                            <li>
                                当会员的投注额未达到上述条款要求，且账户现金余额少于5 @Currency 时，则无需继续履行此优惠规则与条款。
                            </li>
                            <li>@serverInfo.SiteName 有权随时中止或取消本优惠。</li>
                            <li>@serverInfo.SiteName 保留对本优惠的最终解释权。</li>
                            <li>@serverInfo.SiteName <a class="text-link" href="@StaticRootPath/Promotion.html" target="_blank">标准规则和条款</a>适用。</li>
                        </ol>
                    </article>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(function() {
           const diff = moment.duration(moment.unix(@promotion.PeriodTo).diff(new Date()))
            $("#REMAINING").html(diff.days() + " 天" + diff.hours() + " 小时" );
            $("#ExpiryTime").html(moment.unix(@ExpiryTime).format('lll'));

            $("#JOIN").on("touchstart, click", function () {
                   if (confirm("@Html.Raw(selLangBLL.GetResourceValue("lbl_BonusConfirm"))")) {
                    axios.post('/api/Promotion/SetClaimPromotion/@selLangBLL.GetLangId()', { BonusCode:"@promotion.BonusCode"})
                        .then(function (response) {
                            var result = response.data;
                            if (result.errorCode == 0) {
                                 alert("@Html.Raw(selLangBLL.GetMsg("msg_Updatesuccessful"))");
                                window.location.replace("@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })");
                            } else {
                                alert(result.message);
                            }
                        }.bind(this)).catch(function (error) {
                            alert(error);
                        }.bind(this));
                }
            });
        });
    </script>
}

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject PromotionBLL promotionBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var CurrencyId = selLangBLL.GetPreferCurrencyId();
    if (User.Identity.IsAuthenticated)
    {
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;
    }

    var Currency = selLangBLL.GetResourceValue($"lbl_Currency_{CurrencyId}");

    var promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">PromotionsInfo</span>
        </div>
        <div class="promotions-module">
            <article>
                <div class="promotions-banner"></div>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">50% Deposit Awal Bonus Hingga IDR 1,000,000</li>
                        <li class="txt-gray">
                            Selamat menikmati maksimal bonus MYR 500 dengan deposit anda yang pertama pada Nova88! Mari bergabung SEKARANG!
                        </li>
                        <li>
                            <div class="promotions-type">
                                <ul class="txt-gray">
                                    <li>
                                        <i class="icon icon-transaction"></i>BONUS
                                        <span class="txt-org">@Currency @promotion.Bonus.ToString("#,##0")%</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-gototop"></i>JUMLAH MAKSIMAL BONUS
                                        <span class="txt-org">@Currency @promotion.MaxBonus.ToString("#,##0")</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-sport252"></i>PERPUTARAN
                                        <span class="txt-org">@(promotion.RollOver)x</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-race"></i>SISA WAKTU
                                        <span class="txt-org" id="REMAINING"></span>
                                    </li>
                                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                                    {
                                        <li>
                                            <div class="btn-group">
                                                <button class="btn btn-secondary" id="JOIN">
                                                    <div class="btn__inner">
                                                        <span class="text">Gabung Sekarang</span>
                                                    </div>
                                                </button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">Syarat dan Kondisi Penting</span>
            <article>
                <ol type="i">
                    <li>Promosi ini hanya berlaku untuk akun pemain dengan mata uang @Currency;</li>
                    <li>Diharuskan melakukan deposit pertama untuk emndapatkan bonus.</li>
                    <li>Promosi ini dimulai Dari 00:00:00 (GMT+8) Sampai xxxx 2020 23:59:59 (GMT+8) (“Periode Promosi”).</li>
                    <li>Untuk memenuhi syarat, Pemain harus melakukan Deposit awal dan Pemain tidak boleh melakukan penarikan terlebih dahulu.</li>
                    <li>
                        Bonus hingga @Currency 1.000.000 berdasarkan Jumlah deposit Awal akan dikreditkan ke pemain yang memenuhi syarat dalam waktu 48 jam;
                    </li>
                    <li>
                        Jumlah bonus dan jumlah kualifikasi Deposit yang digunakan tergantung pada persyaratan Rollover sebanyak @promotion.RollOver kali dalam waktu 30 hari, berlaku untuk semua produk Nova88 kecuali Kasino dan juga produk Cash out.
                        <br>
                        <br>Contohnya:
                        <br>
                        <em>
                            - Total deposit: @Currency 3,000,000
                            <br> - Jumlah Bonus = @Currency 3,000,000 X 50% = batas maksimal @Currency 1,000,000
                            <br> - Jumlah Deposit yang memenuhi syarat yang digunakan untuk Bonus = @Currency 1,000,000 / 50% = @Currency 2,000,000
                            <br> - Jumlah Deposit yang tidak digunakan untuk Promosi = @Currency 3,000,000 - @Currency 2,000,000 = @Currency 1,000,000
                            <br> - Syarat Putaran = (@Currency 2,000,000 + @Currency 1,000,000 X @promotion.RollOver) + @Currency 1,000,000 = @Currency 46,000,000
                        </em>
                    </li>
                </ol>
            </article>
            <div class="panel panel-primary panel--payment" data-open="true">
                <div class="panel__header">
                    <span class="txt-blue">SYARAT DAN KETENTUAN SPESIFIK PROMOSI</span>
                    <i class="icon icon-caret"></i>
                </div>
                <div class="panel__body">
                    <article>
                        <ol type="i">
                            <li>
                                Untuk dapat mengklaim bonus, para pemain harus memenuhi persyaratan berikut ("Member yang memenuhi syarat"):
                            </li>
                            <ol>
                                <li>- Telah memilih @Currency sebagai mata uang pilihan</li>
                                <li>
                                    - Telah melakukan deposit awal yang telah disetujui dalam akun @serverInfo.SiteName selama masa periode promosi
                                </li>
                            </ol>
                            <li>
                                Bagi Member yang memenuhi syarat akan diberikan 50% bonus berdasarkan jumlah Deposit pertama yang disetujui selama periode promosi, Dapatkan bonus hingga @Currency 1,000,000 ("Bonus"), seperti yang diilustrasikan sebagai berikut:
                                <br>
                                <div class="table table-rwd table-primary">
                                    <div class="thead">
                                        <div class="tr">
                                            <div class="td-date">
                                                <span class="text">BONUS</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">PRODUK</span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">MAX JUMLAH BONUS (@Currency)</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">SYARAT PUTARAN</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tbody">
                                        <div class="tr row-even">
                                            <div class="td-date">
                                                <span class="text">@promotion.Bonus.ToString("#,##0")%</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">
                                                    Semua Produk @serverInfo.SiteName Kecuali Kasino dan Produk Cash Out
                                                </span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">@promotion.MaxBonus.ToString("#,##0")</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">@(promotion.RollOver)x</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li>
                                Bagi Member yang Memenuhi Syarat harus mengklik tombol “GABUNG SEKARANG” di halaman Syarat dan Ketentuan Khusus Promosi saat masuk ke akun @serverInfo.SiteName mereka di www.@(serverInfo.SiteName).net untuk mengklaim Bonus.
                            </li>
                            <li>
                                Bagi Member yang memenuhi syarat tidak diizinkan untuk membatalkan Bonus setelah dikreditkan ke akun @serverInfo.SiteName mereka.
                            </li>
                            <li>
                                Jumlah Bonus yang diterima dan jumlah Deposit yang memenuhi syarat yang digunakan untuk Bonus @promotion.RollOver kali persyaratan putaran di produk @serverInfo.SiteName Kecuali Casino dan Produk Cash Out, sebelum penarikan dapat dilakukan. Aturan penarikan umum berlaku untuk semua jumlah setoran lainnya yang tidak digunakan untuk promosi.
                                <p>
                                    Contoh:
                                    Member A telah membuat Deposit yang memenuhi syarat selama Periode Promosi sejumlah @Currency 3,000,000. Member A akan mendapatkan Bonus, seperti yang dihitung sebagai berikut:
                                    <br>
                                    <br> - Jumlah Bonus = @Currency 3.000,000 x 50% = Batas maksimal @Currency 1,000,000
                                    <br> - Jumlah Deposit yang memenuhi syarat yang digunakan untuk Bonus = @Currency 1,000,000 / 50% = @Currency 2,000,000
                                    <br> - Jumlah Deposit yang tidak digunakan untuk Promosi = @Currency 3,000,000 – @Currency 2,000,000 = @Currency 1,000,000
                                    <br>
                                    <br>Sebelum melakukan penarikan, pemain yang memenuhi syarat harus mencapai syarat Rolloverebelum penarikan dapat dilakukan, jumlah penuh Bonus dan jumlah Deposit yang memenuhi syarat yang digunakan untuk Bonus terkena persyaratan putaran = (@Currency 2,000,000+ @Currency 1,000,000) x @promotion.RollOver = @Currency 46,000,000.
                                </p>
                            </li>
                            <li>
                                Member yang memenuhi syarat hanya diperbolehkan untuk berpartisipasi pada satu (1) promosi terkait 'Bonus Deposit Awal' yang ditawarkan oleh @serverInfo.SiteName selama Periode Promosi. Jika Member yang memenuhi syarat berpartisipasi di lebih dari satu (1) promosi terkait 'Bonus Deposit Awal' selama Periode Promosi, hanya promosi terkait 'Bonus Deposit Awal' pertama yang diterima oleh @serverInfo.SiteName dari Member yang memenuhi syarat yang akan dianggap berlaku dan partisipasi di seluruh promosi terkait 'Bonus Deposit Awal' lainnya akan dibatalkan.
                            </li>
                            <li>
                                Member yang memenuhi syarat akan didiskualifikasi dari Promosi apabila penarikan dilakukan sebelum Bonus dikreditkan ke akun @serverInfo.SiteName mereka.
                            </li>
                            <li>
                                Hanya taruhan pada produk @serverInfo.SiteName yang menghasilkan menang/kalah yang akan berkontribusi terhadap persyaratan Rollover. Taruhan yang berakhir seri, taruhan yang dibatalkan atau tidak berlaku, taruhan dengan odds kurang dari (Desimal Odds 1.5; Tiongkok Odds 0.5; Malaysia Odds positif 0.5; Indonesia Odds -2.0; Amerika Odds -200),atau taruhan pada dua kemungkinan pada permainan tunggal tidak akan dihitung ke dalam persyaratan ini.
                            </li>
                            <li>
                                Persyaratan putaran akan dianggap terpenuhi jika saldo akun @serverInfo.SiteName Member yang memenuhi syarat kurang dari jumlah taruhan yang diperbolehkan (i.e @Currency 15,000)
                            </li>
                            <li>@serverInfo.SiteName berhak untuk merubah atau menarik Promosi kapan saja.</li>
                            <li>@serverInfo.SiteName adalah penyelenggara tunggal Promosi dan keputusannya adalah final.</li>
                            <li>Berlaku <a class="text-link" href="~/SiteSkin/Nova88/Static/id/Promotion.html" target="_blank">syarat dan ketentuan umum</a> @serverInfo.SiteName.</li>
                        </ol>
                    </article>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(function() {
            $("#REMAINING").html(moment.unix(@promotion.PeriodTo).format('lll'));

            $("#JOIN").on("touchstart, click", function () {
                if (confirm("Are you sure?")) {
                    axios.post('/api/Promotion/SetClaimPromotion/@selLangBLL.GetLangId()', { BonusCode:"@promotion.BonusCode"})
                        .then(function (response) {
                            var result = response.data;
                            if (result.errorCode == 0) {
                                alert("success!");
                                window.location.replace("@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })");
                            } else {
                                alert(result.message);
                            }
                        }.bind(this)).catch(function (error) {
                            alert(error);
                        }.bind(this));
                }
            });
        });
    </script>
}
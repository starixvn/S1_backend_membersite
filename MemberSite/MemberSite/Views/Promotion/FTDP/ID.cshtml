@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject PromotionBLL promotionBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var CurrencyId = selLangBLL.GetPreferCurrencyId();
    if (User.Identity.IsAuthenticated)
    {
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;
    }

    var Currency = selLangBLL.GetResourceValue($"Currency_{CurrencyId}");

    var promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">PromotionsInfo</span>
        </div>
        <div class="promotions-module">
            <article>
                <div class="promotions-banner"></div>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">@Currency 988 First Deposit Bonus Promotion</li>
                        <li class="txt-gray">
                            Enjoy up to @Currency 988 Bonus with your first deposit made in @serverInfo.SiteName! If you
                            are not an @serverInfo.SiteName member yet, join now! Enjoy up to @Currency 988 Bonus with your first deposit
                            made in @serverInfo.SiteName! If you are not an @serverInfo.SiteName member yet, join now! Enjoy
                            up to @Currency 988 Bonus with your first deposit made in @serverInfo.SiteName! If you are not an @serverInfo.SiteName member
                            yet, join now! Enjoy up to @Currency 988 Bonus with your first deposit made in @serverInfo.SiteName! If you are
                            not an @serverInfo.SiteName member yet, join now!
                        </li>
                        <li>
                            <div class="promotions-type">
                                <ul class="txt-gray">
                                    <li>
                                        <i class="icon icon-transaction"></i>BONUS
                                        <span class="txt-org">@Currency @promotion.Bonus.ToString("#,##0") %</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-gototop"></i>MAX
                                        <span class="txt-org">@Currency @promotion.MaxBonus.ToString("#,##0")</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-sport252"></i>ROLL OVER
                                        <span class="txt-org">@promotion.RollOver X</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-race"></i>REMAINING TIME
                                        <span class="txt-org" id="REMAINING"></span>
                                    </li>
                                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                                    {
                                        <li>
                                            <div class="btn-group">
                                                <button class="btn btn-secondary" id="JOIN">
                                                    <div class="btn__inner">
                                                        <span class="text">JOIN NOW</span>
                                                    </div>
                                                </button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">

            <span class="promotions-title">Syarat dan Kondisi Penting</span>
            <article>
                <ol type="i">
                    <li>Promosi ini Hanya berlaku untuk akun Member mata uang @Currency;</li>
                    <li>First Deposit must be made to get Bonus</li>
                    <li>Promosi ini dimulai Dari 00:00:00 (GMT+8) Sampai xxxx 2020 23:59:59 (GMT+8) (“Periode Promosi”).</li>
                    <li>Untuk memenuhi syarat, Pemain harus melakukan Deposit awal dan Pemain tidak  boleh melakukan penarikan terlebih dahulu.</li>
                    <li>
                        Bonus hingga @Currency 1.000.000 berdasarkan Jumlah deposit Awal akan dikreditkan ke pemain yang memenuhi syarat dalam waktu 48 jam;
                    </li>
                    <li>
                        Jumlah Bonus dan Setoran Kualifikasi yang digunakan tunduk pada persyaratan rollover @promotion.RollOver kali dalam 30 hari pada produk @serverInfo.SiteName apa pun, kecuali Kasino dan produk Cash Out.
                        <br>
                        <br> Misalnya:
                        <br>
                        <em>
                            - Total deposit: @Currency 3,000,000
                            <br> - Jumlah Bonus = @Currency 3,000,000 X 50% = batas atas Max @Currency 1,000,000
                            <br> - Jumlah Deposit yang memenuhi syarat yang digunakan untuk Bonus = @Currency 1,000,000/ 50% = @Currency 2,000,000
                            <br> - Jumlah Deposit yang tidak digunakan untuk Promosi = @Currency 3,000,000 - @Currency 2,000,000 = @Currency 1,000,000
                            <br> - Syarat Putaran = (@Currency 2,000,000 + @Currency 1,000,000 X @promotion.RollOver) + @Currency 1,000,000 = @Currency 46,000,000

            <span class="promotions-title">Significant Conditions</span>
            <article>
                <ol type="i">
                    <li>Only available to @Currency account members;</li>
                    <li>First Deposit must be made to get Bonus</li>
                    <li>Have not made a withdrawal request before the Bonus is credited;</li>
                    <li>Members must click on the “Join Now” button to take part;</li>
                    <li>
                        A Bonus of up to @Currency 500 based on the First Deposit amount will be credited within 48 hours;
                    </li>
                    <li>
                        The Bonus and Qualifying Deposit amount used are subject to a 20 times rollover requirement
                        within 30 days on any @serverInfo.SiteName products, except Casino.
                        <br>
                        <br> Example:
                        <br>
                        <em>
                            - Deposit amount: @Currency 1,500
                            <br> - Bonus amount = @Currency 1,500 x 50% = @Currency 500 Capped MAX
                            <br> - Deposit amount used to generate the bonus = @Currency 500/ 50% = @Currency 1,000
                            <br> - Deposit amounts not used for the promotion = @Currency 1,500 – @Currency 1,000 = @Currency 500
                            <br> - Rollover requirement = (@Currency 1,000 + @Currency 500) x 20 + @Currency 500 = @Currency 30,500

                        </em>
                        <br>
                    </li>
                </ol>
            </article>
            <div class="panel panel-primary panel--payment" data-open="true">
                <div class="panel__header">

                    <span class="txt-blue">Syarat dan kondisi spesifik Promosi Lengkap</span>

                    <span class="txt-blue">Full Promotion Specific Terms and Conditions</span>

                    <i class="icon icon-caret"></i>
                </div>
                <div class="promotions-module">
                    <span class="promotions-title">Syarat dan Kondisi Penting</span>
                    <article>
                        <ol type="i">
                            <li>Promosi ini hanya berlaku untuk akun pemain dengan mata uang IDR;</li>
                            <li>Diharuskan melakukan deposit pertama untuk emndapatkan bonus.</li>
                            <li>Promosi ini dimulai Dari 00:00:00 (GMT+8) Sampai xxxx 2020 23:59:59 (GMT+8) (“Periode Promosi”).</li>
                            <li>Untuk memenuhi syarat, Pemain harus melakukan Deposit awal dan Pemain tidak  boleh melakukan penarikan terlebih dahulu.</li>
                            <li>
                                Bonus hingga IDR 1.000.000 berdasarkan Jumlah deposit Awal akan dikreditkan ke pemain yang memenuhi syarat dalam waktu 48 jam;
                            </li>
                            <li>
                                Jumlah bonus dan jumlah kualifikasi Deposit yang digunakan tergantung pada persyaratan Rollover sebanyak 15 kali dalam waktu 30 hari, berlaku untuk semua produk Nova88 kecuali Kasino dan juga produk Cash out.
                                <br>
                                <br>Contohnya:
                                <br>
                                <em>
                                    - Total deposit: IDR 3,000,000
                                    <br> - Jumlah Bonus = IDR 3,000,000 X 50% = batas maksimal IDR 1,000,000
                                    <br> - Jumlah Deposit yang memenuhi syarat yang digunakan untuk Bonus = IDR 1,000,000/ 50% = IDR 2,000,000
                                    <br> - Jumlah Deposit yang tidak digunakan untuk Promosi = IDR 3,000,000 - IDR 2,000,000 = IDR 1,000,000
                                    <br> - Syarat Putaran = (IDR 2,000,000 + IDR 1,000,000 X 15) + IDR 1,000,000 = IDR 46,000,000
                                </em>
                                <br>
                            </li>
                        </ol>
                    </article>
                    <div class="panel panel-primary panel--payment" data-open="true">
                        <div class="panel__header">
                            <span class="txt-blue">Syarat dan kondisi spesifik Promosi Lengkap</span>
                            <i class="icon icon-caret"></i>
                        </div>
                        <div class="panel__body">
                            <article>
                                <ol type="i">
                                    <li>
                                        Untuk dapat mengklaim bonus, para pemain harus memenuhi persyaratan berikut ("Member yang memenuhi syarat"):
                                    </li>
                                    <ol>
                                        <li>- Telah memilih IDR sebagai mata pilihan</li>
                                        <li>
                                            - Telah melakukan deposit awal yang telah disetujui dalam akun Nova88 masa periode promosi
                                        </li>
                                    </ol>
                                    <li>
                                        Bagi Member yang memenuhi syarat akan diberikan 50% bonus berdasarkan jumlah Deposit pertama yang disetujui selama periode promosi, Dapatkan bonus hingga IDR 1,000,000 ("Bonus"), seperti yang diilustrasikan sebagai berikut:
                                        <br>
                                        <div class="table table-rwd table-primary">
                                            <div class="thead">
                                                <div class="tr">
                                                    <div class="td-date">
                                                        <span class="text">BONUS</span>
                                                    </div>
                                                    <div class="td-date">
                                                        <span class="text">PRODUK</span>
                                                    </div>
                                                    <div class="td-time">
                                                        <span class="text">MAX JUMLAH BONUS (IDR)</span>
                                                    </div>
                                                    <div class="td-id">
                                                        <span class="text">SYARAT PUTARAN</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="tbody">
                                                <div class="tr row-even">
                                                    <div class="td-date">
                                                        <span class="text">50%</span>
                                                    </div>
                                                    <div class="td-date">
                                                        <span class="text">
                                                            Semua Produk Nova88 Kecuali Kasino dan Produk Cash Out
                                                        </span>
                                                    </div>
                                                    <div class="td-time">
                                                        <span class="text">1,000,000</span>
                                                    </div>
                                                    <div class="td-id">
                                                        <span class="text">15x</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                    <li>
                                        Bagi Member yang Memenuhi Syarat harus mengklik tombol “GABUNG SEKARANG” di halaman Syarat dan Ketentuan Khusus Promosi saat masuk ke akun Nova88 mereka di www.Nova88.net untuk mengklaim Bonus.
                                    </li>
                                    <li>
                                        Bagi Member yang memenuhi syarat tidak diizinkan untuk membatalkan Bonus setelah dikreditkan ke akun Nova88 mereka.
                                    </li>
                                    <li>
                                        Jumlah Bonus yang diterima dan jumlah Deposit yang memenuhi syarat yang digunakan untuk Bonus 15 kali persyaratan putaran di produk Nova88 Kecuali Casino dan Produk Cash Out, sebelum penarikan dapat dilakukan. Aturan penarikan umum berlaku untuk semua jumlah setoran lainnya yang tidak digunakan untuk promosi.
                                        <p>
                                            Contoh:
                                            Member A telah membuat Deposit yang memenuhi syarat selama Periode Promosi sejumlah IDR 3,000,000. Member A akan mendapatkan Bonus, seperti yang dihitung sebagai berikut:
                                            <br>
                                            <br> - Jumlah Bonus = IDR 3.000,000 x 50% = Batas maksimal IDR 1,000,000
                                            <br> - Jumlah Deposit yang memenuhi syarat yang digunakan untuk Bonus = IDR 1,000,000 / 50% = IDR 2,000,000
                                            <br> - Jumlah Deposit yang tidak digunakan untuk Promosi = IDR 3,000,000 – IDR 2,000,000 = IDR 1,000,000
                                            <br>
                                            <br>Sebelum melakukan penarikan, pemain yang memenuhi syarat harus mencapai syarat Rollover = (IDR 2,000,000+ IDR 1,000,000) x 15 = IDR 46,000,000.
                                        </p>
                                    </li>
                                    <li>
                                        Member yang memenuhi syarat hanya diperbolehkan untuk berpartisipasi pada satu (1) promosi terkait 'Bonus Deposit Awal' yang ditawarkan oleh Nova88 selama Periode Promosi. Jika Member yang memenuhi syarat berpartisipasi di lebih dari satu (1) promosi terkait 'Bonus Deposit Awal' selama Periode Promosi, hanya promosi terkait 'Bonus Deposit Awal' pertama yang diterima oleh Nova88 dari Member yang memenuhi syarat yang akan dianggap berlaku dan partisipasi di seluruh promosi terkait 'Bonus Deposit Awal' lainnya akan dibatalkan.
                                    </li>
                                    <li>
                                        Member yang memenuhi syarat akan didiskualifikasi dari Promosi apabila penarikan dilakukan sebelum Bonus dikreditkan ke akun Nova88 mereka.
                                    </li>
                                    <li>
                                        Hanya taruhan pada produk Nova88 yang menghasilkan menang/kalah yang akan berkontribusi terhadap persyaratan Rollover. Taruhan yang berakhir seri, taruhan yang dibatalkan atau tidak berlaku, taruhan dengan odds kurang dari (Desimal Odds 1.5; Tiongkok Odds 0.5; Malaysia Odds positif 0.5; Indonesia Odds -2.0; Amerika Odds -200),atau taruhan pada dua kemungkinan pada permainan tunggal tidak akan dihitung ke dalam persyaratan ini.
                                    </li>
                                    <li>
                                        Persyaratan putaran akan dianggap terpenuhi jika saldo akun Nova88 Member yang memenuhi syarat kurang dari jumlah taruhan yang diperbolehkan (i.e IDR 15,000)
                                    </li>
                                    <li>Nova88 berhak untuk merubah atau menarik Promosi kapan saja.</li>
                                    <li>Nova88 adalah penyelenggara tunggal Promosi dan keputusannya adalah final.</li>
                                    <li>Berlaku <a class="text-link" href="/SiteSkin/Nova88/Static/id/Promotion.html" target="_blank">syarat dan ketentuan umum </a> Nova88.</li>
                                </ol>
                            </article>
                        </div>
                    </div>
                </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(function() {
            $("#REMAINING").html(moment.unix(@promotion.PeriodTo).format('lll'));

            $("#JOIN").on("touchstart, click", function () {
                if (confirm("Are you sure?")) {
                    axios.post('/api/Promotion/SetClaimPromotion/@selLangBLL.GetLangId()', { BonusCode:"@promotion.BonusCode"})
                        .then(function (response) {
                            var result = response.data;
                            if (result.errorCode == 0) {
                                alert("success!");
                                window.location.replace("@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })");
                            } else {
                                alert(result.message);
                            }
                        }.bind(this)).catch(function (error) {
                            alert(error);
                        }.bind(this));
                }
            });
        });
    </script>
}
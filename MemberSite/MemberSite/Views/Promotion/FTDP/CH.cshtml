@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject PromotionBLL promotionBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var StaticRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Static/{selLangBLL.GetLangId()}");
    int CurrencyId = 0;
    long ExpiryTime = 0;
    Promotion promotion = null;

    if (User.Identity.IsAuthenticated)
    {
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;

        promotion = promotionBLL.GetPromotionListByCustId(custId).FirstOrDefault();
    }
    else
    {
        CurrencyId = selLangBLL.GetPreferCurrencyId();
        promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
    }

    if (promotion.BonusInfoStatus == 0)
    {
        ExpiryTime = promotion.PeriodTo;
    }
    else
    {
        ExpiryTime = new DateTimeOffset(promotion.ExpiryTime.ToUniversalTime(), TimeSpan.Zero).ToUnixTimeSeconds();
    }
    var Currency = selLangBLL.GetResourceValue($"lbl_Currency_{CurrencyId}");
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">PromotionsInfo</span>
        </div>
        <div class="promotions-module">
            <article>
                <div class="promotions-banner" style="background-image: url('@Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Promotion/{promotion.BonusCode}/{selLangBLL.GetLangId()}.png")'); background-position: center top; background-size: cover;"></div>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">50% 歡迎紅利，最高 @Currency 500</li>
                        <li class="txt-gray">
                            在歐亞88完成第一筆存款以享受高達 馬幣500 的優惠回饋！立即加入！
                        </li>
                        <li>
                            <div class="promotions-type">
                                <ul class="txt-gray">
                                    <li>
                                        <i class="icon icon-transaction"></i>優惠
                                        <span class="txt-org"> @promotion.Bonus.ToString("#,##0")%</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-gototop"></i>最高獎金
                                        <span class="txt-org"> @Currency @promotion.MaxBonus.ToString("#,##0")</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-sport252"></i>最低投注倍數
                                        <span class="txt-org"> @(promotion.RollOver)x</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-race"></i>剩餘時間
                                        <span class="txt-org" id="REMAINING"></span>
                                    </li>
                                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                                    {
                                        <li>
                                            <div class="btn-group">
                                                <button class="btn btn-secondary" id="JOIN">
                                                    <div class="btn__inner">
                                                        <span class="text">@selLangBLL.GetResourceValue("lbl_JoinNow")</span>
                                                    </div>
                                                </button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">
                優惠標準規則
            </span>
            <article>
                <ol type="i">
                    <li>此優惠活動使用於貨幣為 @Currency 的新客戶。</li>
                    <li>優惠期限為馬來西亞時間 至 <span id="ExpiryTime"></span>(優惠期間)</li>
                    <li>獲得紅利資格，玩家必須先進行首存，並且沒有申請過提款請求。</li>
                    <li>根據首存存款額，最高 @Currency 500的紅利將在48小時內存入玩家賬戶。</li>
                    <li>
                        在提款前，存款金額和紅利至少需要完成 @promotion.RollOver 倍投注額；在紅利注入的30天，若未完成最低投注，帶來的贏利將被扣除。紅利適用於 @serverInfo.SiteName 所有產品，除了娛樂城和即時兌現。
                        <br>
                        <br>舉例：
                        <br>
                        <em>
                            - 存款金額 = 1,500 @Currency
                            <br> - 優惠紅利 = 1,500 @Currency X 50% = 封頂紅利500 @Currency
                            <br> - 用於申請獎金的部分 = 封頂獎金500 @Currency / 50% = 1,000 @Currency
                            <br> - 沒有申請獎金的部分 = 1,500 @Currency – 1,000 @Currency = 500 @Currency
                            <br> - 最低投注額 = (1,000 @Currency + 500 @Currency) x @promotion.RollOver + 500 @Currency = 23,000 @Currency
                        </em>
                    </li>
                </ol>
            </article>
            <div class="panel panel-primary panel--payment" data-open="true">
                <div class="panel__header">
                    <span class="txt-blue">完整優惠標準規則</span>
                    <i class="icon icon-caret"></i>
                </div>
                <div class="panel__body">
                    <article>
                        <ol type="i">
                            <li>
                                本優惠適用於以下會員（“符合資格的會員”）：
                            </li>
                            <ol>
                                <li>首選貨幣是 @Currency</li>
                                <li>
                                    優惠期間，在 @serverInfo.SiteName 有首次成功的存款(“有效存款”)。
                                </li>
                            </ol>
                            <li>
                                優惠期間，符合以上優惠資格的會員，可享有一次50%首存存款獎金，最高為500 @Currency（“獎金”），詳情如下：
                                <br>
                                <div class="table table-rwd table-primary">
                                    <div class="thead">
                                        <div class="tr">
                                            <div class="td-date">
                                                <span class="text">優惠</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">產品</span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">最高獎金（@Currency）</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">最低投注倍數</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tbody">
                                        <div class="tr row-even">
                                            <div class="td-date">
                                                <span class="text">@promotion.Bonus.ToString("#,##0")%</span>
                                            </div>
                                            <div class="td-date">
                                                <span class="text">所有 @serverInfo.SiteName 產品，除了娛樂城與即時兌現.</span>
                                            </div>
                                            <div class="td-time">
                                                <span class="text">@promotion.MaxBonus.ToString("#,##0")</span>
                                            </div>
                                            <div class="td-id">
                                                <span class="text">@(promotion.RollOver)x</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li>
                                符合資格的會員請登錄 @serverInfo.SiteName 網站，進入優惠頁面，點擊特定的優惠規則與條款，在上方點擊"立即加入"即可。
                            </li>
                            <li>
                                優惠獎金注入後，會員將不能申請取消。
                            </li>
                            <li>
                                會員申請優惠的存款金額和獎金需要在 @serverInfo.SiteName 達到指定獎金的投注要求後，才可申請提款。此優惠獎金最低投注金額倍數為 @promotion.RollOver 倍。此投注要求會且僅計算 @serverInfo.SiteName 產品，除了娛樂城與即時兌現。
                                <p>
                                    舉例: 會員A在優惠期間成功存款了1,500 @Currency, 以下是本優惠最低投注需求演算法;
                                    <br>
                                    <br> - 優惠獎金 = 1,500 @Currency x 50% = 封頂獎金500 @Currency
                                    <br> - 用於申請獎金的部分 = 封頂獎金500 @Currency / 50% = 1,000 @Currency
                                    <br> - 沒有申請獎金的部分 = 1,500 @Currency – 1,000 @Currency = 500 @Currency
                                    <br>
                                    <br>會員A在申請提款前必須完成的最低投注額 = (1,000 @Currency + 500 @Currency) x @promotion.RollOver + 500 @Currency = 23,000 @Currency.
                                </p>
                            </li>
                            <li>
                                符合資格的會員在優惠期間只能領取一次“首存優惠獎金”，如果會員在優惠期間申請了多次“首存優惠獎金”，只有第一筆的“首存優惠獎金”被視為有效，而其他申請將被視為無效。
                            </li>
                            <li>
                                在獎金未註入您的賬號之前請勿提款，否則將失去領取獎金的資格。
                            </li>
                            <li>
                                有效投注額僅計算在 @serverInfo.SiteName 投注產生輸贏結果的注單。即時兌現，注單取消或本金退還，任何賠率低於標準盤1.5、中國盤0.5、馬來盤正數賠率0.5、印尼盤-2.0、美國盤-200的投注，及在同一局遊戲中同時投注對等盤口，或在娛樂城的注單將不計算為有效投注額內。
                            </li>
                            <li>
                                當會員的投注額未達到上述條款要求，且帳戶現金餘額少於5 @Currency 時，則無需繼續履行此優惠規則與條款。
                            </li>
                            <li>@serverInfo.SiteName 有權隨時中止或取消本優惠。</li>
                            <li>@serverInfo.SiteName 保留對本優惠的最終解釋權。</li>
                            <li>@serverInfo.SiteName <a class="text-link" href="@StaticRootPath/Promotion.html" target="_blank">標準規則和條款</a>適用。</li>
                        </ol>
                    </article>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(function () {

            const diff = moment.duration(moment.unix(@promotion.PeriodTo).diff(new Date()))
            $("#REMAINING").html(diff.days() + " 天" + diff.hours() + " 小時" );
            $("#ExpiryTime").html(moment.unix(@ExpiryTime).format('lll'));


            $("#JOIN").on("touchstart, click", function () {
                if (confirm("@Html.Raw(selLangBLL.GetResourceValue("lbl_BonusConfirm"))")) {
                    axios.post('/api/Promotion/SetClaimPromotion/@selLangBLL.GetLangId()', { BonusCode:"@promotion.BonusCode"})
                        .then(function (response) {
                            var result = response.data;
                            if (result.errorCode == 0) {
                                alert("@Html.Raw(selLangBLL.GetMsg("msg_Updatesuccessful"))");
                                window.location.replace("@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })");
                            } else {
                                alert(result.message);
                            }
                        }.bind(this)).catch(function (error) {
                            alert(error);
                        }.bind(this));
                }
            });
        });
    </script>
}
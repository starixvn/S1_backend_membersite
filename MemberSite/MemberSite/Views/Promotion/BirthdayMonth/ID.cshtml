@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Promosi</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-BirthdayMonth.jpg" alt="" style="display: block;width: 100%;" />
        </div>
        <div class="promotions-module">
            <h2>Bonus Bulan Kelahiran</h2>

        </div>
        <div class="promotions-module">
            <span class="promotions-title">Ketentuan umum</span>
            <ol type="a">
                <li>Promosi berlaku untuk semua anggota Nova88.<br><br></li>
                <li>Semua member berhak untuk mengklaim bonus pada bulan kelahirannya.<br><br></li>
                <li>Hubungi customer service kami melalui Live chat untuk mengklaim bonus anda<br><br></li>
                <li>wajib melampirkan ID valid anda kepada customer service kami untuk tujuan verifikasi<br><br></li>
                <li>setelah identitas berhasil terverifikasi, customer kami akan memproses bonus bulan kelahiran anda<br><br></li>
                <li>Member wajib mencapai TO x1 untuk bisa melakukan penarikan<br><br></li>
            </ol>

            <span class="promotions-title">Ketentuan Bonus:</span>
            <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                <tr>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;" colspan="4">
                        Bonus Bulan Kelahiran
                    </th>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center; color:#000000">MYR 388</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center; color:#000000">THB 2,888</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center; color:#000000">IDR 1,300,000</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center; color:#000000">1x Rollover</td>
                </tr>
            </table>
            <br><br>

            <span class="promotions-title">Syarat dan ketentuan</span>
            <ol type="1">
                <li>promosi ini berlaku dalam bulan kelahiran member. member berhak mengklaim bonus satu kali (1x) dalam setahun<br><br></li>
                <li>Bonus Bulan kelahiran akan di kreditkan ke akun member yang telah terverifikasi.<br><br></li>
                <li>Bonus berlaku selama tiga puluh (30) hari setelah diberlakukan. kemenangan dari bonus akan di hapuskan dari member tidak terpenuhi dalam jangka waktu yang diberikan.<br><br></li>
                <li>Hanya taruhan yang ditempatkan pada produk Nova88 yang menghasilkan hasil win-loss yang berkontribusi pada persyaratan turnover satu kali (1x) di semua produk Nova88 kecuali Cash out. Taruhan yang dibatalkan atau dibatalkan tidak akan diperhitungkan dalam persyaratan ini.<br><br></li>
                <li>Member yang berpartisipasi harus mematuhi semua persyaratan yang disebutkan di atas serta semua peraturan dan ketentuan yang dinyatakan di situs web Nova88.<br><br></li>
                <li>Nova88 berhak untuk mengubah promosi kapanpun.<br><br></li>
                <li>Nova88 adalah penyelenggara tunggal Promosi dan keputusannya adalah final.<br><br></li>
                <li>Berlaku syarat dan ketentuan Umum Nova88.<br><br></li>
            </ol>

        </div>
    </div>
</div>
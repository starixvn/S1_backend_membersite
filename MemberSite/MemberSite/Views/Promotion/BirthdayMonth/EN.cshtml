@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Promotion</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-BirthdayMonth.jpg" alt="" style="display: block;width: 100%;" />
        </div>
        <div class="promotions-module">
            <h2>Birthday Month Bonus</h2>

        </div>
        <div class="promotions-module">
            <span class="promotions-title">Significant Conditions</span>
            <ol type="a">
                <li>This Promotion applied to all Nova88 Members.<br><br></li>
                <li>All members entitle to claim the bonus on your birthday month only.<br><br></li>
                <li>Contact Customer Service via Live Chat to claim your birthday bonus.<br><br></li>
                <li>A valid Photo ID are required by Customer Service for verification purposes.<br><br></li>
                <li>Once identity successfully verified, customer service will proceed the birthday bonus claimed.<br><br></li>
                <li>Member are require to one time (1x) rollover for the bonus before making withdrawal<br><br></li>
            </ol>

            <span class="promotions-title">Bonus Conditions:</span>
            <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                <tr>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;" colspan="4">Birthday Month Bonus</th>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">MYR 388</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">THB 2,888</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">IDR 1,300,000</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">1x Rollover</td>
                </tr>
            </table>
            <br><br>

            <span class="promotions-title">Terms and Conditions</span>
            <ol type="1">
                <li>This promotion is only valid during the member’s birthday month only. One member will only be entitled to apply once a year.<br><br></li>
                <li>Bonus funds will be credited to the selected wallet after verification.<br><br></li>
                <li>Bonus are valid for thirty (30) days upon issuance unless stated otherwise. Money won using bonus funds will be removed from the member’s account if prerequisites are not fulfilled within the given time frame.<br><br></li>
                <li>Only wagers in Nova88 that generate a win/loss return will be contributed to the rollover requirement. Cash Out, cancelled, void wagers, or wagers on both even-chances during a single game will not count towards this requirement.<br><br></li>
                <li>Participating members must accept and comply with all the terms mentioned above as well as all relevant rules and regulations stated on the Nova88 website.<br><br></li>
                <li>Nova88 reserves the right to amend or withdraw the Promotion at any time.<br><br></li>
                <li>Nova88 is the sole arbiter of the Promotion and its decision is final.<br><br></li>
                <li>Nova88 Standard Terms and Conditions apply.<br><br></li>
            </ol>

        </div>
    </div>
</div>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">优惠活动</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-BirthdayMonth.jpg" alt="" style="display: block;width: 100%;" />
        </div>
        <div class="promotions-module">
            <h2>生日月份大优惠</h2>

        </div>
        <div class="promotions-module">
            <span class="promotions-title">优惠标准规则</span>
            <ol type="a">
                <li>促销适用于所有Nova88会员。<br><br></li>
                <li>所有会员都享有在生日月份领取奖金。<br><br></li>
                <li>联系Nova88 在线客服以索取您的生日奖金。<br><br></li>
                <li>请提交附有照片的身份证予在线客服以进行验证。<br><br></li>
                <li>成功验证身份后，在线客服将会汇入生日奖金。<br><br></li>
                <li>优惠金额必须进行1X的流水投注才能提款。<br><br></li>
            </ol>

            <span class="promotions-title">优惠奖励条件:</span>
            <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                <tr>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;" colspan="4">
                        生日月份优惠
                    </th>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">MYR 388</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">THB 2,888</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">IDR 1,300,000</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">1x Rollover</td>
                </tr>
            </table>
            <br><br>

            <span class="promotions-title">优惠标准规则</span>
            <ol type="1">
                <li>此促销仅在会员的生日月份内有效。 每位会员每年只能申请一次生日奖金。<br><br></li>
                <li>优惠奖金将在验证后汇入账号钱包。<br><br></li>
                <li>除非另有说明，否则从此次促销中获得的奖金在汇入的三十（30）天内有效。参加会员在指定的时间内未能达到要求的条件，所有优惠奖金将被撤销.<br><br></li>
                <li>有效投注额仅计算在 Nova88 投注产生输赢结果的注单。即时兑现，注单取消或本金退还，及在同一局游戏中同时投注对等盘口的注单将不计算为有效投注额内。<br><br></li>
                <li>参与优惠会员必须接受并遵守上述所有条款以及Nova88实施的所有相关规则和规定。<br><br></li>
                <li>Nova88有权随时中止或取消本优惠。<br><br></li>
                <li>Nova88保留对本优惠的最终解释权。<br><br></li>
                <li>Nova88标准规则和条款适用。<br><br></li>
            </ol>

        </div>
    </div>
</div>
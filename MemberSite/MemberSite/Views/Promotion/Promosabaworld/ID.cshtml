@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Promotion Info</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-sabaworldcup.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>


        <div class="promotions-module">
            <article>
                    <span class="promotions-title txt-blue">SABA PIALA DUNIA  2020 - BONUS PUTARAN GRATIS</span>
            </article>
        </div>
            <div class="promotions-module">
                
                <span class="promotions-title">Syarat dan Kondisi Penting</span>
                    <ol type="1">
                        <li>Semua member yang aktif akan secara otomatis berhak dapatkan Bonus Putaran Gratis  SABA Piala Dunia 2020 selama periode promosi hanya di Nova88.<br><br></li>
                        <li>Bonus 10 putaran gratis pada permainan yang dipilih untuk setiap pertandingan tunggal di pertandingan SABA Piala Dunia.<br><br></li>
                        <li>Satu pemenang untuk setiap pertandingan tunggal di turnamen SABA Piala Dunia dari Tanggal 16 April hingga 22 April 2020<br><br></li>
                        <li>Kami memberikan total 640 Putaran Gratis dalam periode SABA Piala Dunia untuk member dari setiap mata uang ,berdasarkan pada MYR, IDR & THB, (640x3) total 1920 hadiah Gratis Putaran sedang menunggu Anda.<br><br></li>
                    </ol>

                <span class="promotions-title">Ketentuan Bermain Bonus</span>
                    <ol type="a">
                        <li>Setiap pemenang pertandingan tunggal dengan Turnover Tertinggi hanya untuk pertandingan SABA Piala Dunia.<br><br></li>
                        <li>Bonus pemenang akan dihitung pada akhir harinya dan akan dirilis dalam waktu 48 jam.<br><br></li>
                        <li>Layanan pelanggan kami akan menginformasikan bagi Member yang menang untuk mengklaim Gratis Putaran di Permainan Nova88 pilihan kami.<br><br></li>
                        <li>Permainan gratis yang dipilih akan memunculkan 10 PUTARAN yang Diberikan setelah Anda memasuki permainan berikut yang disediakan oleh Pelayanan pelanggan kami.<br><br></li>
                    </ol>
                
                <span class="promotions-title">Syarat dan ketentuan</span>
                    <ol type="1">
                        <li>Taruhan yang dibatalkan atau Taruhan ditempatkan dibatalkan, karena itu tidak akan dihitung sebagai Turnover yang valid.<br><br></li>
                        <li>Bonus harus diklaim dalam seminggu ( 7 Hari ), setelah bonus dikreditkan.<br><br></li>
                        <li>Putaran bonus akan hangus setelah periode klaim (7 hari) seminggu kemudian.<br><br></li>
                        <li>Promosi ini akan otomatis berlaku untuk semua Member Nova88.<br><br></li>
                        <li>Bagi Member yang berpartisipasi harus menerima dan mematuhi semua persyaratan yang disebutkan di atas serta semua peraturan dan ketentuan yang relevan yang dinyatakan di situs web Nova88.<br><br></li>
                        <li>Nova88 berhak untuk mengubah atau menarik promosi setiap saat. <br><br></li>
                        <li>Nova88 adalah penyelenggara tunggal Promosi dan keputusannya adalah final.<br><br></li>
                        <li>Nova88 syarat dan ketentuan standar berlaku.<br><br></li>
                    </ol>
            </div>       
       
    </div>
</div>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var lang = selLangBLL.GetLangId();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Promotion</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-FantasyDay.jpg" alt="" style="display: block;width: 100%;" />
        </div>
        <div class="promotions-module">
            <h2>Fantasy Nova88 Day</h2>

        </div>
        <div class="promotions-module">
            <span class="promotions-title">Significant Conditions</span>
            <ol type="a">
                <li>Promotion applied to all Nova88 members.<br><br></li>
                <li>This is Nova88 Day special bonus, it’s available on the selected date of only.<br><br></li>
                <li>Promotion date are on 8th, 18th & 28th August 2020 from 00:00:00 (GMT+8) to 23:59:59 (GMT+8)<br><br></li>
                <li>Each members are entitle to claimed once on any day of the promotion date. (8th , 18th & 28th)<br><br></li>
                <li>Members are required to meet the daily turnover target on the promotion date only.<br><br></li>
                <li>Cash prize will be release to member within 48 hours after the cut off time.<br><br></li>
                <li>Winners are required to contact Customer Support within 14 days upon the personal message sent to member's inbox. Any redemption request after the 14 days will be forfeited.<br><br></li>
                <li>Once identity successfully verified, customer service will proceed the cash prize claimed.<br><br></li>
            </ol>


            <span class="promotions-title">Promotion particulars are as illustrated below:</span>
            <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                <tr>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;" colspan="2">
                        Fantasy Nova88 Day Cash Prize
                    </th>
                </tr>
                <tr>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        Turnover Target (on date)
                    </th>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        Cash
                    </th>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">MYR 88,888</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">MYR 888</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">THB 688,888</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">THB 6,888</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">IDR 300 Juta</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">IDR 3 Juta</td>
                </tr>
            </table>
           

            <span class="promotions-title">Terms and Conditions:</span>
            <ol type="1">
                <li>Only wagers in Nova88 that generate a win/loss return will be contributed to the rollover requirement. Cash Out, cancelled, void wagers, or wagers on both even-chances during a single game will not count towards this requirement.<br><br></li>
                <li>Participating members must accept and comply with all the terms mentioned above as well as all relevant rules and regulations stated on the Nova88 website.<br><br></li>
                <li>Nova88 reserves the right to amend or withdraw the Promotion at any time.<br><br></li>
                <li>Nova88 is the sole arbiter of the Promotion and its decision is final.<br><br></li>
                <li>Berlaku <a class="text-link" href="https://www.nova88asia.com/SiteSkin/Nova88/Static/@lang/Promotion.html" target="_blank">syarat dan ketentuan umum</a> Nova88.<br><br></li>
            </ol>

        </div>
    </div>
</div>
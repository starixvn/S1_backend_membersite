@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var lang = selLangBLL.GetLangId();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Promosi</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-FantasyDay.jpg" alt="" style="display: block;width: 100%;" />
        </div>
        <div class="promotions-module">
            <h2>Fantasi Harian Nova88</h2>

        </div>
        <div class="promotions-module">
            <span class="promotions-title">Ketentuan umum</span>
            <ol type="a">
                <li>Promosi berlaku untuk semua Member Nova88.<br><br></li>
                <li>Ini merupakan bonus special dari Nova88. hanya berlaku pada hari tertentu saja.<br><br></li>
                <li>Promosi berlaku pada tanggal 8, 18, dan 28 agustus 2020 pda jam 00:00:00 (GMT+8) sampai 23:59:59 (GMT+8)<br><br></li>
                <li>Setiap member hanya dapatmengklaim satu kali pada tanggal promosi (8, 18, dan 28)<br><br></li>
                <li>Member wajib mencapai turnover harian pada tanggal promosi<br><br></li>
                <li>Hadiah uang akan melepaskan kepada member dalam kurun waktu 48 jam setelah batas akhir promosi <br><br></li>
                <li>Pemenang wajib menghubungi customer service dalam waktu 14 hari sejak pesan dikirim kepada kotak pesan member. jika melebihi 14 hari akan dianggap hangus<br><br></li>
                <li>Setelah identitas berhasil terverifikasi, customer service akan memproses klaim hadiah anda<br><br></li>
            </ol>


            <span class="promotions-title">Informasi promosi seperti diilustrasikan di bawah ini:</span>
            <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                <tr>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;" colspan="2">
                        Fantasi Harian Nova88 Hadiah Uang
                    </th>
                </tr>
                <tr>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        Turnover Target (on date)
                    </th>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        Cash
                    </th>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">MYR 88,888</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">MYR 888</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">THB 688,888</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">THB 6,888</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">IDR 300 Juta</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">IDR 3 Juta</td>
                </tr>
            </table>
           

            <span class="promotions-title">Syarat dan ketentuan:</span>
            <ol type="1">
                <li>Hanya taruhan di Nova88 yang menghasilkan menang/klaah yang akan dikontribusikan ke persyaratan rollover. Cash out, membatalkan, membatalkan taruhan, atau bertaruh pada peluang sama selama satu pertandingan tidak akan diperhitungkan dalam persyaratan ini.<br><br></li>
                <li>Member yang berpartisipasi harus mematuhi semua persyaratan yang disebutkan di atas serta semua peraturan dan ketentuan yang dinyatakan di situs web Nova88.<br><br></li>
                <li>Nova88 berhak untuk mengubah promosi kapanpun.<br><br></li>
                <li>Nova88 adalah penyelenggara tunggal Promosi dan keputusannya adalah final.<br><br></li>
               <li>Berlaku <a class="text-link" href="https://www.nova88asia.com/SiteSkin/Nova88/Static/@lang/Promotion.html" target="_blank">syarat dan ketentuan umum</a> Nova88.<br><br></li>
            </ol>

        </div>
    </div>
</div>
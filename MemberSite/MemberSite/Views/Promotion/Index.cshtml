@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@inject SelLangBLL selLangBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    Dictionary<string, string> i18n = new Dictionary<string, string>();
    i18n.Add("lbl_Bonus", selLangBLL.GetResourceValue("lbl_Bonus"));
    i18n.Add("lbl_MaxBonusAmount", selLangBLL.GetResourceValue("lbl_MaxBonusAmount"));
    i18n.Add("lbl_RollOver", selLangBLL.GetResourceValue("lbl_RollOver"));
    i18n.Add("lbl_RemainingTime", selLangBLL.GetResourceValue("lbl_RemainingTime"));
    i18n.Add("lbl_ExpiryTime", selLangBLL.GetResourceValue("lbl_ExpiryTime"));
    i18n.Add("lbl_BonusAmount", selLangBLL.GetResourceValue("lbl_BonusAmount"));
    i18n.Add("lbl_DepositRollOver", selLangBLL.GetResourceValue("lbl_DepositRollOver"));
    i18n.Add("lbl_BonusRollOver", selLangBLL.GetResourceValue("lbl_BonusRollOver"));

    string[] lbl_Txts = new string[] { "lbl_TC" };
    foreach (var lbl_Txt in lbl_Txts)
    {
        if (!i18n.ContainsKey(lbl_Txt))
            i18n.Add(lbl_Txt, selLangBLL.GetResourceValue(lbl_Txt));
    }

    for (var currencyId = 0; currencyId <= 51; currencyId++)
    {
        var ccr = selLangBLL.GetResourceValue($"Currency_{currencyId}");
        if (ccr != null)
            i18n.Add($"Currency_{currencyId}", ccr);
    }
}

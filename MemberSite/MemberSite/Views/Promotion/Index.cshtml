@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@inject SelLangBLL selLangBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    Dictionary<string, string> i18n = new Dictionary<string, string>();
    i18n.Add("lbl_Bonus", selLangBLL.GetResourceValue("lbl_Bonus"));
    i18n.Add("lbl_MaxBonusAmount", selLangBLL.GetResourceValue("lbl_MaxBonusAmount"));
    i18n.Add("lbl_RollOver", selLangBLL.GetResourceValue("lbl_RollOver"));
    i18n.Add("lbl_RemainingTime", selLangBLL.GetResourceValue("lbl_RemainingTime"));
    i18n.Add("lbl_ExpiryTime", selLangBLL.GetResourceValue("lbl_ExpiryTime"));
    i18n.Add("lbl_BonusAmount", selLangBLL.GetResourceValue("lbl_BonusAmount"));
    i18n.Add("lbl_DepositRollOver", selLangBLL.GetResourceValue("lbl_DepositRollOver"));
    i18n.Add("lbl_BonusRollOver", selLangBLL.GetResourceValue("lbl_BonusRollOver"));

    string[] lbl_Txts = new string[] { "lbl_TC" };
    foreach (var lbl_Txt in lbl_Txts)
    {
        if (!i18n.ContainsKey(lbl_Txt))
            i18n.Add(lbl_Txt, selLangBLL.GetResourceValue(lbl_Txt));
    }

    for (var currencyId = 0; currencyId <= 51; currencyId++)
    {
        var ccr = selLangBLL.GetResourceValue($"Currency_{currencyId}");
        if (ccr != null)
            i18n.Add($"Currency_{currencyId}", ccr);
    }
}
<div class="main">
    @if (User.Identity.IsAuthenticated)
    {
        <partial name="~/Views/Shared/_DesktopLeftMenu.cshtml" />
    }
    <div class="page-title" role="mobile-only">
        <span class="text">@selLangBLL.GetResourceValue("lbl_Promotions")</span>
    </div>
    <div class="promotionsList-page page">
        <div class="heading">
            <span class="text">@selLangBLL.GetResourceValue("lbl_PromotionsList")</span>
        </div>
        @*<form>
                <div class="form-row form-row--bg">
                    <div class="form-group flex-2">
                        <ul>
                            <li>
                                <i class="icon icon-all"></i>ALL(
                                <span>12</span>)
                            </li>
                            <li>
                                REDEPOSIT BONUS(
                                <span>12</span>)
                            </li>
                            <li>
                                REBATE(
                                <span>12</span>)
                            </li>
                            <li>
                                SPECIAL BONUS(
                                <span>12</span>)
                            </li>
                            <li>
                                OVER(
                                <span>12</span>)
                            </li>
                            <li>
                                <div class="form-group">
                                    <label class="form-title">DATE</label>
                                    <a class="btn">
                                        <i class="icon icon-caret"></i>
                                    </a>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </form>*@
        <!--Group-start-->
        <div id="promotions"></div>
        <!--Group-end-->
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
    </script>
    <script src="~/lib/runtime.min.js"></script>
    @*<script src="~/lib/clipboard.min.js"></script>*@
    <script src="~/js/component/Promotion/promotions.min.js" asp-append-version="true"></script>
}

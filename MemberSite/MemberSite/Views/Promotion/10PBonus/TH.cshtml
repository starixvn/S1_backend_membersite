@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Promotion Info</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-promo10.png" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <article>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">ฝากเงินครั้งแรก รับโบนัส 10% สูงสุดถึง  THB5000</li>
                        
                        <li>
                            <div class="promotions-type">
                                <ul class="txt-gray">
                                    <li>
                                        <i class="icon icon-transaction"></i>โบนัส
                                        <span class="txt-org"> 10%</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-gototop"></i>จำนวนโบนัสสูงสุด
                                        <span class="txt-org"> THB 5000</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-sport252"></i>ยอดหมุนเวียน
                                        <span class="txt-org"> 1x</span>
                                    </li>
                                    
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">ข้อตกลงและเงื่อนไข</span>
            <article>
                <ol type="i">
                    <li>รับทันทีโบนัส 10% สำหรับสมาชิกใหม่ที่เพิ่งฝากเงินกับเรา</li>
                    <li>คลิ๊กที่ สมัครที่นี่ เพื่อร่วมสนุกกับโปรโมชั่นนี้</li>
                    <li>โบนัสสูงสุด 5000 บาทสำหรับการฝากเงินครั้งแรกจะถูกโอนไปยังบัญชีที่ผ่านการพิจารณาภายใน 48 ชั่วโมงหลังฝาก</li>
                    <li>โบนัสและเงินฝากที่มีคุณสมบัติตามที่กำหนดนั้น ขึ้นอยู่กับการทำยอดเดิมพันหมุนเวียนให้ครบ 1 ครั้ง ในเกมทั้งหมดของ NOVA88  ยกเว้นคาสิโน, ไลฟ์คาสิโน, เวอร์ชวลเกม, โปกเกอร์, เกมตกปลา, เกมหมากรุก และการแลกเงินสด (Cash Out)</li>
                    <li>ผู้เล่นมีสิทธิ์เข้าร่วมโปรโมชั่น (1) โบนัสเงินฝากครั้งแรกที่ได้รับอนุมัติโดย NOVA88 เพียงครั้งเดียวเท่านั้น</li>
                    <li>โปรโมชั่น เริ่มตั้งแต่ วันที่ 5 มีนาคม 12:01 (GMT+8) จนถึง 1 เมษายน 23:59 (GMT+8)</li>
                    <li>NOVA88 ขอสงวนสิทธิ์ในการแก้ไขหรือยกเลิกโปรโมชั่นได้ตลอดเวลา</li>
                </ol>
            </article>
            <div class="panel panel-primary panel--payment" data-open="true">
                <div class="panel__header">
                    <span class="txt-blue">3 ขั้นตอนง่ายๆที่จะได้รับโปรโมชั่นนี้</span>
                    <i class="icon icon-caret"></i>
                </div>
                <div class="panel__body">
                    <p>1. สมัครกับ NOVA88</p>
                    <p>2. ฝากเงินกับเรา</p>
                    <p>3. ติดต่อ Live Chat</p>
                </div>
            </div>
        </div>
    </div>
</div>
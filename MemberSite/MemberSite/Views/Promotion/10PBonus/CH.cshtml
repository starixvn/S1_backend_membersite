@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Promotion Info</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-promo10.png" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <article>
                <div class="promotions-txt">
                    <ul>
                        <li class="txt-blue">10% 存款红利高达 MYR500 第一次存款</li>

                        <li>
                            <div class="promotions-type">
                                <ul class="txt-gray">
                                    <li>
                                        <i class="icon icon-transaction"></i>優惠
                                        <span class="txt-org"> 10%</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-gototop"></i>最高獎金
                                        <span class="txt-org"> MYR 500</span>
                                    </li>
                                    <li>
                                        <i class="icon icon-sport252"></i>最低投注倍數
                                        <span class="txt-org"> 1x</span>
                                    </li>

                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </article>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">
                條款與規則
            </span>
            <article>
                <ol type="i">
                    <li>所有新會員能享受第一筆存款的10%免費投注</li>
                    <li>請按 「 立即加入. 」 即可獲得優惠資格 </li>
                    <li>根據首存存款額，最高 馬幣 500 的紅利將在48小時記憶體入玩家帳戶。</li>
                    <li>此優惠獎金與首存有效投注額在Nova88產品（除了娛樂城與即時兌現）進行1倍投注後，才可申請提款。</li>
                    <li>符合資格的會員只能參加歐亞體育提供的一（1）個「首次存款獎金」相關促銷活動 </li>
                    <li>促銷期：2020年3月5日中午12:01至2020年4月1日上午11:59（GMT + 8）</li>
                    <li>
                        Nova88 有權隨時中止或取消本優惠 並 保留對本優惠的最終解釋權。<br>
                        Nova88 標準規則和條款適用。
                    </li>

                </ol>
            </article>
            <div class="panel panel-primary panel--payment" data-open="true">
                <div class="panel__header">
                    <span class="txt-blue">三個簡單的步驟</span>
                    <i class="icon icon-caret"></i>
                </div>
                <div class="panel__body">
                    <p>1.立即加入“歐亞體育”</p>
                    <p>2.進行首存存款 </p>
                    <p>3.聯繫實時聊天並提供屏幕截圖為證明</p>
                </div>
            </div>
        </div>
    </div>
</div>
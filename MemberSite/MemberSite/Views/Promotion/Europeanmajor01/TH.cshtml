@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-Europeanmajor01.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <h2>4 EUROPEAN เมเจอร์ลีค</h2>
            <h2>คืนเงินเทิร์นโอเวอร์ 0.3% สูงสุดถึง 8,888 บาท</h2>
            
        </div>
        <div class="promotions-module">
             <span class="promotions-title">เงื่อนไขที่สำคัญ</span>
                <ol type="a">
                    <li>สมาชิกทั้งหมดของ Nova88 สามารถเข้าร่วมโปรโมชั่นนี้ได้โดยอัตโนมัติ<br><br></li>
                    <li>โปรโมชั่นนี้ให้สิทธิ์กับ 4 ลีคหลักเท่านั้นคือ Premier League พรีเมียร์ลีค, Laliga ลาลีกา, Serie A กัลโช่ เซเรียอา และ Bundesliga บุนเดสลีกา<br><br></li>
                    <li>เพื่อให้บรรลุจำนวนเงินเดิมพันที่ถูกต้องสำหรับการจ่ายเงินขั้นต่ำก่อนเวลา cut off ในทุกวันจันทร์ 11:59:59 (GMT + 8) โดยนับจากในช่วงระยะเวลาโปรโมชั่นที่ Nova88 กำหนดเท่านั้น<br><br></li>
                    <li>เงินคืนจะได้รับคืนเป็นเครดิตภายใน 48 ชั่วโมงถัดไปหลังจากเวลา cut off.<br><br></li>
                    <li>สมาชิกจะต้องทำยอดการหมุนเวียนหนึ่งครั้ง (1x) สำหรับการคืนเงินก่อนที่จะทำการถอน<br><br></li>
                </ol>

            <span class="promotions-title">เงื่อนไขการเล่นโบนัส</span>
            <div class="table table-rwd table-primary">
                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">โบนัส 0.3% (สกุลเงิน)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">การจ่ายเงินขั้นต่ำ</span>
                        </div>
                        <div class="td-date">
                            <span class="text">การจ่ายเงินสูงสุด (ต่อยอด)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">เทิร์นโอเวอร์</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">MYR</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 10</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 999</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">IDR</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR 30,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR3,000,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">THB</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 100</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 8,888</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">RMB</span>
                        </div>
                        <div class="td-date">
                            <span class="text">RMB 10</span>
                        </div>
                        <div class="td-date">
                            <span class="text">RMB 1500</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>



            </div>
            <br><br>
            <span class="promotions-title">ตัวอย่างเช่น:</span>
                <ol type="a">
                    <li>การจ่ายเงินหมุนเวียนขั้นต่ำรายสัปดาห์เริ่มต้นที่ 33,300 บาท x 0.3% = 100 บาทต่อสมาชิก<br><br></li>
                    <li>การจ่ายเงินหมุนเวียนสูงสุดต่อสัปดาห์อยู่ที่ 9,000 บาท x 0.3% = 8,888 บาทต่อสมาชิก<br><br></li>
                </ol>

            <span class="promotions-title">ข้อกำหนดและเงื่อนไข:</span>
                <ol type="1">
                    <li>โปรโมชั่นนี้สำหรับสมาชิก Nova88 ทุกคน<br><br></li>
                <li>การคืนเงินจะมีระยะเวลาสามสิบ (30) วันเมื่อมีการประกาศ เว้นแต่จะระบุไว้เป็นอย่างอื่น เงินที่ได้รับจากการใช้เงินโบนัสจะถูกลบออกจากบัญชีของสมาชิกหากไม่สามารถทำตามข้อกำหนดเบื้องต้นได้ภายในเวลาที่กำหนด<br><br></li>
                <li>การวางเดิมพันเฉพาะผลิตภัณฑ์ Nova88 ที่มีผลการชนะ / แพ้จะมีผลต่อข้อกำหนดการหมุนเวียนหนึ่งครั้ง (เทิร์นโอเวอร์) (1x) ในผลิตภัณฑ์ Nova88 ทั้งหมด<br><br></li>
                <li>สมาชิกทั้งหมดของ Nova88 สามารถเข้าร่วมโปรโมชั่นนี้ได้โดยอัตโนมัติ<br><br></li>
                <li>สมาชิกที่เข้าร่วมต้องยอมรับและปฏิบัติตามข้อกำหนดทั้งหมดที่กล่าวถึงข้างต้นรวมถึงกฎและระเบียบที่เกี่ยวข้องทั้งหมดที่ใช้โดย Nova88<br><br></li>
                <li>Nova88 ขอสงวนสิทธิ์ในการแก้ไขหรือถอนโปรโมชั่นได้ตลอดเวลา<br><br></li>
                <li>Nova88 เป็นผู้ชี้ขาด แต่เพียงผู้เดียวของโปรโมชั่นและการตัดสินของ Nova88 ถือเป็นที่สิ้นสุด<br><br></li>
                <li>ข้อกำหนดและเงื่อนไขของ Nova88<br><br></li>
                </ol>

        </div>
    </div>
</div>
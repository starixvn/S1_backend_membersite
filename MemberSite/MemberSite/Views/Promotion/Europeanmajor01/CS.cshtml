@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-Europeanmajor01.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <h2>欧盟四大联赛</h2>
            <h2>0.3%返水高达1500元</h2>
            
        </div>
        <div class="promotions-module">
             <span class="promotions-title">优惠标准规则</span>
                <ol type="a">
                    <li>所有成员将自动获得此促销活动。<br><br></li>
                    <li>此优惠活动仅计算于四大联赛的有效投注注单，即英超，西甲，意甲与德甲。<br><br></li>
                    <li>每星期一 11:59:59 (GMT +8) 促销优惠活动截止前在欧亚体育进行有效投注额投注就能达到活动最低支付。<br><br></li>
                    <li>返水将在截止时间后48小时内汇入。<br><br></li>
                    <li>返水金额必须进行1X的流水投注才能提款。<br><br></li>
                </ol>

            <span class="promotions-title">优惠奖励条件:</span>
            <div class="table table-rwd table-primary">
                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">优惠 0.3% (货币)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">最低支出</span>
                        </div>
                        <div class="td-date">
                            <span class="text">最高支出</span>
                        </div>
                        <div class="td-date">
                            <span class="text">投注倍数</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">马币 (MYR)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 10</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 999</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">印尼盾 (IDR)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR 30,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR3,000,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">泰铢 (THB)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 100</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 8,888</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">人民币 (RMB)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">RMB 10</span>
                        </div>
                        <div class="td-date">
                            <span class="text">RMB 1500</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>



            </div>
            <br><br>
            <span class="promotions-title">举例：</span>
                <ol type="a">
                    <li>每周最低有效投注额支付： RMB 3,300 x 0.3% = RMB 10 (每位会员)<br><br></li>
                    <li>每周最高有效投注额支付： RMB 500,000 x 0.3% = RMB 1500 (每位会员)<br><br></li>
                </ol>

            <span class="promotions-title">优惠标准规则</span>
                <ol type="1">
                    <li>促销适用于所有Nova88会员。<br><br></li>
                    <li>除非另有说明，否则从此次促销中返水金额在汇入的三十（30）天内有效。参加会员在指定的时间内未能达到要求的条件，所有返水金额使用的赢利将被撤销。<br><br></li>
                    <li>有效投注额仅计算在 Nova88 投注产生输赢结果的注单。即时兑现，注单取消或本金退还，及在同一局游戏中同时投注对等盘口的注单将不计算为有效投注额内。<br><br></li>
                    <li>所有欧亚体育会员将自动获得此促销活动。<br><br></li>
                    <li>参与优惠会员必须接受并遵守上述所有条款以及Nova88实施的所有相关规则和规定。<br><br></li>
                    <li>Nova88有权随时中止或取消本优惠。<br><br></li>
                    <li>Nova88保留对本优惠的最终解释权。<br><br></li>
                    <li>Nova88标准规则和条款适用。<br><br></li>
                </ol>

        </div>
    </div>
</div>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-Europeanmajor01.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <h2>FOUR EUROPEAN MAJOR LEAGUE</h2>
            <h2>0.3% TURNOVER REBATE up to MYR 999</h2>
            
        </div>
        <div class="promotions-module">
             <span class="promotions-title">Significant Conditions</span>
                <ol type="a">
                    <li>All active members will be automatically entitled this promotion.<br><br></li>
                    <li>This promotion only entitle Four Major League valid bets only, such as Premier League, Laliga, Serie A & Bundesliga.<br><br></li>
                    <li>To achieve the valid bet amount for minimum payout before the cut-off time on every Monday 11:59:59 (GMT+8) with participating during the promotion period at Nova88 only.<br><br></li>
                    <li>Rebate will be credited within next 48 hours after the cut-off time.<br><br></li>
                    <li>Member are require to one time (1x) rollover for the rebate before making withdrawal<br><br></li>
                </ol>

            <span class="promotions-title">Bonus Play Conditions:</span>
            <div class="table table-rwd table-primary">
                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">Rebate 0.3% (currencies)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">Minimum Payout</span>
                        </div>
                        <div class="td-date">
                            <span class="text">Maximum Payout (capped)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">Turnover</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">MYR</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 10</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 999</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">IDR</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR 30,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR3,000,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">THB</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 100</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 8,888</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">RMB</span>
                        </div>
                        <div class="td-date">
                            <span class="text">RMB 10</span>
                        </div>
                        <div class="td-date">
                            <span class="text">RMB 1500</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>



            </div>
            <br><br>
            <span class="promotions-title">Example:</span>
                <ol type="a">
                    <li>Weekly Minimum turnover payout start from MYR3300 x 0.3% = MYR10 per member<br><br></li>
                    <li>Weekly Maximum turnover payout capped on MYR333,000 x 0.3% = MYR999 per member<br><br></li>
                </ol>

            <span class="promotions-title">Terms and Conditions:</span>
                <ol type="1">
                    <li>This promotion only applies to all Nova88 members only.<br><br></li>
                    <li>Rebates are valid for thirty (30) days upon issuance unless stated otherwise. Money won using bonus funds will be removed from the member’s account if prerequisites are not fulfilled within the given time frame.<br><br></li>
                    <li>Only wagers in Nova88 that generate a win/loss return will be contributed to the rollover requirement. Cash Out, cancelled, void wagers, or wagers on both even-chances during a single game will not count towards this requirement.<br><br></li>
                    <li>This promotion will automatically apply to all Nova88 members.<br><br></li>
                    <li>Participating members must accept and comply with all the terms mentioned above as well as all relevant rules and regulations stated on the Nova88 website.<br><br></li>
                    <li>Nova88 reserves the right to amend or withdraw the Promotion at any time.<br><br></li>
                    <li>Nova88 is the sole arbiter of the Promotion and its decision is final.<br><br></li>
                    <li>Nova88 Standard Terms and Conditions apply.<br><br></li>
                </ol>

        </div>
    </div>
</div>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-Europeanmajor01.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <h2>歐盟四大聯賽</h2>
            <h2>0.3%返水高達 MYR 999</h2>
            
        </div>
        <div class="promotions-module">
             <span class="promotions-title">優惠標準規則</span>
                <ol type="a">
                    <li>所有成員將自動獲得此促銷活動。<br><br></li>
                    <li>此優惠活動僅計算於四大聯賽的有效投註註單，即英超，西甲，意甲與德甲。<br><br></li>
                    <li>每星期一 11:59:59 (GMT +8) 促銷優惠活動截止前在歐亞體育進行有效投注額投注就能達到活動最低支付。<br><br></li>
                    <li>返水將在截止時間後48小時內匯入。<br><br></li>
                    <li>返水金額必須進行1X的流水投注才能提款。<br><br></li>
                </ol>

            <span class="promotions-title">優惠獎勵條件</span>
            <div class="table table-rwd table-primary">
                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">優惠 0.3% (貨幣)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">最低支出</span>
                        </div>
                        <div class="td-date">
                            <span class="text">最高支出</span>
                        </div>
                        <div class="td-date">
                            <span class="text">投注倍數</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">馬幣 (MYR)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 10</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 999</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">印尼盾 (IDR)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR 30,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR3,000,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">泰銖 (THB)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 100</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 8,888</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">人民幣 (RMB)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">RMB 10</span>
                        </div>
                        <div class="td-date">
                            <span class="text">RMB 1500</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>



            </div>
            <br><br>
            <span class="promotions-title">舉例：</span>
                <ol type="a">
                    <li>每週最低有效投注額支付： MYR 3,300 x 0.3% = MYR 10 (每位會員)<br><br></li>
                    <li>每週最高有效投注額支付： MYR 333,000 x 0.3% = MYR 999 (每位會員)<br><br></li>
                </ol>

            <span class="promotions-title">優惠標準規則</span>
                <ol type="1">
                    <li>促銷適用於所有Nova88會員。<br><br></li>
                    <li>除非另有說明，否則從此次促銷中返水金額在匯入的三十（30）天內有效。參加會員在指定的時間內未能達到要求的條件，所有返水金額使用的贏利將被撤銷。<br><br></li>
                    <li>有效投注額僅計算在 Nova88 投注產生輸贏結果的注單。即時兌現，注單取消或本金退還，及在同一局遊戲中同時投注對等盤口的注單將不計算為有效投注額內。<br><br></li>
                    <li>所有歐亞體育會員將自動獲得此促銷活動。<br><br></li>
                    <li>參與優惠會員必須接受並遵守上述所有條款以及Nova88實施的所有相關規則和規定。<br><br></li>
                    <li>Nova88有權隨時中止或取消本優惠。<br><br></li>
                    <li>Nova88保留對本優惠的最終解釋權。<br><br></li>
                    <li>Nova88標準規則和條款適用。<br><br></li>
                </ol>

        </div>
    </div>
</div>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var lang = selLangBLL.GetLangId();
}

<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">Promosi</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-RegisterWiniPhone.jpg" alt="" style="display: block;width: 100%;" />
        </div>
        <div class="promotions-module">
            <h2>Daftar dan Menangkan Iphone 11</h2>
            <h3>Daftar hari ini kesempatan untuk anda memenangkan Iphone 11</h3>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">Ketentuan umum:</span>
            <ol type="a">
                <li>Promo ini berlaku untuk akun member MYR, IDR, dan THB<br><br></li>
                <li>Promo berlaku mulai tanggal 21 agustus 2020, 12:00:00PM (GMT+8) sampai 21 september 2020 11:59:59 AM (GMT+8)<br><br></li>
                <li>Promosi hanya berlaku untuk seluruh member baru yang telah melakukan deposit pertama pada masa periode promosi<br><br>
                <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                <tr>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        periode promosi
                    </th>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        hadiah
                    </th>
                    </tr>
                    <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">21 August – 21 September 2020</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">Apple iPhone 11 (64GB) </td>
                </tr>
                </table>
                <br><br></li>
                <li>Setiap mata uang akan ada 2 pemenang dan akan di pilih secara acak oleh sistem (RNG)<br><br></li>
                <li>Setiap member diwajibkan hanya memiliki 1 ID saja dan dilarang memiliki beberapa ID<br><br></li>
                <li>Hadiah akan dikirimkan dalam waktu 48 jam setelah berasil memverifikasi data pemenang, namun tanggal pengiriman tergantung dari ketersediaan stok dalam waktu 30hari<br><br></li>
                <li>Untuk garansi bisa di klaim melalui pihak ke tiga dari pengiriman barang<br><br></li>
            </ol>
           
            <span class="promotions-title">Syarat dan ketentuan :</span>
            <ol type="1">
                <li>Pemenang akan mendapatkan pesan pribadi pada kotak masuk (Inbox) member dalam waktu 24 jam setelah batas akhir waktu, dan pemenang wajib menghubungi layanan pelanggan kami dalam waktu 7 hari untuk mengklaim hadiah<br><br></li>
                <li>Member wajib melampirkan ID yang valid untuk diverifikasi data dengan layanan pelanggan dan detail akun pemenang untuk mencocokkan informasi yang di daftar di Nova88, jika tidak pihak Nova88 berhak mendiskualifikasi pemenang dari promo ini.<br><br></li>
                <li>Member yang ikut serta dalam promo ini wajib mematuhi seluruh ketentuan diatas dan peraturan yang di keluarkan oleh situs Nova88<br><br></li>
                <li>Nova88 berhak untuk mengubah atau membatalkan promosi kapan saja<br><br></li>
                <li>Nova88 adalah satu-satunya penengah Promosi dan keputusannya bersifat mutlak.<br><br></li>
                <li><a class="text-link" href="https://www.nova88asia.com/SiteSkin/Nova88/Static/@lang/Promotion.html" target="_blank">Syarat dan Ketentuan Nova88 terlampir</a><br><br></li>
            </ol>

        </div>
    </div>
</div>
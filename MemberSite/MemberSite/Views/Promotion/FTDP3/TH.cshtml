@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject PromotionBLL promotionBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var StaticRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Static/{selLangBLL.GetLangId()}");
    int CurrencyId = 0;
    long ExpiryTime = 0;
    Promotion promotion = null;

    if (User.Identity.IsAuthenticated)
    {
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;

        promotion = promotionBLL.GetPromotionListByCustId(custId).FirstOrDefault();

        if (promotion == null)
            promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
    }
    else
    {
        CurrencyId = selLangBLL.GetPreferCurrencyId();
        if (CurrencyId == 13)
            CurrencyId = 2;

        promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
    }

    if (promotion.BonusInfoStatus != 1)
    {
        ExpiryTime = promotion.PeriodTo;
    }
    else
    {
        ExpiryTime = new DateTimeOffset(promotion.ExpiryTime.ToUniversalTime(), TimeSpan.Zero).ToUnixTimeSeconds();
    }
    var Currency = selLangBLL.GetResourceValue($"lbl_Currency_{CurrencyId}");
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">@selLangBLL.GetResourceValue("lbl_PromotionInfo")</span>
        </div>

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-FTDP3.jpg" alt="" style="display: block;width: 100%;" />
        </div>
        <div class="promotions-module">
            <h2>โบนัสแรกเข้า 100% สูงสุดถึง 2,888 บาท</h2>
            <h3>เข้าร่วมตอนนี้ ! รับโบนัสมากถึง 2,888 บาทด้วยการฝากครั้งแรกที่ @serverInfo.SiteName!</h3>
        </div>
        <div class="promotions-module">
            <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                <tr>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">โบนัส </th>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">จำนวนโบนัสสูงสุด </th>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">ยอดหมุนเวียน </th>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">เวลาคงเหลือ </th>
                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                    {
                        <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;"></th>
                    }
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">@promotion.Bonus.ToString("#,##0")%</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">@Currency @promotion.MaxBonus.ToString("#,##0")</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">@(promotion.RollOver)x</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;" id="REMAINING"></td>
                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                    {
                        <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">
                            <div class="btn-group">
                                <button class="btn btn-secondary" id="JOIN">
                                    <div class="btn__inner">
                                        <span class="text">@selLangBLL.GetResourceValue("lbl_JoinNow")</span>
                                    </div>
                                </button>
                            </div>
                        </td>
                    }
                </tr>
            </table>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">เงื่อนไขที่สำคัญ</span>
            <ol type="a">
                <li>โปรโมชั่นนี้สำหรับสมาชิก ไทยบาท เท่านั้น<br><br></li>
                <li>โปรโมชั่นนี้เริ่มตั้งแต่วันที่ 13 กรกฎาคม 2020 00:00:00 (GMT + 8) จนกว่าจะมีประกาศเปลี่ยนแปลง<br><br></li>
                <li>คุณสมบัติที่สำคัญสำหรับการเข้าร่วมโปรโมชั่นนี้คือ ผู้เล่นจะต้องทำการฝากครั้งแรกและไม่มีการถอน<br><br></li>
                <li>โปรดคลิ๊ก "เข้าร่วมทันที" ภายในหน้าข้อกำหนดในการให้บริการเฉพาะของโปรโมชั่นเมื่อลงชื่อเข้าใช้บัญชี @serverInfo.SiteName เพื่อทำการส่งเสริมการขายนี้<br><br></li>
            </ol>

            <span class="promotions-title">ยกตัวอย่างเช่น</span>
            <ol>
                <li style="list-style-type:disc">สมาชิกฝากเงินครั้งแรก 15,000 บาท<br><br></li>
                <li style="list-style-type:disc">ยอดเงินโบนัสที่จะได้รับคือ 15,000 x 100% = 2,888 บาท (จำนวนโบนัสสูงสุดไม่เกิน)<br><br></li>
                <li style="list-style-type:disc">ยอดเงินฝากสูงสุดที่นำมาคิดโบนัสคือ 2,888 บาท/100% = 2,888 บาท<br><br></li>
                <li style="list-style-type:disc">ยอดเงินฝากที่ไม่ได้นำมาคิดโบนัสคือ 15,000 - 2,888 = 12,112 บาท<br><br></li>
                <li style="list-style-type:disc">คำนวนยอดเงินเดิมพันสะสม/หมุนเวียนคือ (2888 + 2888) x 18+ 12,112= 116,080 บาท<br><br></li>
            </ol>


            <span class="promotions-title">ข้อกำหนดและเงื่อนไขเฉพาะของโปรโมชั่นทั้งหมด</span>
            <ol type="1">
                <li>เพื่อให้มีสิทธิ์รับโปรโมชั่นนี้ ผู้เล่นจะต้องเป็นทำตามเงื่อนไขทั้งหมดด้านล่าง:<br><br></li>
                <li>
                    ผู้เล่นที่ผ่านการรับรองจะได้รับโบนัส 100% ตามจำนวนเงินฝากที่ได้รับอนุมัติครั้งแรกในช่วงระยะเวลาโปรโมชั่นสูงสุด 2,888 บาท (ต่อยอด) ดังที่แสดงด้านล่าง:
                    <br><br>
                    <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                        <tr>
                            <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">โบนัส</th>
                            <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">ผลิตภัณฑ์ที่ไม่รวมอยู่ในโปรโมชั่น</th>
                            <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">จ่ายสูงสุด (ต่อยอด)</th>
                            <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">โรลโอเวอร์</th>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">100%</td>
                            <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">คาสิโน, คาสิโนสด, เกมเสมือนจริง, โป๊กเกอร์, เกมยิงปลา, เกมหมากรุก, เกมบนโต๊ะ, อินโด 4D, คีโน, ล็อตเตอรี และ Cash out</td>
                            <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">2,888 บาท</td>
                            <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">18x (เท่า)</td>
                        </tr>
                    </table>
                    <br><br>
                </li>
                <li>สมาชิกที่ผ่านการรับรองจะไม่ได้รับอนุญาตให้ยกเลิกโบนัสเมื่อเครดิตเข้าบัญชีโนวา 88<br><br></li>
                <li>เทิร์นโอเวอร์ของเกมที่สามารถใช้ได้คือ : สปอร์ตบุ๊ค, อี-สปอร์ต, นัมเบอร์เกม และ กีฬาเสมือนจริง ส่วน Cash out และตัวผลิตภัณฑ์อื่นๆ ไม่รวมอยู่ในโรลโอเวอร์<br><br></li>
                <li>
                    ผู้เล่นที่ผ่านการรับรองจะได้รับอนุญาตให้เข้าร่วมในโปรโมชั่นที่เกี่ยวข้องกับโบนัสเงินฝากครั้งแรก (1) โดย @serverInfo.SiteName หากผู้เล่นที่มีคุณสมบัติเหมาะสมเข้าร่วมมากกว่าหนึ่ง (1) โปรโมชั่นที่เกี่ยวข้อง 'โบนัสเงินฝากครั้งแรก' ที่ได้รับอนุมัติครั้งแรกโดย
                    @serverInfo.SiteName ผู้เล่นที่มีคุณสมบัติดังกล่าวจะถูกพิจารณาและมีส่วนร่วมในโปรโมชั่นที่เกี่ยวข้อง ให้เป็นโมฆะ<br><br>
                </li>
                <li>ผู้เล่นที่ผ่านการรับรองจะถูกตัดสิทธิ์จากโปรโมชั่นหากมีการถอนใด ๆ ก่อนที่โบนัสจะเข้าบัญชี @serverInfo.SiteName<br><br></li>
                <li>เฉพาะการเดิมพันที่สร้างผลตอบแทน ชนะ / แพ้ เท่านั้นที่จะนำไปสู่ข้อกำหนดโรลโอเวอร์ การยกเลิกหรือการเดิมพันที่เป็นโมฆะการเดิมพันในราคาต่ำกว่า 1.5 (เลขทศนิยมคี่) 0.5 (จีน); 0.5 (มาเลย์คี่บวก); -2.0 (อินโด); -200 (สหรัฐ) หรือการเดิมพันทั้งคู่โอกาสในระหว่างเกมเดียวจะไม่ถูกนับรวมในข้อกำหนดนี้<br><br></li>
                <li>ข้อกำหนดการโรลโอเวอร์จะได้รับการพิจารณาว่าสมบูรณ์หากยอดคงเหลือในบัญชีของผู้เล่นที่ผ่านการรับรองน้อยกว่าจำนวนเงินเดิมพันขั้นต่ำที่อนุญาต (เช่น 50 บาท)<br><br></li>
                <li>โปรโมชั่นนี้ใช้ได้กับ เงิน มาเลเซียริงกิต, ไทยบาท และ เงินรูเปียอินโดนีเซียเท่านั้น<br><br></li>
                <li>@serverInfo.SiteName ขอสงวนสิทธิ์ในการแก้ไขหรือถอนโปรโมชั่นได้ตลอดเวลา<br><br></li>
                <li>@serverInfo.SiteName เป็นผู้ชี้ขาดแต่เพียงผู้เดียวของโปรโมชั่นและการตัดสินของเราถือเป็นที่สิ้นสุด<br><br></li>
                <li><a class="text-link" href="@StaticRootPath/Promotion.html" target="_blank">ข้อกำหนดและเงื่อนไขโปรโมชั่</a>นแบบทั่วไปของ @serverInfo.SiteName</li>
            </ol>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(function() {
            const diff = moment.duration(moment.unix(@promotion.PeriodTo).diff(new Date()))
            $("#REMAINING").html(diff.months()*30+diff.days() + " วัน " + diff.hours() + " ชั่วโมง" );
           var sExpiryTime = moment.unix(@ExpiryTime).date() +' วัน '+ (parseInt(moment.unix(@ExpiryTime).get('month'),10) + 1 ) +' เดือน '+ moment.unix(@ExpiryTime).year() +' ปี';
            sExpiryTime += moment.unix(@ExpiryTime).format(' HH:mm');
            $("#ExpiryTime").html(sExpiryTime);

            $("#JOIN").on("touchstart, click", function () {
                  if (confirm("@Html.Raw(selLangBLL.GetResourceValue("lbl_BonusConfirm"))")) {
                    axios.post('/api/Promotion/SetClaimPromotion/@selLangBLL.GetLangId()', { BonusCode:"@promotion.BonusCode"})
                        .then(function (response) {
                            var result = response.data;
                            if (result.errorCode == 0) {
                                alert("@Html.Raw(selLangBLL.GetMsg("msg_Updatesuccessful"))");
                                window.location.replace("@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })");
                            } else {
                                alert(result.message);
                            }
                        }.bind(this)).catch(function (error) {
                            alert(error);
                        }.bind(this));
                }
            });
        });
    </script>
}
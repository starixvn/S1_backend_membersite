@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject PromotionBLL promotionBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var StaticRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Static/{selLangBLL.GetLangId()}");
    int CurrencyId = 0;
    long ExpiryTime = 0;
    Promotion promotion = null;

    if (User.Identity.IsAuthenticated)
    {
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;

        promotion = promotionBLL.GetPromotionListByCustId(custId).FirstOrDefault();

        if (promotion == null)
            promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
    }
    else
    {
        CurrencyId = selLangBLL.GetPreferCurrencyId();
        if (CurrencyId == 13)
            CurrencyId = 2;

        promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
    }

    if (promotion.BonusInfoStatus != 1)
    {
        ExpiryTime = promotion.PeriodTo;
    }
    else
    {
        ExpiryTime = new DateTimeOffset(promotion.ExpiryTime.ToUniversalTime(), TimeSpan.Zero).ToUnixTimeSeconds();
    }
    var Currency = selLangBLL.GetResourceValue($"lbl_Currency_{CurrencyId}");
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">@selLangBLL.GetResourceValue("lbl_PromotionInfo")</span>
        </div>

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-FTDP3.jpg" alt="" style="display: block;width: 100%;" />
        </div>
        <br><br>
        <div class="promotions-module">
            <h2>100% WELCOME BONUS up to MYR 388</h2>
            <h3>JOIN NOW ! To enjoy up to MYR 388 Bonus with your first deposit at Nova88!</h3>
        </div>
        <div class="promotions-module">
            <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                <tr>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">Bonus </th>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">Max Bonus Amount </th>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">Rollover </th>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">Remaining Time </th>
                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                    {
                        <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;"></th>
                    }
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">@promotion.Bonus.ToString("#,##0")%</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">@Currency @promotion.MaxBonus.ToString("#,##0")</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">@(promotion.RollOver)x</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;" id="REMAINING"></td>
                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                    {
                        <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">
                            <div class="btn-group">
                                <button class="btn btn-secondary" id="JOIN">
                                    <div class="btn__inner">
                                        <span class="text">@selLangBLL.GetResourceValue("lbl_JoinNow")</span>
                                    </div>
                                </button>
                            </div>
                        </td>
                    }
                </tr>
            </table>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">Significant Conditions</span>
            <ol type="a">
                <li>This promotion apply to MYR members only.<br><br></li>
                <li>This promotion start on 13 July 2020 00:00:00 (GMT+8) until further notice.<br><br></li>
                <li>The player must made their First Deposit and none withdrawal request, to qualify.<br><br></li>
                <li>Please click ”JOIN NOW” within the Promotion-Specific Terms and Conditions page upon login to their Nova88 account to qualified this promotion.<br><br></li>
            </ol>

            <span class="promotions-title">Example:</span>
            <ol>
                <li style="list-style-type:disc">Deposit amount: Malaysian Ringgit 1,500<br><br></li>
                <li style="list-style-type:disc">Bonus amount = Malaysian Ringgit 1,500 x 100% = Malaysian Ringgit 388 Capped MAX<br><br></li>
                <li style="list-style-type:disc">Deposit amount used to generate the bonus = Malaysian Ringgit 388 / 100% = Malaysian Ringgit 388<br><br></li>
                <li style="list-style-type:disc">Deposit amount not used for the promotion = MYR 1,500 – MYR 388 = MYR 1112<br><br></li>
                <li style="list-style-type:disc">Rollover requirement = (MYR 388 + MYR 388 x 18 + MYR 1112 = MYR 15080<br><br></li>
            </ol>


            <span class="promotions-title">FULL PROMOTION SPECIFIC TERMS AND CONDITIONS</span>
            <ol type="1">
                <li>To be eligible for the Promotion, players must meet all the criteria below:<br><br></li>
                <li>
                    Qualified players will be awarded with a 100% bonus based on their first approved deposit amount made during the promotion period, up to maximum MYR 388 (capped), as illustrated below:
                    <br><br>
                    <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                        <tr>
                            <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">Bonus </th>
                            <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">Excluded Product </th>
                            <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">Max Pay Out (capped) </th>
                            <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">Rollover </th>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">100% </td>
                            <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">Casino, Live casino, Virtual game, Poker, Fishing game, Chess games, Table games, Indo 4D, Keno, Lottery and Cash out. </td>
                            <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">MYR 388 </td>
                            <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">18x (times) </td>
                        </tr>
                    </table>
                    <br><br>
                </li>
                <li>The qualified members are not allowed to cancel the bonus once it credited to Nova88 account.<br><br></li>
                <li>Valid turnover only includes these product : Sportsbook, E-Sports, Number Game & Virtual Sports. Cash out and other product is not included in rollover. <br><br></li>
                <li>
                    The qualified player is allowed to participate in only one (1)‘First Time Deposit Bonus’ related promotion offered by Nova88. Should the qualified player participate in more than one (1), only the first approved ‘First Time Deposit Bonus’
                    related promotion received by Nova88 from such qualified player will be considered valid and participation in all other ‘First Time Deposit Bonus’ related promotions will be void. <br><br>
                </li>
                <li>The qualified player will be disqualified from the promotion if any withdrawal are made before the Bonus is credited to their Nova88 account.<br><br></li>
                <li>
                    Only wagers that generate a win/loss return will contribute to the Rollover Requirement. Cancelled or void wagers, wagers on odds less than 1.5 (Decimal odd); 0.5 (China odd) ; 0.5 (Malay Positive odd); -2.0 (Indo odd); -200(US odd), or
                    wagers on both even chances during a single game will not count towards this requirement.<br><br>
                </li>
                <li>The rollover requirement will be considered fulfilled, if the qualified player’s account balance is less than the minimum stake amount allowed.(i.e. MYR 5)<br><br></li>
                <li>This Promotion only entitle for MYR,THB & IDR currencies only.<br><br></li>
                <li>Nova88 reserves the right to amend or withdraw the Promotion at any time.<br><br></li>
                <li>Nova88 is the sole arbiter of the Promotion and its decision is final.<br><br></li>
                <li>Nova88 Standard Terms & Conditions apply.<br><br></li>
            </ol>



        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(function() {
            const diff = moment.duration(moment.unix(@promotion.PeriodTo).diff(new Date()))
            $("#REMAINING").html(diff.days() + " days" + diff.hours() + " hours" );
            //$("#ExpiryTime").html(moment.unix(@ExpiryTime).format('l11'));
            var sExpiryTime = moment.unix(@ExpiryTime).format('MMMM') +' ' + moment.unix(@ExpiryTime).date() + ' ,' + moment.unix(@ExpiryTime).year();
            sExpiryTime += moment.unix(@ExpiryTime).format(' HH:mm');
            $("#ExpiryTime").html(sExpiryTime);

            $("#JOIN").on("touchstart, click", function () {
                  if (confirm("@Html.Raw(selLangBLL.GetResourceValue("lbl_BonusConfirm"))")) {
                    axios.post('/api/Promotion/SetClaimPromotion/@selLangBLL.GetLangId()', { BonusCode:"@promotion.BonusCode"})
                        .then(function (response) {
                            var result = response.data;
                            if (result.errorCode == 0) {
                                alert("@Html.Raw(selLangBLL.GetMsg("msg_Updatesuccessful"))");
                                window.location.replace("@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })");
                            } else {
                                alert(result.message);
                            }
                        }.bind(this)).catch(function (error) {
                            alert(error);
                        }.bind(this));
                }
            });
        });
    </script>
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject PromotionBLL promotionBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var StaticRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Static/{selLangBLL.GetLangId()}");
    int CurrencyId = 0;
    long ExpiryTime = 0;
    Promotion promotion = null;

    if (User.Identity.IsAuthenticated)
    {
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;

        promotion = promotionBLL.GetPromotionListByCustId(custId).FirstOrDefault();

        if (promotion == null)
            promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
    }
    else
    {
        CurrencyId = selLangBLL.GetPreferCurrencyId();
        if (CurrencyId == 13)
            CurrencyId = 2;

        promotion = promotionBLL.GetPromotionListWithCache(serverInfo.SiteId).Where(x => x.CurrencyId == CurrencyId).FirstOrDefault();
    }

    if (promotion.BonusInfoStatus != 1)
    {
        ExpiryTime = promotion.PeriodTo;
    }
    else
    {
        ExpiryTime = new DateTimeOffset(promotion.ExpiryTime.ToUniversalTime(), TimeSpan.Zero).ToUnixTimeSeconds();
    }
    var Currency = selLangBLL.GetResourceValue($"lbl_Currency_{CurrencyId}");
}
<div class="main ">
    <div class="promotionsInfo-page page">
        <div class="heading">
            <span class="text">@selLangBLL.GetResourceValue("lbl_PromotionInfo")</span>
        </div>
        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-FTDP3.jpg" alt="" style="display: block;width: 100%;" />
        </div>
        <div class="promotions-module">
            <h2>100% 欢迎红利，高达 MYR 388</h2>
            <h3>立即加入！在 “Nova88“ 完成第一笔存款以享受高达 MYR388 的优惠奖金！</h3>
        </div>
        <div class="promotions-module">
            <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                <tr>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">优惠 </th>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">最高獎金 </th>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">最低投注倍數 </th>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">剩餘時間 </th>
                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                    {
                        <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;"></th>
                    }
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">@promotion.Bonus.ToString("#,##0")%</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">@Currency @promotion.MaxBonus.ToString("#,##0")</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">@(promotion.RollOver)x</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;" id="REMAINING"></td>
                    @if (User.Identity.IsAuthenticated && promotionBLL.GetCanJoin(authorizeBLL.GetAuthData().CustId, ViewContext.HttpContext.Request.Query["BonusCode"]))
                    {
                        <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">
                            <div class="btn-group">
                                <button class="btn btn-secondary" id="JOIN">
                                    <div class="btn__inner">
                                        <span class="text">@selLangBLL.GetResourceValue("lbl_JoinNow")</span>
                                    </div>
                                </button>
                            </div>
                        </td>
                    }
                </tr>
            </table>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">优惠标准规则</span>
            <ol type="a">
                <li>此促销优惠仅适用于马币会员。<br><br></li>
                <li>此促销活动于2020年7月13日00:00:00（GMT + 8）开始，截止日期另行通知。<br><br></li>
                <li>玩家必须先进行首存，并且没有申请过提款请求 ，以获得红利资格。<br><br></li>
                <li>登入 Nova88 账号后，在优惠活动专用条款和条件页面，点击“立即加入”以获得红利资格。<br><br></li>
            </ol>

            <span class="promotions-title">举例：</span>
            <ol>
                <li style="list-style-type:disc">存款金额=1,500马币<br><br></li>
                <li style="list-style-type:disc">优惠红利 = 1,500马币 X 100% = 封顶红利388马币<br><br></li>
                <li style="list-style-type:disc">用于申请奖金的部分 = 封顶奖金388马币/ 100% = 388马币<br><br></li>
                <li style="list-style-type:disc">没有申请奖金的部分 = 1,500马币 – 388马币 = 1112马币<br><br></li>
                <li style="list-style-type:disc">最低投注额 = (388马币 + 388马币) x 18 + 1112马币 =15,080马币<br><br></li>
            </ol>


            <span class="promotions-title">完整优惠标准规则</span>
            <ol type="1">
                <li>获得此次促销的资格，玩家必须满足以下所有条件:<br><br></li>
                <li>
                    优惠期间，符合优惠资格的会员，可享有一次 100% 首存存款奖金，最高为 马币 388 (最高奖金)，详情如下:
                    <br><br>
                    <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                        <tr>
                            <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">优惠 </th>
                            <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">优惠不包括产品 </th>
                            <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">最高奖金 (马币) </th>
                            <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;border: 1px solid #cfcfcf;">最低投注倍数 </th>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">100%</td>
                            <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">娱乐城，真人娱乐场，虚拟娱乐城，扑克，捕鱼，棋牌，牌桌，印尼 4D ，快乐彩，彩票和即时兑现.</td>
                            <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">马币 388</td>
                            <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">18x</td>
                        </tr>
                    </table>
                    <br><br>
                </li>
                <li>优惠奖金注入后，会员将不能申请取消。<br><br></li>
                <li>有效投注额仅包括以下产品：体育博彩，电子竞技，百练赛及虚拟运动。即时兑现及其他产品有效投注额将不计算在内。<br><br></li>
                <li>符合资格的会员在优惠期间只能领取一次“首存优惠奖金”，如果会员在优惠期间申请了多次“首存优惠奖金”，只有第一笔的“首存优惠奖金”被视为有效，而其他申请将被视为无效。<br><br></li>
                <li>在奖金未注入您的账号之前请勿提款，否则将失去领取奖金的资格。<br><br></li>
                <li>有效投注额仅计算在 Nova88 投注产生输赢结果的注单。注单取消或本金退还，任何赔率低于标准盘1.5、中国盘0.5、马来盘正数赔率0.5、印度尼西亚盘-2.0、美国盘-200的投注，及在同一局游戏中同时投注对等盘口的注单将不计算为有效投注额内。<br><br></li>
                <li>当会员的投注额未达到上述条款要求，且账户现金余额少于马币 5 时，则无需继续履行此优惠规则与条款。<br><br></li>
                <li>此促销优惠仅适用于MYR，THB到IDR货币<br><br></li>
                <li>Nova88 有权随时中止或取消本优惠。<br><br></li>
                <li>Nova88 保留对本优惠的最终解释权。<br><br></li>
                <li>Nova88 标准规则和条款适用。<br><br></li>
            </ol>



        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(function() {
           const diff = moment.duration(moment.unix(@promotion.PeriodTo).diff(new Date()))
            $("#REMAINING").html(diff.days() + " 天" + diff.hours() + " 小时" );
            var sExpiryTime = moment.unix(@ExpiryTime).format('YYYY年MM月DD日');
            sExpiryTime += moment.unix(@ExpiryTime).format(' HH:mm');
            $("#ExpiryTime").html(sExpiryTime);

            $("#JOIN").on("touchstart, click", function () {
                   if (confirm("@Html.Raw(selLangBLL.GetResourceValue("lbl_BonusConfirm"))")) {
                    axios.post('/api/Promotion/SetClaimPromotion/@selLangBLL.GetLangId()', { BonusCode:"@promotion.BonusCode"})
                        .then(function (response) {
                            var result = response.data;
                            if (result.errorCode == 0) {
                                 alert("@Html.Raw(selLangBLL.GetMsg("msg_Updatesuccessful"))");
                                window.location.replace("@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })");
                            } else {
                                alert(result.message);
                            }
                        }.bind(this)).catch(function (error) {
                            alert(error);
                        }.bind(this));
                }
            });
        });
    </script>
}

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-Mega1.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <h2>เมกะโบนัสเฉพาะวันเสาร์ รับ 10% เมื่อฝากเงินซ้ำ</h2>
        </div>
        <div class="promotions-module">
             <span class="promotions-title">รายละเอียดโปรโมชั่น</span>
                <ol type="a">
                    <li>โปรโมชั่นจะใช้ได้เมื่อสมาชิกทำการฝากขั้นต่ำ<br><br></li>
                    <li>โบนัสจะถูกโอนเข้าบัญชีกระเป๋าเงินภายใน 24 ชั่วโมงเมื่อทำการฝากเงินสำเร็จ<br><br></li>
                </ol>

            <span class="promotions-title">เงื่อนไขการเล่นโบนัส</span>
                <ol type="a">
                    <li>สมาชิกจะได้รับโบนัสก็ต่อเมื่อมีการโรลโอเวอร์  1 ครั้ง (1x) หลังจากได้รับเครดิต ก่อนทำการถอน<br><br></li>
                </ol>

            <span class="promotions-title">รายการละเอียดโบนัสมีดังต่อไปนี้:</span>
            <div class="table table-rwd table-primary">
                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">โบนัส 10% ( ตามสกุลเงิน )</span>
                        </div>
                        <div class="td-date">
                            <span class="text">การจ่ายเงินสูงสุด (ต่อยอด)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">เทิร์นโอเวอร์</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">MYR</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 300</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">THB</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 2,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">IDR</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR 1,000,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

            </div>
            <br><br>
            
            <span class="promotions-title">ข้อกำหนดและเงื่อนไข</span>
                <ol type="1">
                    <li>โปรโมชั่นนี้ใช้ได้กับทุกวันเสาร์เท่านั้น<br><br></li>
                    <li>โปรโมชั่นนี้เริ่มตั้งแต่วันท่ี 20 มิถุนายน 2020 (วันเสาร์)<br><br></li>
                    <li>โปรโมชั่นสะสมยอดรวม การฝากเงินซ้ำ (redeposit) ไม่จำกัด เฉพาะในวันโปรโมชั่น (วันเสาร์)<br><br></li>
                    <li>โปรโมชั่นนี้สำหรับสมาชิก Nova88 ทุกคน<br><br></li>
                    <li>โบนัสที่ได้รับจากโปรโมชั่นนี้สามารถใช้ได้เป็นเวลาสามสิบ (30) วันเมื่อมีการออกโบนัส เว้นแต่จะระบุไว้เป็นอย่างอื่น สมาชิกที่เข้าร่วมจะต้องปฏิบัติตามข้อกำหนดเบื้องต้นภายในระยะเวลาที่กำหนด มิเช่นนั้นเงินทั้งหมดที่ได้รับจากการใช้เงินโบนัสจะถูกเพิกถอน<br><br></li>
                    <li>การวางเดิมพันเฉพาะผลิตภัณฑ์ Nova88 ที่มีผลการชนะ / แพ้จะมีผลต่อข้อกำหนดการหมุนเวียนหนึ่งครั้ง (เทิร์นโอเวอร์) (1x) ในผลิตภัณฑ์ Nova88 ทั้งหมด<br><br></li>
                    <li>สมาชิกที่เข้าร่วมต้องยอมรับและปฏิบัติตามข้อกำหนดทั้งหมดที่กล่าวถึงข้างต้นรวมถึงกฎและระเบียบที่เกี่ยวข้องทั้งหมดที่ใช้โดย Nova88<br><br></li>
                    <li>Nova88 ขอสงวนสิทธิ์ในการแก้ไขหรือถอนโปรโมชั่นได้ตลอดเวลา<br><br></li>
                    <li>Nova88 เป็นผู้ชี้ขาด แต่เพียงผู้เดียวของโปรโมชั่นและการตัดสินของ Nova88 ถือเป็นที่สิ้นสุด<br><br></li>
                    <li>ข้อกำหนดและเงื่อนไขของ Nova88<br><br></li>
                </ol>

        </div>
    </div>
</div>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-FishingRebate.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <h2>Fishing Rebate 0.8%</h2>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">Significant Conditions</span>
            <ol type="a">
                <li>This promotion starts at July 07, 2020 12:00 AM until further notice.<br><br></li>
                <li>The cut-off time for this promotion is on every Tuesday at 11:59:59 AM (GMT+8) <br><br></li>
                <li>The Fishing Rebate 0.8% is calculated from player turnover weekly from Tueday to Monday.<br><br></li>
                <li>All Nova88 Members are entitled weekly Fishing Rebate 0.8% based on turnover Nova88 Platform only. <br><br></li>
                <li>Member are required to one time (1x) rollover for the rebate after credit to members , before making withdrawal. <br><br></li>
                <li>The rebate will be credited to qualified players Nova88 account every Tuesday within 48 hours.<br><br></li>
            </ol>
            <span class="promotions-title">Bonus Play Conditions:</span>
            <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                <tr>
                    <th colspan="4" style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">Products</th>
                </tr>
                <tr>
                    <th colspan="4" style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">Fishing Games</th>
                </tr>
                <tr>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">Bonus 0.8% (currencies)</th>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">Minimum Payout (capped)</th>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">Maximum Payout (capped)</th>
                    <th style="padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">Turnover</th>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">Malaysia</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">MYR 50</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">MYR 2000</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">1x</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">Indonesia</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">IDR 175,000</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">IDR 7,000,000</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">1x</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">Thailand</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">THB 370</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">THB 15,000</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;">1x</td>
                </tr>
            </table>


            <br><br>

            <span class="promotions-title">Terms and Conditions:</span>
            <ol type="1">
                <li>This promotion will automatic apply to all Nova88 members.<br><br></li>
                <li>Participating members must accept and comply with all the terms mentioned above as well as all relevant rules and regulations stated on the Nova88 website. <br><br></li>
                <li>Nova88 reserves the right to amend or withdraw the Promotion at any time.<br><br></li>
                <li>Nova88 is the sole arbiter of the Promotion and its decision is final.<br><br></li>
                <li>Nova88 Standard Terms and Conditions apply.<br><br></li>
            </ol>

        </div>
    </div>
</div>
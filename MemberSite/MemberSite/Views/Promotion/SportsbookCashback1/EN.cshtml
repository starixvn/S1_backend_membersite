@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-SportsbookCashback1.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <h2>Sportsbook Cashback 5%</h2>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">Significant Conditions</span>
            <ol type="a">
                <li>This promotion starts at June 24, 2020 12:00 AM until further notice.<br><br></li>
                <li>The cut-off time for this promotion is on every Wednesday at 11:59:59 AM (GMT+8)<br><br></li>
                <li>The Sportbook Cashback 5% is calculated from member Total Loss weekly from Wednesday to Tuesday.<br><br></li>
                <li>All Nova88 Members are entitled to 5% cashback based on “LOSS” status in Nova88 Sportsbook Product by weekly only.<br><br></li>
                <li>Member are required to one time (1x) rollover for the cashback after credit to members , before making withdrawal.<br><br></li>
                <li>The cashback will be credited to qualified players Nova88 account every Wednesday within 48 hours.<br><br></li>
            </ol>
            <span class="promotions-title">Bonus Play Conditions:</span>
            <div class="table table-rwd table-primary">
                <div class="thead">
                    <div class="tr">
                        <div class="td-date" style="align-items: center;">
                            Product
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date" style="align-items: center;">
                            All Sports except Virtual Sport
                        </div>
                    </div>
                </div>

                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">Bonus 5% (currencies)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">Minimum Payout (capped)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">Maximum Payout (capped)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">Turnover</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">Malaysia</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 10</span>
                        </div>
                        <div class="td-date">
                            <span class="text">MYR 3000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">Indonesia</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR 30,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">IDR10,000,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

                <div class="tbody">
                    <div class="tr row-even">
                        <div class="td-date">
                            <span class="text">Thailand</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 100</span>
                        </div>
                        <div class="td-date">
                            <span class="text">THB 20,000</span>
                        </div>
                        <div class="td-date">
                            <span class="text">1x</span>
                        </div>
                    </div>
                </div>

            </div>
            <br><br>

            <span class="promotions-title">Terms and Conditions:</span>
            <ol type="1">
                <li>This promotion will automatic apply to all Nova88 members.<br><br></li>
                <li>Participating members must accept and comply with all the terms mentioned above as well as all relevant rules and regulations stated on the Nova88 website. <br><br></li>
                <li>Nova88 reserves the right to amend or withdraw the Promotion at any time.<br><br></li>
                <li>Nova88 is the sole arbiter of the Promotion and its decision is final.<br><br></li>
                <li>Nova88 Standard Terms and Conditions apply.<br><br></li>
            </ol>

        </div>
    </div>
</div>
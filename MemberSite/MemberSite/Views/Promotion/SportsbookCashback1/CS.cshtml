                    </div>
                </div>

                <div class="thead">
                    <div class="tr">
                        <div class="td-date">
                            <span class="text">优惠 5% (货币)</span>
                        </div>
                        <div class="td-date">
                            <span class="text">最低支出</span>
                        </div>
                        <div class="td-date">
                            <span class="text">最高支出</span>
                        </div>
                        <div class="td-date">

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using MemberSite.Service.Model
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var lang = selLangBLL.GetLangId();
}

<div class="main ">
    <div class="promotionsInfo-page page">

        <div style="border: 0;display: inline-block;position: relative;display: block;width: 100%;">
            <img src="~/CMS/@serverInfo.SiteName/Promotion/@selLangBLL.GetLangId()/banner-WINEXTRA10ON4MAJORLEAGUE.jpg" alt="" style="display: block;width: 100%;" />
        </div><br><br>
        <div class="promotions-module">
            <h2>WIN EXTRA 10% ON FOUR MAJOR LEAGUE NEW SEASON</h2>
            <h3>Extra 10% Bonus from total winning balance of Four Major League matches</h3>
        </div>
        <div class="promotions-module">
            <span class="promotions-title">Significant Conditions</span>
            <ol type="a">
                <li>This promotion applied to all Nova88 members.<br><br></li>
                <li>The EXTRA 10% Bonus of member total winning balance on Four Major League matches only, the bonus will be count from Monday to Sunday.<br><br></li>
                <li>Four Major League; Premier League, La Liga, Serie A & Bundesliga only.<br><br></li>
                <li>The EXTRA 10% Bonus, will be credited to Nova88 members account on every Monday within 48 hours.<br><br></li>
            </ol>
            
            <span class="promotions-title">Bonus Play Conditions</span>
            <ol type="a" start="5">
                <li>Member are required to onetime (1x) rollover for the Bonus after credited to members, before making withdrawal.<br><br></li>
            </ol>
            
            <span class="promotions-title">Promotion particulars are as illustrated below:</span>
            <br><br>
            <table style="border-collapse: collapse; width: 100%;background-color: #fafafa;">
                <tr>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;" colspan="4">
                        Four Major League: Premier League, La Liga, Serie A & Bundesliga
                    </th>
                </tr>
                <tr>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        Bonus 10% (currencies)
                    </th>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        Minimum Payout
                    </th>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        Maximum Payout (capped)
                    </th>
                    <th style="border: 1px solid #cfcfcf; padding-top: 12px;padding-bottom: 12px;text-align: left;background-color: #5574a7;color: white; text-align: center;">
                        Rollover
                    </th>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">MYR</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">MYR 5</td>                
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">MYR 10,000</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">1x</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">THB</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">THB 50</td>  
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">THB 74,000</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">1x</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">IDR</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">IDR 15,000</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">IDR 34,000,000</td>
                    <td style="border: 1px solid #cfcfcf;padding: 8px; text-align: center;color:#000000">1x</td> 
                </tr>
                </table>
<br>

            <span class="promotions-title">Promotion Terms & Conditions:</span>
            <ol type="1">
                <li>This promotion only applies to all Nova88 members.<br><br></li>
                <li>Bonus are valid for thirty (30) days upon issuance unless stated otherwise. Money won using bonus funds will be removed from the member’s account if prerequisites are not fulfilled within the given time frame.<br><br></li>
                <li>Only wagers in Nova88 that generate a win/loss return will be contributed to the rollover requirement. Cash Out, cancelled, void wagers, or wagers on both even-chances during a single game will not count towards this requirement.<br><br></li>
                <li>Participating members must accept and comply with all the terms mentioned above as well as all relevant rules and regulations stated on the Nova88 website.<br><br></li>
                <li>Nova88 reserves the right to amend or withdraw the Promotion at any time.<br><br></li>
                <li>Nova88 is the sole arbiter of the Promotion and its decision is final.<br><br></li>
                <li>Nova88 <a class="text-link" href="https://www.nova88asia.com/SiteSkin/Nova88/Static/@lang/Promotion.html" target="_blank">Standard Terms and Conditions apply</a>.<br><br></li>
            </ol>

        </div>
    </div>
</div>
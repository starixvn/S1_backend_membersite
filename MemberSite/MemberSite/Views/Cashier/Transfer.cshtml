@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = "Transfer";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var authData = authorizeBLL.GetAuthData();
    //var custInfoProfile = custInfoBLL.GetCustInfoProfile(authData.CustId);
}
@{
    var i18n = new Dictionary<string, string>();
    string[] lbl_Txts = new string[] { "lbl_RealName", "lbl_RemindForName" };
    foreach (var lbl_Txt in lbl_Txts)
    {
        if (!i18n.ContainsKey(lbl_Txt))
            i18n.Add(lbl_Txt, selLangBLL.GetResourceValue(lbl_Txt));
    }
}

@section Style{

}
@{
    <div class="main">
        <partial name="~/Views/Shared/_DesktopLeftMenu.cshtml" />
        <div class="page-title" role="mobile-only">
            <span class="text">@selLangBLL.GetResourceValue("lbl_Cashier")</span>
        </div>
        <div class="page-tabs" role="mobile-only">
            <a class="page-tabs__btn" href="@Url.RouteUrl("desktop", new { action = "Deposit", controller = "Cashier", LangId = selLangBLL.GetLangId() })">
                <span class="text">@selLangBLL.GetResourceValue("lbl_Deposit")</span>
            </a>
            <a class="page-tabs__btn" data-selected="true">
                <span class="text">@selLangBLL.GetResourceValue("lbl_TransferFunds")</span>
            </a>
            <a class="page-tabs__btn" href="@Url.RouteUrl("desktop", new { action = "Withdrawal", controller = "Cashier", LangId = selLangBLL.GetLangId() })">
                <span class="text">@selLangBLL.GetResourceValue("lbl_Withdrawal")</span>
            </a>
        </div>
        <div class="page wt">
            <div class="heading">
                <span class="text">@selLangBLL.GetResourceValue("lbl_TransferFunds")</span>
            </div>
            <form class="form">
                <div class="form-group">
                    <label class="form-title">Transfer out of wallet</label>
                    <div class="form-content">
                        <div class="dropdown dropdown-default">
                            <a class="btn">
                                <div class="text-group">
                                    <span class="text">Bank 1</span>
                                </div>
                                <i class="icon icon-caret"></i>
                            </a>
                            <div class="dropdown__container">
                                <div class="dropdown__list">
                                    <div class="dropdown__item" data-selected="true">
                                        <div class="text-group">
                                            <span class="text">Bank 1</span>
                                        </div>
                                    </div>
                                    <div class="dropdown__item">
                                        <div class="text-group">
                                            <span class="text">Bank 2</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-title">Transfer to wallet</label>
                    <div class="form-content">
                        <div class="dropdown dropdown-default">
                            <a class="btn">
                                <div class="text-group">
                                    <span class="text">Bank 1</span>
                                </div>
                                <i class="icon icon-caret"></i>
                            </a>
                            <div class="dropdown__container">
                                <div class="dropdown__list">
                                    <div class="dropdown__item" data-selected="true">
                                        <div class="text-group">
                                            <span class="text">Bank 1</span>
                                        </div>
                                    </div>
                                    <div class="dropdown__item">
                                        <div class="text-group">
                                            <span class="text">Bank 2</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-title">Transfer amount</label>
                    <div class="form-content" data-status="valid">
                        <div class="textfield">
                            <input type="number" class="textfield__input" pattern="[0-9]*" value="23423438">
                            <span class="textfield__bg"></span>
                        </div>
                    </div>
                </div>
                <div class="btn-group">
                    <button class="btn btn-secondary dropdown-highlight" demo-open-modal="">
                        <div class="btn__inner">
                            <span class="text">Highest Value</span>
                        </div>
                    </button>
                    <button class="btn btn-secondary" demo-open-modal="">
                        <div class="btn__inner">
                            <span class="text">Transfer</span>
                        </div>
                    </button>
                </div>
            </form>
            <div class="table table-rwd table-primary">
                <div class="thead" role="desktop-only">
                    <div class="tr">
                        <div class="td-Main-wallet" data-title="Main wallet">
                            <span class="text">Main wallet</span>
                        </div>
                        <div class="td-Balance" data-title="Balance">
                            <span class="text">Balance</span>
                        </div>
                        <div class="td-status" data-title="Retrieve">
                            <span class="text">Retrieve</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr">
                        <div class="td-Main-wallet" data-title="Main wallet">
                            <span class="text">NOVA88</span>
                        </div>
                        <div class="td-Balance" data-title="Balance">
                            <span class="text">1,121,316.69</span>
                            <a class="btn btn-icon" data-refresh="false">
                                <i class="icon icon-refresh"></i>
                                <div class="preloader">
                                    <div class="preloader__spiner">
                                        <div class="preloader__circles">
                                            <div class="preloader__circle-1"></div>
                                            <div class="preloader__circle-2"></div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="td-status">
                            <div class="btn-group">
                                <button class="btn btn btn-primary">
                                    <div class="btn__inner">
                                        <span class="text">Retrieve all</span>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="table table-rwd table-primary2">
                <div class="thead" role="desktop-only">
                    <div class="tr">
                        <div class="td-Secondary-wallet" data-title="Secondary wallet">
                            <span class="text">Secondary wallet</span>
                        </div>
                        <div class="td-Balance" data-title="Balance">
                            <span class="text">Balance</span>
                        </div>
                        <div class="td-status" data-title="Transfer all">
                            <span class="text">Transfer all</span>
                        </div>
                    </div>
                </div>
                <div class="tbody">
                    <div class="tr">
                        <div class="td-Secondary-wallet" data-title="Secondary wallet">
                            <span class="text">GD</span>
                        </div>
                        <div class="td-Balance" data-title="Balance">
                            <span class="text">3,020.50</span>
                            <a class="btn btn-icon" data-refresh="false">
                                <i class="icon icon-refresh"></i>
                                <div class="preloader">
                                    <div class="preloader__spiner">
                                        <div class="preloader__circles">
                                            <div class="preloader__circle-1"></div>
                                            <div class="preloader__circle-2"></div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="td-status">
                            <div class="btn-group">
                                <button class="btn btn-highlight">
                                    <div class="btn__inner">
                                        <span class="text">Transfer Out</span>
                                    </div>
                                </button>
                                <button class="btn btn-secondary">
                                    <div class="btn__inner">
                                        <span class="text">Transfer To</span>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="tr">
                        <div class="td-Secondary-wallet" data-title="Secondary wallet">
                            <span class="text">AG</span>
                        </div>
                        <div class="td-Balance" data-title="Balance">
                            <span class="text">3,020.50</span>
                            <a class="btn btn-icon" data-refresh="false">
                                <i class="icon icon-refresh"></i>
                                <div class="preloader">
                                    <div class="preloader__spiner">
                                        <div class="preloader__circles">
                                            <div class="preloader__circle-1"></div>
                                            <div class="preloader__circle-2"></div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="td-status">
                            <div class="btn-group">
                                <button class="btn btn-highlight">
                                    <div class="btn__inner">
                                        <span class="text">Transfer Out</span>
                                    </div>
                                </button>
                                <button class="btn btn-secondary">
                                    <div class="btn__inner">
                                        <span class="text">Transfer To</span>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@section Scripts{
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
        var hrefAllTrans = "@Url.RouteUrl("desktop", new { action = "Deposit", controller = "History", LangId = selLangBLL.GetLangId() })";
        var OnlineBankingUrl = "@Url.RouteUrl("desktop", new { action = "DepositReqOnlineBanking", controller = "Cashier", LangId = selLangBLL.GetLangId() })";
    </script>
    <script src="~/lib/runtime.min.js"></script>
}
@section Style{

}
<div id="DepositPanel" class="main"></div>

@section Scripts{
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
        var hrefAllTrans = "@Url.RouteUrl("desktop", new { action = "Deposit", controller = "History", LangId = selLangBLL.GetLangId() })";
    </script>
    <script src="~/lib/runtime.min.js"></script>
    <script src="~/lib/clipboard.min.js"></script>
    <script src="~/js/component/cashier/depositPanel.min.js" asp-append-version="true"></script>

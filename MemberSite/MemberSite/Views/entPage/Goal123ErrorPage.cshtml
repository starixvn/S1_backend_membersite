@model MemberSite.Controllers.entPageController.ErrorData
@using MemberSite.Service.BLL
@inject SelLangBLL selLangBLL
<html>
<head>
    <title>@selLangBLL.GetResourceValue("lbl_Title")</title>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="https://error.goal123.org/404/img/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://error.goal123.org/404/css/style.css">
</head>
<body>
    <div class="page404">
        <div class="container">
            <img class="logo" src="https://error.goal123.org/404/img/logo.png" alt="Logo">
            <div class="title">
                @selLangBLL.GetResourceValue("lbl_Error_Title")
            </div>
            <div class="content">@selLangBLL.GetResourceValue("lbl_Error_Message")</div>
            <div class="content">@Model.Message</div>
            <a href="https://direct.lc.chat/12171870" target="_blank" class="liveChat_btn">
                <img src="https://error.goal123.org/404/img/LiveChat_Btn.png" alt="LiveChat">
            </a>
        </div>
    </div>
</body>
</html>

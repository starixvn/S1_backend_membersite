                        <span>THB 160,000 / Total prize pool</span>
                        <div class="evn-img">
                            <ul>
                                <li><img src="~/common/images/event/g11.png" /></li>
                                <li><img src="~/common/images/event/g12.png" /></li>
                                <li><img src="~/common/images/event/g13.png" /></li>
                            </ul>
                        </div>

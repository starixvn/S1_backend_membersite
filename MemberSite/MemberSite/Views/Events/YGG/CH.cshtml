@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using MemberSite.Service.Library
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject IWebHostEnvironment environment
@inject WalletBLL walletBLL
@inject CustInfoBLL custInfoBLL
@inject Tools tools
@inject SelLangBLL selLangBLL
@inject AuthorizeBLL authorizeBLL
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var SkinRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/common");
    var CmsEventPath = Url.Content($"~/CMS/{serverInfo.SiteName}/Casino/{selLangBLL.GetLangId()}");
    var CurrencyId = 0;
    if (User.Identity.IsAuthenticated)
    {
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;
    }
    else
    {
        CurrencyId = selLangBLL.GetPreferCurrencyId();
    }
    var Currency = selLangBLL.GetResourceValue($"lbl_Currency_{CurrencyId}");

    //ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = null;
}

<html lang="@selLangBLL.GetLangId()" data-layout="@(tools.IsMobile() ? "mobile" : "desktop")">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta name="format-detection" content="telephone=no">
    <link rel="shortcut icon" href="@SkinRootPath/images/favicon.ico" type="image/x-icon">

    <title>Event-YGG</title>
    <link href="@SkinRootPath/css/main.css" rel="stylesheet" asp-append-version="true" />
    <link href="@SkinRootPath/css/event-ygg.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="app app--help">
        <div class="header">
            <div class="header__main">
                <div class="header__logo">
                    <a class="logo" href="HelpCenter.html"></a>
                </div>
            </div>
        </div>
        <div class="main">
            <div class="evn-banner">
                <img src="@CmsEventPath/event-ygg-20200508.png" />
            </div>
            <div class="info">
                <div class="evn-time">
                    <h1>
                        和 YGG 一起環遊世界
                    </h1>
                    <h2>老虎機錦標賽時間表</h2>
                    <h4 class="start">
                        即將開始
                    </h4>
                    <h3>
                        [ 享受陽光 ] 掉獎遊戲
                    </h3>
                    <h4>2020/5/11 (14:00) ~  2020/5/18 (23:59)  GMT+8</h4>
                    <h3>
                        [ 神秘旅程 ] 多遊戲錦標賽
                    </h3>
                    <h4>2020/5/19 (14:00) ~ 2020/5/25 (23:59)  GMT+8</h4>
                    <h3>
                        [ 旅遊贏家 ] 任務積分賽
                    </h3>
                    <h4>2020/5/26 (14:00) ~ 2020/5/30 (14:00)  GMT+8</h4>
                </div>
                <div class="evn-time-line">
                    <div class="point">
                        <div class="Round"></div>
                        <h1 class="text">START</h1>
                    </div>
                    <h4>2020/05/11 14:00</h4>
                    <div class="point open" id="div1">
                        <div class="Round"></div>
                        <h1 class="text">
                            [ 享受陽光 ] 掉獎遊戲
                        </h1>
                    </div>
                    <h4>2020/05/11 14:00</h4>
                    <div class="evn-list">
                        <h1>隨機獲得神秘禮</h1>
                        <span>€ 3,000 / 獎池總金額</span>
                        <div class="evn-img">
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g1.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g2.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g3.png" /></li>
                            </ul>
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g4.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g5.png" /></li>
                            </ul>
                        </div>
                        <button class="terms">
                            條款與規則<i class="icon icon-caret"></i>
                        </button>
                        <div class="terms-list">
                            <ul>
                                <li>
                                    此活動期間獎池總金額 € 3,000。
                                </li>
                                <li>
                                    參加活動最低下注 € 0.25 (JPY 30)。
                                </li>
                                <li>
                                    於指定老虎機，巴西狂歡節、撒哈拉之夜、金魚缸、陽光海灘、山谷之神，點擊”立即遊戲”，再點擊“立即加入”。
                                </li>
                                <li>贏獎次數不設限，遊戲次數越多中獎機率越高。</li>
                                <li>
                                    剩餘獎池金額每60秒更新一次。
                                </li>
                                <li>
                                    獎金將即時發放至您的主錢包。
                                </li>
                                <li>在活動期間，玩家可以贏得1個以上隨機獎金。</li>
                            </ul>
                        </div>
                    </div>
                    <div class="point" id="div2">
                        <div class="Round"></div>
                        <h1 class="text">
                            [ 神秘旅程 ] 多遊戲錦標賽
                        </h1>
                    </div>
                    <h4>2020/05/19 14:00</h4>
                    <div class="evn-list">
                        <h1>
                            單次金幣投注能獲最高獎金
                        </h1>
                        <span>€ 3,000 / 獎池總金額</span>
                        <div class="evn-img">
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g6.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g7.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g8.png" /></li>
                            </ul>
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g9.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g10.png" /></li>
                            </ul>
                        </div>
                        <button class="terms">條款與規則<i class="icon icon-caret"></i></button>
                        <div class="terms-list">
                            <ul>
                                <li>
                                    此活動期間獎池總金額 € 3,000。
                                </li>
                                <li>參加活動不需要最低下注。</li>
                                <li>
                                    在參加比賽的第一場贏分之後(活動遊戲: 海盜-精靈島、黃金寺廟、飛向奇蹟、相撲爭霸、狂野北歐海盜)，將為玩家提供一個唯一的錦標賽ID號（“錦標賽ID ”），該編號將在排行榜上進行識別，該排行榜可在遊戲工具欄中找到。
                                </li>
                                <li>排行榜中每個玩家的得分均基於錦標賽期間所有活動遊戲中任何旋轉的最高硬幣獲勝數之和。</li>
                                <li>
                                    如果有兩個或兩個以上相等的分數，則率先獲得贏分第一的玩家將在排行榜上排名較高。每個玩家在整個競選期間獲得的最高分數將計入其排行榜排名。
                                </li>
                                <li>每個玩家在活動遊戲期間獲得的最高分數，將計入其排行榜排名。</li>
                                <li>每個玩家的排行榜位置將每60秒刷新一次。如果出現延誤或顯示最新的排行榜位置，玩家將需要重新加載遊戲。</li>
                                <li>
                                    如果由於任何參與比賽的機器或人為錯誤引起的任何明顯錯誤，錯誤或技術故障（包括不正確的遊戲支出）導致獲勝，則Yggdrasil保留不支付獎金的權利。如果我們認為與其他玩家作弊或串通導致獲勝，我們還保留不支付獎金的權利。
                                </li>
                                <li>
                                    Yggdrasil 保留隨時取消或修改此促銷活動的權利。
                                </li>
                            </ul>
                            <ul>
                            </ul>
                        </div>
                    </div>
                    <div class="point" id="div3">
                        <div class="Round"></div>
                        <h1 class="text">[ 旅遊贏家 ] 任務積分賽</h1>
                    </div>
                    <h4>2020/05/26 14:00</h4>
                    <div class="evn-list">
                        <h1>
                            完成任務能獲最高獎金
                        </h1>
                        <span>€ 4,000 / 獎池總金額</span>
                        <div class="evn-img">
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g11.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g12.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g13.png" /></li>
                            </ul>
                        </div>
                        <button class="terms">條款與規則<i class="icon icon-caret"></i></button>
                        <div class="terms-list">
                            <ul>
                                <li>
                                    任務中目標的數量：完成以下所有目標方可完成任務，獎池總金額 € 4,000。
                                </li>
                                <li>
                                    <ul>
                                        <li>滿天星淘汰賽 – 收集10個星星</li>
                                        <li>皇室大家庭 – 收集100 wild符號</li>
                                        <li>
                                            奪寶奇兵 – 點擊和打開3個箱子
                                        </li>
                                    </ul>
                                </li>
                                <li>參加活動不需要最低下注。</li>
                                <li>
                                    將為所有首次完成任務的玩家，提供唯一的玩家編號。
                                </li>
                                <li>
                                    在活動期間首次完成任務的玩家將獲得特別ID號。獨特的比賽ID號會為活動排行榜的顯示。若玩家成績在獎勵排行榜中將會顯示+1，例如總獎勵排行榜超過600名玩家，此玩家A排行將會顯示+1。
                                </li>
                                <li>此活動的獎金池以歐元設置，可能會受到貨幣兌換波動的影響，實際獎金將以當下放送金額為主。</li>
                                <li>
                                    完成任務的旋轉次數確定玩家在排行榜上的位置。在最少回合中完成任務的玩家將在排行榜得第一，並於活動結束後獲得一等獎。
                                </li>
                                <li>如果有兩個或更多的玩家以相同的回合次數完成任務，則首先完成任務的玩家將在排行榜上具有更高的位置。</li>
                                <li>每位玩家的位置每60秒更新一次。如果存在延時或者想要顯示最終的積分榜時，玩家將需要刷新遊戲。</li>
                                <li>在正式活動下進行下注才有資格參加活動。</li>
                                <li>活動中，玩家在排行榜上的排名是會更動的。</li>
                                <li>
                                    在整個活動期間，獲得的最佳成績將會計入排名榜中。
                                </li>
                                <li>玩家可於固定的旋轉之後選擇重新開始任務。</li>
                                <li>
                                    該活動結束後，玩家下一次登錄至任意一款 YGGDRASIL 老虎機遊戲時，獎品將會被發放至贏獎玩家的賬戶中。
                                </li>
                                <li>
                                    所有獎金將從各自營運商的發票中扣除，現金獎金自動授予給玩家時，將新增到玩家賬戶貨幣餘額中。
                                </li>
                            </ul>
                            <ul>
                            </ul>
                        </div>
                    </div>
                    <div class="point">
                        <div class="Round"></div>
                        <h1 class="text">THE END</h1>
                    </div>
                    <h4>2020/5/30 23:59</h4>
                </div>
                <div class="evn-rules">
                    <h3>
                        活動條款與規則
                    </h3>
                    <ul>
                        <li>唯有享受陽光，參加活動需最低下注€0.25(JPY 30)，神秘旅程 & 旅遊贏家皆不需要最低下注。</li>
                        <li>玩家可在彈出窗口中點即”立即加入”參加活動，活動不需要額外付費。</li>
                        <li>
                            如因任何參與比賽的機器或人為失誤引起的任何明顯錯誤，或技術故障（包括不正確的遊戲支出）導致獲勝，則Yggdrasil保留不支付獎金的權利。如果我們認為與其他玩家作弊或串通導致獲勝，我們還保留不支付獎金的權利。
                        </li>
                        <li>
                            此活動的所有獎金將從相應運營商的月度發票中扣除。請注意，當自動將現金獎勵授予玩家時，相關獎勵將以相應的帳戶幣種添加到玩家的餘額中。 Yggdrasil將根據發票中的貨幣（歐元），按照獎金池中指定的歐元值，將發票的扣除額記入。
                        </li>
                        <li>Yggdrasil 保留隨時取消或修改此促銷活動的權利。</li>
                    </ul>
                </div>
                <div class="min-bet">
                    <h3>最低投注額</h3>
                    <div class="rank-list">
                        <div class="table-body">
                            <div>
                                <img src="@SkinRootPath/images/event/country/myr.png" />
                                <span>MYR</span>
                                <span>1.5</span>
                            </div>
                            <div>
                                <img src="@SkinRootPath/images/event/country/usd.png" />
                                <span>USD</span>
                                <span>0.35</span>
                            </div>
                        </div>
                        <div class="table-body">
                            <div>
                                <img src="@SkinRootPath/images/event/country/idr.png" />
                                <span>IDR</span>
                                <span>2,000</span>
                            </div>
                            <div>
                                <img src="@SkinRootPath/images/event/country/thb.png" />
                                <span>THB</span>
                                <span>10</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer">
            <div class="footer__cpr">
                <span class="text">© Copyright 2020. @serverInfo.SiteName. All Rights Reserved.</span>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery-3.4.1.slim.min.js"></script>
    <script type="text/javascript">
        $(function () {
            $('.point').click(function () {
                $('.point').removeClass('open');
                $(this).addClass('open');
            });
            $('.terms').click(function () {
                $(this).siblings('.terms-list').toggle();
                $(this).children('i').toggleClass('open');
            });
        });
    </script>
</body>
</html>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using MemberSite.Service.Library
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject IWebHostEnvironment environment
@inject WalletBLL walletBLL
@inject CustInfoBLL custInfoBLL
@inject Tools tools
@inject SelLangBLL selLangBLL
@inject AuthorizeBLL authorizeBLL
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var SkinRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/common");
    var CmsEventPath = Url.Content($"~/CMS/{serverInfo.SiteName}/Casino/{selLangBLL.GetLangId()}");
    var CurrencyId = 0;
    if (User.Identity.IsAuthenticated)
    {
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;
    }
    else
    {
        CurrencyId = selLangBLL.GetPreferCurrencyId();
    }
    var Currency = selLangBLL.GetResourceValue($"lbl_Currency_{CurrencyId}");

    //ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = null;

}

<html lang="@selLangBLL.GetLangId()" data-layout="@(tools.IsMobile() ? "mobile" : "desktop")">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta name="format-detection" content="telephone=no">
    <link rel="shortcut icon" href="@SkinRootPath/images/favicon.ico" type="image/x-icon">

    <title>Event-YGG</title>
    <link href="@SkinRootPath/css/main.css" rel="stylesheet" asp-append-version="true" />
    <link href="@SkinRootPath/css/event-ygg.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="app app--help">
        <div class="header">
            <div class="header__main">
                <div class="header__logo">
                    <a class="logo" href="HelpCenter.html"></a>
                </div>
            </div>
        </div>
        <div class="main">
            <div class="evn-banner">
                <img src="@CmsEventPath/event-ygg-20200508.png" />
            </div>
            <div class="info">
                <div class="evn-time">
                    <h1>TRAVEL WITH YGGDRASIL</h1>
                    <h2>PROMOTION SCHEDULE</h2>
                    <h4 class="start">
                        Up Coming Promotion
                    </h4>
                    <h3>[ Enjoy the Sunshine ] Prize Drop Game</h3>
                    <h4>2020/5/11 (14:00) ~  2020/5/18 (23:59)  GMT+8</h4>
                    <h3>[ Journey to a mysterious adventure ] Multi-game Tournament</h3>
                    <h4>2020/5/19 (14:00) ~ 2020/5/25 (23:59)  GMT+8</h4>
                    <h3>[ Travel winner with rewards & souvenirs ] Mission</h3>
                    <h4>2020/5/26 (14:00) ~ 2020/5/30 (14:00)  GMT+8</h4>
                </div>
                <div class="evn-time-line">
                    <div class="point">
                        <div class="Round"></div>
                        <h1 class="text">START</h1>
                    </div>
                    <h4>2020/05/11 14:00</h4>
                    <div class="point open" id="div1">
                        <div class="Round"></div>
                        <h1 class="text">[ Enjoy the Sunshine ] Winning Game</h1>
                    </div>
                    <h4>2020/05/11 14:00</h4>
                    <div class="evn-list">
                        <h1>Randomly get a mystery</h1>
                        <span>€ 3,000 / Total prize pool</span>
                        <div class="evn-img">
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g1.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g2.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g3.png" /></li>
                            </ul>
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g4.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g5.png" /></li>
                            </ul>
                        </div>
                        <button class="terms">TERMS & CONDITIONS<i class="icon icon-caret"></i></button>
                        <div class="terms-list">
                            <ul>
                                <li>During these days has a big prize amount € 3,000</li>
                                <li>The minimum bet required to participate is €0.25(JPY 30)</li>
                                <li>Any bet placed on the participating games (BRAZIL BOMBA、SAHARA NIGHTS、GOLDEN FISH TANK、SUNNY SHORES、VALLEY OF THE GODS) during the campaign period can trigger a random mystery prize from the prize pool.</li>
                                <li>Each bet can win only 1 random prize reward.</li>
                                <li>Remaining number of prizes is updated every 60 seconds.</li>
                                <li>Prizes will be credited as cash.</li>
                                <li>Players can win more than 1 random prize reward during the campaign.</li>
                            </ul>
                        </div>
                    </div>
                    <div class="point" id="div2">
                        <div class="Round"></div>
                        <h1 class="text">[ Journey to a mysterious adventure ] Multi-game Tournament</h1>
                    </div>
                    <h4>2020/05/19 14:00</h4>
                    <div class="evn-list">
                        <h1>Highest Single Coin Win</h1>
                        <span>€ 3,000 / Total prize pool</span>
                        <div class="evn-img">
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g1.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g2.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g3.png" /></li>
                            </ul>
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g4.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g5.png" /></li>
                            </ul>
                        </div>
                        <div class="evn-img">
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g6.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g7.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g8.png" /></li>
                            </ul>
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g9.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g10.png" /></li>
                            </ul>
                        </div>
                        <button class="terms">TERMS & CONDITIONS<i class="icon icon-caret"></i></button>
                        <div class="terms-list">
                            <ul>
                                <li>Journey to a mysterious adventure is available in play for real mode with big prize amount € 3,000</li>
                                <li>There is not the minimum bet required to participate</li>
                                <li>Following their first win in the participating game (PIRATES–SMUGGLERS PARADISE、TEMPLE STACKS: SPLITZ、MULTIFLY、YOKOZUNA CLASH、VIKINGS GO WILD) , players will be provided with a unique tournament id number (“tournament id”), which will identify them on the leaderboard, which is available in the game’s client.</li>
                                <li>Each player’s score in the leaderboard is based on the sum of the highest coin wins in any spin in all selected games during the tournament period.</li>
                                <li>If there are two or more equal scores, the player who scored first will have the higher ranking on the leaderboard.</li>
                                <li>The highest score achieved throughout the campaign period by each player will count for their leaderboard ranking.</li>
                                <li>Each player’s leaderboard position will be refreshed every 60 seconds</li>
                                <li>Yggdrasil reserves the right to void scores, or not pay out a prize, where all or part of the score results from any obvious error, mistake or technical fault (including incorrect game payouts) whether caused by a machine or human error in respect of any of the participating games</li>
                                <li>Yggdrasil reserves the right to amend or cancel the campaign at any time.</li>
                            </ul>
                            <ul>
                            </ul>
                        </div>
                    </div>
                    <div class="point" id="div3">
                        <div class="Round"></div>
                        <h1 class="text">[ Travel winner with rewards & souvenirs ] Mission</h1>
                    </div>
                    <h4>2020/05/26 14:00</h4>
                    <div class="evn-list">
                        <h1>To complete the mission big prize amount</h1>
                        <span>€ 4,000 / Total prize pool</span>
                        <div class="evn-img">
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g11.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g12.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g13.png" /></li>
                            </ul>
                        </div>
                        <button class="terms">TERMS & CONDITIONS<i class="icon icon-caret"></i></button>
                        <div class="terms-list">
                            <ul>
                                <li>To complete the mission big prize amount € 4,000 , all objectives have to be fulfilled accordingly in each game:</li>
                                <li>
                                    <ul>
                                        <li>ALL STAR KNOCKOUT – Collect 10 Stars</li>
                                        <li>THE ROYAL FAMILY – Collect 100 Wild symbols in the base game</li>
                                        <li>JACKPOT RAIDERS– Open 3 chests in the Pick & Click</li>
                                    </ul>
                                </li>
                                <li>There is not the minimum bet required to participate</li>
                                <li>All players who complete the mission for the first time will be provided with a unique player number</li>
                                <li>The unique player number will be highlighted for the players on the leaderboard in the game client to follow their position</li>
                                <li>Prize pool for this campaign are set up in EUR and might be subject to currency conversion fluctuations</li>
                                <li>The number of spins made to complete the mission determines the player’s position on the leaderboard</li>
                                <li>If there are two or more players who complete the mission with the same number of rounds, the player completing it first will have higher position on the leaderboard</li>
                                <li>Player’s position is refreshed every 60 seconds</li>
                                <li>Only bets made in play for real mode qualify for the campaign</li>
                                <li>Players’ position on the leaderboard can change throughout the mission</li>
                                <li>Mission progress is automatically restarted when players can no longer improve the score</li>
                                <li>Mission progress can be restarted manually by the player after 25 spins</li>
                                <li>Cash prizes from the leaderboard will be credited to the players’ accounts after leaderboard is over For all other operators, prizes will need to be credited as cash (no wagering requirements) manually within 72 working hours</li>
                                <li>All prizes in the network campaign will be deducted from the monthly invoice of the respective operator</li>
                            </ul>
                        </div>
                    </div>
                    <div class="point">
                        <div class="Round"></div>
                        <h1 class="text">THE END</h1>
                    </div>
                    <h4>2020/5/30 23:59</h4>
                </div>
                <div class="evn-rules">
                    <h3>CAMPAIGN DETAILS</h3>
                    <ul>
                        <li>Only Enjoy the sunshine -Prize Drop (Mystery Prize), the minimum bet required to participate is €0.25(JPY 30)</li>
                        <li>To participate in the campaign, players shall confirm that they wish to take part in any of the stages of the campaign by clicking “join now” in the pop-up window</li>
                        <li>Yggdrasil reserves the right to not pay out a prize where the win results from any obvious error, mistake or technical fault (including incorrect game pay-outs) whether caused by a machine or human error in respect of any of the participating games</li>
                        <li>All prizes from this campaign will be deducted from the monthly invoice of the respective operator</li>
                        <li>Yggdrasil reserves the right to cancel or amend this promotion at any time.</li>
                    </ul>
                </div>
                <div class="min-bet">
                    <h3>MIN BET SIZE</h3>
                    <div class="rank-list">
                        <div class="table-body">
                            <div>
                                <img src="@SkinRootPath/images/event/country/myr.png" />
                                <span>MYR</span>
                                <span>1.5</span>
                            </div>
                            <div>
                                <img src="@SkinRootPath/images/event/country/usd.png" />
                                <span>USD</span>
                                <span>0.35</span>
                            </div>
                        </div>
                        <div class="table-body">
                            <div>
                                <img src="@SkinRootPath/images/event/country/idr.png" />
                                <span>IDR</span>
                                <span>2,000</span>
                            </div>
                            <div>
                                <img src="@SkinRootPath/images/event/country/thb.png" />
                                <span>THB</span>
                                <span>10</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer">
            <div class="footer__cpr">
                <span class="text">© Copyright 2020. @serverInfo.SiteName. All Rights Reserved.</span>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery-3.4.1.slim.min.js"></script>
    <script type="text/javascript">
        $(function () {
            $('.point').click(function () {
                $('.point').removeClass('open');
                $(this).addClass('open');
            });
            $('.terms').click(function () {
                $(this).siblings('.terms-list').toggle();
                $(this).children('i').toggleClass('open');
            });
        });
    </script>
</body>
</html>

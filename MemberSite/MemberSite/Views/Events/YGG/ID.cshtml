@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using MemberSite.Service.BLL
@using MemberSite.Service.Library
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject IWebHostEnvironment environment
@inject WalletBLL walletBLL
@inject CustInfoBLL custInfoBLL
@inject Tools tools
@inject SelLangBLL selLangBLL
@inject AuthorizeBLL authorizeBLL
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var SkinRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/common");
    var CmsEventPath = Url.Content($"~/CMS/{serverInfo.SiteName}/Casino/{selLangBLL.GetLangId()}");
    var CurrencyId = 0;
    if (User.Identity.IsAuthenticated)
    {
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;
    }
    else
    {
        CurrencyId = selLangBLL.GetPreferCurrencyId();
    }
    var Currency = selLangBLL.GetResourceValue($"lbl_Currency_{CurrencyId}");

    //ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Promotions");
    Layout = null;

}

<html lang="@selLangBLL.GetLangId()" data-layout="@(tools.IsMobile() ? "mobile" : "desktop")">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta name="format-detection" content="telephone=no">
    <link rel="shortcut icon" href="@SkinRootPath/images/favicon.ico" type="image/x-icon">

    <title>Event-YGG</title>
    <link href="@SkinRootPath/css/main.css" rel="stylesheet" asp-append-version="true" />
    <link href="@SkinRootPath/css/event-ygg.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="app app--help">
        <div class="header">
            <div class="header__main">
                <div class="header__logo">
                    <a class="logo" href="HelpCenter.html"></a>
                </div>
            </div>
        </div>
        <div class="main">
            <div class="evn-banner">
                <img src="@CmsEventPath/event-ygg-20200508.png" />
            </div>
            <div class="info">
                <div class="evn-time">
                    <h1>TRAVEL WITH YGGDRASIL<br />(TOTAL PRIZE IDR 175,000,000)</h1>
                    <h2>Campaign Berjalan Sebagai Berikut:</h2>
                    <h4 class="start">
                        Up Coming Promotion
                    </h4>
                    <h3>[ Enjoy the Sunshine ] Prize Drop</h3>
                    <h4>Tanggal 11 Mei pukul 14:00 ~ 18t Mei pukul 23:59 GMT+8</h4>
                    <h3>[ Journey to a mysterious adventure ] Multi-game Tournament</h3>
                    <h4>Tanggal 19 Mei Pukul 14:00 ~ Tanggal 25 Mei Pukul 23:59 GMT+8</h4>
                    <h3>[ Travel winner with rewards & souvenirs ] Mission</h3>
                    <h4>Tanggal 26 Mei Pukul 14:00 ~ Tanggal 30 Mei Pukul 23:59 GMT+8</h4>
                </div>
                <div class="evn-time-line">
                    <div class="point">
                        <div class="Round"></div>
                        <h1 class="text">START</h1>
                    </div>
                    <h4>2020/05/11 14:00</h4>
                    <div class="point open" id="div1">
                        <div class="Round"></div>
                        <h1 class="text">Enjoy the sunshine - Menjatuhkan Hadiah</h1>
                    </div>
                    <h4>2020/05/11 14:00</h4>
                    <div class="evn-list">
                        <h1>Hadiah Misteri</h1>
                        <span>€ 3,000 / Total prize pool</span>
                        <div class="evn-img">
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g1.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g2.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g3.png" /></li>
                            </ul>
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g4.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g5.png" /></li>
                            </ul>
                        </div>
                        <button class="terms">TERMS & CONDITIONS<i class="icon icon-caret"></i></button>
                        <div class="terms-list">
                            <ul>
                                <li>Selama di hari ini memiliki jumlah hadiah besar sebesar IDR 52,500,000.</li>
                                <li>Taruhan minimum yang diperlukan untuk berpartisipasi adalah IDR 437,500.</li>
                                <li>Setiap taruhan ditempatkan pada permainan yang berpartisipasi (BRAZIL BOMBA、SAHARA NIGHTS、GOLDEN FISH TANK、SUNNY SHORES、 VALLEY OF THE GODS) selama periode Campaign dapat memicu hadiah misteri acak dari kumpulan hadiah.</li>
                                <li>Setiap taruhan hanya bisa memenangkan satu hadiah acak.</li>
                                <li>Jumlah hadiah yang tersisa diperbarui setiap 60 detik.</li>
                                <li>Hadiah akan dikreditkan menjadi uang tunai.</li>
                                <li>Pemain dapat memenangkan lebih dari 1 hadiah acak selama Campaign.</li>
                            </ul>
                        </div>
                    </div>
                    <div class="point" id="div2">
                        <div class="Round"></div>
                        <h1 class="text">Journey to a mysterious adventure- Multi-Permainan petualangan-misterius</h1>
                    </div>
                    <h4>2020/05/19 14:00</h4>
                    <div class="evn-list">
                        <h1>Kemenangan Koin Tunggal Tertinggi</h1>
                        <span>€ 3,000 / Total prize pool</span>
                        <div class="evn-img">
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g1.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g2.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g3.png" /></li>
                            </ul>
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g4.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g5.png" /></li>
                            </ul>
                        </div>
                        <div class="evn-img">
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g6.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g7.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g8.png" /></li>
                            </ul>
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g9.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g10.png" /></li>
                            </ul>
                        </div>
                        <button class="terms">TERMS & CONDITIONS<i class="icon icon-caret"></i></button>
                        <div class="terms-list">
                            <ul>
                                <li>Journey to a mysterious adventure tersedia dalam mode nyata dengan jumlah hadiah besar Rp 52.500.000.</li>
                                <li>Tidak ada taruhan minimum yang diperlukan untuk berpartisipasi.</li>
                                <li>Skor setiap pemain di papan peringkat didasarkan pada jumlah kemenangan koin tertinggi dalam putaran apa pun di semua permainan yang dipilih selama periode turnamen.</li>
                                <li>Jika ada dua atau lebih dari skor yang sama, pemain yang pertama mencetak gol akan memiliki peringkat lebih tinggi di papan peringkat.</li>
                                <li>Skor tertinggi yang tercapai sepanjang periode Campaign oleh setiap pemain akan dihitung untuk peringkat papan peringkat mereka.</li>
                                <li>tiap Posisi pemain dipapan peringkat pemain akan diperbaharui ulang setiap 60 detik. Jika terjadi keterlambatan atau untuk menampilkan posisi papan peringkat terkini, pemain harus memuat ulang kembali permainan.</li>
                            </ul>
                            <ul>
                            </ul>
                        </div>
                    </div>
                    <div class="point" id="div3">
                        <div class="Round"></div>
                        <h1 class="text">Perjalanan Pemenang dengan hadiah & souvenir - Misi</h1>
                    </div>
                    <h4>2020/05/26 14:00</h4>
                    <div class="evn-list">
                        <h1>To complete the mission big prize amount</h1>
                        <span>€ 4,000 / Total prize pool</span>
                        <div class="evn-img">
                            <ul>
                                <li><img src="@SkinRootPath/images/event/g11.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g12.png" /></li>
                                <li><img src="@SkinRootPath/images/event/g13.png" /></li>
                            </ul>
                        </div>
                        <button class="terms">TERMS & CONDITIONS<i class="icon icon-caret"></i></button>
                        <div class="terms-list">
                            <ul>
                                <li>Semua persyaratan harus terpenuhi sesuai dalam setiap permainan:</li>
                                <li>
                                    <ul>
                                        <li>ALL STAR KNOCKOUT – koleksi 10 Bintang</li>
                                        <li>THE ROYAL FAMILY – Koleksi 100 Wild symbols dalam dasar permainan</li>
                                        <li>JACKPOT RAIDERS– Buka 3 peti di Pick & Click</li>
                                    </ul>
                                </li>
                                <li>Tidak ada taruhan minimum yang diperlukan untuk berpartisipasi.</li>
                                <li>Semua pemain yang menyelesaikan misi untuk pertama kalinya akan diberi nomor pemain unik.</li>
                                <li>Nomor pemain unik akan disorot untuk para pemain di papan peringkat dalam Klien permainan untuk mengikuti posisi mereka. Pemain yang berada di luar posisi papan peringkat akan ditampilkan sebagai posisi papan peringkat kualifikasi terakhir +1. Misalnya, untuk semua pemain yang peringkat di luar 600 posisi kualifikasi Papan peringkat, posisi yang ditampilkan adalah +1.</li>
                                <li>Kelompok hadiah untuk Campaign ini diatur dalam EUR dan dapat dikenakan fluktuasi konversi mata uang.</li>
                                <li>Jumlah misi yang dilakukan untuk menyelesaikan misi yang akan menentukan posisi pemain di papan peringkat. Pemain yang menyelesaikan misi dengan jumlah putaran yang paling sedikit akan selesai di posisi 1 dan memenangkan hadiah pertama.</li>
                                <li>Jika ada dua atau lebih dari pemain yang menyelesaikan misi dengan jumlah putaran yang sama, pemain yang menyelesaikannya terlebih dahulu akan memiliki posisi lebih tinggi di papan peringkat.</li>
                                <li>Posisi pemain di-perbaharui ulang setiap 60 detik.</li>
                                <li>Hanya taruhan yang dibuat untuk mode nyata yang memenuhi syarat untuk Campaign.</li>
                                <li>Di papan peringkat posisi pemain dapat berubah sepanjang misi.</li>
                                <li>Kemajuan misi secara otomatis dimulai kembali ketika pemain tidak dapat lagi meningkatkan skor. Skor terbaik akan selalu disimpan.</li>
                                <li>Kemajuan misi dapat dimulai kembali secara manual oleh pemain setelah 25 putaran. Tombol mulai ulang dapat ditemukan di klien permainan.</li>
                                <li>Hadiah uang tunai dari Papan peringkat akan dikreditkan ke akun para pemain setelah Papan peringkat berakhir. Untuk menampilkan hadiah sesuai dengan keseimbangannya, pemain harus membuka kembali permainan Yggdrasil apa pun setelah papan peringkat selesai. Hadiah tunai akan dikreditkan Menjadi uang tunai (tanpa persyaratan taruhan) secara manual dalam waktu Kerja 72 jam.</li>
                                <li>@serverInfo.SiteName berhak untuk tidak membayar hadiah di mana kemenangan hasil dari kesalahan yang jelas atau kesalahan teknis (termasuk pembayaran permainan yang salah) baik yang disebabkan oleh mesin atau kesalahan manusia sehubungan dengan salah satu permainan yang berpartisipasi. Kami selanjutnya berhak untuk tidak membayar hadiah di mana, menurut pendapat kami, hasil menang adalahdari kecurangan atau kolusi dengan pemain lain.</li>
                                <li>@serverInfo.SiteName berhak untuk mengubah atau menarik Promosi setiap saat.</li>
                                <li>@serverInfo.SiteName adalah penyelenggara tunggal Promosi dan keputusannya adalah final.</li>
                                <li>Berlaku Syarat dan ketentuan Umum @serverInfo.SiteName.</li>
                            </ul>
                        </div>
                    </div>
                    <div class="point">
                        <div class="Round"></div>
                        <h1 class="text">THE END</h1>
                    </div>
                    <h4>2020/5/30 23:59</h4>
                </div>
                <div class="evn-rules">
                    <h3>CAMPAIGN DETAILS</h3>
                    <ul>
                        <li>Only Enjoy the sunshine -Prize Drop (Mystery Prize), the minimum bet required to participate is €0.25(JPY 30)</li>
                        <li>To participate in the campaign, players shall confirm that they wish to take part in any of the stages of the campaign by clicking “join now” in the pop-up window</li>
                        <li>Yggdrasil reserves the right to not pay out a prize where the win results from any obvious error, mistake or technical fault (including incorrect game pay-outs) whether caused by a machine or human error in respect of any of the participating games</li>
                        <li>All prizes from this campaign will be deducted from the monthly invoice of the respective operator</li>
                        <li>Yggdrasil reserves the right to cancel or amend this promotion at any time.</li>
                    </ul>
                </div>
                <div class="min-bet">
                    <h3>MIN BET SIZE</h3>
                    <div class="rank-list">
                        <div class="table-body">
                            <div>
                                <img src="@SkinRootPath/images/event/country/myr.png" />
                                <span>MYR</span>
                                <span>1.5</span>
                            </div>
                            <div>
                                <img src="@SkinRootPath/images/event/country/usd.png" />
                                <span>USD</span>
                                <span>0.35</span>
                            </div>
                        </div>
                        <div class="table-body">
                            <div>
                                <img src="@SkinRootPath/images/event/country/idr.png" />
                                <span>IDR</span>
                                <span>2,000</span>
                            </div>
                            <div>
                                <img src="@SkinRootPath/images/event/country/thb.png" />
                                <span>THB</span>
                                <span>10</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer">
            <div class="footer__cpr">
                <span class="text">© Copyright 2020. @serverInfo.SiteName. All Rights Reserved.</span>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery-3.4.1.slim.min.js"></script>
    <script type="text/javascript">
        $(function () {
            $('.point').click(function () {
                $('.point').removeClass('open');
                $(this).addClass('open');
            });
            $('.terms').click(function () {
                $(this).siblings('.terms-list').toggle();
                $(this).children('i').toggleClass('open');
            });
        });
    </script>
</body>
</html>

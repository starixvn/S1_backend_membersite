@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@using MemberSite.Service.Model.Mapping
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject AuthorizeBLL authorizeBLL
@inject CustInfoBll custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Profile");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var authData = authorizeBLL.GetAuthData();
    var custInfoProfile = custInfoBLL.GetCustInfoProfile(authData.CustId);

    var i18n = new Dictionary<string, string>();
    var Country = new Dictionary<string, string>();
    i18n.Add("lbl_Birthday", selLangBLL.GetResourceValue("lbl_Birthday"));
    i18n.Add("msg_GoToDepositPage", selLangBLL.GetMsg("msg_GoToDepositPage"));
    i18n.Add("msg_SelectBirthDay", selLangBLL.GetMsg("msg_SelectBirthDay"));
    i18n.Add("msg_EnterRealName", selLangBLL.GetMsg("msg_EnterRealName"));
    i18n.Add("msg_EnterPhoneNumber", selLangBLL.GetMsg("msg_EnterPhoneNumber"));
    i18n.Add("lbl_ReModify", selLangBLL.GetResourceValue("lbl_ReModify"));
    i18n.Add("lbl_ConfirmAndUpdate", selLangBLL.GetResourceValue("lbl_ConfirmAndUpdate"));
    i18n.Add("msg_ConfirmRealNameAlert", selLangBLL.GetMsg("msg_ConfirmRealNameAlert"));

    i18n.Add("lbl_Month1", selLangBLL.GetResourceValue("lbl_Month1"));
    i18n.Add("lbl_Month2", selLangBLL.GetResourceValue("lbl_Month2"));
    i18n.Add("lbl_Month3", selLangBLL.GetResourceValue("lbl_Month3"));
    i18n.Add("lbl_Month4", selLangBLL.GetResourceValue("lbl_Month4"));
    i18n.Add("lbl_Month5", selLangBLL.GetResourceValue("lbl_Month5"));
    i18n.Add("lbl_Month6", selLangBLL.GetResourceValue("lbl_Month6"));
    i18n.Add("lbl_Month7", selLangBLL.GetResourceValue("lbl_Month7"));
    i18n.Add("lbl_Month8", selLangBLL.GetResourceValue("lbl_Month8"));
    i18n.Add("lbl_Month9", selLangBLL.GetResourceValue("lbl_Month9"));
    i18n.Add("lbl_Month10", selLangBLL.GetResourceValue("lbl_Month10"));
    i18n.Add("lbl_Month11", selLangBLL.GetResourceValue("lbl_Month11"));
    i18n.Add("lbl_Month12", selLangBLL.GetResourceValue("lbl_Month12"));

    i18n.Add("lbl_Confirm", selLangBLL.GetResourceValue("lbl_Confirm"));
    i18n.Add("lbl_Later", selLangBLL.GetResourceValue("lbl_Later"));
    i18n.Add("lbl_DepositNow", selLangBLL.GetResourceValue("lbl_DepositNow"));
    i18n.Add("lbl_Success", selLangBLL.GetResourceValue("lbl_Success"));
    i18n.Add("lbl_Profile", selLangBLL.GetResourceValue("lbl_Profile"));
    i18n.Add("lbl_Username", selLangBLL.GetResourceValue("lbl_Username"));
    i18n.Add("lbl_UsernameTooltip", selLangBLL.GetResourceValue("lbl_UsernameTooltip"));
    i18n.Add("lbl_CompletedRegistration", selLangBLL.GetResourceValue("lbl_CompletedRegistration"));
    i18n.Add("lbl_Email", selLangBLL.GetResourceValue("lbl_Email"));
    i18n.Add("lbl_EmailToolTip", selLangBLL.GetResourceValue("lbl_EmailToolTip"));
    i18n.Add("lbl_BankAccountName", selLangBLL.GetResourceValue("lbl_BankAccountName"));
    i18n.Add("lbl_BankAccountNameHint", selLangBLL.GetResourceValue("lbl_BankAccountNameHint"));
    i18n.Add("lbl_Country", selLangBLL.GetResourceValue("lbl_Country"));
    i18n.Add("lbl_CountryTooltip", selLangBLL.GetResourceValue("lbl_CountryTooltip"));
    i18n.Add("lbl_Phone", selLangBLL.GetResourceValue("lbl_Phone"));
    i18n.Add("lbl_PhoneTooltip", selLangBLL.GetResourceValue("lbl_PhoneTooltip"));
    i18n.Add("lbl_VIPLevel", selLangBLL.GetResourceValue("lbl_VIPLevel"));
    i18n.Add("lbl_Agent", selLangBLL.GetResourceValue("lbl_Agent"));
    i18n.Add("lbl_RegisterTime", selLangBLL.GetResourceValue("lbl_RegisterTime"));
    i18n.Add("lbl_LastLogin", selLangBLL.GetResourceValue("lbl_LastLogin"));
    i18n.Add("lbl_Back", selLangBLL.GetResourceValue("lbl_Back"));
    i18n.Add("lbl_Submit", selLangBLL.GetResourceValue("lbl_Submit"));
    i18n.Add("lbl_Update", selLangBLL.GetResourceValue("lbl_Update"));
    i18n.Add("msg_UsernameNotAvailable", selLangBLL.GetMsg("msg_UsernameNotAvailable"));
    i18n.Add("msg_UsernameReq", selLangBLL.GetMsg("msg_UsernameReq"));
    i18n.Add("msg_UsernameValidate", selLangBLL.GetMsg("msg_UsernameValidate"));
    i18n.Add("msg_MailReq", selLangBLL.GetMsg("msg_MailReq"));
    i18n.Add("msg_MailExisted", selLangBLL.GetMsg("msg_MailExisted"));
    i18n.Add("msg_Wrong", selLangBLL.GetMsg("msg_Wrong"));
    i18n.Add("msg_Updatesuccessful", selLangBLL.GetMsg("msg_Updatesuccessful"));
    var lbl_Txts = new string[] { "lbl_RealName", "lbl_RemindForName" };
    foreach (var lbl_Txt in lbl_Txts)
    {
        if (!i18n.ContainsKey(lbl_Txt))
            i18n.Add(lbl_Txt, selLangBLL.GetResourceValue(lbl_Txt));
    }

    var PerCountry = new CurrencyMapping().CountryMap;

    var currencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;

    var status = 3;
    if (custInfoProfile == null || string.IsNullOrEmpty(custInfoProfile.AccountName) && string.IsNullOrEmpty(custInfoProfile.PhoneNo))
    {
        status = 1;
    }
    else if (string.IsNullOrEmpty(custInfoProfile.AccountName))
    {
        status = 2;
    }
    else if (string.IsNullOrEmpty(custInfoProfile.Birth_y)) 
    {
        status = 4;
    }
}

@section Style{

}
<div class="main">
    <partial name="~/Views/Shared/_DesktopLeftMenu.cshtml" />
    <div class="page-title" role="mobile-only">
        <span class="text">@selLangBLL.GetResourceValue("lbl_MyAccount")</span>
    </div>
    <div class="page-tabs" role="mobile-only">
        <a class="page-tabs__btn" href="@Url.RouteUrl("desktop", new { action = "Profile", controller = "Account", LangId = selLangBLL.GetLangId() })" data-selected="true">
            <span class="text">@selLangBLL.GetResourceValue("lbl_Profile")</span>
        </a>
        <a class="page-tabs__btn" href="@Url.RouteUrl("desktop", new { action = "CustBankInfo", controller = "Account", LangId = selLangBLL.GetLangId() })">
            <span class="text">@selLangBLL.GetResourceValue("lbl_CustBank")</span>
        </a>
    </div>
    <div id="Profile" class="page"></div>
</div>
@section Scripts{
    <script type="text/javascript">
        var perCountry="@PerCountry[currencyId]";
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
        var Country = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(selLangBLL.GetCountryList()));
    </script>
    <script src="~/lib/runtime.min.js"></script>
    @if (custInfoProfile == null || custInfoProfile.AccountName == null || custInfoProfile.CountryCode == null || custInfoProfile.PhoneNo == null)
    {
    <script>
            var SetStatus = '@status';
            var custdata = {
                AccountName:'@custInfoProfile.AccountName',
                Birthday: {
                    day:'@custInfoProfile.Birth_d',
                    month: '@custInfoProfile.Birth_m',
                    year:'@custInfoProfile.Birth_y'
                },
                PhoneNo: '@custInfoProfile.PhoneNo'
            }

    </script>
    <script src="~/js/component/account/UpdProfile.min.js" asp-append-version="true"></script>
    }
    else
    {
    <script src="~/js/component/account/Profile.min.js" asp-append-version="true"></script>
    }
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_ChangePassword");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var i18n = new Dictionary<string, string>
    {
        { "lbl_NewPassword", selLangBLL.GetResourceValue("lbl_NewPassword") },
        { "lbl_PasswordTooltip", selLangBLL.GetResourceValue("lbl_PasswordTooltip") },
        { "lbl_Submit", selLangBLL.GetResourceValue("lbl_Submit") },
        { "msg_PasswordReq", selLangBLL.GetMsg("msg_PasswordReq") },
        { "msg_PasswordLength", selLangBLL.GetMsg("msg_PasswordLength") },
        { "msg_PasswordValidate", selLangBLL.GetMsg("msg_PasswordValidate") }
    };
}
<div class="main">
    <partial name="~/Views/Shared/_DesktopLeftMenu.cshtml" />
    <div class="page">
        <div class="heading">
            <span class="text">@selLangBLL.GetResourceValue("lbl_ResetPassword")</span>
        </div>
        <div id="ResetPwd"></div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
    </script>

    <script src="~/lib/runtime.min.js"></script>
    <script src="~/js/component/account/ResetPwd.min.js" asp-append-version="true"></script>
}
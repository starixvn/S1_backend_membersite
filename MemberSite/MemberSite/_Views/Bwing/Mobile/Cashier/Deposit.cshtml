@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Deposit");
    Layout = "~/_Views/Bwing/Mobile/Shared/_Layout.cshtml";
    var authData = authorizeBLL.GetAuthData();
    var custInfoProfile = custInfoBLL.GetCustInfoProfile(authData.CustId);
}
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var i18n = new Dictionary<string, string>();
    i18n.Add("lbl_Deposit", selLangBLL.GetResourceValue("lbl_Deposit"));
    i18n.Add("lbl_Transaction", selLangBLL.GetResourceValue("lbl_Transaction"));
    i18n.Add("lbl_TransactionHint", selLangBLL.GetResourceValue("lbl_TransactionHint"));
    i18n.Add("lbl_BankAccountName", selLangBLL.GetResourceValue("lbl_BankAccountName"));
    i18n.Add("lbl_BankNumber", selLangBLL.GetResourceValue("lbl_BankNumber"));
    i18n.Add("lbl_DepositAmount", selLangBLL.GetResourceValue("lbl_DepositAmount"));
    i18n.Add("lbl_Postscript", selLangBLL.GetResourceValue("lbl_Postscript"));
    i18n.Add("lbl_PostscriptHint", selLangBLL.GetResourceValue("lbl_PostscriptHint"));
    i18n.Add("lbl_Close", selLangBLL.GetResourceValue("lbl_Close"));
    i18n.Add("lbl_ImportantNote", selLangBLL.GetResourceValue("lbl_ImportantNote"));
    i18n.Add("lbl_ConfirmDeposit", selLangBLL.GetResourceValue("lbl_ConfirmDeposit"));
    i18n.Add("lbl_TransferTo", selLangBLL.GetResourceValue("lbl_TransferTo"));
    i18n.Add("lbl_Memo", selLangBLL.GetResourceValue("lbl_Memo"));
    i18n.Add("lbl_Cancel", selLangBLL.GetResourceValue("lbl_Cancel"));
    i18n.Add("lbl_Confirm", selLangBLL.GetResourceValue("lbl_Confirm"));
    i18n.Add("lbl_RecentTransactions", selLangBLL.GetResourceValue("lbl_RecentTransactions"));
    i18n.Add("lbl_AllTranscations", selLangBLL.GetResourceValue("lbl_AllTranscations"));
    i18n.Add("lbl_Date", selLangBLL.GetResourceValue("lbl_Date"));
    i18n.Add("lbl_Time", selLangBLL.GetResourceValue("lbl_Time"));
    i18n.Add("lbl_ID", selLangBLL.GetResourceValue("lbl_ID"));
    i18n.Add("lbl_Method", selLangBLL.GetResourceValue("lbl_Method"));
    i18n.Add("lbl_Amount", selLangBLL.GetResourceValue("lbl_Amount"));
    i18n.Add("lbl_Status", selLangBLL.GetResourceValue("lbl_Status"));
    i18n.Add("lbl_WireTransfers", selLangBLL.GetResourceValue("lbl_WireTransfers"));
    i18n.Add("lbl_DepositOptionHint", selLangBLL.GetResourceValue("lbl_DepositOptionHint"));
    i18n.Add("lbl_CreditTime", selLangBLL.GetResourceValue("lbl_CreditTime"));
    i18n.Add("lbl_5mins", selLangBLL.GetResourceValue("lbl_5mins"));
    i18n.Add("lbl_Instant", selLangBLL.GetResourceValue("lbl_Instant"));
    i18n.Add("lbl_OnlineBanking", selLangBLL.GetResourceValue("lbl_OnlineBanking"));
    i18n.Add("lbl_MobileDeposit", selLangBLL.GetResourceValue("lbl_MobileDeposit"));
    i18n.Add("lbl_AmountTooltip", selLangBLL.GetResourceValue("lbl_AmountTooltip"));
    i18n.Add("lbl_Back", selLangBLL.GetResourceValue("lbl_Back"));
    i18n.Add("lbl_Submit", selLangBLL.GetResourceValue("lbl_Submit"));
    i18n.Add("lbl_NotinLimit", selLangBLL.GetResourceValue("lbl_NotinLimit"));
    i18n.Add("lbl_MomoHint", selLangBLL.GetResourceValue("lbl_MomoHint"));
    i18n.Add("lbl_Limit", selLangBLL.GetResourceValue("lbl_Limit"));
    i18n.Add("lbl_Unlimited", selLangBLL.GetResourceValue("lbl_Unlimited"));
    i18n.Add("lbl_Optional", selLangBLL.GetResourceValue("lbl_Optional"));
    i18n.Add("lbl_Refno", selLangBLL.GetResourceValue("lbl_Refno"));
    i18n.Add("lbl_RefnoToolTip", selLangBLL.GetResourceValue("lbl_RefnoToolTip"));
    i18n.Add("lbl_DepositTime", selLangBLL.GetResourceValue("lbl_DepositTime"));
    i18n.Add("lbl_DepositTimeToolTip", selLangBLL.GetResourceValue("lbl_DepositTimeToolTip"));
    i18n.Add("lbl_Required", selLangBLL.GetResourceValue("lbl_Required"));
    i18n.Add("lbl_UploadSuccess", selLangBLL.GetResourceValue("lbl_UploadSuccess"));
    i18n.Add("lbl_UploadFile", selLangBLL.GetResourceValue("lbl_UploadFile"));
    i18n.Add("lbl_UpdateSuccess", selLangBLL.GetResourceValue("lbl_UpdateSuccess"));
    i18n.Add("lbl_AttachFile", selLangBLL.GetResourceValue("lbl_AttachFile"));
    i18n.Add("lbl_SubmitProof", selLangBLL.GetResourceValue("lbl_SubmitProof"));
    i18n.Add("lbl_CancelConfirm", selLangBLL.GetResourceValue("lbl_CancelConfirm"));
    i18n.Add("lbl_MOMO", selLangBLL.GetResourceValue("lbl_MOMO"));
    i18n.Add("lbl_ZALO", selLangBLL.GetResourceValue("lbl_ZALO"));
    i18n.Add("lbl_VIETTELPAY", selLangBLL.GetResourceValue("lbl_VIETTELPAY"));
    i18n.Add("lbl_ThaiQR", selLangBLL.GetResourceValue("lbl_ThaiQR"));
    i18n.Add("lbl_Alipay", selLangBLL.GetResourceValue("lbl_Alipay"));
    i18n.Add("lbl_WeChatPay", selLangBLL.GetResourceValue("lbl_WeChatPay"));
    i18n.Add("lbl_QQpay", selLangBLL.GetResourceValue("lbl_QQpay"));
    i18n.Add("lbl_JDpay", selLangBLL.GetResourceValue("lbl_JDpay"));
    i18n.Add("lbl_Unionpay", selLangBLL.GetResourceValue("lbl_Unionpay"));

    for (int depositStatus = 0; depositStatus <= 8; depositStatus++)
    {
        string sKey = $"lbl_DepositStatus{depositStatus}";
        i18n.Add(sKey, selLangBLL.GetResourceValue(sKey));
    }
    i18n.Add($"lbl_DepositStatus{99}", selLangBLL.GetResourceValue($"lbl_DepositStatus{99}"));

    for (var depositType = 1; depositType <= 3; depositType++)
    {
        string sKey = $"lbl_DepositType{depositType}";
        i18n.Add(sKey, selLangBLL.GetResourceValue(sKey));
    }
}
@section Style{
    <link rel="stylesheet" type="text/css" href="~/SiteSkin/Bwing/Mobile/assets/css/lib/daterangepicker.css" />
    <link href="~/SiteSkin/Bwing/Mobile/assets/css/page.css" rel="stylesheet" />
    <link href="~/SiteSkin/Bwing/Mobile/assets/css/system.css" rel="stylesheet" />
    <link href="~/SiteSkin/Bwing/Mobile/assets/css/lib//select2/select2.css" rel="stylesheet" />
}

<div class="system-content">
    <div class="page-title">@selLangBLL.GetResourceValue("lbl_Cashier")</div>
    <div class="sub-page">
        <div class="sub-title active">
            <a>@selLangBLL.GetResourceValue("lbl_Deposit")</a>
        </div>
        <div class="sub-title">
            <a href="@Url.RouteUrl("desktop", new { action = "Transfer", controller = "Cashier", LangId = selLangBLL.GetLangId() })">@selLangBLL.GetResourceValue("lbl_TransferFunds")</a>
        </div>
        <div class="sub-title">
            <a href="@Url.RouteUrl("desktop", new { action = "Withdrawal", controller = "Cashier", LangId = selLangBLL.GetLangId() })">@selLangBLL.GetResourceValue("lbl_Withdrawal")</a>
        </div>
    </div>

    @if (custInfoProfile == null || custInfoProfile.AccountName == null || custInfoProfile.CountryCode == null || custInfoProfile.PhoneNo == null)
    {
        <div class="page">
            <div class="heading">
                <span class="text">@selLangBLL.GetResourceValue("lbl_Deposit")</span>
            </div>
            <div class="text--lg">@selLangBLL.GetResourceValue("lbl_ImportantNote")</div>
            <p>@selLangBLL.GetResourceValue("lbl_UpdatePersonalInfo")</p><br />
            <div class="btn-group">
                <a class="btn btn-secondary" href="@Url.RouteUrl("desktop", new { action = "Profile", controller = "Account", LangId = selLangBLL.GetLangId() })">
                    <span class="text">@selLangBLL.GetResourceValue("lbl_UpdatePersonalDetail")</span>
                </a>
            </div>
        </div>
    }
    else
    {
        <div id="content"></div>
    }

</div>

@section Scripts{
    @if (custInfoProfile == null || custInfoProfile.AccountName == null || custInfoProfile.CountryCode == null || custInfoProfile.PhoneNo == null)
    {

    }
    else
    {
        <script type="text/javascript">
            $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
            var hrefAllTrans = "@Url.RouteUrl("desktop", new { action = "Deposit", controller = "History", LangId = selLangBLL.GetLangId() })";
            var OnlineBankingUrl = "@Url.RouteUrl("desktop", new { action = "DepositReqOnlineBanking", controller = "Cashier", LangId = selLangBLL.GetLangId() })";
            var MobilePayUrl = "@Url.RouteUrl("desktop", new { action = "DepositReqMobilePay", controller = "Cashier", LangId = selLangBLL.GetLangId() })";
        </script>
        <script src="~/SiteSkin/Bwing/Mobile/js/lib//select2//select2.js"></script>
        <script src="~/lib/runtime.min.js"></script>
        <script src="~/lib/clipboard.min.js"></script>
        <script src="~/js/Bwing/component/cashier/depositPanel.min.js" asp-append-version="true"></script>
    }
}
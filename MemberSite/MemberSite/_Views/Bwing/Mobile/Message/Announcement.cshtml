@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL

@{
    ViewData["Title"] = selLangBLL.GetResourceValue("lbl_Announcement");
    Layout = "~/_Views/Bwing/Mobile/Shared/_Layout.cshtml";
}
@{
    var i18n = new Dictionary<string, string>();
    i18n.Add("lbl_SelectAll", selLangBLL.GetResourceValue("lbl_SelectAll"));
    i18n.Add("lbl_Page", selLangBLL.GetResourceValue("lbl_Page"));
    i18n.Add("lbl_Of", selLangBLL.GetResourceValue("lbl_Of"));
    i18n.Add("msg_NoData", selLangBLL.GetMsg("msg_NoData"));
    i18n.Add("lbl_Announcement", selLangBLL.GetResourceValue("lbl_Announcement"));
}

@section Style{
    <link href="~/SiteSkin/Bwing/Mobile/assets/css/page.css" rel="stylesheet" />
    <link href="~/SiteSkin/Bwing/Mobile/assets/css/system.css" rel="stylesheet" />
}

<div class="system-content">
    <div class="page-title">@selLangBLL.GetResourceValue("lbl_Announcement")</div>
    <div class="sub-page">
        <div class="sub-title">
            <a href="@Url.RouteUrl("desktop", new { action = "PersonalMsg", controller = "Message", LangId = selLangBLL.GetLangId() })">@selLangBLL.GetResourceValue("lbl_PersonalMsg")</a>
        </div>
        <div class="sub-title active">
            <a>@selLangBLL.GetResourceValue("lbl_Announcement")</a>
        </div>
    </div>
    <div id="content"></div>
</div>

@section Scripts{
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
    </script>
    <script src="~/js/Bwing/component/message/announcement/announcement.min.js" asp-append-version="true"></script>
}

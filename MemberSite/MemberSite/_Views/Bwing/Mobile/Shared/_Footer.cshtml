@using MemberSite.Service.BLL
@using MemberSite.Service.Library
@using MemberSite.Service.Model.enums
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL
@inject Tools tools
@inject GamingBLL gamingBLL
@{
    var domain = serverInfoBLL.GetDomain();
    var pos = domain.IndexOf(".");
    if (pos > 0)
        domain = domain.Substring(pos+1);

    var serverInfo = serverInfoBLL.GetServerInfo();
    var StaticRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Static/{selLangBLL.GetLangId()}");

    var entFishingPageUrl = "";
    if (User.Identity.IsAuthenticated)
    {
        entFishingPageUrl = gamingBLL.GetEntPageUrl(7, "10", Url, GameType.Fishing);
        entFishingPageUrl = $"javascript:window.open('{entFishingPageUrl}', 'Tp_7_10', 'toolbar=no, menubar=no,scrollbars=no,resizable=no,location=no,directories=no,status=no, top=0, left=0').focus()";
    }
    else
    {
        entFishingPageUrl = "javascript:void(0);";
    }
}
@functions{
    string GetEntPageUrl(int tpId, string gameId)
    {
        var homeUrl = Url.RouteUrl("desktop", new { action = ViewContext.RouteData.Values["action"], controller = ViewContext.RouteData.Values["controller"], LangId = selLangBLL.GetLangId() }, protocol: Context.Request.Scheme, host: Context.Request.Host.Host);
        var signupUrl = Url.RouteUrl("desktop", new { action = "Register", controller = "Home", LangId = selLangBLL.GetLangId() }, protocol: Context.Request.Scheme, host: Context.Request.Host.Host);
        var LoginUrl = Url.RouteUrl("desktop", new { action = ViewContext.RouteData.Values["action"], controller = ViewContext.RouteData.Values["controller"], LangId = selLangBLL.GetLangId(), loginCont = 1 }, protocol: Context.Request.Scheme, host: Context.Request.Host.Host);
        var entPageUrl = "";


        if (!User.Identity.IsAuthenticated)
        {
            entPageUrl = "javascript:void();";
        }
        else
        {
            //if (tpId == 1)
            //{
            //    var msg =  @selLangBLL.GetErrMsg(10);
            //    entPageUrl = $"javascript:alert('{msg}');";
            //    return entPageUrl;
            //}

            entPageUrl = Url.RouteUrl("desktop", new { action = "Index", controller = "entPage", LangId = selLangBLL.GetLangId(), homeUrl, signupUrl, LoginUrl, tpId, gameId });
            entPageUrl = $"javascript:LaunchGame('{entPageUrl}', 'Tp_{tpId}_{gameId}',{tpId}, {gameId});";
        }
        return entPageUrl;
    }
}
<footer class="footer">
    <div class="container">
        <div class="menu-footer">
            <div class="item footer-product">
                <p class="title">@selLangBLL.GetResourceValue("lbl_SportsBetting")</p>
                <ul class="item-list">
                    <li><a class="link-footer" href="@gamingBLL.GetEntPageUrl(1,"1",Url)">@selLangBLL.GetResourceValue("lbl_SoccerBetting")</a></li>
                    <li><a class="link-footer" href="@gamingBLL.GetEntPageUrl(1,"2",Url)">@selLangBLL.GetResourceValue("lbl_BasketballBetting")</a></li>
                    <li><a class="link-footer" href="@gamingBLL.GetEntPageUrl(1,"8",Url)">@selLangBLL.GetResourceValue("lbl_BaseballBetting")</a></li>
                    <li><a class="link-footer" href="@gamingBLL.GetEntPageUrl(1,"3",Url)">@selLangBLL.GetResourceValue("lbl_FootballBetting")</a></li>
                    <li><a class="link-footer" href="@gamingBLL.GetEntPageUrl(1,"5",Url)">@selLangBLL.GetResourceValue("lbl_TennisBetting")</a></li>
                    <li><a class="link-footer" href="@gamingBLL.GetEntPageUrl(1,"4",Url)">@selLangBLL.GetResourceValue("lbl_HockeyBetting")</a></li>
                    <li><a class="link-footer @(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@gamingBLL.GetEntPageUrl(1,"43",Url)">@selLangBLL.GetResourceValue("lbl_eSportsBetting")</a></li>
                </ul>
            </div>
            <div class="item">
                <div>
                    <p class="title">@selLangBLL.GetResourceValue("lbl_OurPolicies")</p>
                    <ul class="item-list">
                        <li><a class="link-footer" href="@StaticRootPath/ResposibleGaming.html" target="_temp">@selLangBLL.GetResourceValue("lbl_ResposibleGaming")</a></li>
                        <li><a class="link-footer" href="@StaticRootPath/TermsConditions.html" target="_temp">@selLangBLL.GetResourceValue("lbl_TermsConditions")</a></li>
                        <li><a class="link-footer" href="@StaticRootPath/PrivacyPolicy.html" target="_temp">@selLangBLL.GetResourceValue("lbl_PrivacyPolicy")</a></li>
                        <li><a class="link-footer" href="@StaticRootPath/CookiePolicy.html" target="_temp">@selLangBLL.GetResourceValue("lbl_CookiePolicy")</a></li>
                    </ul>
                </div>
                <div class="item footer-support">
                    <p class="title">@selLangBLL.GetResourceValue("lbl_HelpSupport")</p>
                    <ul class="item-list">
                        <li><a class="link-footer" href="@StaticRootPath/RulesandRegulations.html" target="_temp">@selLangBLL.GetResourceValue("lbl_RuleRegulations")</a></li>
                        <li><a class="link-footer" href="@StaticRootPath/AccountTerms.html" target="_temp">@selLangBLL.GetResourceValue("lbl_AccountTerms")</a></li>
                        <li><a class="link-footer" href="@StaticRootPath/FAQ.html" target="_temp">@selLangBLL.GetResourceValue("lbl_FAQ")</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="menu-footer">
            <div class="item footer-promotions">
                <p class="title">@selLangBLL.GetResourceValue("lbl_Promotion")</p>
                <ul class="item-list">
                    <li>
                        <a class="link-footer" href="@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })" target="_temp">
                            @selLangBLL.GetResourceValue("lbl_Promotion")
                        </a>
                    </li>
                </ul>
            </div>
            <div class="item about-us">
                <div class="footer-social">
                    <p class="title">@selLangBLL.GetResourceValue("lbl_SocialMedia")</p>
                    <ul class="item-list">
                        <li><a class="link-footer" href="https://www.facebook.com/@(selLangBLL.GetResourceValue("lbl_FacebookAccount"))" target="_temp"><i class="icon icon-facebook-circle"></i>@selLangBLL.GetResourceValue("lbl_Facebook")</a></li>
                        <li><a class="link-footer" href="https://twitter.com/@(selLangBLL.GetResourceValue("lbl_TwitterAccount"))" target="_temp"><i class="icon icon-twitter-circle"></i>@selLangBLL.GetResourceValue("lbl_Twitter")</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="menu-footer">
            <div class="item about-us">
                <div class="title">@serverInfo.SiteName</div>
                <ul class="item-list">
                    <li><a class="link-footer" href="https://aff.@domain/?lang=@selLangBLL.GetLangId()" target="_temp"><strong>@selLangBLL.GetResourceValue("lbl_Affiliates")</strong></a></li>
                    <li><a class="link-footer" href="@StaticRootPath/AboutUs.html" target="_temp">@selLangBLL.GetResourceValue("lbl_AboutUs")</a></li>
                    <li><a class="link-footer" href="@StaticRootPath/Terms.html" target="_temp">@selLangBLL.GetResourceValue("lbl_Terms")</a></li>
                    <li><a class="link-footer" href="@StaticRootPath/ContactUs.html" target="_temp">@selLangBLL.GetResourceValue("lbl_ContactUs")</a></li>
                </ul>

                <div class="languages">
                    <div class="languages-box">
                        <div id="lang_selector" class="language-dropdown">
                            <label for="toggle" class="lang-flag lang-@selLangBLL.GetLangId()" title="@selLangBLL.GetResourceValue("lbl_SelectLanguage")">
                                <span class="flag"></span>
                            </label>
                            <ul class="lang-list">
                                @foreach (var siteLanguage in selLangBLL.GetLangIdList())
                                {
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <li class="lang lang-@siteLanguage.LangId @(siteLanguage.LangId == selLangBLL.GetLangId() ? "selected":"")" Js-lang-id="@siteLanguage.LangId" title="@siteLanguage.Language">
                                            <span class="flag"></span>
                                            <span class="text">@siteLanguage.Language</span>
                                        </li>
                                    }
                                    else
                                    {
                                        var LangUrl = $"{Url.RouteUrl("desktop", new { action = ViewContext.RouteData.Values["action"], controller = ViewContext.RouteData.Values["controller"], siteLanguage.LangId })}{Context.Request.QueryString}";
                                        <li class="lang lang-@siteLanguage.LangId @(siteLanguage.LangId == selLangBLL.GetLangId() ? "selected":"")" title="@siteLanguage.Language" onclick="location.href='@LangUrl';">
                                            <span class="flag"></span>
                                            <span class="text">@siteLanguage.Language</span>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                        <div id="lang_selected" class="lang_selected">
                            <p>@selLangBLL.GetLangIdList().Where(x => x.LangId == selLangBLL.GetLangId()).FirstOrDefault().Language</p>
                        </div>
                    </div>
                </div>

            </div>
            <div class="item footer-contact">
                <div>
                    <div class="title">@selLangBLL.GetResourceValue("lbl_ContactUs")</div>
                    <div class="text">
                        @selLangBLL.GetResourceValue("lbl_ContactUsHint")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="copy-right">
        <p>© Copyright @DateTime.Now.Year. @serverInfo.SiteName. All Rights Reserved.</p>
        @*<button class="btn btn-view">
                <i class="icon icon-desktop"></i>@selLangBLL.GetResourceValue("lbl_Fullversion")
            </button>*@
    </div>
</footer>
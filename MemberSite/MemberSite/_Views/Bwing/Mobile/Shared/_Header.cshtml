                                <i class="icon icon-key"></i>
                            </span><span>Change password</span>
                        </a>
                        <a href="views/systems/transfer.html" class="system-item">
                            <span class="system-icon">
                                <i class="icon icon-dola"></i>
                            </span><span>Transfer</span>
                        </a>
                        <a href="views/systems/deposit-history.html" class="system-item">
                            <span class="system-icon">
                                <i class="icon icon-history"></i>
                            </span><span>Transaction History</span>
                        </a>
                        <a href="views/systems/statement.html" class="system-item">
                            <span class="system-icon">
                                <i class="icon icon-profile"></i>
                            </span><span>Statement</span>
                        </a>
                    </div>

@using MemberSite.Service.BLL
@using MemberSite.Service.Library
@using MemberSite.Service.Model.enums
@using System.Security.Claims
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL
@inject CustInfoBll custInfoBLL
@inject PromotionBll promotionBLL
@inject Tools tools
@inject GamingBLL gamingBLL
@inject AuthorizeBLL authorizeBLL
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var SkinRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/common");

    var entFishingPageUrl = "";
    var entFishingPageUrlSG1 = "";
    var entFishingPageUrlSG2 = "";
    var CurrencyId = 0;
    if (User.Identity.IsAuthenticated)
    {
        entFishingPageUrl = gamingBLL.GetEntPageUrl(7, "10", Url, GameType.Fishing);
        entFishingPageUrl = $"javascript:window.open('{entFishingPageUrl}', 'Tp_7_10', 'toolbar=no, menubar=no,scrollbars=no,resizable=no,location=no,directories=no,status=no, top=0, left=0').focus()";
        
        entFishingPageUrlSG1 = gamingBLL.GetEntPageUrl(10, "F-SF01", Url, GameType.Fishing);
        entFishingPageUrlSG1 = $"javascript:window.open('{entFishingPageUrlSG1}', 'Tp_10_F-SF01', 'toolbar=no, menubar=no,scrollbars=no,resizable=no,location=no,directories=no,status=no, top=0, left=0').focus()";

        entFishingPageUrlSG2 = gamingBLL.GetEntPageUrl(10, "F-SF02", Url, GameType.Fishing);
        entFishingPageUrlSG2 = $"javascript:window.open('{entFishingPageUrlSG2}', 'Tp_10_F-SF02', 'toolbar=no, menubar=no,scrollbars=no,resizable=no,location=no,directories=no,status=no, top=0, left=0').focus()";

        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;
    }
    else
    {
        entFishingPageUrl = "javascript:void(0);";
        entFishingPageUrlSG1 = "javascript:void(0);";
        entFishingPageUrlSG2 = "javascript:void(0);";
        CurrencyId = selLangBLL.GetPreferCurrencyId();
    }
}
<header class="header @(User.Identity.IsAuthenticated ? "is-login":"")">
    <span class="btn-menu" id="btn-menu"><span class="line"></span></span>
    <a class="logo-header" href="@Url.RouteUrl("desktop", new { action = "Index", controller = "Home", LangId = selLangBLL.GetLangId() })">
        <img src="~/SiteSkin/Bwing/Mobile/assets/images/logo.png" alt="Logo" />
    </a>
    <div class="header-top-right">
        @if (!User.Identity.IsAuthenticated)
        {
            <div class="before-login">
                <button class="btn btn-login" data-remodal-target="modal-login">
                    @selLangBLL.GetResourceValue("lbl_Login")
                </button>
                <button class="btn btn-register" data-remodal-target="modal-register">
                    @selLangBLL.GetResourceValue("lbl_Register")
                </button>
            </div>
        }
    </div>
    <div class="nav-mobile-overlay">
        <div class="nav-mobile">
            <span class="btn-menu bt-menu-close" id="btn-menu-close"><span class="line"></span></span>
            @if (User.Identity.IsAuthenticated)
            {
                <div class="nav-top-after">
                    <div class="nav-info">
                        <div class="info">
                            @selLangBLL.GetResourceValue("lbl_Welcome"),
                            <span class="link">@User.Identity.Name</span>
                            <div id="header-wallet-info">
                                <p class="balance Js-Balance Js-Wallet-Refresh"></p>
                            </div>
                        </div>
                        <i id="logout" class="icon icon-logout"></i>
                    </div>
                    <div class="nav-button">
                        <a class="btn btn-primary" href="@Url.RouteUrl("desktop", new { action="Deposit" , controller="Cashier" , LangId=selLangBLL.GetLangId() })">@selLangBLL.GetResourceValue("lbl_Deposit")</a>
                        <a class="btn btn-primary" href="@Url.RouteUrl("desktop", new { action = "Transfer", controller = "Cashier", LangId = selLangBLL.GetLangId() })"> @selLangBLL.GetResourceValue("lbl_Transfer")</a>
                        <a class="btn btn-primary" href="@Url.RouteUrl("desktop", new { action = "Withdrawal", controller = "Cashier", LangId = selLangBLL.GetLangId() })"> @selLangBLL.GetResourceValue("lbl_Withdrawal")</a>
                    </div>
                </div>
            }
            else
            {
                <div class="nav-top-before">
                    <button class="btn btn-login" data-remodal-target="modal-login"> @selLangBLL.GetResourceValue("lbl_Login")</button>
                    <button class="btn btn-register" data-remodal-target="modal-register"> @selLangBLL.GetResourceValue("lbl_Register")</button>
                </div>
            }
            <div class="nav-mobile-main">
                <div class="main-nav-mobile">
                    <div class="nav-item">
                        <a href="@Url.RouteUrl("desktop", new { action = "Index", controller = "Home", LangId = selLangBLL.GetLangId() })">
                            <i class="icon icon-menu-home"></i> @selLangBLL.GetResourceValue("lbl_Home")
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@gamingBLL.GetEntPageUrl(1,"1",Url)">
                            <i class="icon icon-menu-sport"></i> @selLangBLL.GetResourceValue("lbl_Sports")
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="@(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@gamingBLL.GetEntPageUrl(1,"43",Url)">
                            <i class="icon icon-menu-esport"></i> @selLangBLL.GetResourceValue("lbl_eSports")
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="@(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@gamingBLL.GetEntPageUrl(1,"200",Url)">
                            <i class="icon icon-menu-number"></i>Saba Club
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@gamingBLL.GetEntPageUrl(1,"180",Url)">
                            <i class="icon icon-menu-virtual"></i>@selLangBLL.GetResourceValue("lbl_VirtualSports")
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@Url.RouteUrl("desktop", new { action = "Index", controller = "Casino", LangId = selLangBLL.GetLangId() })">
                            <i class="icon icon-menu-casino"></i>@selLangBLL.GetResourceValue("lbl_Casino")
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@Url.RouteUrl("desktop", new { action = "Index", controller = "LiveCasino", LangId = selLangBLL.GetLangId() })">
                            <i class="icon icon-menu-live"></i>@selLangBLL.GetResourceValue("lbl_LiveCasino")
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="@(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@gamingBLL.GetEntPageUrl(1,"202",Url)">
                            <i class="icon icon-menu-keno"></i>@selLangBLL.GetResourceValue("lbl_Keno")
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="@(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@gamingBLL.GetEntPageUrl(1,"220",Url)">
                            <i class="icon icon-menu-keno"></i>@selLangBLL.GetResourceValue("lbl_Lottery")
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@gamingBLL.GetEntPageUrl(1,"161",Url)">
                            <i class="icon icon-menu-number"></i>@selLangBLL.GetResourceValue("lbl_NumberGame")
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="@(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@entFishingPageUrl">
                            <i class="icon icon-menu-fishing"></i>@selLangBLL.GetResourceValue("lbl_FishingGG")
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="@(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@entFishingPageUrlSG1">
                            <i class="icon icon-menu-fishing"></i>@selLangBLL.GetResourceValue("lbl_FishingSG1")
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="@(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@entFishingPageUrlSG2">
                            <i class="icon icon-menu-fishing"></i>@selLangBLL.GetResourceValue("lbl_FishingSG2")
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="link-footer" href="@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })" target="_temp">
                            <i class="icon icon-promotion"></i>@selLangBLL.GetResourceValue("lbl_Promotion")
                        </a>
                    </div>
                </div>
                <div class="languages">
                    <div class="languages-box">
                        <div id="lang_selector" class="language-dropdown">
                            <label for="toggle" class="lang-flag lang-@selLangBLL.GetLangId()" title="@selLangBLL.GetResourceValue("lbl_SelectLanguage")">
                                <span class="flag"></span>
                            </label>
                            <ul class="lang-list">
                                @foreach (var siteLanguage in selLangBLL.GetLangIdList())
                                {
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <li class="lang lang-@siteLanguage.LangId @(siteLanguage.LangId == selLangBLL.GetLangId() ? "selected":"")" Js-lang-id="@siteLanguage.LangId" title="@siteLanguage.Language">
                                            <span class="flag"></span>
                                            <span class="text">@siteLanguage.Language</span>
                                        </li>
                                    }
                                    else
                                    {
                                        var LangUrl = $"{Url.RouteUrl("desktop", new { action = ViewContext.RouteData.Values["action"], controller = ViewContext.RouteData.Values["controller"], siteLanguage.LangId })}{Context.Request.QueryString}";
                                        <li class="lang lang-@siteLanguage.LangId @(siteLanguage.LangId == selLangBLL.GetLangId() ? "selected":"")" title="@siteLanguage.Language" onclick="location.href='@LangUrl';">
                                            <span class="flag"></span>
                                            <span class="text">@siteLanguage.Language</span>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                        <div id="lang_selected" class="lang_selected">
                            <p>@selLangBLL.GetLangIdList().Where(x => x.LangId == selLangBLL.GetLangId()).FirstOrDefault().Language</p>
                        </div>
                    </div>
                </div>
                <div class="nav-system">
                    <div class="system-mob">
                        <a href="@Url.RouteUrl("desktop", new { action="PersonalMsg" , controller="Message" , LangId=selLangBLL.GetLangId() })" class="system-item">
                            <span class="system-icon">
                                <i class="icon icon-info"></i>
                            </span><span>@selLangBLL.GetResourceValue("lbl_Message")</span>
                        </a>
                        <a href="@Url.RouteUrl("desktop", new { action="Profile" , controller="Account" , LangId=selLangBLL.GetLangId() })" class="system-item">
                            <span class="system-icon">
                                <i class="icon icon-account"></i>
                            </span><span>@selLangBLL.GetResourceValue("lbl_Profile")</span>
                        </a>
                        @*<a href="@Url.RouteUrl("desktop", new { action="Index" , controller="Promotion" , LangId=selLangBLL.GetLangId() })" class="system-item">
                                <span class="system-icon">
                                    <i class="icon icon-promotion"></i>
                                </span><span>@selLangBLL.GetResourceValue("lbl_Promotion")</span>
                            </a>*@
                        <a href="@Url.RouteUrl("desktop", new { action="ChangePwd" , controller="Account" , LangId=selLangBLL.GetLangId() })" class="system-item">
                            <span class="system-icon">
                                <i class="icon icon-key"></i>
                            </span><span>@selLangBLL.GetResourceValue("lbl_ChangePassword")</span>
                        </a>
                        <a href="@Url.RouteUrl("desktop", new { action="Deposit" , controller="Cashier" , LangId=selLangBLL.GetLangId() })" class="system-item">
                            <span class="system-icon">
                                <i class="icon icon-dola"></i>
                            </span><span>@selLangBLL.GetResourceValue("lbl_Transfer")</span>
                        </a>
                        <a href="@Url.RouteUrl("desktop", new { action="Transfer" , controller="History" , LangId=selLangBLL.GetLangId() })" class="system-item">
                            <span class="system-icon">
                                <i class="icon icon-history"></i>
                            </span><span>@selLangBLL.GetResourceValue("lbl_TransferHistory")</span>
                        </a>
                        <a href="@Url.RouteUrl("desktop", new { action = "Statement", controller = "History", LangId = selLangBLL.GetLangId() })" class="system-item">
                            <span class="system-icon">
                                <i class="icon icon-profile"></i>
                            </span><span>@selLangBLL.GetResourceValue("lbl_Statement")</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

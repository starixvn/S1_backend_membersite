<body>
    @{if (User.Identity.IsAuthenticated && !Context.Request.Cookies.ContainsKey($"InitializationReset{User.Identity.Name}"))
        {
            var authData = authorizeBLL.GetAuthData();
            var custInfo = custInfoBLL.GetCustInfo(authData.CustId);
            if (custInfo.IsResetPwd)
            {
                showResetPwdAlert = true;

                var option = new Microsoft.AspNetCore.Http.CookieOptions();
                option.Expires = DateTime.Now.AddDays(1);
                Context.Response.Cookies.Append($"InitializationReset{User.Identity.Name}", "1", option);
                @:<script>ResetPwdAlert = 1;</script>
                <div id="ResetPwdAlert"></div>
            }
        }
    }
    <div class="page">
        <partial name="~/_Views/Bwing/Mobile/Shared/_Header.cshtml" />
        <div class="wrap-content @(User.Identity.IsAuthenticated ? "is-login":"")">
            @RenderBody()
        </div>
        <partial name="~/_Views/Bwing/Mobile/Shared/_Footer.cshtml" />
    </div>

    <div class="remodal-bg"></div>
    @if (User.Identity.IsAuthenticated)
    {

    }
    else

                            <button class="btn btn-primary Js-Sports" type="button">
                                <span class="text">@selLangBLL.GetResourceValue("lbl_Enter")</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="app-loading" data-open="false">
                <div class="preloader">
                    <div class="preloader__spiner">
                        <div class="preloader__circles">
                            <div class="preloader__circle-1"></div>
                            <div class="preloader__circle-2"></div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</body>
</html>
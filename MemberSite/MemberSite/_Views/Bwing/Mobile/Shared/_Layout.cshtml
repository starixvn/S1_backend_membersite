                            <label>@selLangBLL.GetResourceValue("lbl_Username"):</label>
                            <input class="input-field invalid" type="text" id="Register_UserName" />
                            <div class="invalid-mess">@selLangBLL.GetResourceValue("lbl_UsernameTooltip")</div>
                        </div>
                        <div class="form-group" id="Register_UserName">
                            <label>@selLangBLL.GetResourceValue("lbl_Password"):</label>
                            <input class="input-field" type="text" />
                            <div class="invalid-mess">@selLangBLL.GetResourceValue("lbl_PasswordTooltip")</div>
                        </div>
                        <div class="form-group">
                            <label>@selLangBLL.GetResourceValue("lbl_Email"):</label>

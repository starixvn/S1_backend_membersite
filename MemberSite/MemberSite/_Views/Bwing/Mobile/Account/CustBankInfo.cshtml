@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = selLangBLL.GetResourceValue("lbl_CustBankInfo");

    Layout = "~/_Views/Bwing/Mobile/Shared/_Layout.cshtml";
}
@{
    var i18n = new Dictionary<string, string>();
    i18n.Add("lbl_BankName", selLangBLL.GetResourceValue("lbl_BankName"));
    i18n.Add("lbl_BankAccountName", selLangBLL.GetResourceValue("lbl_BankAccountName"));
    i18n.Add("lbl_BankAccountNameHint", selLangBLL.GetResourceValue("lbl_BankAccountNameHint"));
    i18n.Add("lbl_BankNumber", selLangBLL.GetResourceValue("lbl_BankNumber"));
    i18n.Add("lbl_NewAccountName", selLangBLL.GetResourceValue("lbl_NewAccountName"));
    i18n.Add("lbl_CustBankInfo", selLangBLL.GetResourceValue("lbl_CustBankInfo"));
    i18n.Add("lbl_Back", selLangBLL.GetResourceValue("lbl_Back"));
    i18n.Add("lbl_Submit", selLangBLL.GetResourceValue("lbl_Submit"));
    i18n.Add("lbl_BankInfo", selLangBLL.GetResourceValue("lbl_BankInfo"));
    i18n.Add("lbl_ContactCSD", selLangBLL.GetResourceValue("lbl_ContactCSD"));
    i18n.Add("lbl_AddNewAccount", selLangBLL.GetResourceValue("lbl_AddNewAccount"));
    i18n.Add("lbl_CheckConfirm", selLangBLL.GetResourceValue("lbl_CheckConfirm"));
    i18n.Add("lbl_BankAccount", selLangBLL.GetResourceValue("lbl_BankAccount"));
    i18n.Add("msg_NeedAccountName", selLangBLL.GetMsg("msg_NeedAccountName"));
    i18n.Add("msg_NeedAccountNo", selLangBLL.GetMsg("msg_NeedAccountNo"));
}
@section Style{
    <link href="~/SiteSkin/Bwing/Mobile/assets/css/page.css" rel="stylesheet" />
    <link href="~/SiteSkin/Bwing/Mobile/assets/css/system.css" rel="stylesheet" />
    <link href="~/SiteSkin/Bwing/Mobile/assets/css/select2.css" rel="stylesheet" />
}

@*$.extend(i18n, {"lbl_BankName":"Bank Name","lbl_BankAccountName":"Account Name","lbl_BankAccountNameHint":"Please use your real name for account name. This field cannot be changed once entered!","lbl_BankNumber":"Account Number","lbl_NewAccountName":null,"lbl_CustBankInfo":"Update Bank Information","lbl_Back":"Back","lbl_Submit":"Submit","lbl_BankInfo":"Bank Info","lbl_ContactCSD":"For any request of modification, please contact CSD.","lbl_AddNewAccount":"Add New Account","lbl_CheckConfirm":"Are you sure you want to delete? It cannot restore after deletion!","lbl_BankAccount":"Bank Account","msg_NeedAccountName":"Need Account Name","msg_NeedAccountNo":"Need Account Number"});*@



<div class="system-content">
    <div class="page-title">@selLangBLL.GetResourceValue("lbl_MyAccount")</div>
    <div class="sub-page">
        <div class="sub-title">
            <a href="@Url.RouteUrl("desktop", new { action = "ChangePwd", controller = "Account", LangId = selLangBLL.GetLangId() })">@selLangBLL.GetResourceValue("lbl_ChangePassword")</a>
        </div>
        <div class="sub-title">
            <a href="@Url.RouteUrl("desktop", new { action = "Profile", controller = "Account", LangId = selLangBLL.GetLangId() })">@selLangBLL.GetResourceValue("lbl_Profile")</a>
        </div>
        <div class="sub-title active">
            <a href="@Url.RouteUrl("desktop", new { action = "CustBankInfo", controller = "Account", LangId = selLangBLL.GetLangId() })">@selLangBLL.GetResourceValue("lbl_CustBank")</a>
        </div>
    </div>
    <div class="content">
        <div class="form form-account">
            <div class="form-group">
                <div class="label">
                    <span class="text-bold">@selLangBLL.GetResourceValue("lbl_BankAccountName"): </span>
                </div>
                <div class="input-field">
                    <input class="input-control text-bold AccountName" type="text" value="" placeholder="@selLangBLL.GetResourceValue("lbl_BankAccountName")" />
                </div>
            </div>
            <div class="button-group">
                <button class="btn btn-primary" id="btn-add-username">@selLangBLL.GetResourceValue("lbl_AddNewAccount")</button>
            </div>
        </div>
        <div class="table-content">
            <div class="option-header">
                <span class="text-bold">@selLangBLL.GetResourceValue("lbl_BankAccount")</span>
            </div>
            <table class="tbl-account">
                <tbody id="Bank_Account_List"></tbody>
            </table>
        </div>
        <div class="form form-add-user hide">
            <div class="form-group">
                <div class="label">
                    <span class="text-bold">@selLangBLL.GetResourceValue("lbl_BankAccountName"): </span>
                </div>
                <div class="input-field">
                    <input class="input-control text-bold AccountName" type="text" value="" placeholder="@selLangBLL.GetResourceValue("lbl_BankAccountName")" />
                </div>
                <span></span>
                <p class="bank-note">@selLangBLL.GetResourceValue("lbl_ContactCSD")</p>
                <div class="label">
                    <span class="text-bold">@selLangBLL.GetResourceValue("lbl_BankName"): </span>
                </div>
                <div class="input-field bank-wrapper" id="BankInfoSysList"></div>
                <div class="label">
                    <span class="text-bold">@selLangBLL.GetResourceValue("lbl_BankNumber"): </span>
                </div>
                <div class="input-field">
                    <input id="BankNumber" class="input-control text-bold" type="text" value="" placeholder="@selLangBLL.GetResourceValue("lbl_BankNumber")" />
                    <div class="invalid-mess"></div>
                </div>
            </div>

            <div class="button-group">
                <button class="btn btn-primary" id="btn-back">
                    Back
                </button>
                <button class="btn btn-secondary">Submit</button>
            </div>
        </div>
    </div>
</div>


@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL
@{
    ViewData["Title"] = selLangBLL.GetResourceValue("lbl_CustBankInfo");

    Layout = "~/_Views/Bwing/Mobile/Shared/_Layout.cshtml";
}
@{
    var i18n = new Dictionary<string, string>
    {
        { "lbl_BankName", selLangBLL.GetResourceValue("lbl_BankName") },
        { "lbl_BankAccountName", selLangBLL.GetResourceValue("lbl_BankAccountName") },
        { "lbl_BankAccountNameHint", selLangBLL.GetResourceValue("lbl_BankAccountNameHint") },
        { "lbl_BankNumber", selLangBLL.GetResourceValue("lbl_BankNumber") },
        { "lbl_NewAccountName", selLangBLL.GetResourceValue("lbl_NewAccountName") },
        { "lbl_CustBankInfo", selLangBLL.GetResourceValue("lbl_CustBankInfo") },
        { "lbl_Back", selLangBLL.GetResourceValue("lbl_Back") },
        { "lbl_Submit", selLangBLL.GetResourceValue("lbl_Submit") },
        { "lbl_BankInfo", selLangBLL.GetResourceValue("lbl_BankInfo") },
        { "lbl_ContactCSD", selLangBLL.GetResourceValue("lbl_ContactCSD") },
        { "lbl_AddNewAccount", selLangBLL.GetResourceValue("lbl_AddNewAccount") },
        { "lbl_CheckConfirm", selLangBLL.GetResourceValue("lbl_CheckConfirm") },
        { "lbl_BankAccount", selLangBLL.GetResourceValue("lbl_BankAccount") },
        { "msg_NeedAccountName", selLangBLL.GetMsg("msg_NeedAccountName") },
        { "msg_NeedAccountNo", selLangBLL.GetMsg("msg_NeedAccountNo") }
    };
}
@section Style{
    <link href="~/SiteSkin/Bwing/Mobile/assets/css/page.css" rel="stylesheet" />
    <link href="~/SiteSkin/Bwing/Mobile/assets/css/system.css" rel="stylesheet" />
}

<div class="system-content">
    <div class="page-title">@selLangBLL.GetResourceValue("lbl_MyAccount")</div>
    <div class="sub-page">
        <div class="sub-title">
            <a href="@Url.RouteUrl("desktop", new { action = "ChangePwd", controller = "Account", LangId = selLangBLL.GetLangId() })">@selLangBLL.GetResourceValue("lbl_ChangePassword")</a>
        </div>
        <div class="sub-title">
            <a href="@Url.RouteUrl("desktop", new { action = "Profile", controller = "Account", LangId = selLangBLL.GetLangId() })">@selLangBLL.GetResourceValue("lbl_Profile")</a>
        </div>
        <div class="sub-title active">
            <a href="@Url.RouteUrl("desktop", new { action = "CustBankInfo", controller = "Account", LangId = selLangBLL.GetLangId() })">@selLangBLL.GetResourceValue("lbl_CustBank")</a>
        </div>
    </div>
    <div class="content">
        <div class="form form-account">
            <div class="form-group">
                <div class="label">
                    <span class="text-bold">@selLangBLL.GetResourceValue("lbl_BankAccountName"): </span>
                </div>
                <div class="input-field">
                    <input class="input-control text-bold AccountName" type="text" value="" placeholder="@selLangBLL.GetResourceValue("lbl_BankAccountName")" />
                </div>
            </div>
            <div class="button-group">
                <button class="btn btn-primary" id="btn-add-username">@selLangBLL.GetResourceValue("lbl_AddNewAccount")</button>
            </div>
        </div>
        <div class="table-content">
            <div class="option-header">
                <span class="text-bold">@selLangBLL.GetResourceValue("lbl_BankAccount")</span>
            </div>
            <table class="tbl-account">
                <tbody id="Bank_Account_List"></tbody>
            </table>
        </div>
        <div class="form form-add-user hide">
            <form id="form">
                <div class="form-group">
                    <div class="label">
                        <span class="text-bold">@selLangBLL.GetResourceValue("lbl_BankAccountName"): </span>
                    </div>
                    <div class="input-field">
                        <input id="SetAccountName" class="input-control text-bold AccountName" type="text" value="" placeholder="@selLangBLL.GetResourceValue("lbl_BankAccountName")" />
                        <div class="invalid-mess"></div>
                    </div>
                    <span></span>
                    <p class="bank-note">@selLangBLL.GetResourceValue("lbl_ContactCSD")</p>
                    <div class="label">
                        <span class="text-bold">@selLangBLL.GetResourceValue("lbl_BankName"): </span>
                    </div>
                    <div class="input-field dropdown ddl-default" id="BankInfoSysList"></div>
                    <div class="label">
                        <span class="text-bold">@selLangBLL.GetResourceValue("lbl_BankNumber"): </span>
                    </div>
                    <div class="input-field">
                        <input id="BankNumber" class="input-control text-bold" type="text" value="" placeholder="@selLangBLL.GetResourceValue("lbl_BankNumber")" />
                        <div class="invalid-mess"></div>
                    </div>
                </div>

                <div class="button-group">
                    <button class="btn btn-primary" id="btn-back" type="button">@selLangBLL.GetResourceValue("lbl_Back")</button>
                    <button class="btn btn-secondary" type="submit">@selLangBLL.GetResourceValue("lbl_Submit")</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
    </script>
    <script src="~/lib/runtime.min.js"></script>
    @*<script src="~/js/component/account/CustBankInfo.min.js" asp-append-version="true"></script>*@
    <script src="~/js/Bwing/component/account/CustBankInfo.js" asp-append-version="true"></script>
}
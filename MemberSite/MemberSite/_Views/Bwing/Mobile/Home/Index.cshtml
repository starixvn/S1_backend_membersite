@functions{
    private class TpInfo
    {
        public int TpId { set; get; }
        public int CustId { set; get; }
        public Dictionary<string, string> inputs { set; get; }
    }

    async Task<decimal> Get3rdBalanceAsync(int tpId, int custId)
    {
        var apiUrl = configuration.GetValue<string>("TpService");
        var myUrl = $"{apiUrl}GetBalance";
        var oTpInfo = new TpInfo
        {
            TpId = tpId,
            CustId = custId,
            inputs = new Dictionary<string, string>()
        };

        var data = await courierAdapter.MyPostAsync<UserBalance, TpInfo>(myUrl, oTpInfo);

        return data.ErrorCode == 0 ? data.Data.balance + data.Data.bonus : 0;
    }
}
@section PromptMsg{
    @if (User.Identity.IsAuthenticated)
    {
        if (!Context.Request.Cookies.ContainsKey($"Initialization{User.Identity.Name}"))
        {
            var custId = customer.CustId;
            var balance = 0m;
            if (customer.ActStatus == 2)
            {
                balance = walletBLL.GetBalance(custId) + await Get3rdBalanceAsync(1, custId);
                if (custInfoBLL.IsConvertRequired(CurrencyId))
                {
                    balance /= 1000;
                }
            }

            if (balance < 1m)
            {
                <div class="modal" id="DepositAlet" data-open="true">
                    <div class="overlay"></div>
                    <div class="modal__dialog">
                        <button class="remodal-close Js-DepositAlet"></button>
                        <div class="modal__header">
                            <span class="text">@selLangBLL.GetResourceValue("lbl_Notice")</span>
                        </div>
                        <div class="modal__body">
                            @Html.Raw(string.Format(selLangBLL.GetMsg("msg_DepositAlert"), selLangBLL.GetResourceValue($"Currency_{CurrencyId}"), balance.ToString("#,##0.##")))
                        </div>
                        <div class="modal__footer">
                            <div class="btn-group">
                                <button class="btn btn-primary Js-DepositAlet" type="button">
                                    <span class="text">@selLangBLL.GetResourceValue("lbl_Later")</span>
                                </button>
                                <a class="btn btn-secondary" href="@Url.RouteUrl("desktop", new { action = "Deposit", controller = "Cashier", LangId = selLangBLL.GetLangId() })">
                                    <span class="text">@selLangBLL.GetResourceValue("lbl_DepositNow")</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                @:<script>DepositAlert = 1;</script>
            }
            var option = new Microsoft.AspNetCore.Http.CookieOptions
            {
                Expires = DateTime.Now.AddDays(1)
            };
            Context.Response.Cookies.Append($"Initialization{User.Identity.Name}", "1", option);
        }
    }
}

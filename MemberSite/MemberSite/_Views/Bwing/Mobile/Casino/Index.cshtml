@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL
@inject GamingBLL gamingBLL
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Title") + '|' + @selLangBLL.GetResourceValue("lbl_TitleDesc") + "|" + @selLangBLL.GetResourceValue("lbl_Casino");
    Layout = $"~/_Views/{serverInfo.SiteName}/Mobile/Shared/_Layout.cshtml";

    var SkinRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/Mobile");
    var lang = selLangBLL.GetLangId();
}
@section Style{
    <link rel="stylesheet" href="@SkinRootPath/assets/css/page.css" asp-append-version="true">
}

<div class="container p-t-20">
    <div class="casino-title">
        <img src="@SkinRootPath/assets/images/page/casino-title.png" alt="Banner" />
    </div>
    <div class="top-page-banner two-banner">
        <a class="item banner-1" onclick="location.href='@Url.RouteUrl("desktop", new { action = "Lobby", controller = "Casino", LangId = selLangBLL.GetLangId() })'">
            <img src="@SkinRootPath/assets/images/page/casino-banner-1-@(lang).jpg" alt="Banner" />
        </a>
        <a class="item banner-2 @(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" onclick="@(!User.Identity.IsAuthenticated ? "javascript:void(0);" : @gamingBLL.GetEntPageUrl(1,"208",Url))">
            <img src="@SkinRootPath/assets/images/page/casino-banner-2-@(lang).jpg" alt="Banner" />
        </a>
    </div>
</div>
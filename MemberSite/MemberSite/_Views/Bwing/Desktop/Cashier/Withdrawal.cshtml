@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Withdrawal");
    Layout = "~/_Views/Bwing/Desktop/Shared/_Layout.cshtml";
    var authData = authorizeBLL.GetAuthData();
    var custBankInfo = custInfoBLL.GetCustBankInfo(authData.CustId);
    int submittedCustPhotoId = 0;
}
@{
    var i18n = new Dictionary<string, string>();
    i18n.Add("lbl_Withdrawal", selLangBLL.GetResourceValue("lbl_Withdrawal"));
    i18n.Add("lbl_RecentTransactions", selLangBLL.GetResourceValue("lbl_RecentTransactions"));
    i18n.Add("lbl_AllTranscations", selLangBLL.GetResourceValue("lbl_AllTranscations"));
    i18n.Add("lbl_Date", selLangBLL.GetResourceValue("lbl_Date"));
    i18n.Add("lbl_Time", selLangBLL.GetResourceValue("lbl_Time"));
    i18n.Add("lbl_ID", selLangBLL.GetResourceValue("lbl_ID"));
    i18n.Add("lbl_Amount", selLangBLL.GetResourceValue("lbl_Amount"));
    i18n.Add("lbl_ChargeFee", selLangBLL.GetResourceValue("lbl_ChargeFee"));
    i18n.Add("lbl_Status", selLangBLL.GetResourceValue("lbl_Status"));
    i18n.Add("lbl_ConfirmWithdrawal", selLangBLL.GetResourceValue("lbl_ConfirmWithdrawal"));
    i18n.Add("lbl_ImportantNote", selLangBLL.GetResourceValue("lbl_ImportantNote"));
    i18n.Add("lbl_WithdrawalTo", selLangBLL.GetResourceValue("lbl_WithdrawalTo"));
    i18n.Add("lbl_BankAccountName", selLangBLL.GetResourceValue("lbl_BankAccountName"));
    i18n.Add("lbl_BankNumber", selLangBLL.GetResourceValue("lbl_BankNumber"));
    i18n.Add("lbl_WithdrawalAmount", selLangBLL.GetResourceValue("lbl_WithdrawalAmount"));
    i18n.Add("lbl_Memo", selLangBLL.GetResourceValue("lbl_Memo"));
    i18n.Add("lbl_Cancel", selLangBLL.GetResourceValue("lbl_Cancel"));
    i18n.Add("lbl_Confirm", selLangBLL.GetResourceValue("lbl_Confirm"));
    i18n.Add("lbl_Submit", selLangBLL.GetResourceValue("lbl_Submit"));
    i18n.Add("lbl_AmountTooltip", selLangBLL.GetResourceValue("lbl_AmountTooltip"));
    i18n.Add("lbl_TransferTo", selLangBLL.GetResourceValue("lbl_TransferTo"));
    i18n.Add("lbl_MomoHint", selLangBLL.GetResourceValue("lbl_MomoHint"));
    i18n.Add("lbl_CancelConfirm", selLangBLL.GetResourceValue("lbl_CancelConfirm"));
    i18n.Add("lbl_UploadPhotoId", selLangBLL.GetResourceValue("lbl_UploadPhotoId"));
    i18n.Add("lbl_UploadSuccess", selLangBLL.GetResourceValue("lbl_UploadSuccess"));
    i18n.Add("lbl_EligibleWithdrawalAmount", selLangBLL.GetResourceValue("lbl_EligibleWithdrawalAmount"));
    i18n.Add("lbl_RolloverOver", selLangBLL.GetResourceValue("lbl_RolloverOver"));
    i18n.Add("lbl_DepositOver", selLangBLL.GetResourceValue("lbl_DepositOver"));
    i18n.Add("lbl_WithdrawalOver", selLangBLL.GetResourceValue("lbl_WithdrawalOver"));
    i18n.Add("lbl_WithdrawalLimit", selLangBLL.GetResourceValue("lbl_WithdrawalLimit"));
    i18n.Add("lbl_Deduction", selLangBLL.GetResourceValue("lbl_Deduction"));
    i18n.Add("lbl_Balance", selLangBLL.GetResourceValue("lbl_Balance"));
    i18n.Add("lbl_SelectBank", selLangBLL.GetResourceValue("lbl_SelectBank"));
    i18n.Add("lbl_InputAmount", selLangBLL.GetResourceValue("lbl_InputAmount"));
    i18n.Add("lbl_DependOnTheBank", selLangBLL.GetResourceValue("lbl_DependOnTheBank"));
    i18n.Add("lbl_RecipientInfo", selLangBLL.GetResourceValue("lbl_RecipientInfo"));
    i18n.Add("lbl_WithdrawalNotice", selLangBLL.GetResourceValue("lbl_WithdrawalNotice"));
    i18n.Add("lbl_Note", selLangBLL.GetResourceValue("lbl_Note"));
    i18n.Add("lbl_AccountNumber", selLangBLL.GetResourceValue("lbl_AccountNumber"));
    i18n.Add("lbl_RecipientName", selLangBLL.GetResourceValue("lbl_RecipientName"));
    i18n.Add("lbl_PleaseSelBank", selLangBLL.GetResourceValue("lbl_PleaseSelBank"));

    string[] lbl_Txts = new string[] { "lbl_Close" };
    foreach (var lbl_Txt in lbl_Txts)
    {
        if (!i18n.ContainsKey(lbl_Txt))
            i18n.Add(lbl_Txt, selLangBLL.GetResourceValue(lbl_Txt));
    }

    for (int i = 0; i <= 7; i++)
    {
        if (!i18n.ContainsKey($"lbl_WithdrawalStatus{i}"))
            i18n.Add($"lbl_WithdrawalStatus{i}", selLangBLL.GetResourceValue($"lbl_WithdrawalStatus{i}"));
    }
    i18n.Add($"lbl_WithdrawalStatus{99}", selLangBLL.GetResourceValue($"lbl_WithdrawalStatus{99}"));
}

@section Style{
    <link rel="stylesheet" type="text/css" href="~/SiteSkin/Bwing/Desktop/assets/css/lib/daterangepicker.css" />
}

@if (custBankInfo == null || custBankInfo.bankInfoDetail == null || custBankInfo.bankInfoDetail.Count() == 0)
{
<div class="system-content">
    <partial name="~/_Views/Bwing/Desktop/Shared/_DesktopLeftMenu.cshtml" />
    <div class="modal" id="WithdrawalAlet" data-open="true">
        <div class="overlay"></div>
        <div class="modal__dialog">
            <div class="modal__header">
                <span class="text">@selLangBLL.GetResourceValue("lbl_ImportantNote")</span>
            </div>
            <div class="modal__body">
                <p>@selLangBLL.GetResourceValue("lbl_UpdateBankInfo")</p>
            </div>
            <div class="modal__footer">
                <div class="btn-group">
                    <a class="btn btn-secondary" href="@Url.RouteUrl("desktop", new { action = "CustBankInfo", controller = "Account", LangId = selLangBLL.GetLangId() })">
                        <span class="text">@selLangBLL.GetResourceValue("lbl_UpdateBankDetail")</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
}
else
{
    submittedCustPhotoId = custInfoBLL.SubmittedCustPhotoId(authData.CustId);
    if (submittedCustPhotoId == 2)
    {
        <div class="system-content">
            <partial name="~/_Views/Bwing/Desktop/Shared/_DesktopLeftMenu.cshtml" />
            <div class="right-panel">
                <div class="kyc page">
                    <h3>@selLangBLL.GetResourceValue("lbl_WaitKYC")</h3>
                    <div class="panel panel-primary panel--payment" data-open="true">
                        <div class="panel__header">
                            <span class="text"></span>
                            <i class="icon icon-caret"></i>
                        </div>
                        @*<div class="panel__body" id="UploadForm"></div>*@
                    </div>
                    <div class="text">@selLangBLL.GetResourceValue("lbl_WaitKYCHint")</div>
                </div>
            </div>
        </div>
    }
    else if (submittedCustPhotoId == 1)
    {
        <div class="system-content">
            <partial name="~/_Views/Bwing/Desktop/Shared/_DesktopLeftMenu.cshtml" />
            <div class="right-panel">
                <div class="kyc page">
                    <h3>@selLangBLL.GetResourceValue("lbl_SubmitPhotoId")</h3>
                    <div class="form-content" id="UploadForm"></div>
                    <div class="text">
                        @selLangBLL.GetResourceValue("lbl_SubmitPhotoIdHint")
                        <pre>@selLangBLL.GetResourceValue("lbl_SubmitPhotoIdList")</pre>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="system-content">
            <partial name="~/_Views/Bwing/Desktop/Shared/_DesktopLeftMenu.cshtml" />
            <div id="content" class="right-panel"></div>
        </div>
    }
}

@section Scripts{
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
    </script>
    @if (submittedCustPhotoId == 1)
    {
    <script src="~/js/component/account/UploadPhotoId.min.js" asp-append-version="true"></script>
    }
    else if(!(custBankInfo == null || custBankInfo.bankInfoDetail == null || custBankInfo.bankInfoDetail.Count() == 0))
    {
    <script type="text/javascript">
            var hrefAllTrans = "@Url.RouteUrl("desktop", new { action = "Withdrawal", controller = "History", LangId = selLangBLL.GetLangId() })";
    </script>
    <script src="~/lib/runtime.min.js"></script>
    <script src="~/js/Bwing/component/Desktop/cashier/WithdrawalPanel.min.js" asp-append-version="true"></script>
    }
}

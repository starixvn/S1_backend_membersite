@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject CustInfoBll custInfoBLL
@{
    ViewData["Title"] = "Transfer";
    Layout = "~/_Views/Bwing/Desktop/Shared/_Layout.cshtml";
    var authData = authorizeBLL.GetAuthData();
    var custInfo = custInfoBLL.GetCustInfo(authData.CustId);
    //var custInfoProfile = custInfoBLL.GetCustInfoProfile(authData.CustId);
}
@{

    var i18n = new Dictionary<string, string>
    {
        { "lbl_TransferFrom", selLangBLL.GetResourceValue("lbl_TransferFrom") },
        { "lbl_TransferTo", selLangBLL.GetResourceValue("lbl_TransferTo") },
        { "lbl_MaxAmount", selLangBLL.GetResourceValue("lbl_MaxAmount") },
        { "lbl_TransferFunds", selLangBLL.GetResourceValue("lbl_TransferFunds") },
        { "lbl_OtherWallet", selLangBLL.GetResourceValue("lbl_OtherWallet") },
        { "lbl_RetriveAllIn", selLangBLL.GetResourceValue("lbl_RetriveAllIn") },
        { "lbl_TransferIn", selLangBLL.GetResourceValue("lbl_TransferIn") },
        { "lbl_TransferOut", selLangBLL.GetResourceValue("lbl_TransferOut") },
        { "lbl_SabaWalletHint", selLangBLL.GetResourceValue("lbl_SabaWalletHint") },
        { "lbl_LastTransaction", selLangBLL.GetResourceValue("lbl_LastTransaction") },
        { "lbl_TurnoverAccmulateHint", selLangBLL.GetResourceValue("lbl_TurnoverAccmulateHint") },
        { "lbl_Req", selLangBLL.GetResourceValue("lbl_Req") },
        { "lbl_Currency", selLangBLL.GetResourceValue($"Currency_{custInfo.CurrencyId}") },
        { "lbl_TurnoverAccumulated", selLangBLL.GetResourceValue("lbl_TurnoverAccumulated") }
    };

    var lbl_Txts = new string[] { "lbl_Close", "lbl_AllTranscations", "lbl_Status", "lbl_Amount", "lbl_ID", "lbl_Time", "lbl_Date",
            "lbl_RecentTransactions", "lbl_Wallet_Saba", "lbl_MainWallet", "lbl_Transfer", "lbl_Balance", "lbl_Memo", "lbl_Direction",
            "lbl_WalletType", "lbl_Success", "lbl_Fail", "lbl_Pending", "lbl_ImportantNote" };
    foreach (var lbl_Txt in lbl_Txts)
    {
        if (!i18n.ContainsKey(lbl_Txt))
            i18n.Add(lbl_Txt, selLangBLL.GetResourceValue(lbl_Txt));
    }
}

@section Style{
    <link rel="stylesheet" type="text/css" href="~/SiteSkin/Bwing/Desktop/assets/css/lib/daterangepicker.css" />
}

<div class="system-content">
    <partial name="~/_Views/Bwing/Desktop/Shared/_DesktopLeftMenu.cshtml" />
    <div id="content" class="right-panel"></div>
</div>

@section Scripts{
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
        var hrefAllTrans = "@Url.RouteUrl("desktop", new { action = "Transfer", controller = "History", LangId = selLangBLL.GetLangId() })";
    </script>
    <script src="~/lib/runtime.min.js"></script>
    <script src="~/js/Bwing/component/Desktop/cashier/TransferPanel.min.js" asp-append-version="true"></script>
}
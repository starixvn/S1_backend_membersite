@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject CustInfoBLL custInfoBLL
@{
    ViewData["Title"] = "Transfer";
    Layout = "~/_Views/Bwing/Desktop/Shared/_Layout.cshtml";
    var authData = authorizeBLL.GetAuthData();
    //var custInfoProfile = custInfoBLL.GetCustInfoProfile(authData.CustId);
}
@{

    Dictionary<string, string> i18n = new Dictionary<string, string>();
    i18n.Add("lbl_TransferFrom", selLangBLL.GetResourceValue("lbl_TransferFrom"));
    i18n.Add("lbl_TransferTo", selLangBLL.GetResourceValue("lbl_TransferTo"));
    i18n.Add("lbl_MaxAmount", selLangBLL.GetResourceValue("lbl_MaxAmount"));
    i18n.Add("lbl_TransferFunds", selLangBLL.GetResourceValue("lbl_TransferFunds"));
    i18n.Add("lbl_OtherWallet", selLangBLL.GetResourceValue("lbl_OtherWallet"));
    i18n.Add("lbl_RetriveAllIn", selLangBLL.GetResourceValue("lbl_RetriveAllIn"));
    i18n.Add("lbl_TransferIn", selLangBLL.GetResourceValue("lbl_TransferIn"));
    i18n.Add("lbl_TransferOut", selLangBLL.GetResourceValue("lbl_TransferOut"));
    i18n.Add("lbl_SabaWalletHint", selLangBLL.GetResourceValue("lbl_SabaWalletHint"));
    i18n.Add("lbl_LastTransaction", selLangBLL.GetResourceValue("lbl_LastTransaction"));

    string[] lbl_Txts = new string[] { "lbl_Close", "lbl_AllTranscations", "lbl_Status", "lbl_Amount", "lbl_ID", "lbl_Time", "lbl_Date",
            "lbl_RecentTransactions", "lbl_Wallet_Saba", "lbl_MainWallet", "lbl_Transfer", "lbl_Balance", "lbl_Memo", "lbl_Direction",
            "lbl_WalletType", "lbl_Success", "lbl_Fail", "lbl_Pending" };
    foreach (var lbl_Txt in lbl_Txts)
    {
        if (!i18n.ContainsKey(lbl_Txt))
            i18n.Add(lbl_Txt, selLangBLL.GetResourceValue(lbl_Txt));
    }
}

@section Style{
    <link rel="stylesheet" type="text/css" href="~/SiteSkin/Bwing/Desktop/assets/css/lib/daterangepicker.css" />
}

<div class="system-content">
    <partial name="~/_Views/Bwing/Desktop/Shared/_DesktopLeftMenu.cshtml" />
    <div id="content" class="right-panel"></div>
</div>

@section Scripts{
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
        var hrefAllTrans = "@Url.RouteUrl("desktop", new { action = "Transfer", controller = "History", LangId = selLangBLL.GetLangId() })";
    </script>
    <script src="~/lib/runtime.min.js"></script>
    <script src="~/js/Bwing/component/Desktop/cashier/TransferPanel.min.js" asp-append-version="true"></script>
}
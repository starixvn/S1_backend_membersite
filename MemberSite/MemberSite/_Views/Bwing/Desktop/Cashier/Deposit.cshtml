@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject CustInfoBll custInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Deposit");
    Layout = "~/_Views/Bwing/Desktop/Shared/_Layout.cshtml";
    var authData = authorizeBLL.GetAuthData();
    var custInfoProfile = custInfoBLL.GetCustInfoProfile(authData.CustId);
}
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var i18n = new Dictionary<string, string>
    {
        { "lbl_Deposit", selLangBLL.GetResourceValue("lbl_Deposit") },
        { "lbl_Transaction", selLangBLL.GetResourceValue("lbl_Transaction") },
        { "lbl_TransactionHint", selLangBLL.GetResourceValue("lbl_TransactionHint") },
        { "lbl_BankAccountName", selLangBLL.GetResourceValue("lbl_BankAccountName") },
        { "lbl_BankNumber", selLangBLL.GetResourceValue("lbl_BankNumber") },
        { "lbl_DepositAmount", selLangBLL.GetResourceValue("lbl_DepositAmount") },
        { "lbl_Postscript", selLangBLL.GetResourceValue("lbl_Postscript") },
        { "lbl_PostscriptHint", selLangBLL.GetResourceValue("lbl_PostscriptHint") },
        { "lbl_Close", selLangBLL.GetResourceValue("lbl_Close") },
        { "lbl_ImportantNote", selLangBLL.GetResourceValue("lbl_ImportantNote") },
        { "lbl_ConfirmDeposit", selLangBLL.GetResourceValue("lbl_ConfirmDeposit") },
        { "lbl_TransferTo", selLangBLL.GetResourceValue("lbl_TransferTo") },
        { "lbl_Memo", selLangBLL.GetResourceValue("lbl_Memo") },
        { "lbl_Cancel", selLangBLL.GetResourceValue("lbl_Cancel") },
        { "lbl_Confirm", selLangBLL.GetResourceValue("lbl_Confirm") },
        { "lbl_RecentTransactions", selLangBLL.GetResourceValue("lbl_RecentTransactions") },
        { "lbl_AllTranscations", selLangBLL.GetResourceValue("lbl_AllTranscations") },
        { "lbl_Date", selLangBLL.GetResourceValue("lbl_Date") },
        { "lbl_Time", selLangBLL.GetResourceValue("lbl_Time") },
        { "lbl_ID", selLangBLL.GetResourceValue("lbl_ID") },
        { "lbl_Method", selLangBLL.GetResourceValue("lbl_Method") },
        { "lbl_Amount", selLangBLL.GetResourceValue("lbl_Amount") },
        { "lbl_Status", selLangBLL.GetResourceValue("lbl_Status") },
        { "lbl_WireTransfers", selLangBLL.GetResourceValue("lbl_WireTransfers") },
        { "lbl_DepositOptionHint", selLangBLL.GetResourceValue("lbl_DepositOptionHint") },
        { "lbl_CreditTime", selLangBLL.GetResourceValue("lbl_CreditTime") },
        { "lbl_5mins", selLangBLL.GetResourceValue("lbl_5mins") },
        { "lbl_Instant", selLangBLL.GetResourceValue("lbl_Instant") },
        { "lbl_OnlineBanking", selLangBLL.GetResourceValue("lbl_OnlineBanking") },
        { "lbl_MobileDeposit", selLangBLL.GetResourceValue("lbl_MobileDeposit") },
        { "lbl_AmountTooltip", selLangBLL.GetResourceValue("lbl_AmountTooltip") },
        { "lbl_Back", selLangBLL.GetResourceValue("lbl_Back") },
        { "lbl_Submit", selLangBLL.GetResourceValue("lbl_Submit") },
        { "lbl_NotinLimit", selLangBLL.GetResourceValue("lbl_NotinLimit") },
        { "lbl_MomoHint", selLangBLL.GetResourceValue("lbl_MomoHint") },
        { "lbl_Limit", selLangBLL.GetResourceValue("lbl_Limit") },
        { "lbl_Unlimited", selLangBLL.GetResourceValue("lbl_Unlimited") },
        { "lbl_Optional", selLangBLL.GetResourceValue("lbl_Optional") },
        { "lbl_Refno", selLangBLL.GetResourceValue("lbl_Refno") },
        { "lbl_RefnoToolTip", selLangBLL.GetResourceValue("lbl_RefnoToolTip") },
        { "lbl_DepositTime", selLangBLL.GetResourceValue("lbl_DepositTime") },
        { "lbl_DepositTimeToolTip", selLangBLL.GetResourceValue("lbl_DepositTimeToolTip") },
        { "lbl_Required", selLangBLL.GetResourceValue("lbl_Required") },
        { "lbl_UploadSuccess", selLangBLL.GetResourceValue("lbl_UploadSuccess") },
        { "lbl_UploadFile", selLangBLL.GetResourceValue("lbl_UploadFile") },
        { "lbl_UpdateSuccess", selLangBLL.GetResourceValue("lbl_UpdateSuccess") },
        { "lbl_AttachFile", selLangBLL.GetResourceValue("lbl_AttachFile") },
        { "lbl_SubmitProof", selLangBLL.GetResourceValue("lbl_SubmitProof") },
        { "lbl_CancelConfirm", selLangBLL.GetResourceValue("lbl_CancelConfirm") },
        { "lbl_MOMO", selLangBLL.GetResourceValue("lbl_MOMO") },
        { "lbl_ZALO", selLangBLL.GetResourceValue("lbl_ZALO") },
        { "lbl_VIETTELPAY", selLangBLL.GetResourceValue("lbl_VIETTELPAY") },
        { "lbl_ThaiQR", selLangBLL.GetResourceValue("lbl_ThaiQR") },
        { "lbl_Alipay", selLangBLL.GetResourceValue("lbl_Alipay") },
        { "lbl_WeChatPay", selLangBLL.GetResourceValue("lbl_WeChatPay") },
        { "lbl_QQpay", selLangBLL.GetResourceValue("lbl_QQpay") },
        { "lbl_JDpay", selLangBLL.GetResourceValue("lbl_JDpay") },
        { "lbl_Unionpay", selLangBLL.GetResourceValue("lbl_Unionpay") },
        { "lbl_SelectBank", selLangBLL.GetResourceValue("lbl_SelectBank") },
        { "lbl_InputAmount", selLangBLL.GetResourceValue("lbl_InputAmount") },
        { "lbl_DependOnTheBank", selLangBLL.GetResourceValue("lbl_DependOnTheBank") },
        { "lbl_PleaseSelBank", selLangBLL.GetResourceValue("lbl_PleaseSelBank") }
    };

    for (var depositStatus = 0; depositStatus <= 8; depositStatus++)
    {
        var sKey = $"lbl_DepositStatus{depositStatus}";
        i18n.Add(sKey, selLangBLL.GetResourceValue(sKey));
    }
    i18n.Add($"lbl_DepositStatus{99}", selLangBLL.GetResourceValue($"lbl_DepositStatus{99}"));

    for (var depositType = 1; depositType <= 3; depositType++)
    {
        var sKey = $"lbl_DepositType{depositType}";
        i18n.Add(sKey, selLangBLL.GetResourceValue(sKey));
    }
}
@section Style{

    <link rel="stylesheet" type="text/css" href="~/SiteSkin/Bwing/Desktop/assets/css/lib/daterangepicker.css" asp-append-version="true" />
}

<div class="system-content">
    <partial name="~/_Views/Bwing/Desktop/Shared/_DesktopLeftMenu.cshtml" />
    @if (custInfoProfile == null || custInfoProfile.AccountName == null || custInfoProfile.CountryCode == null || custInfoProfile.PhoneNo == null)
    {
        <div class="modal" id="DepositAlet" data-open="true">
            <div class="overlay"></div>
            <div class="modal__dialog">
                <div class="modal__header">
                    <span class="text">@selLangBLL.GetResourceValue("lbl_ImportantNote")</span>
                </div>
                <div class="modal__body">
                    <p>@selLangBLL.GetResourceValue("lbl_UpdatePersonalInfo")</p>
                </div>
                <div class="modal__footer">
                    <div class="btn-group">
                        <a class="btn btn-secondary" href="@Url.RouteUrl("desktop", new { action = "Profile", controller = "Account", LangId = selLangBLL.GetLangId() })">
                            <span class="text">@selLangBLL.GetResourceValue("lbl_UpdatePersonalDetail")</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div id="content" class="right-panel"></div>
    }
</div>

@section Scripts{
    @if (custInfoProfile == null || custInfoProfile.AccountName == null || custInfoProfile.CountryCode == null || custInfoProfile.PhoneNo == null)
    {

    }
    else
    {
        <script type="text/javascript">
    $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
    var hrefAllTrans = "@Url.RouteUrl("desktop", new { action = "Deposit", controller = "History", LangId = selLangBLL.GetLangId() })";
    var OnlineBankingUrl = "@Url.RouteUrl("desktop", new { action = "DepositReqOnlineBanking", controller = "Cashier", LangId = selLangBLL.GetLangId() })";
    var MobilePayUrl = "@Url.RouteUrl("desktop", new { action = "DepositReqMobilePay", controller = "Cashier", LangId = selLangBLL.GetLangId() })";
        </script>
        <script src="~/SiteSkin/Bwing/Desktop/js/lib/daterangepicker.min.js"></script>
        <script src="~/lib/runtime.min.js"></script>
        <script src="~/lib/clipboard.min.js"></script>
        <script src="~/js/Bwing/component/Desktop/cashier/depositPanel.min.js" asp-append-version="true"></script>
    }
}

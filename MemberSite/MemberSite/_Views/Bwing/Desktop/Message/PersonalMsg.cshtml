@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL

@{
    ViewData["Title"] = selLangBLL.GetResourceValue("lbl_PersonalMsg");
    Layout = "~/_Views/Bwing/Desktop/Shared/_Layout.cshtml";
}
@{
    var i18n = new Dictionary<string, string>
    {
        { "lbl_SelectAll", selLangBLL.GetResourceValue("lbl_SelectAll") },
        { "lbl_Page", selLangBLL.GetResourceValue("lbl_Page") },
        { "lbl_Of", selLangBLL.GetResourceValue("lbl_Of") },
        { "msg_NoData", selLangBLL.GetMsg("msg_NoData") },
        { "lbl_PersonalMsg", selLangBLL.GetResourceValue("lbl_PersonalMsg") },
        { "lbl_AreYouSure", selLangBLL.GetResourceValue("lbl_AreYouSure") }
    };
}

<div class="system-content">
    <partial name="~/_Views/Bwing/Desktop/Shared/_DesktopLeftMenu.cshtml" />
    <div id="content" class="right-panel"></div>
</div>

@section Scripts{
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
    </script>
    <script src="~/js/Bwing/component/Desktop/message/personalMsg/personalMsg.min.js" asp-append-version="true"></script>
}

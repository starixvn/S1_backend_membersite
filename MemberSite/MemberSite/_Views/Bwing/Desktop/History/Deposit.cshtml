@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL

@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Deposit");
    Layout = "~/_Views/Bwing/Desktop/Shared/_Layout.cshtml";
}
@{
    var i18n = new Dictionary<string, string>();
    i18n.Add("lbl_TransactionHistory", selLangBLL.GetResourceValue("lbl_TransactionHistory"));
    i18n.Add("lbl_TransactionHint", selLangBLL.GetResourceValue("lbl_TransactionHint"));
    i18n.Add("lbl_RecentTransactions", selLangBLL.GetResourceValue("lbl_RecentTransactions"));
    i18n.Add("lbl_Transaction", selLangBLL.GetResourceValue("lbl_Transaction"));
    i18n.Add("lbl_Deposit", selLangBLL.GetResourceValue("lbl_Deposit"));
    i18n.Add("lbl_Date", selLangBLL.GetResourceValue("lbl_Date"));
    i18n.Add("lbl_Time", selLangBLL.GetResourceValue("lbl_Time"));
    i18n.Add("lbl_From", selLangBLL.GetResourceValue("lbl_From"));
    i18n.Add("lbl_To", selLangBLL.GetResourceValue("lbl_To"));
    i18n.Add("lbl_ID", selLangBLL.GetResourceValue("lbl_ID"));
    i18n.Add("lbl_Method", selLangBLL.GetResourceValue("lbl_Method"));
    i18n.Add("lbl_Amount", selLangBLL.GetResourceValue("lbl_Amount"));
    i18n.Add("lbl_DepositAmount", selLangBLL.GetResourceValue("lbl_DepositAmount"));
    i18n.Add("lbl_Status", selLangBLL.GetResourceValue("lbl_Status"));
    i18n.Add("lbl_Submit", selLangBLL.GetResourceValue("lbl_Submit"));
    i18n.Add("lbl_Back", selLangBLL.GetResourceValue("lbl_Back"));
    i18n.Add("lbl_Refno", selLangBLL.GetResourceValue("lbl_Refno"));
    i18n.Add("lbl_RefnoToolTip", selLangBLL.GetResourceValue("lbl_RefnoToolTip"));
    i18n.Add("lbl_DepositTime", selLangBLL.GetResourceValue("lbl_DepositTime"));
    i18n.Add("lbl_DepositTimeToolTip", selLangBLL.GetResourceValue("lbl_DepositTimeToolTip"));
    i18n.Add("lbl_Required", selLangBLL.GetResourceValue("lbl_Required"));
    i18n.Add("lbl_UploadSuccess", selLangBLL.GetResourceValue("lbl_UploadSuccess"));
    i18n.Add("lbl_UploadFile", selLangBLL.GetResourceValue("lbl_UploadFile"));
    i18n.Add("lbl_UpdateSuccess", selLangBLL.GetResourceValue("lbl_UpdateSuccess"));
    i18n.Add("lbl_AttachFile", selLangBLL.GetResourceValue("lbl_AttachFile"));
    i18n.Add("lbl_CancelConfirm", selLangBLL.GetResourceValue("lbl_CancelConfirm"));
    i18n.Add("lbl_Optional", selLangBLL.GetResourceValue("lbl_Optional"));
    i18n.Add("lbl_BankAccountName", selLangBLL.GetResourceValue("lbl_BankAccountName"));
    i18n.Add("lbl_BankNumber", selLangBLL.GetResourceValue("lbl_BankNumber"));
    i18n.Add("lbl_DateMissing", selLangBLL.GetResourceValue("lbl_DateMissing"));
    i18n.Add("lbl_Cancel", selLangBLL.GetResourceValue("lbl_Cancel"));
    i18n.Add("lbl_Close", selLangBLL.GetResourceValue("lbl_Close"));
    i18n.Add("lbl_SubmitProof", selLangBLL.GetResourceValue("lbl_SubmitProof"));
    i18n.Add("lbl_Page", selLangBLL.GetResourceValue("lbl_Page"));
    i18n.Add("lbl_Of", selLangBLL.GetResourceValue("lbl_Of"));
    i18n.Add("msg_NoData", selLangBLL.GetMsg("msg_NoData"));

    i18n.Add("lbl_QuickPick", selLangBLL.GetResourceValue("lbl_QuickPick"));
    i18n.Add("lbl_Today", selLangBLL.GetResourceValue("lbl_Today"));
    i18n.Add("lbl_YesterDay", selLangBLL.GetResourceValue("lbl_YesterDay"));
    i18n.Add("lbl_ThisWeek", selLangBLL.GetResourceValue("lbl_ThisWeek"));
    i18n.Add("lbl_LastWeek", selLangBLL.GetResourceValue("lbl_LastWeek"));
    i18n.Add("lbl_ThisMonth", selLangBLL.GetResourceValue("lbl_ThisMonth"));
    i18n.Add("lbl_LastMonth", selLangBLL.GetResourceValue("lbl_LastMonth"));
    i18n.Add("lbl_ViewHistory", selLangBLL.GetResourceValue("lbl_ViewHistory"));
    i18n.Add("lbl_DepositHistory", selLangBLL.GetResourceValue("lbl_DepositHistory"));
    i18n.Add("lbl_Confirm", selLangBLL.GetResourceValue("lbl_Confirm"));

    for (var depositStatus = 0; depositStatus <= 8; depositStatus++)
    {
        var sKey = $"lbl_DepositStatus{depositStatus}";
        i18n.Add(sKey, selLangBLL.GetResourceValue(sKey));
    }
    i18n.Add($"lbl_DepositStatus{99}", selLangBLL.GetResourceValue($"lbl_DepositStatus{99}"));

    for (var depositType = 1; depositType <= 3; depositType++)
    {
        var sKey = $"lbl_DepositType{depositType}";
        i18n.Add(sKey, selLangBLL.GetResourceValue(sKey));
    }
}
@section Style{
    <link rel="stylesheet" type="text/css" href="~/SiteSkin/Bwing/Desktop/assets/css/lib/daterangepicker.css" />
}

<div class="system-content">
    <partial name="~/_Views/Bwing/Desktop/Shared/_DesktopLeftMenu.cshtml" />
    <div id="content" class="right-panel"></div>
</div>

@section Scripts{
    <script src="~/SiteSkin/Bwing/Desktop/js/lib/daterangepicker.min.js"></script>
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
    </script>
    <script src="~/lib/runtime.min.js"></script>
    <script src="~/lib/clipboard.min.js"></script>
    <script src="~/js/Bwing/component/Desktop/history/Deposit.min.js" asp-append-version="true"></script>
}

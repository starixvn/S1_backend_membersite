@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL

@{
    ViewData["Title"] = "Withdrawal";
    Layout = "~/_Views/Bwing/Desktop/Shared/_Layout.cshtml";
}
@{
    var i18n = new Dictionary<string, string>
    {
        { "lbl_TransactionHistory", selLangBLL.GetResourceValue("lbl_TransactionHistory") },
        { "lbl_Withdrawal", selLangBLL.GetResourceValue("lbl_Withdrawal") },
        { "lbl_Date", selLangBLL.GetResourceValue("lbl_Date") },
        { "lbl_Time", selLangBLL.GetResourceValue("lbl_Time") },
        { "lbl_From", selLangBLL.GetResourceValue("lbl_From") },
        { "lbl_To", selLangBLL.GetResourceValue("lbl_To") },
        { "lbl_ID", selLangBLL.GetResourceValue("lbl_ID") },
        { "lbl_Method", selLangBLL.GetResourceValue("lbl_Method") },
        { "lbl_Amount", selLangBLL.GetResourceValue("lbl_Amount") },
        { "lbl_ChargeFee", selLangBLL.GetResourceValue("lbl_ChargeFee") },
        { "lbl_Status", selLangBLL.GetResourceValue("lbl_Status") },
        { "lbl_Submit", selLangBLL.GetResourceValue("lbl_Submit") },
        { "lbl_Page", selLangBLL.GetResourceValue("lbl_Page") },
        { "lbl_Of", selLangBLL.GetResourceValue("lbl_Of") },
        { "lbl_DateMissing", selLangBLL.GetResourceValue("lbl_DateMissing") },
        { "msg_NoData", selLangBLL.GetMsg("msg_NoData") },
        { "lbl_QuickPick", selLangBLL.GetResourceValue("lbl_QuickPick") },
        { "lbl_Today", selLangBLL.GetResourceValue("lbl_Today") },
        { "lbl_YesterDay", selLangBLL.GetResourceValue("lbl_YesterDay") },
        { "lbl_ThisWeek", selLangBLL.GetResourceValue("lbl_ThisWeek") },
        { "lbl_LastWeek", selLangBLL.GetResourceValue("lbl_LastWeek") },
        { "lbl_ThisMonth", selLangBLL.GetResourceValue("lbl_ThisMonth") },
        { "lbl_LastMonth", selLangBLL.GetResourceValue("lbl_LastMonth") },
        { "lbl_ViewHistory", selLangBLL.GetResourceValue("lbl_ViewHistory") }
    };

    for (var i = 0; i <= 7; i++)
    {
        if (!i18n.ContainsKey($"lbl_WithdrawalStatus{i}"))
            i18n.Add($"lbl_WithdrawalStatus{i}", selLangBLL.GetResourceValue($"lbl_WithdrawalStatus{i}"));
    }
    i18n.Add($"lbl_WithdrawalStatus{99}", selLangBLL.GetResourceValue($"lbl_WithdrawalStatus{99}"));
}

@section Style{
    <link rel="stylesheet" type="text/css" href="~/SiteSkin/Bwing/Desktop/assets/css/lib/daterangepicker.css" />
}

<div class="system-content">
    <partial name="~/_Views/Bwing/Desktop/Shared/_DesktopLeftMenu.cshtml" />
    <div id="content" class="right-panel"></div>
</div>

@section Scripts{
    <script src="~/SiteSkin/Bwing/Desktop/js/lib/daterangepicker.min.js"></script>
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
    </script>
    <script src="~/lib/runtime.min.js"></script>
    <script src="~/js/Bwing/component/Desktop/history/Withdrawal.min.js" asp-append-version="true"></script>
}



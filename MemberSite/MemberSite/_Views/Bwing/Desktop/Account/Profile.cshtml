    i18n.Add("lbl_Month6", selLangBLL.GetResourceValue("lbl_Month6"));
    i18n.Add("lbl_Month7", selLangBLL.GetResourceValue("lbl_Month7"));
    i18n.Add("lbl_Month8", selLangBLL.GetResourceValue("lbl_Month8"));
    i18n.Add("lbl_Month9", selLangBLL.GetResourceValue("lbl_Month9"));
    i18n.Add("lbl_Month10", selLangBLL.GetResourceValue("lbl_Month10"));
    i18n.Add("lbl_Month11", selLangBLL.GetResourceValue("lbl_Month11"));
    i18n.Add("lbl_Month12", selLangBLL.GetResourceValue("lbl_Month12"));

    i18n.Add("lbl_Confirm", selLangBLL.GetResourceValue("lbl_Confirm"));
    i18n.Add("lbl_Later", selLangBLL.GetResourceValue("lbl_Later"));
    i18n.Add("lbl_DepositNow", selLangBLL.GetResourceValue("lbl_DepositNow"));
    i18n.Add("lbl_Success", selLangBLL.GetResourceValue("lbl_Success"));
    i18n.Add("lbl_Profile", selLangBLL.GetResourceValue("lbl_Profile"));
    i18n.Add("lbl_Username", selLangBLL.GetResourceValue("lbl_Username"));
    i18n.Add("lbl_UsernameTooltip", selLangBLL.GetResourceValue("lbl_UsernameTooltip"));
    i18n.Add("lbl_CompletedRegistration", selLangBLL.GetResourceValue("lbl_CompletedRegistration"));
    i18n.Add("lbl_Email", selLangBLL.GetResourceValue("lbl_Email"));
    i18n.Add("lbl_EmailToolTip", selLangBLL.GetResourceValue("lbl_EmailToolTip"));
    i18n.Add("lbl_BankAccountName", selLangBLL.GetResourceValue("lbl_BankAccountName"));
    i18n.Add("lbl_BankAccountNameHint", selLangBLL.GetResourceValue("lbl_BankAccountNameHint"));
    i18n.Add("lbl_Country", selLangBLL.GetResourceValue("lbl_Country"));
    i18n.Add("lbl_CountryTooltip", selLangBLL.GetResourceValue("lbl_CountryTooltip"));
    i18n.Add("lbl_Phone", selLangBLL.GetResourceValue("lbl_Phone"));

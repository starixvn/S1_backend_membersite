    i18n.Add("msg_OTP_SendOTPSMS_5002", selLangBLL.GetResourceValue("msg_OTP_SendOTPSMS_5002"));
    i18n.Add("msg_OTP_SendOTPSMS_1000", selLangBLL.GetResourceValue("msg_OTP_SendOTPSMS_1000"));


    var lbl_Txts = new string[] { "lbl_RealName", "lbl_RemindForName" };
    foreach (var lbl_Txt in lbl_Txts)
    {
        if (!i18n.ContainsKey(lbl_Txt))
            i18n.Add(lbl_Txt, selLangBLL.GetResourceValue(lbl_Txt));
    }

    var PerCountry = new CurrencyMapping().CountryMap;
    var currencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;
}

@section Style{
    <link rel="stylesheet" type="text/css" href="~/SiteSkin/Bwing/Desktop/assets/css/lib/daterangepicker.css" />
}

<div class="system-content">
    <partial name="~/_Views/Bwing/Desktop/Shared/_DesktopLeftMenu.cshtml" />
    <div id="content" class="right-panel"></div>
</div>

@section Scripts{
    <script type="text/javascript">
        var perCountry="@PerCountry[currencyId]";
        i18n = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n));
        var Country = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(selLangBLL.GetCountryList()));
    </script>
    <script src="~/SiteSkin/Bwing/Desktop/js/lib/daterangepicker.min.js"></script>
    <script src="~/lib/runtime.min.js"></script>

    @if (custInfoProfile == null || custInfoProfile.AccountName == null || custInfoProfile.CountryCode == null || custInfoProfile.PhoneNo == null)
    {
        <script>
            var SetStatus = '@(custInfoProfile == null || string.IsNullOrEmpty(custInfoProfile.AccountName) && string.IsNullOrEmpty(custInfoProfile.PhoneNo) ? 1 : string.IsNullOrEmpty(custInfoProfile.AccountName) ? 2 : 3)';
            var custdata = {
                AccountName:'@custInfoProfile.AccountName',
                Birthday: {
                    day:'@custInfoProfile.Birth_d',
                    month: '@custInfoProfile.Birth_m',
                    year:'@custInfoProfile.Birth_y'
                },
                PhoneNo: '@custInfoProfile.PhoneNo',
                Email: '@custInfoProfile.Email'
            }
        </script>
        <script src="~/js/Bwing/component/Desktop/account/UpdProfile.min.js" asp-append-version="true"></script>
    }
    else
    {
        <script src="~/js/Bwing/component/Desktop/account/Profile.min.js" asp-append-version="true"></script>
        <script>
            $('#showOTPPopup').click(function () {
                $('#OTPPopupContent').attr('data-open', "true");
                if (window.SendVerifySMS) {
                    window.SendVerifySMS();
                }
            })
        </script>
    }
}
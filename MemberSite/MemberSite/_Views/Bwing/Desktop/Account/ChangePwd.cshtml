@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_ChangePassword");
    Layout = "~/_Views/Bwing/Desktop/Shared/_Layout.cshtml";
}
@{
    var i18n = new Dictionary<string, string>();
    i18n.Add("lbl_OldPassword", selLangBLL.GetResourceValue("lbl_OldPassword"));
    i18n.Add("lbl_NewPassword", selLangBLL.GetResourceValue("lbl_NewPassword"));
    i18n.Add("lbl_PasswordTooltip", selLangBLL.GetResourceValue("lbl_PasswordTooltip"));
    i18n.Add("lbl_Submit", selLangBLL.GetResourceValue("lbl_Submit"));
    i18n.Add("msg_PasswordReq", selLangBLL.GetMsg("msg_PasswordReq"));
    i18n.Add("msg_PasswordLength", selLangBLL.GetMsg("msg_PasswordLength"));
    i18n.Add("msg_PasswordVaildate", selLangBLL.GetMsg("msg_PasswordVaildate"));
}
@section Style{
}

<div class="system-content">
    <partial name="~/_Views/Bwing/Desktop/Shared/_DesktopLeftMenu.cshtml" />
    <div class="right-panel">
        <div class="title">@selLangBLL.GetResourceValue("lbl_ChangePassword")</div>
        <div class="content">
            <form id="ChangePwdForm">
                <div class="form">
                    <div class="form-group" style="width: 100%;">
                        <div class="label">@selLangBLL.GetResourceValue("lbl_OldPassword"):</div>
                        <div class="input-field">
                            <input class="input-control oldpwd" name="OldPassword" type="password" autocomplete="off" />
                            <div class="invalid-mess"></div>
                        </div>
                        <div class="label">@selLangBLL.GetResourceValue("lbl_NewPassword"):</div>
                        <div class="input-field">
                            <input class="input-control newpwd" name="NewPassword" type="password" autocomplete="off" />
                            <div class="invalid-mess"></div>
                        </div>
                        <div class="label">@selLangBLL.GetResourceValue("lbl_Retype"):</div>
                        <div class="input-field">
                            <input class="input-control repwd" name="Retype" type="password" autocomplete="off" />
                            <div class="invalid-mess"></div>
                        </div>
                        <div class="label"></div>
                        <div class="button-group">
                            <button class="btn btn-primary type="submit">@selLangBLL.GetResourceValue("lbl_ChangePassword")</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
    </script>

    <script src="~/lib/runtime.min.js"></script>
    @*<script src="~/js/component/account/ChangePwd.min.js" asp-append-version="true"></script>*@
    <script src="~/js/Bwing/component/account/ChangePwd.js" asp-append-version="true"></script>
}

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_ForgetPassword");
    Layout = "~/_Views/Bwing/Desktop/Shared/_Layout.cshtml";
}

    <div class="page">
        <div class="wrap-content is-login">
            <div class="container p-t-20">
                <div class="page-content">
                    <div class="forget">
                        <div class="txt-yellow">@selLangBLL.GetResourceValue("lbl_ForgetPwdHint")</div>
                        <form class="form" method="post" id="ForgetPassowrd">
                            <div class="form-group">
                                <div class="label">
                                    <span class="text-white">@selLangBLL.GetResourceValue("lbl_YourEmail"): </span>
                                </div>
                                <div class="input-field">
                                    <input class="input-control" type="email" id="email">
                                </div>
                            </div>
                            <div class="btn-group">
                                <button class="btn btn-secondary" type="submit">
                                    <span class="text">@selLangBLL.GetResourceValue("lbl_Submit")</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

@section Scripts{
    <script>
        var langId = '@selLangBLL.GetLangId()';
    </script>
    <script src="~/lib/runtime.min.js"></script>
    <script src="~/js/component/home/ForgetPassowrd.min.js" asp-append-version="true"></script>
}
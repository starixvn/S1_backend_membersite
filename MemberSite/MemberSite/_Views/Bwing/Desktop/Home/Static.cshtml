@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using MemberSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL
@{
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_Title") + '|' + @selLangBLL.GetResourceValue("lbl_TitleDesc") + "|" + @selLangBLL.GetResourceValue("lbl_Sports");
    Layout = "~/Views/Shared/_Layout.cshtml";

    var serverInfo = serverInfoBLL.GetServerInfo();
    var SkinRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/common");
    var CMSPath = Url.Content($"~/CMS/{serverInfo.SiteName}");
}

@section Style{
    <style>
        html,
        body {
            height: 100%;
        }

        [data-layout=desktop] .main {
            background-size: cover;
            padding: 0rem 0rem;
            max-width: none;
        }
    </style>
}

<div class="main">
    @if (Context.Request.Query["gameId"] == "211")@*Live Casino*@
    {
        <img src="@SkinRootPath/images/Lobby/Home/Casino_Static.jpg" style="margin:auto;" />
    }
    else if (Context.Request.Query["gameId"] == "208") @*RNG*@
    {
        <img src="@SkinRootPath/images/Lobby/Home/RNG_Static.jpg" style="margin:auto;" />
    }
    else if (Context.Request.Query["gameId"] == "202") @*Lottery*@
    {
        <img src="@CMSPath/Keno/@selLangBLL.GetLangId()/landing-page.jpg" style="margin:auto;" />
    }
</div>
            </div>
            <div class="page-nav">
                <a class="@((SelectAction.Equals("Announcement", StringComparison.OrdinalIgnoreCase) && SelectController.Equals("Message", StringComparison.OrdinalIgnoreCase)) ? "toggle-section" : "")" href="@Url.RouteUrl("desktop", new { action = "Announcement", controller = "Message", LangId = selLangBLL.GetLangId() })">
                    @selLangBLL.GetResourceValue("lbl_Announcement")
                </a>
            </div>
        </div>
    </div>
</div>


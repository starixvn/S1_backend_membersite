@using MemberSite.Service.BLL
@using MemberSite.Service.Library
@using MemberSite.Service.Model.enums
@using System.Security.Claims
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject CustInfoBLL custInfoBLL
@inject PromotionBLL promotionBLL
@inject Tools tools
@inject GamingBLL gamingBLL
@inject AuthorizeBLL authorizeBLL
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var SkinRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/common");

    var entFishingPageUrl = "";
    int CurrencyId = 0;
    if (User.Identity.IsAuthenticated)
    {
        entFishingPageUrl = gamingBLL.GetEntPageUrl(7, "10", Url, GameType.Fishing);
        entFishingPageUrl = $"javascript:window.open('{entFishingPageUrl}', 'Tp_7_10', 'toolbar=no, menubar=no,scrollbars=no,resizable=no,location=no,directories=no,status=no, top=0, left=0').focus()";
        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;
    }
    else
    {
        entFishingPageUrl = "javascript:void(0);";
        CurrencyId = selLangBLL.GetPreferCurrencyId();
    }
}
<header class="header @(User.Identity.IsAuthenticated ? "is-login":"")">
    <div class="header-top-right container">
        @if (!User.Identity.IsAuthenticated)
        {
            <div class="before-login">
                <button class="btn btn-login" data-remodal-target="modal-login">
                    @selLangBLL.GetResourceValue("lbl_Login")
                </button>
                <button class="btn btn-register" data-remodal-target="modal-register">
                    @selLangBLL.GetResourceValue("lbl_Register")
                </button>
            </div>
        }
        else
        {
            <div class="after-login">
                <div class="dropdown-hover">
                    <a href="" class="btn btn-header-secondary">
                        <i class="icon icon-circle icon-cash"></i>Cashier<i class="icon icon-arrow-down"></i>
                    </a>
                    <div class="dropdown">
                        <ul>
                            <li>
                                <a href="views/system/cashier/deposit.html">Deposit</a>
                            </li>
                            <li>
                                <a href="views/system/cashier/transfer.html">Transfer</a>
                            </li>
                            <li>
                                <a href="views/system/cashier/withdrawal.html">Withdrawal</a>
                            </li>
                            <li>
                                <a href="views/system/history/deposit.html">Transaction History</a>
                            </li>
                            <li>
                                <a href="views/system/history/statement.html">Statement</a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="dropdown-hover">
                    <a href="" class="btn btn-header-primary">
                        <i class="icon icon-circle icon-wallet"></i><span>VND</span><span class="cash-detail">59,243,834</span><i class="icon icon-arrow-down"></i>
                    </a>
                    <div class="dropdown dropdown-wallet">
                        <div class="checkbox">
                            <input id="show-cash" type="checkbox" value="true" /><label for="show-cash">Show Balance</label>
                        </div>
                        <div class="wallet-item wallet-main">
                            <label class="text-bold">VND</label><span>0 ('000)<i class="icon icon-refresh"></i></span>
                        </div>
                        <div class="wallet-item">
                            <label>Sportsbook Wallet</label><span>0 ('000)</span>
                        </div>
                        <div class="button-group">
                            <button class="btn btn-primary" type="button">
                                Deposit
                            </button><button class="btn btn-primary" type="button">
                                Transfer
                            </button>
                        </div>
                        <div class="history">
                            <div class="flex between">
                                <span>Last Login</span><span>4/10/2020 10:05:58 PM</span>
                            </div>
                            <div class="flex between">
                                <span>Last Transaction</span><span>4/10/2020 10:05:58 PM</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="dropdown-hover">
                    <a href="" class="btn btn-header-primary">
                        <i class="icon icon-circle icon-user"></i><span>Tôn Nữ Phong</span><i class="icon icon-arrow-down"></i>
                    </a>
                    <div class="dropdown">
                        <ul>
                            <li>
                                <a href="views/system/account/change-password.html">Change Password</a>
                            </li>
                            <li>
                                <a href="views/system/account/profile.html">Profile</a>
                            </li>
                            <li>
                                <a href="views/system/account/bank-info.html">Bank</a>
                            </li>
                            <li>
                                <a href="views/system/notification/promotion.html">Promotion</a>
                            </li>
                            <li><a href="#">Logout</a></li>
                        </ul>
                    </div>
                </div>
                <div class="header-icon">
                    <a href="views/system/notification/announcement.html"><i class="icon icon-bell has-new"></i></a><a href="#/"><i class="icon icon-logout"></i></a>
                </div>
            </div>
        }
        <div class="languages">
            <div id="lang_selector" class="language-dropdown">
                <label for="toggle"
                       class="lang-flag lang-@selLangBLL.GetLangId()"
                       title="@selLangBLL.GetResourceValue("lbl_SelectLanguage")">
                    <span class="flag"></span>
                </label>
                <ul class="lang-list">
                    @foreach (var siteLanguage in selLangBLL.GetLangIdList())
                    {
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="lang lang-@siteLanguage.LangId @(siteLanguage.LangId == selLangBLL.GetLangId() ? "selected":"")" Js-lang-id="@siteLanguage.LangId" title="@siteLanguage.Language">
                                <span class="flag"></span>
                                <span class="text">@siteLanguage.Language</span>
                            </li>
                        }
                        else
                        {
                            var LangUrl = $"{Url.RouteUrl("desktop", new { action = ViewContext.RouteData.Values["action"], controller = ViewContext.RouteData.Values["controller"], LangId = siteLanguage.LangId })}{Context.Request.QueryString}";
                            <li class="lang lang-@siteLanguage.LangId @(siteLanguage.LangId == selLangBLL.GetLangId() ? "selected":"")" title="@siteLanguage.Language" onclick="location.href='@LangUrl';">
                                <span class="flag"></span>
                                <span class="text">@siteLanguage.Language</span>
                            </li>
                        }
                    }
                </ul>
            </div>
            <div id="lang_selected" class="lang_selected">
                <p>@selLangBLL.GetLangIdList().Where(x => x.LangId == selLangBLL.GetLangId()).FirstOrDefault().Language</p>
            </div>
            <span class="icon-arrow"></span>
        </div>
        <span class="btn-menu" id="menu-toggle">
            <span class="line"></span>
        </span>
    </div>
    <nav class="header-nav">
        <div class="container">
            <ul class="main-nav">
                <li class="nav-logo">
                    <a aria-current="page"
                       class="logo-header active"
                       href="index.html">
                        <img src="~/SiteSkin/Bwing/Desktop/images/logo.png" alt="@serverInfo.SiteName"/>

                    </a>
                </li>
                <li class="nav-item"><a href="views/sport.html">Sports</a></li>
                <li class="nav-item">
                    <a href="views/esport.html">E-Sports</a>
                </li>
                <li class="nav-item">
                    <a href="views/number-game.html">Number game</a>
                </li>
                <li class="nav-item">
                    <a href="views/virtual-sport.html">Virtual Sports</a>
                </li>
                <li class="nav-item"><a href="views/casino.html">Casino</a></li>
                <li class="nav-item">
                    <a href="views/live-casino.html">Live casino</a>
                </li>
                <li class="nav-item"><a href="views/keno.html">Keno</a></li>
                <li class="nav-item">
                    <a href="views/slot.html">Fishing World</a>
                </li>
            </ul>
        </div>
    </nav>
</header>
@using MemberSite.Service.BLL
@using MemberSite.Service.Library
@using MemberSite.Service.Model.enums
@using System.Security.Claims
@inject SelLangBLL selLangBLL
@inject ServerInfoBll serverInfoBLL
@inject CustInfoBll custInfoBLL
@inject PromotionBll promotionBLL
@inject Tools tools
@inject GamingBLL gamingBLL
@inject AuthorizeBLL authorizeBLL
@{
    var serverInfo = serverInfoBLL.GetServerInfo();
    var SkinRootPath = Url.Content($"~/SiteSkin/{serverInfo.SiteName}/common");

    var entFishingPageUrl = "";
    var entFishingPageUrlSG1 = "";
    var entFishingPageUrlSG2 = "";
    var CurrencyId = 0;
    if (User.Identity.IsAuthenticated)
    {
        entFishingPageUrl = gamingBLL.GetEntPageUrl(7, "10", Url, GameType.Fishing);
        entFishingPageUrl = $"javascript:window.open('{entFishingPageUrl}', 'Tp_7_10', 'toolbar=no, menubar=no,scrollbars=no,resizable=no,location=no,directories=no,status=no, top=0, left=0').focus()";

        entFishingPageUrlSG1 = gamingBLL.GetEntPageUrl(10, "F-SF01", Url, GameType.Fishing);
        entFishingPageUrlSG1 = $"javascript:window.open('{entFishingPageUrlSG1}', 'Tp_10_F-SF01', 'toolbar=no, menubar=no,scrollbars=no,resizable=no,location=no,directories=no,status=no, top=0, left=0').focus()";

        entFishingPageUrlSG2 = gamingBLL.GetEntPageUrl(10, "F-SF02", Url, GameType.Fishing);
        entFishingPageUrlSG2 = $"javascript:window.open('{entFishingPageUrlSG2}', 'Tp_10_F-SF02', 'toolbar=no, menubar=no,scrollbars=no,resizable=no,location=no,directories=no,status=no, top=0, left=0').focus()";

        var custId = Convert.ToInt32(User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
        CurrencyId = custInfoBLL.GetCustInfoWithCache(authorizeBLL.GetAuthData().CustId).CurrencyId;
    }
    else
    {
        entFishingPageUrl = "javascript:void(0);";
        entFishingPageUrlSG1 = "javascript:void(0);";
        entFishingPageUrlSG2 = "javascript:void(0);";
        CurrencyId = selLangBLL.GetPreferCurrencyId();
    }
}
<header class="header @(User.Identity.IsAuthenticated ? "is-login":"")">
    <div class="header-top-right container">
        <div class="languages">
            <div id="lang_selector" class="language-dropdown">
                <label for="toggle"
                       class="lang-flag lang-@selLangBLL.GetLangId()"
                       title="@selLangBLL.GetResourceValue("lbl_SelectLanguage")">
                    <span class="flag"></span>
                </label>
                <ul class="lang-list">
                    @foreach (var siteLanguage in selLangBLL.GetLangIdList())
                    {
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="lang lang-@siteLanguage.LangId @(siteLanguage.LangId == selLangBLL.GetLangId() ? "selected":"")" Js-lang-id="@siteLanguage.LangId" title="@siteLanguage.Language">
                                <span class="flag"></span>
                                <span class="text">@siteLanguage.Language</span>
                            </li>
                        }
                        else
                        {
                            var LangUrl = $"{Url.RouteUrl("desktop", new { action = ViewContext.RouteData.Values["action"], controller = ViewContext.RouteData.Values["controller"], siteLanguage.LangId })}{Context.Request.QueryString}";
                            <li class="lang lang-@siteLanguage.LangId @(siteLanguage.LangId == selLangBLL.GetLangId() ? "selected":"")" title="@siteLanguage.Language" onclick="location.href='@LangUrl';">
                                <span class="flag"></span>
                                <span class="text">@siteLanguage.Language</span>
                            </li>
                        }
                    }
                </ul>
            </div>
            <div id="lang_selected" class="lang_selected">
                <p>@selLangBLL.GetLangIdList().Where(x => x.LangId == selLangBLL.GetLangId()).FirstOrDefault().Language</p>
            </div>
            <span class="icon-arrow"></span>
        </div>
        @if (!User.Identity.IsAuthenticated)
        {
            <div class="before-login">
                <button class="btn btn-login" data-remodal-target="modal-login">
                    @selLangBLL.GetResourceValue("lbl_Login")
                </button>
                <button class="btn btn-register" data-remodal-target="modal-register">
                    @selLangBLL.GetResourceValue("lbl_Register")
                </button>
            </div>
        }
        else
        {
            <div class="after-login">
                <div class="dropdown-hover">
                    <a class="btn btn-header-secondary">
                        <i class="icon icon-circle icon-cash"></i>@selLangBLL.GetResourceValue("lbl_Cashier")<i class="icon icon-arrow-down"></i>
                    </a>
                    <div class="dropdown">
                        <ul>
                            <li>
                                <a href="@Url.RouteUrl("desktop", new { action = "Deposit", controller = "Cashier", LangId = selLangBLL.GetLangId() })">
                                    @selLangBLL.GetResourceValue("lbl_Deposit")
                                </a>
                            </li>
                            <li>
                                <a href="@Url.RouteUrl("desktop", new { action = "Transfer", controller = "Cashier", LangId = selLangBLL.GetLangId() })">
                                    @selLangBLL.GetResourceValue("lbl_Transfer")
                                </a>
                            </li>
                            <li>
                                <a href="@Url.RouteUrl("desktop", new { action = "Withdrawal", controller = "Cashier", LangId = selLangBLL.GetLangId() })">
                                    @selLangBLL.GetResourceValue("lbl_Withdrawal")
                                </a>
                            </li>
                            <li>
                                <a href="@Url.RouteUrl("desktop", new { action = "Deposit", controller = "History", LangId = selLangBLL.GetLangId() })">
                                    @selLangBLL.GetResourceValue("lbl_TransactionHistory")
                                </a>
                            </li>
                            <li>
                                <a href="@Url.RouteUrl("desktop", new { action = "Statement", controller = "History", LangId = selLangBLL.GetLangId() })">
                                    @selLangBLL.GetResourceValue("lbl_Statement")
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="dropdown-hover">
                    <a href="javascript:void(0)" class="btn btn-header-primary">
                        <i class="icon icon-circle icon-wallet"></i>
                        <span class="Js-Currency"></span>
                        <span class="cash-detail Js-Balance-Top"></span><i class="icon icon-arrow-down"></i>
                    </a>
                    <div class="dropdown dropdown-wallet">
                        <div class="checkbox">
                            <input id="show-cash" type="checkbox" /><label for="show-cash">@selLangBLL.GetResourceValue("lbl_ShowBalance")</label>
                        </div>
                        <div class="wallet-item wallet-main Js-Wallet-Refresh" id="wallet-main">
                            <label class="text-bold Js-Currency"></label>
                            <span class="Js-Balance"></span>
                        </div>
                        <div class="button-group">
                            <a class="btn btn-primary" href="@Url.RouteUrl("desktop", new { action = "Deposit", controller = "Cashier", LangId = selLangBLL.GetLangId() })">@selLangBLL.GetResourceValue("lbl_Deposit")</a>
                            <a class="btn btn-primary" href="@Url.RouteUrl("desktop", new { action = "Transfer", controller = "Cashier", LangId = selLangBLL.GetLangId() })">@selLangBLL.GetResourceValue("lbl_TransferFunds")</a>
                        </div>
                        <div class="history">
                            <div class="flex between">
                                <span>@selLangBLL.GetResourceValue("lbl_LastLogin")</span><span class="Js-LastLoginTime"></span>
                            </div>
                            <div class="flex between">
                                <span>@selLangBLL.GetResourceValue("lbl_LastTransaction")</span><span class="Js-LastTransaction"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="dropdown-hover">
                    <a class="btn btn-header-primary">
                        <i class="icon icon-circle icon-user"></i><span>@User.Identity.Name</span><i class="icon icon-arrow-down"></i>
                    </a>
                    <div class="dropdown">
                        <ul>
                            <li>
                                <a href="@Url.RouteUrl("desktop", new { action = "ChangePwd", controller = "Account", LangId = selLangBLL.GetLangId() })">
                                    @selLangBLL.GetResourceValue("lbl_ChangePassword")
                                </a>
                            </li>
                            <li>
                                <a href="@Url.RouteUrl("desktop", new { action = "Profile", controller = "Account", LangId = selLangBLL.GetLangId() })">
                                    @selLangBLL.GetResourceValue("lbl_Profile")
                                </a>
                            </li>
                            <li>
                                <a href="@Url.RouteUrl("desktop", new { action = "CustBankInfo", controller = "Account", LangId = selLangBLL.GetLangId() })">
                                    @selLangBLL.GetResourceValue("lbl_CustBank")
                                </a>
                            </li>
                            @*<li>
                                <a href="@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })">
                                    @selLangBLL.GetResourceValue("lbl_Promotion")
                                </a>
                            </li>*@
                            <li>
                                <a href="javascript:void(0)" class="Js-logout">
                                    @selLangBLL.GetResourceValue("lbl_Logout")
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="header-icon">
                    <a href="@Url.RouteUrl("desktop", new { action = "PersonalMsg", controller = "Message", LangId = selLangBLL.GetLangId() })">
                        <i id="msg-noti-icon" class="icon icon-bell"></i>
                    </a>
                    <a href="javascript:void(0)">
                        <i class="icon icon-logout"></i>
                    </a>
                </div>
            </div>
        }

        <span class="btn-menu" id="menu-toggle">
            <span class="line"></span>
        </span>
    </div>
    <nav class="header-nav">
        <div class="container">
            <div class="main-nav">
                <div class="nav-logo">
                    <a aria-current="page" class="logo-header active" href="@Url.RouteUrl("desktop", new { action = "Index", controller = "Home", LangId = selLangBLL.GetLangId() })">
                        <img src="~/SiteSkin/Bwing/Desktop/images/logo.png" alt="@serverInfo.SiteName" />
                    </a>
                </div>
                <div class="nav-item">
                    <a href="~/">
                        <img src="~/SiteSkin/Bwing/Desktop/images/home.png" />
                    </a>
                </div>
                <div class="nav-item">
                    <a href="@gamingBLL.GetEntPageUrl(1,"1",Url)">
                        @selLangBLL.GetResourceValue("lbl_Sports")
                    </a>
                </div>
                <div class="nav-item">
                    <a class="@(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@gamingBLL.GetEntPageUrl(1,"43",Url)">
                        @selLangBLL.GetResourceValue("lbl_eSports")
                    </a>
                </div>
                <div class="nav-item">
                    <a class="@(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@gamingBLL.GetEntPageUrl(1,"200",Url)">
                        Saba Club
                    </a>
                </div>
                <div class="nav-item">
                    <a href="@gamingBLL.GetEntPageUrl(1,"180",Url)">
                        @selLangBLL.GetResourceValue("lbl_VirtualSports")
                    </a>
                </div>
                <div class="nav-item">
                    <a href="@Url.RouteUrl("desktop", new { action = "Index", controller = "Casino", LangId = selLangBLL.GetLangId() })">
                        @selLangBLL.GetResourceValue("lbl_Casino")
                    </a>
                </div>
                <div class="nav-item">
                    <a href="@Url.RouteUrl("desktop", new { action = "Index", controller = "LiveCasino", LangId = selLangBLL.GetLangId() })">
                        @selLangBLL.GetResourceValue("lbl_LiveCasino")
                    </a>
                </div>
                <div class="nav-item lotteryBtn" id="lotteryBtn">
                    <a>@selLangBLL.GetResourceValue("lbl_Lottery")<i class="icon icon-arrow-down"></i></a>
                    <div class="snav-item" id="lotteryBtn_snav">
                        <a class="@(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@gamingBLL.GetEntPageUrl(1,"220",Url)">
                            @selLangBLL.GetResourceValue("lbl_Lottery")
                        </a>
                        <a class="@(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@gamingBLL.GetEntPageUrl(1,"202",Url)">
                            @selLangBLL.GetResourceValue("lbl_Keno")
                        </a>
                        <a href="@gamingBLL.GetEntPageUrl(1,"161",Url)">
                            @selLangBLL.GetResourceValue("lbl_NumberGame")
                        </a>
                    </div>
                </div>

                <div class="nav-item fishingBtn" id="fishingBtn">
                    <a>@selLangBLL.GetResourceValue("lbl_Fishing")<i class="icon icon-arrow-down"></i></a>
                    <div class="snav-item" id="fishingBtn_snav">
                        <a class="@(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@entFishingPageUrl">
                            @selLangBLL.GetResourceValue("lbl_FishingGG")
                        </a>
                        <a class="@(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@entFishingPageUrlSG1">
                            @selLangBLL.GetResourceValue("lbl_FishingSG1")
                        </a>
                        <a class="@(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@entFishingPageUrlSG2">
                            @selLangBLL.GetResourceValue("lbl_FishingSG2")
                        </a>
                    </div>
                </div>

                @*<div class="nav-item">
                    <a class="@(!User.Identity.IsAuthenticated ? "loginBtn" : string.Empty)" href="@entFishingPageUrl">
                        @selLangBLL.GetResourceValue("lbl_Fishing")
                    </a>
                </div>*@
                <div class="nav-item">
                    <a class="link-footer" href="@Url.RouteUrl("desktop", new { action = "Index", controller = "Promotion", LangId = selLangBLL.GetLangId() })">
                        @selLangBLL.GetResourceValue("lbl_Promotion")
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>


